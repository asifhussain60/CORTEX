# === SECURITY & PRIVACY RULES ===

  - rule_id: SENSITIVE_DATA_DETECTION
  category: security_privacy
  severity: blocked
  name: "No Sensitive Data in Commits"
  description: |
    MUST detect and block commits containing sensitive data.
    API keys, passwords, PII must be sanitized before commit.
  
  enforcement:
    trigger: "git_commit"
    action: "block_if_sensitive_data_detected"
  
  patterns:
    - regex: "[A-Z0-9]{20,}" # API keys
    - regex: "password\\s*=\\s*['\"].*['\"]" # Hardcoded passwords
    - regex: "\\b\\d{3}-\\d{2}-\\d{4}\\b" # SSN
    - regex: "\\b\\d{16}\\b" # Credit card numbers
  
  examples:
    pass:
      - "Commit without API keys"
      - "Secrets stored in environment variables"
    fail:
      - "Commit with API_KEY = 'sk-ABCD1234...'"

  - rule_id: PII_SANITIZATION
  category: security_privacy
  severity: blocked
  name: "PII Must Be Sanitized in Reports"
  description: |
    Reports and logs MUST NOT contain personally identifiable information.
    Use sanitization orchestrator before sharing.
  
  enforcement:
    trigger: "report_generation"
    action: "block_if_pii_detected"
  
  validation:
    - "Names → [REDACTED_NAME]"
    - "Emails → user@[DOMAIN_REDACTED]"
    - "Paths → /Users/[REDACTED]/..."

---

# Governance Settings
governance:
  enforcement_level: "strict" # strict | permissive | audit_only
  
  override_allowed: false # Cannot override blocked rules
  
  audit_logging:
    enabled: true
    log_path: "tracking/governance-audit.jsonl"
    track_violations: true
    track_overrides: false
  
  notification:
    enabled: true
    channels:
      - "console"
      - "log_file"

# Rule Priority (Higher = enforced first)
priority_order:
  1: SETUP_VERIFICATION  # Phase -2 runs first
  2: RUNTIME_GOVERNANCE  # Governance throughout execution
  3: TDD_ENFORCEMENT  # Tests before implementation
  4: PLANNING_ISOLATION  # Planning never implements
  5: PHASE_ACCEPTANCE_CRITERIA  # DoR/DoD validation
  6: GIT_ISOLATION  # Code stays in CORTEX repo
  7: TEARDOWN_REFACTOR  # Phase N+1 runs last
  8: EPIC_ACCEPTANCE_CRITERIA  # Final validation
  9: SENSITIVE_DATA_DETECTION  # Security check before commit
  10: HOLISTIC_DISCOVERY  # Search before create

