# CORTEX Brain Protection Rules (SKULL)
# Strategic Knowledge & Universal Lifecycle Laws
#
# These rules protect CORTEX's architectural integrity and prevent
# common failure patterns identified through lessons learned.
#
# Version: 5.0 (CORTEX v5 Universal Pattern Integration)
# Author: Asif Hussain
# Date: January 4, 2026

schema_version: "5.0"

# SKULL Rule Categories
categories:
  - development_workflow
  - architecture_integrity
  - quality_gates
  - orchestration_lifecycle
  - security_privacy

# === ORCHESTRATION LIFECYCLE RULES (NEW - CORTEX v5 Universal Pattern) ===

rules:
  - rule_id: SETUP_VERIFICATION
    category: orchestration_lifecycle
    severity: blocked
    name: "Phase -2: Setup Verification Mandatory"
    description: |
      ALL orchestrators MUST run Phase -2 setup verification before execution.
      This prevents false positives and ensures dependencies are ACTUALLY complete.
    enforcement:
      trigger: "orchestrator_execution_start"
      action: "block_if_verification_fails"
    validation:
      - "Dependencies must pass implementation tests (not just file existence)"
      - "False positive detection must run"
      - "VSCode cache state must be checked"
      - "Governance compliance must be validated"
    implementation:
      middleware: "src.orchestrators.middleware.setup_verification.SetupVerifier"
      hook: "pre_execution"
      priority: 1
    examples:
      pass:
        - "C50-03 verifies C50-00C tests ACTUALLY pass (pytest execution)"
        - "Planning v5 detects broken dependency file (import test fails)"
      fail:
        - "Orchestrator starts without running SetupVerifier"
        - "Dependency file exists but broken (false positive not detected)"

  - rule_id: TEARDOWN_REFACTOR
  category: orchestration_lifecycle
  severity: blocked
  name: "Phase N+1: Teardown + REFACTOR + Commit Mandatory"
  description: |
    ALL orchestrators MUST run Phase N+1 teardown after execution.
    This ensures code cleanup and atomic git commits follow /cortex-git-commit pattern.
  
  enforcement:
    trigger: "orchestrator_execution_complete"
    action: "block_if_refactor_fails"
  
  validation:
    - "Whole-file REFACTOR must run (remove unused imports, orphaned code)"
    - "All modified files must be refactored"
    - "Git commit must follow /cortex-git-commit pattern"
    - "Commit message must include orchestrator name + phase summary"
  
  implementation:
    middleware: "src.orchestrators.middleware.teardown_refactor.TeardownRefactor"
    hook: "post_execution"
    priority: 30
  
  examples:
    pass:
      - "Orchestrator completes → REFACTOR runs → Git commit with Co-authored-by"
      - "5 files modified → All refactored → Atomic commit"
    fail:
      - "Orchestrator completes but no REFACTOR cycle"
      - "Git commit without /cortex-git-commit pattern"

  - rule_id: RUNTIME_GOVERNANCE
  category: orchestration_lifecycle
  severity: blocked
  name: "Runtime Governance Enforcement (Gap 2 Remediation)"
  description: |
    Governance validation must occur at RUNTIME (not just Phase -1).
    SKULL rules must be enforced at phase start, operations, and completion.
  
  enforcement:
    trigger: "phase_start | operation_execution | phase_complete"
    action: "block_if_governance_violated"
  
  validation:
    - "Governance checkpoints must fire at phase boundaries"
    - "Audit trail must log all governance decisions"
    - "SKULL rule violations must block execution"
  
  implementation:
    middleware: "src.orchestrators.middleware.governance_checkpoint.GovernanceCheckpoint"
    hooks:
      - name: "pre_execution"
        priority: 20
      - name: "post_execution"
        priority: 20
    audit_log: "tracking/governance-audit.jsonl"
  
  examples:
    pass:
      - "Phase 2 starts → Governance checkpoint validates TDD_ENFORCEMENT → Passes"
      - "PLANNING_ISOLATION violated → Execution blocked → Audit logged"
    fail:
      - "Phase executes without governance checkpoint"
      - "Governance violation not logged to audit trail"

