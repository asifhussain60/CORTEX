# === DEVELOPMENT WORKFLOW RULES ===

  - rule_id: TDD_ENFORCEMENT
  category: development_workflow
  severity: blocked
  name: "Test-Driven Development Mandatory"
  description: |
    Tests MUST be written BEFORE implementation (RED → GREEN → REFACTOR).
    This prevents untested code from entering the codebase.
  
  enforcement:
    trigger: "code_change"
    action: "block_if_no_test_first"
  
  validation:
    - "Test file must exist before implementation file"
    - "Test must fail initially (RED phase)"
    - "Implementation makes test pass (GREEN phase)"
    - "REFACTOR phase removes code smells"
  
  examples:
    pass:
      - "test_feature.py created → RED → feature.py created → GREEN → REFACTOR"
    fail:
      - "feature.py created without test_feature.py"
      - "Test never fails (not actually testing anything)"

  - rule_id: INCREMENTAL_PLAN_GENERATION
  category: development_workflow
  severity: warning
  name: "Incremental Planning Enforced"
  description: |
    Plans should be generated incrementally, not all at once.
    This allows for course correction and user feedback.
  
  enforcement:
    trigger: "plan_generation"
    action: "warn_if_monolithic"
  
  validation:
    - "Plan should have logical phases/milestones"
    - "Each phase should have clear exit criteria"
    - "User checkpoints between phases"

  - rule_id: HOLISTIC_DISCOVERY
  category: development_workflow
  severity: blocked
  name: "Search Before Create (Prevent Duplication)"
  description: |
    MUST search workspace for existing implementations before creating new files.
    This prevents duplicate code and orphaned implementations.
  
  enforcement:
    trigger: "file_creation"
    action: "block_if_duplicate_exists"
  
  validation:
    - "Semantic search must run before file creation"
    - "Existing similar files must be reviewed"
    - "Justification required if creating despite duplicates"
  
  examples:
    pass:
      - "Search 'user authentication' → Found auth.py → Extend instead of create"
    fail:
      - "Create auth_new.py without searching for existing auth implementations"

