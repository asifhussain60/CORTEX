# === QUALITY GATES RULES ===

  - rule_id: PHASE_ACCEPTANCE_CRITERIA
  category: quality_gates
  severity: blocked
  name: "Phase-Level DoR/DoD Validation (Gap 1 Remediation)"
  description: |
    Phases MUST have Definition of Ready (DoR) and Definition of Done (DoD).
    DoR blocks phase start if not met. DoD blocks phase completion if not met.
  
  enforcement:
    trigger: "phase_start | phase_complete"
    action: "block_if_criteria_not_met"
  
  validation:
    - "DoR: dependencies_met, resources_available, false_positive_check"
    - "DoD: deliverables_created, tests_passing, refactor_complete"
  
  implementation:
    methods:
      - "validate_phase_dor(phase_number)"
      - "validate_phase_dod(phase_number)"
    hooks:
      - name: "pre_execution"
        priority: 15
      - name: "post_execution"
        priority: 5
  
  examples:
    pass:
      - "Phase 2 DoR met → Phase starts"
      - "Phase 2 DoD not met → Phase completion blocked"
    fail:
      - "Phase starts without DoR validation"
      - "Phase completes with failing tests (DoD not enforced)"

  - rule_id: EPIC_ACCEPTANCE_CRITERIA
  category: quality_gates
  severity: blocked
  name: "Epic-Level Production Readiness (Gap 3 Remediation)"
  description: |
    Epics MUST have production readiness checklist validated before completion.
    Single source of truth for 'system is production ready'.
  
  enforcement:
    trigger: "epic_completion"
    action: "block_if_not_production_ready"
  
  validation:
    - "All 130 acceptance criteria passed"
    - "Test coverage ≥80%"
    - "15-item production readiness checklist validated"
    - "Epic acceptance tracker updated"
  
  implementation:
    validator: "src.orchestrators.planning.epic_acceptance_validator.EpicAcceptanceValidator"
    hook: "post_execution"
    priority: 25
    condition: "orchestrator_type == 'planning' AND plan_type == 'epic'"
  
  examples:
    pass:
      - "Epic complete → 130 criteria validated → Production ready"
    fail:
      - "Epic marked complete with 15% test coverage"

  - rule_id: TEST_COVERAGE_MINIMUM
  category: quality_gates
  severity: warning
  name: "Minimum Test Coverage (80%)"
  description: |
    New code MUST maintain ≥80% test coverage.
    Below 80% triggers warning but doesn't block (can be overridden).
  
  enforcement:
    trigger: "code_change"
    action: "warn_if_coverage_below_80"
  
  validation:
    - "Line coverage ≥80%"
    - "Branch coverage ≥70%"
    - "Critical paths 100% covered"

