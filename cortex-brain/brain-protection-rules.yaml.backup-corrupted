# === ARCHITECTURE INTEGRITY RULES ===

  - rule_id: PLANNING_ISOLATION
  category: architecture_integrity
  severity: blocked
  name: "Planning Commands Create Plans ONLY"
  description: |
    When user says 'plan', ONLY create plan structure. NEVER implement.
    This prevents scope creep and ensures user review before execution.
  
  enforcement:
    trigger: "pattern_match:^(plan|create a plan).*$"
    action: "block_if_implementation_detected"
  
  validation:
    - "Planning command → Create plan folder + files"
    - "NO code implementation during planning"
    - "User must explicitly approve plan before execution"
  
  examples:
    pass:
      - "'plan user auth' → Creates plan folder with 00-user-auth.md"
    fail:
      - "'plan user auth' → Directly implements auth.py"

  - rule_id: GIT_ISOLATION
  category: architecture_integrity
  severity: blocked
  name: "CORTEX Code Never in User Repos"
  description: |
    CORTEX implementation code MUST stay in CORTEX repo.
    User repos get ONLY generated artifacts (plans, reports, configs).
  
  enforcement:
    trigger: "git_commit"
    action: "block_if_cortex_code_in_user_repo"
  
  validation:
    - "src/orchestrators/* → Only in CORTEX repo"
    - "User repo commits → Only artifacts (*.md, *.json, *.yaml)"
  
  examples:
    pass:
      - "CORTEX repo: Commit orchestrator code"
      - "User repo: Commit generated plan + report"
    fail:
      - "User repo: Commit planning_orchestrator_v5.py"

  - rule_id: DOCUMENT_ORGANIZATION_ENFORCEMENT
  category: architecture_integrity
  severity: warning
  name: "No Root-Level Documents"
  description: |
    Documents MUST be organized in cortex-brain/documents/{category}/.
    This prevents workspace clutter and improves discoverability.
  
  enforcement:
    trigger: "document_creation"
    action: "warn_if_root_level"
  
  validation:
    - "Reports → cortex-brain/documents/reports/"
    - "Analysis → cortex-brain/documents/analysis/"
    - "Summaries → cortex-brain/documents/summaries/"
  
  examples:
    pass:
      - "cortex-brain/documents/reports/gap-analysis.md"
    fail:
      - "gap-analysis.md" (root level)

