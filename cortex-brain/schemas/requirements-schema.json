{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CORTEX Requirements Specification",
  "description": "Schema for requirements.yaml files in CORTEX 6.0",
  "type": "object",
  "required": [
    "requirement_id",
    "description",
    "acceptance_criteria"
  ],
  "properties": {
    "requirement_id": {
      "type": "string",
      "pattern": "^REQ-\\d{3}$",
      "description": "Unique requirement identifier (e.g., REQ-001, REQ-002)"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "Detailed requirement description"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "List of acceptance criteria"
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0_CRITICAL",
        "P1_HIGH",
        "P2_MEDIUM",
        "P3_LOW"
      ],
      "description": "Requirement priority"
    },
    "status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "COMPLETE",
        "BLOCKED",
        "DEPRECATED"
      ],
      "description": "Current requirement status"
    },
    "category": {
      "type": "string",
      "enum": [
        "FUNCTIONAL",
        "NON_FUNCTIONAL",
        "TECHNICAL",
        "SECURITY",
        "PERFORMANCE",
        "USABILITY"
      ],
      "description": "Requirement category"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^feat\\d{2}$",
      "description": "Parent feature identifier"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^REQ-\\d{3}$"
      },
      "description": "List of requirement_ids this depends on"
    },
    "implementation": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "test_status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "NOT_RUN"]
        }
      },
      "description": "Implementation details"
    },
    "rationale": {
      "type": "string",
      "description": "Why this requirement exists"
    },
    "estimated_hours": {
      "type": "number",
      "minimum": 0,
      "description": "Estimated hours for implementation"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "author": {
          "type": "string"
        }
      },
      "description": "Requirement metadata"
    }
  }
}
