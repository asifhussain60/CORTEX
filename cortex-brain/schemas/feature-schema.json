{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CORTEX Feature Specification",
  "description": "Schema for feature.yaml files in CORTEX 6.0",
  "type": "object",
  "required": [
    "feature_id",
    "name",
    "description",
    "status"
  ],
  "properties": {
    "feature_id": {
      "type": "string",
      "pattern": "^feat\\d{2}$",
      "description": "Unique feature identifier (e.g., feat01, feat02)"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Feature name"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "Detailed feature description"
    },
    "status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "COMPLETE",
        "BLOCKED",
        "DEPRECATED"
      ],
      "description": "Current feature status"
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0_CRITICAL",
        "P1_HIGH",
        "P2_MEDIUM",
        "P3_LOW"
      ],
      "description": "Feature priority"
    },
    "estimated_hours": {
      "type": "number",
      "minimum": 0,
      "description": "Estimated hours for implementation"
    },
    "actual_hours": {
      "type": "number",
      "minimum": 0,
      "description": "Actual hours spent"
    },
    "owner": {
      "type": "string",
      "description": "Feature owner"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of feature_ids this depends on"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "description"],
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^REQ-\\d{3}$"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETE"]
          }
        }
      },
      "description": "List of requirements"
    },
    "implementation": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Implementation artifacts"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "string"
        }
      },
      "description": "Feature metadata"
    }
  }
}
