{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cortex.ai/schemas/health-data-v1.json",
  "title": "Universal Application Health Data Schema",
  "description": "Standardized schema for application health dashboard data supporting multiple applications (CORTEX, NOOR CANVAS, ALIST, KSESSIONS, etc.)",
  "version": "1.0.0",
  "type": "object",
  "required": ["metadata", "health", "code_metrics", "code_quality"],
  "properties": {
    "metadata": {
      "type": "object",
      "description": "Repository and scan metadata",
      "required": ["repo_name", "branch", "commit_hash", "commit_date", "last_scan"],
      "properties": {
        "repo_name": {
          "type": "string",
          "description": "Application or repository name",
          "examples": ["CORTEX", "NOOR-CANVAS", "ALIST", "KSESSIONS"]
        },
        "repo_url": {
          "type": "string",
          "format": "uri",
          "description": "Repository URL (GitHub, GitLab, etc.)",
          "examples": ["https://github.com/asifhussain60/CORTEX"]
        },
        "branch": {
          "type": "string",
          "description": "Current branch being analyzed",
          "examples": ["main", "dev", "develop", "development", "CORTEX-3.0"]
        },
        "commit_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,40}$",
          "description": "Latest commit SHA (short or full)",
          "examples": ["994eb319", "994eb319d1bb2f42"]
        },
        "commit_date": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of latest commit (ISO 8601)",
          "examples": ["2025-12-04T09:44:28-05:00"]
        },
        "last_scan": {
          "type": "string",
          "format": "date-time",
          "description": "When this health data was generated (ISO 8601)",
          "examples": ["2025-12-04T10:00:00-05:00"]
        },
        "scan_duration_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Time taken to generate this health data"
        },
        "scanner_version": {
          "type": "string",
          "description": "Version of the scanning tool",
          "examples": ["CORTEX-3.5.5", "HealthScanner-2.1.0"]
        }
      }
    },
    "health": {
      "type": "object",
      "description": "Overall application health indicators",
      "required": ["overall_score", "trend", "status"],
      "properties": {
        "overall_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Composite health score (0=critical, 100=excellent)"
        },
        "trend": {
          "type": "string",
          "enum": ["improving", "stable", "degrading"],
          "description": "Direction of health change over time"
        },
        "status": {
          "type": "string",
          "enum": ["healthy", "warning", "critical"],
          "description": "Traffic light status indicator"
        }
      }
    },
    "code_metrics": {
      "type": "object",
      "description": "Code size and composition metrics",
      "required": ["lines_of_code", "file_count", "directory_count"],
      "properties": {
        "lines_of_code": {
          "type": "integer",
          "minimum": 0,
          "description": "Total lines of code (excluding comments and blanks)"
        },
        "file_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of files in repository"
        },
        "directory_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of directories"
        },
        "language_breakdown": {
          "type": "object",
          "description": "Lines of code by programming language",
          "patternProperties": {
            "^[A-Za-z0-9+#/ -]+$": {
              "type": "integer",
              "minimum": 0
            }
          },
          "examples": [
            {
              "Python": 15000,
              "TypeScript": 8500,
              "C#": 12000,
              "HTML/CSS": 3000
            }
          ]
        }
      }
    },
    "code_quality": {
      "type": "object",
      "description": "Code quality and maintainability metrics",
      "required": ["complexity_score", "maintainability_index"],
      "properties": {
        "complexity_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Inverse of complexity (100=simple, 0=highly complex)"
        },
        "maintainability_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Microsoft maintainability index"
        },
        "cyclomatic_complexity_avg": {
          "type": "number",
          "minimum": 0,
          "description": "Average cyclomatic complexity per function"
        },
        "cognitive_complexity_avg": {
          "type": "number",
          "minimum": 0,
          "description": "Average cognitive complexity (mental load)"
        },
        "code_duplication_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of duplicated code"
        },
        "comment_ratio_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Ratio of comment lines to total lines"
        }
      }
    },
    "testing": {
      "type": "object",
      "description": "Test coverage and execution metrics",
      "properties": {
        "coverage_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Overall test coverage percentage"
        },
        "unit_test_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of unit tests"
        },
        "integration_test_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of integration tests"
        },
        "test_pass_rate_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of tests that pass"
        }
      }
    },
    "issues": {
      "type": "object",
      "description": "Open issues and technical debt",
      "properties": {
        "total_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of open issues"
        },
        "by_severity": {
          "type": "object",
          "description": "Issue breakdown by severity",
          "properties": {
            "critical": {
              "type": "integer",
              "minimum": 0
            },
            "high": {
              "type": "integer",
              "minimum": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "low": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "technical_debt_days": {
          "type": "number",
          "minimum": 0,
          "description": "Estimated days to resolve technical debt"
        },
        "code_smells_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of code smells (anti-patterns) detected"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "description": "Dependency health and security",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of dependencies"
        },
        "direct": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of direct (top-level) dependencies"
        },
        "transitive": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of transitive (nested) dependencies"
        },
        "outdated": {
          "type": "integer",
          "minimum": 0,
          "description": "Dependencies with available updates"
        },
        "vulnerable": {
          "type": "integer",
          "minimum": 0,
          "description": "Dependencies with known CVEs"
        },
        "health_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Overall dependency health score"
        }
      }
    },
    "security": {
      "type": "object",
      "description": "Security posture and vulnerabilities",
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Overall security score"
        },
        "vulnerabilities": {
          "type": "object",
          "description": "Vulnerability breakdown by severity",
          "properties": {
            "critical": {
              "type": "integer",
              "minimum": 0
            },
            "high": {
              "type": "integer",
              "minimum": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "low": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "secrets_exposed": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of exposed secrets (API keys, passwords)"
        },
        "last_scan": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last security scan"
        }
      }
    },
    "performance": {
      "type": "object",
      "description": "Performance and deployment metrics",
      "properties": {
        "build_time_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Average build duration in seconds"
        },
        "test_execution_time_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Average test suite execution time"
        },
        "deployment_frequency": {
          "type": "string",
          "enum": ["multiple_per_day", "daily", "weekly", "biweekly", "monthly", "quarterly", "rarely"],
          "description": "How often deployments occur"
        },
        "mean_time_to_recovery_hours": {
          "type": "number",
          "minimum": 0,
          "description": "MTTR for production incidents"
        }
      }
    },
    "activity": {
      "type": "object",
      "description": "Development activity metrics",
      "properties": {
        "commits_last_30_days": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of commits in last 30 days"
        },
        "contributors_active": {
          "type": "integer",
          "minimum": 0,
          "description": "Active contributors (last 90 days)"
        },
        "pull_requests_open": {
          "type": "integer",
          "minimum": 0,
          "description": "Currently open pull requests"
        },
        "pull_requests_merged_last_30_days": {
          "type": "integer",
          "minimum": 0,
          "description": "Pull requests merged in last 30 days"
        }
      }
    },
    "custom_metrics": {
      "type": "object",
      "description": "Application-specific custom metrics (optional, extensible)",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
