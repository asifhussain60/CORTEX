    {
      "id": "KB-DAT-002",
      "domain": "DATA-MANAGEMENT",
      "title": "oracle-best-practices",
      "description": {
        "critical_practices": [
          "Always use bind variables (prevents SQL injection, enables caching)",
          "Use connection pooling (dramatically improves performance)",
          "Close resources properly (prevents resource leaks)",
          "Never hardcode credentials (security fundamental)",
          "Use explicit transactions (ensures data consistency)",
          "Grant least privileges (limits security exposure)"
        ],
        "performance_priorities": [
          "Use appropriate indexes",
          "Set optimal arraysize (1000 for large result sets)",
          "Use executemany() for bulk operations",
          "Select only required columns",
          "Keep transactions short",
          "Gather statistics regularly"
        ],
        "security_priorities": [
          "Use bind variables (prevent SQL injection)",
          "Secure credential storage",
          "Enable network encryption",
          "Implement least privilege access",
          "Enable auditing for sensitive operations",
          "Validate and sanitize all user input"
        ],
        "common_pitfalls": [
          "String concatenation in SQL (SQL injection risk)",
          "Not closing connections (resource leaks)",
          "Fetching rows one at a time (performance issue)",
          "Using SELECT * (inefficient data transfer)",
          "Long-running transactions (lock contention)",
          "Over-privileged database users (security risk)"
        ]
      },
      "file_path": "cortex-brain/tier3/knowledge/DATA-MANAGEMENT/oracle-best-practices.yaml",
