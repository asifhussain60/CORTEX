{
  "name": "cortex-intelligent-ux-demo",
  "version": "1.0.0",
  "description": "Intelligent UX Enhancement Dashboard with Playwright UI Tests",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "serve": "python3 -m http.server 8080",
    "test:ci": "playwright test --reporter=github"
  },
  "keywords": [
    "cortex",
    "ux",
    "dashboard",
    "d3js",
    "visualization",
    "testing"
  ],
  "author": "Asif Hussain",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@types/node": "^20.10.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
