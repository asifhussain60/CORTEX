# ==============================================================================
# CORTEX 6.0 FINALIZED ACCEPTANCE CRITERIA - POST-DOR
# ==============================================================================
# Purpose: Comprehensive acceptance criteria incorporating all stakeholder
#          clarifications and DOR decisions from holistic plan review
# 
# Status: FINALIZED - All ambiguities resolved, validation-ready
# Version: 17.0.0
# Created: 2026-01-09
# Author: Asif Hussain
# DOR Achievement: 100% (14/14 decisions made)
#
# Supersedes: CX6-acceptance-criteria.yaml v16.1.0
# Source: CORTEX6-COMPREHENSIVE-UPGRADE-PLAN.yaml + DOR clarifications
# Total Criteria: 405+ (390 original + 15 new from DOR decisions)
# ==============================================================================

metadata:
  document_type: finalized_acceptance_criteria
  version: 17.0.0
  status: FINALIZED
  dor_status: COMPLETE
  created: 2026-01-09T18:00:00Z
  author: Asif Hussain
  epic_id: CORTEX6-BUILD
  
  changelog:
    v17.0.0:
      date: 2026-01-09T18:00:00Z
      changes:
        - "Added SECTION 26: MIGRATE ORCHESTRATOR (AC-ORC-MIGRATE-001 to AC-ORC-MIGRATE-006)"
        - "Added SECTION 27: CROSS-REPO INFRASTRUCTURE (AC-CROSS-001 to AC-CROSS-009)"
        - "Updated AC-GOV-001: No backward compatibility for SKULL migration"
        - "Updated AC-ORC-HOUSE-001: Manual on-demand only (no auto-triggers)"
        - "Updated AC-AUDIT-007: Size-based log rotation (50MB) + daily fallback"
        - "Updated AC-VAL-005: Bootstrap self-audit validation strategy"
        - "Updated AC-TDD-002: AC-ID tracking only (schema validation separate)"
        - "Added 15 new criteria from DOR decisions (Q3-Q16)"
        - "Total criteria: 405+ (was 390+)"
      reason: "DOR completion - All ambiguities resolved, all architectural decisions finalized"
      
  decision_integration:
    total_decisions: 14
    new_criteria: 15
    updated_criteria: 7
    sections_added: 2
    
  validation_framework:
    dual_evidence: Both test + audit required
    test_tool: pytest with @pytest.mark.ac_id()
    audit_tool: AuditLogger with AC-ID tags
    query_tools: [mcp_ac_coverage, mcp_audit_validate]

# ==============================================================================
# SECTION 1: AUDIT LOGGER INFRASTRUCTURE (UPDATED)
# ==============================================================================

audit_logger_infrastructure:
  
  AC-AUDIT-001:
    id: AC-AUDIT-001
    name: Audit Logger Initialization
    priority: P0_CRITICAL
    stage: 1
    phase: 1.1
    
    criteria: |
      AuditLogger class implements thread-safe singleton pattern with
      initialization to both SQLite database and JSONL backup files.
      
    validation:
      test: |
        - Import AuditLogger in multiple threads
        - Verify same instance returned
        - Verify database connection established
        - Verify JSONL file created
      audit: |
        - Query audit.db for operation='audit_logger_init'
        - Verify timestamp, status=success
        
    acceptance:
      - "✅ Singleton pattern prevents multiple instances"
      - "✅ Thread-safe initialization (threading.Lock)"
      - "✅ SQLite connection to cortex-brain/database/audit.db"
      - "✅ JSONL file created in cortex-brain/audit-logs/"
      - "✅ Self-audit entry logged (bootstrap validation)"
      
  AC-AUDIT-002:
    id: AC-AUDIT-002
    name: Seven Audit Categories
    priority: P0_CRITICAL
    stage: 1
    phase: 1.1
    
    criteria: |
      AuditLogger provides 7 category-specific logging methods with
      consistent interface and JSONL output format.
      
    categories:
      - log_governance(operation, status, ac_id, **metadata)
      - log_orchestrator(operation, status, ac_id, **metadata)
      - log_validation(operation, status, ac_id, **metadata)
      - log_infrastructure(operation, status, ac_id, **metadata)
      - log_mcp(operation, status, ac_id, **metadata)
      - log_brain(operation, status, ac_id, **metadata)
      - log_integration(operation, status, ac_id, **metadata)
      
    validation:
      test: |
        - Call each category method
        - Verify JSONL format {"timestamp", "ac_id", "category", "operation", "status", "duration_ms", "metadata"}
        - Verify database entry created
      audit: |
        - Query each category in audit.db
        - Verify 7 distinct categories exist
        
    acceptance:
      - "✅ All 7 categories implemented"
      - "✅ Consistent method signatures"
      - "✅ JSONL format validated"
      - "✅ Database entries created with correct category"
      
  AC-AUDIT-003:
    id: AC-AUDIT-003
    name: Performance Requirements
    priority: P0_CRITICAL
    stage: 1
    phase: 1.1
    
    criteria: |
      AuditLogger meets performance SLAs for latency, throughput, and memory.
      
    slas:
      latency: "<5ms per log entry"
      throughput: "≥1000 entries/second"
      memory_overhead: "<10MB baseline"
      
    validation:
      test: |
        - Benchmark single log entry (measure time)
        - Benchmark 10,000 entries (measure throughput)
        - Measure memory before/after initialization
      audit: |
        - Query duration_ms column for entries
        - Verify 95th percentile <5ms
        
    acceptance:
      - "✅ Latency: <5ms (95th percentile)"
      - "✅ Throughput: ≥1000 entries/sec sustained"
      - "✅ Memory: <10MB after initialization"
      
  AC-AUDIT-007:
    id: AC-AUDIT-007
    name: Log Rotation Strategy
    priority: HIGH
    stage: 1
    phase: 1.1
    updated: true
    
    criteria: |
      JSONL audit logs rotate based on file size (50MB threshold) with
      daily fallback to prevent single-file bloat.
      
    rotation_strategy:
      primary_trigger: File size ≥50MB
      secondary_trigger: New day (daily fallback)
      naming_convention: audit-YYYY-MM-DD-NNN.jsonl
      example: audit-2026-01-09-001.jsonl, audit-2026-01-09-002.jsonl
      
    validation:
      test: |
        - Generate 51MB of log entries
        - Verify new file created at 50MB
        - Change system date, generate entry
        - Verify new file created for new day
      audit: |
        - List files in cortex-brain/audit-logs/
        - Verify rotation occurred
        
    acceptance:
      - "✅ Files rotate at 50MB (primary)"
      - "✅ Files rotate daily (secondary)"
      - "✅ Naming convention: audit-YYYY-MM-DD-NNN.jsonl"
      - "✅ No single file >50MB in production"
      
    clarifications:
      Q6: Size-based (50MB) + daily fallback (standard logging practice)

# ==============================================================================
# SECTION 2: SKULL TO CORE MIGRATION (UPDATED)
# ==============================================================================

skull_core_migration:
  
  AC-GOV-001:
    id: AC-GOV-001
    name: SKULL to CORE Migration - Clean Deletion
    priority: P0_CRITICAL
    stage: 1
    phase: 1.2
    updated: true
    
    criteria: |
      All 61 SKULL rules migrated to CORE-* numbering with NO backward
      compatibility. brain-protection-rules.yaml deleted entirely.
      
    migration_approach:
      backward_compatibility: NONE
      mapping: Direct replacement (SKULL-001 → CORE-001)
      legacy_file_action: DELETE brain-protection-rules.yaml
      reference_updates: All .py, .yaml, .md files updated
      
    validation:
      test: |
        - Load core-rules.yaml
        - Verify 61 rules exist with CORE-* IDs
        - Verify brain-protection-rules.yaml does not exist
        - Grep codebase for SKULL-*, verify 0 matches
      audit: |
        - Query audit.db for operation='skull_migration'
        - Verify all 61 rules logged as migrated
        
    acceptance:
      - "✅ 61 rules in core-rules.yaml with CORE-* IDs"
      - "✅ brain-protection-rules.yaml deleted"
      - "✅ Zero SKULL-* references in codebase"
      - "✅ No backward compatibility code"
      
    clarifications:
      Q3: No backward compatibility required, clean deletion
      
  AC-GOV-002:
    id: AC-GOV-002
    name: Codebase Reference Cleanup
    priority: P0_CRITICAL
    stage: 1
    phase: 1.2
    new: true
    
    criteria: |
      All references to SKULL-* rules in Python, YAML, and Markdown files
      updated to CORE-* equivalents.
      
    scope:
      python_files: src/**/*.py
      yaml_files: cortex-brain/**/*.yaml, .github/**/*.yaml
      markdown_files: docs/**/*.md, cortex-brain/**/*.md, .github/**/*.md
      
    validation:
      test: |
        - Run: grep -r "SKULL-" src/ cortex-brain/ .github/ docs/
        - Verify 0 matches (or only in archived files)
        - Test governance loader with CORE-* IDs
      audit: |
        - Query audit.db for operation='reference_cleanup'
        - Verify file_count, replacement_count logged
        
    acceptance:
      - "✅ Zero SKULL-* in active Python files"
      - "✅ Zero SKULL-* in active YAML files"
      - "✅ Zero SKULL-* in active Markdown files"
      - "✅ Governance loader uses CORE-* IDs only"

# ==============================================================================
# SECTION 3: AC-ID TRACEABILITY (UPDATED)
# ==============================================================================

ac_id_traceability:
  
  AC-TDD-002:
    id: AC-TDD-002
    name: Pytest AC-ID Marker - Traceability Only
    priority: P0_CRITICAL
    stage: 1
    phase: 1.3
    updated: true
    
    criteria: |
      Pytest marker @pytest.mark.ac_id() provides AC-ID traceability only.
      JSON Schema validation is separate concern (not in marker).
      
    marker_scope:
      purpose: Link tests to acceptance criteria
      not_purpose: Input validation, schema checks, runtime validation
      usage: "@pytest.mark.ac_id('AC-F01-005')"
      
    separation_of_concerns:
      traceability: pytest marker system (this AC)
      schema_validation: CORTEX Toolkit (Stage 3, separate)
      
    validation:
      test: |
        - Add @pytest.mark.ac_id('AC-TEST-001') to test
        - Run: pytest --markers
        - Verify ac_id marker registered
        - Verify no schema validation in marker
      audit: |
        - Query audit.db for operation='ac_marker_registration'
        
    acceptance:
      - "✅ Marker provides traceability only"
      - "✅ No schema validation in marker implementation"
      - "✅ Simple usage: @pytest.mark.ac_id('AC-XXX-NNN')"
      - "✅ JSON Schema validation = separate (Stage 3)"
      
    clarifications:
      Q2: AC-ID tracking only, schema validation separate concern
      
  AC-TDD-003:
    id: AC-TDD-003
    name: Coverage Matrix Generation
    priority: P0_CRITICAL
    stage: 1
    phase: 1.3
    
    criteria: |
      ACTraceabilitySystem scans all test files, extracts ac_id markers,
      generates coverage matrix mapping AC-IDs to test files.
      
    matrix_schema:
      format: YAML
      location: cortex-brain/registry/ac-test-coverage.yaml
      structure: |
        coverage:
          AC-F01-005:
            tests: [tests/unit/test_audit_logger.py::test_init]
            coverage: 100%
          AC-GOV-001:
            tests: [tests/governance/test_skull_migration.py::test_all_rules]
            coverage: 100%
      
    validation:
      test: |
        - Run: python3 -m src.infrastructure.ac_traceability generate
        - Verify ac-test-coverage.yaml created
        - Verify 148 existing tests scanned
        - Verify mapping AC-ID → test files
      audit: |
        - Query audit.db for operation='coverage_matrix_generation'
        
    acceptance:
      - "✅ Coverage matrix generated"
      - "✅ All 148 existing tests scanned"
      - "✅ YAML format validated"
      - "✅ AC → test mapping accurate"

# ==============================================================================
# SECTION 4: HOUSEKEEPING ORCHESTRATOR (UPDATED)
# ==============================================================================

housekeeping_orchestrator:
  
  AC-ORC-HOUSE-001:
    id: AC-ORC-HOUSE-001
    name: Housekeeping Orchestrator - Manual On-Demand Only
    priority: P0_CRITICAL
    stage: 1
    phase: 1.4
    updated: true
    
    criteria: |
      Housekeeping Orchestrator executes 9 health check phases on manual
      user command only. No automatic triggers (git hooks, cron, file watchers).
      
    trigger_strategy:
      manual_commands:
        - "cortex housekeeping"
        - "python3 -m src.main 'housekeeping'"
      automatic_triggers: NONE
      rationale: User control over system maintenance
      
    user_experience:
      invocation: User decides when to run health checks
      duration: Complete in <60 seconds
      output: Health report with phase results
      
    validation:
      test: |
        - Run: cortex housekeeping
        - Verify all 9 phases execute
        - Verify completion <60 seconds
        - Verify no automatic execution
      audit: |
        - Query audit.db for operation='housekeeping_execution'
        - Verify trigger_type='manual'
        
    acceptance:
      - "✅ Manual command execution works"
      - "✅ No git hooks installed"
      - "✅ No cron jobs created"
      - "✅ No file watchers active"
      - "✅ User decides when to run"
      
    clarifications:
      Q4: Manual on-demand (both trigger and control)
      Q9: No automatic triggers (user decides)
      
  AC-ORC-HOUSE-002:
    id: AC-ORC-HOUSE-002
    name: Nine Health Check Phases
    priority: P0_CRITICAL
    stage: 1
    phase: 1.4
    
    criteria: |
      Housekeeping Orchestrator executes 9 sequential health check phases
      with individual pass/fail status and aggregated health score.
      
    phases:
      phase_1: Governance rule validation (verify 61 CORE rules loaded)
      phase_2: Test coverage analysis (≥85% toolkit, 100% orchestrators)
      phase_3: Audit log health check (verify AuditLogger operational)
      phase_4: Brain tier synchronization (Tier0-3 consistency)
      phase_5: Cache cleanup (remove stale cache files)
      phase_6: Git isolation verification (CORE-019 compliance)
      phase_7: Orchestrator manifest validation (all 10+ manifests valid)
      phase_8: AC gap detection (identify AC without tests)
      phase_9: Health report generation (aggregate results, score 0-100)
      
    validation:
      test: |
        - Run housekeeping
        - Verify each phase logs start/completion
        - Verify health score calculated
        - Verify report generated
      audit: |
        - Query audit.db for category='orchestrator', operation LIKE 'housekeeping_phase_%'
        - Verify 9 entries (one per phase)
        
    acceptance:
      - "✅ All 9 phases implemented"
      - "✅ Sequential execution"
      - "✅ Individual pass/fail status"
      - "✅ Aggregate health score (0-100)"
      - "✅ Report saved to cortex-brain/documents/reports/"

# ==============================================================================
# SECTION 5: DUAL VALIDATION FRAMEWORK (UPDATED)
# ==============================================================================

dual_validation_framework:
  
  AC-VAL-005:
    id: AC-VAL-005
    name: Bootstrap Self-Audit Validation
    priority: P0_CRITICAL
    stage: 1
    phase: 1.1
    new: true
    
    criteria: |
      AuditLogger validates itself via bootstrap self-audit approach to
      break circular dependency (can't use audit logs to validate audit logs).
      
    bootstrap_strategy:
      phase_1: AuditLogger initializes
      phase_2: Logs operation='audit_logger_init' (self-audit)
      phase_3: Test queries audit.db for init entry
      phase_4: Manual verification via JSONL inspection
      phase_5: After Stage 1, all future validation uses AuditLogger
      
    validation:
      test: |
        - Import AuditLogger
        - Query: SELECT * FROM audit_logs WHERE operation='audit_logger_init'
        - Verify 1 entry exists, status='success'
      manual: |
        - Run: tail -f cortex-brain/audit-logs/bootstrap.jsonl
        - Verify {"operation": "audit_logger_init", "status": "success"}
      audit: |
        - After Stage 1: Use mcp_audit_validate('AC-F01-005')
        
    acceptance:
      - "✅ AuditLogger logs own initialization"
      - "✅ Test validates self-audit entry"
      - "✅ Manual JSONL verification possible"
      - "✅ Circular dependency resolved"
      
    clarifications:
      Q7: Bootstrap self-audit + manual check breaks circular dependency
      
  AC-VAL-006:
    id: AC-VAL-006
    name: Complementary Validation Strategy
    priority: HIGH
    stage: 1
    new: true
    
    criteria: |
      Pytest tests and audit logs serve complementary purposes (not duplicate).
      Tests verify functionality, audit logs prove execution.
      
    validation_matrix:
      pytest_tests:
        purpose: Verify code correctness (does function work?)
        example: "test_audit_logger_writes_jsonl() → assert file exists"
        when: Pre-deployment, CI/CD pipeline
        
      audit_logs:
        purpose: Prove production execution (did it run successfully?)
        example: "SELECT * WHERE ac_id='AC-F01-005' → 1 entry"
        when: Post-deployment, operational validation
        
      combined:
        purpose: End-to-end validation chain
        process: Test passes (code works) + Audit entry exists (ran successfully)
        
    no_duplication:
      anti_pattern: Writing tests that only check audit logs exist
      correct_pattern: Tests verify logic, audit logs validate operations
      
    validation:
      test: |
        - Review test files, ensure no "test_audit_log_exists()" anti-patterns
        - Verify tests focus on business logic
      audit: |
        - Query audit.db, verify operational evidence exists
        
    acceptance:
      - "✅ Tests verify functionality (unit/integration)"
      - "✅ Audit logs prove execution (operations)"
      - "✅ No duplicate validation"
      - "✅ Complementary purposes clear"
      
    clarifications:
      Q7: Use both efficiently (complementary, not duplicate)

# ==============================================================================
# SECTION 26: MIGRATE ORCHESTRATOR (NEW)
# ==============================================================================

migrate_orchestrator:
  
  AC-ORC-MIGRATE-001:
    id: AC-ORC-MIGRATE-001
    name: Source Plan Detection and Validation
    priority: MEDIUM
    stage: 3
    phase: 3.5
    new: true
    
    criteria: |
      Migrate Orchestrator detects active plan in CORTEX storage and
      validates migration target (user repo).
      
    detection:
      source_location: cortex-brain/documents/planning/user-repos/{repo-name}/
      plan_identification: Plan ID, plan name, or user selection
      validation: Verify plan exists, status=active
      
    target_validation:
      repo_check: Verify user repo has .git/ folder
      write_permission: Verify .cortex/ can be created
      conflict_check: Verify .cortex/plans/ doesn't already exist
      
    validation:
      test: |
        - Create test plan in cortex-brain/.../user-repos/test-repo/
        - Run: cortex migrate plan 'test-plan'
        - Verify orchestrator detects plan
        - Verify user repo validation passes
      audit: |
        - Query audit.db for operation='migrate_detect_plan'
        
    acceptance:
      - "✅ Detects plan in CORTEX storage"
      - "✅ Validates user repo is git repo"
      - "✅ Checks write permissions"
      - "✅ Detects conflicts (existing .cortex/)"
      
  AC-ORC-MIGRATE-002:
    id: AC-ORC-MIGRATE-002
    name: User Repo Directory Creation
    priority: MEDIUM
    stage: 3
    phase: 3.5
    new: true
    
    criteria: |
      Migrate Orchestrator creates .cortex/plans/ directory structure in
      user repo with proper permissions.
      
    directory_structure:
      base: .cortex/
      plans: .cortex/plans/{plan-name}/
      subfolders: acceptance-criteria/, analysis/, artifacts/, tracking/, etc.
      
    validation:
      test: |
        - Run migration
        - Verify .cortex/plans/ created
        - Verify folder structure matches CORTEX plan organization
        - Verify permissions (user read/write)
      audit: |
        - Query audit.db for operation='migrate_create_directories'
        
    acceptance:
      - "✅ .cortex/plans/ created in user repo"
      - "✅ Plan-specific subfolder created"
      - "✅ Proper permissions set"
      - "✅ Folder structure consistent with CORTEX"
      
  AC-ORC-MIGRATE-003:
    id: AC-ORC-MIGRATE-003
    name: Plan Artifact Copy
    priority: MEDIUM
    stage: 3
    phase: 3.5
    new: true
    
    criteria: |
      Migrate Orchestrator copies all plan artifacts (YAML, MD, tracking)
      from CORTEX storage to user repo.
      
    artifacts_copied:
      - config.yaml (plan configuration)
      - todos.yaml (task list)
      - acceptance-criteria/*.yaml
      - tracking/*.md (progress tracking)
      - analysis/*.md (analysis documents)
      - artifacts/*.yaml (plan artifacts)
      
    validation:
      test: |
        - Count files in source plan
        - Run migration
        - Count files in destination
        - Verify file_count_source == file_count_destination
        - Verify checksums match
      audit: |
        - Query audit.db for operation='migrate_copy_artifacts'
        - Verify files_copied count logged
        
    acceptance:
      - "✅ All plan files copied"
      - "✅ File integrity preserved (checksums)"
      - "✅ Folder structure maintained"
      - "✅ No data loss"
      
  AC-ORC-MIGRATE-004:
    id: AC-ORC-MIGRATE-004
    name: Gitignore Management
    priority: MEDIUM
    stage: 3
    phase: 3.5
    new: true
    
    criteria: |
      Migrate Orchestrator optionally adds .cortex/ to .gitignore in user repo
      based on user confirmation prompt.
      
    user_prompt:
      question: "Add .cortex/ to .gitignore? (Y/n)"
      default: Yes
      rationale: Prevent accidental commit of CORTEX plans to user repo
      
    gitignore_handling:
      if_exists: Append .cortex/ if not already present
      if_not_exists: Create .gitignore with .cortex/
      format: "# CORTEX plans (generated)\n.cortex/"
      
    validation:
      test: |
        - Run migration with Yes
        - Verify .cortex/ in .gitignore
        - Run migration with No
        - Verify .cortex/ NOT added
      audit: |
        - Query audit.db for operation='migrate_gitignore'
        - Verify user_choice logged
        
    acceptance:
      - "✅ User confirmation prompt shown"
      - "✅ .cortex/ added if confirmed"
      - "✅ .gitignore created if missing"
      - "✅ No duplicates if already present"
      
  AC-ORC-MIGRATE-005:
    id: AC-ORC-MIGRATE-005
    name: Symlink Creation
    priority: MEDIUM
    stage: 3
    phase: 3.5
    new: true
    
    criteria: |
      Migrate Orchestrator optionally maintains symlink in CORTEX pointing
      to migrated plan in user repo.
      
    user_prompt:
      question: "Keep symlink in CORTEX? (Y/n)"
      default: Yes
      rationale: Allow cortex commands to still reference plan
      
    symlink_creation:
      source: cortex-brain/documents/planning/user-repos/{repo-name}/
      target: ~/user-repo/.cortex/plans/{plan-name}/
      type: Symbolic link (ln -s)
      
    validation:
      test: |
        - Run migration with Yes
        - Verify symlink exists
        - Verify symlink points to user repo
        - Test: ls -la symlink → shows target
      audit: |
        - Query audit.db for operation='migrate_symlink'
        
    acceptance:
      - "✅ Symlink created if confirmed"
      - "✅ Points to correct user repo location"
      - "✅ Readable from CORTEX"
      - "✅ Plan accessible via both paths"
      
  AC-ORC-MIGRATE-006:
    id: AC-ORC-MIGRATE-006
    name: Migration Audit Log
    priority: MEDIUM
    stage: 3
    phase: 3.5
    new: true
    
    criteria: |
      Migrate Orchestrator logs complete migration event with all details
      for audit trail and troubleshooting.
      
    audit_entry_fields:
      operation: migrate_plan
      plan_id: Source plan ID
      source_path: CORTEX storage path
      destination_path: User repo path
      files_copied: Count
      symlink_created: boolean
      gitignore_updated: boolean
      duration_ms: Migration time
      
    validation:
      test: |
        - Run migration
        - Query audit.db WHERE operation='migrate_plan'
        - Verify all fields present
        - Verify metadata includes paths
      audit: |
        - Use mcp_audit_validate('AC-ORC-MIGRATE-006')
        
    acceptance:
      - "✅ Migration logged to audit.db"
      - "✅ All fields captured"
      - "✅ Queryable via MCP tools"
      - "✅ Audit trail complete"

# ==============================================================================
# SECTION 27: CROSS-REPO INFRASTRUCTURE (NEW)
# ==============================================================================

cross_repo_infrastructure:
  
  AC-CROSS-001:
    id: AC-CROSS-001
    name: CLI Entry Point - bin/cortex
    priority: HIGH
    stage: 3
    phase: 3.2
    new: true
    
    criteria: |
      Shell script CLI entry point (bin/cortex) wraps Python entry point
      for simplified cross-repo usage.
      
    script_implementation:
      location: bin/cortex
      type: Bash shell script
      functionality: |
        #!/bin/bash
        CORTEX_DIR="$(cd "$(dirname "$0")/.." && pwd)"
        export CORTEX_HOME="$CORTEX_DIR"
        python3 "$CORTEX_DIR/src/main.py" "$@"
      permissions: chmod +x bin/cortex
      
    validation:
      test: |
        - Run: ./bin/cortex --help
        - Verify help text displayed
        - Run: ./bin/cortex plan "test"
        - Verify planning orchestrator invoked
      audit: |
        - Query audit.db for cli_entry logged
        
    acceptance:
      - "✅ bin/cortex exists and executable"
      - "✅ Wraps python3 src/main.py"
      - "✅ Sets CORTEX_HOME environment variable"
      - "✅ Passes all arguments to Python"
      
    clarifications:
      Q12: bin/cortex shell script (standard Unix convention)
      
  AC-CROSS-002:
    id: AC-CROSS-002
    name: Workspace Detection - cortex-brain/ Check
    priority: HIGH
    stage: 3
    phase: 3.2
    new: true
    
    criteria: |
      WorkspaceDetector identifies CORTEX repo vs user repo by checking
      for presence of cortex-brain/ folder.
      
    detection_algorithm:
      signal: os.path.exists('cortex-brain/')
      cortex_repo: cortex-brain/ exists → return 'CORTEX_REPO'
      user_repo: cortex-brain/ missing → return 'USER_REPO'
      performance: <10ms (simple filesystem check)
      
    implementation:
      location: src/infrastructure/workspace_detector.py
      method: detect_workspace_type() -> str
      caching: Result cached per invocation (no re-check)
      
    validation:
      test: |
        - Run in ~/PROJECTS/CORTEX/: detect → 'CORTEX_REPO'
        - Run in ~/user-project/: detect → 'USER_REPO'
        - Benchmark: verify <10ms
      audit: |
        - Query audit.db for operation='workspace_detection'
        
    acceptance:
      - "✅ Detects CORTEX repo correctly"
      - "✅ Detects user repo correctly"
      - "✅ Performance <10ms"
      - "✅ No false positives/negatives"
      
    clarifications:
      Q13: Check for cortex-brain/ folder (simplest)
      
  AC-CROSS-003:
    id: AC-CROSS-003
    name: Git Isolation Enforcement
    priority: HIGH
    stage: 3
    phase: 3.2
    new: true
    
    criteria: |
      When operating in user repo mode, CORTEX enforces git isolation
      per CORE-019 (never commits to user repos).
      
    isolation_rules:
      write_operations: Blocked in user repos (git add, git commit)
      read_operations: Allowed (git status, git log)
      plan_storage: CORTEX only (cortex-brain/documents/planning/user-repos/)
      validation: Housekeeping Phase 6 checks compliance
      
    validation:
      test: |
        - cd ~/user-project/
        - Run: cortex plan "feature X"
        - Verify no git operations in user-project
        - Verify plan stored in CORTEX
        - Attempt git commit in user repo → verify blocked
      audit: |
        - Query audit.db for operation='git_isolation_check'
        
    acceptance:
      - "✅ No git writes to user repos"
      - "✅ Plans stored in CORTEX"
      - "✅ Git operations validated"
      - "✅ CORE-019 compliance enforced"
      
  AC-CROSS-004:
    id: AC-CROSS-004
    name: Lazy Loading - Import-Time
    priority: MEDIUM
    stage: 3
    phase: 3.2
    new: true
    
    criteria: |
      CORTEX CLI uses import-time lazy loading to achieve <500ms startup.
      Orchestrators load only when needed.
      
    loading_strategy:
      always_loaded:
        - CLI argument parser (~50ms)
        - Intent router (~30ms)
        - Workspace detector (~10ms)
        - Configuration loader (~10ms)
      lazy_loaded:
        - Orchestrators (import when command matches)
        - AuditLogger (import on first log)
        - StateManager (import on plan execution)
        - MCP tools (import on mcp command)
      
    performance_target:
      help_command: ~100ms (CLI only)
      plan_command: ~300-400ms (CLI + PlanningOrchestrator)
      total_budget: <500ms for any command
      
    validation:
      test: |
        - Benchmark: time cortex --help
        - Verify <100ms
        - Benchmark: time cortex plan "test"
        - Verify <500ms
      audit: |
        - Query audit.db for operation='cli_startup'
        - Verify duration_ms <500
        
    acceptance:
      - "✅ Help command <100ms"
      - "✅ Any command <500ms"
      - "✅ Orchestrators lazy-loaded"
      - "✅ Import-time strategy used"
      
    clarifications:
      Q10: Lazy loading required
      Q15: Import-time lazy loading (standard Python)
      
  AC-CROSS-005:
    id: AC-CROSS-005
    name: User Setup - README Instructions
    priority: MEDIUM
    stage: 3
    phase: 3.2
    new: true
    
    criteria: |
      README.md provides clear 2-command manual setup instructions for
      CORTEX installation.
      
    manual_setup:
      step_1: git clone https://github.com/asifhussain60/CORTEX.git
      step_2: echo 'export PATH="$PATH:~/PROJECTS/CORTEX/bin"' >> ~/.zshrc
      step_3: source ~/.zshrc
      duration: ~30 seconds
      
    documentation_location:
      primary: README.md (root)
      secondary: docs/installation/QUICK-START.md
      
    validation:
      test: |
        - Follow README instructions in clean environment
        - Verify PATH updated
        - Run: cortex --help
        - Verify command works
      audit: |
        - User testing feedback
        
    acceptance:
      - "✅ README has setup section"
      - "✅ Instructions tested and verified"
      - "✅ Setup completes in ~30 seconds"
      - "✅ Works on macOS/Linux"
      
  AC-CROSS-006:
    id: AC-CROSS-006
    name: User Setup - Automated Script
    priority: MEDIUM
    stage: 3
    phase: 3.2
    new: true
    
    criteria: |
      Optional setup.sh script automates PATH addition for user convenience.
      
    script_implementation:
      location: setup.sh (root)
      functionality: |
        #!/bin/bash
        CORTEX_DIR="$(cd "$(dirname "$0")" && pwd)"
        echo "export PATH=\"\$PATH:$CORTEX_DIR/bin\"" >> ~/.zshrc
        echo "✅ CORTEX added to PATH. Restart shell or run: source ~/.zshrc"
      permissions: chmod +x setup.sh
      
    validation:
      test: |
        - Run: ./setup.sh
        - Check ~/.zshrc for PATH entry
        - Source ~/.zshrc
        - Run: cortex --help
        - Verify command works
      audit: |
        - User testing feedback
        
    acceptance:
      - "✅ setup.sh exists and executable"
      - "✅ Adds PATH to ~/.zshrc"
      - "✅ Idempotent (no duplicates)"
      - "✅ Works on macOS/Linux"
      
    clarifications:
      Q16: Both README + setup.sh (convenience + control)
      
  AC-CROSS-007:
    id: AC-CROSS-007
    name: User Repo Plan Storage
    priority: HIGH
    stage: 3
    phase: 3.3
    new: true
    
    criteria: |
      Plans for user repos stored in CORTEX by default with clear
      organization and repo name derivation.
      
    storage_location:
      base: cortex-brain/documents/planning/user-repos/
      per_repo: cortex-brain/documents/planning/user-repos/{repo-name}/
      structure: Same as CORTEX plans (acceptance-criteria/, artifacts/, etc.)
      
    repo_name_derivation:
      primary: Git remote URL basename (e.g., my-project from git@github.com:user/my-project.git)
      fallback: Current folder name
      sanitization: Remove special characters, lowercase
      
    validation:
      test: |
        - cd ~/user-project/
        - Run: cortex plan "feature X"
        - Verify plan in cortex-brain/.../user-repos/user-project/
        - Verify folder structure correct
      audit: |
        - Query audit.db for operation='user_repo_plan_storage'
        
    acceptance:
      - "✅ Plans stored in CORTEX"
      - "✅ Repo name derived correctly"
      - "✅ Folder structure consistent"
      - "✅ Git isolation maintained"
      
    clarifications:
      Q14: Store in CORTEX only (git isolation + centralized)
      
  AC-CROSS-008:
    id: AC-CROSS-008
    name: Cross-Repo Command Execution
    priority: HIGH
    stage: 3
    phase: 3.2
    new: true
    
    criteria: |
      CORTEX commands work correctly from any directory (CORTEX repo or
      user repo) with proper context detection.
      
    execution_scenarios:
      cortex_repo_mode:
        cwd: ~/PROJECTS/CORTEX/
        detection: cortex-brain/ exists
        capabilities: Full (all orchestrators)
        plan_storage: cortex-brain/documents/planning/active/
        
      user_repo_mode:
        cwd: ~/user-project/
        detection: No cortex-brain/
        capabilities: User operations (planning, TDD, investigation, etc.)
        plan_storage: cortex-brain/documents/planning/user-repos/user-project/
        
    validation:
      test: |
        - Test from CORTEX: cortex plan "CORTEX 6.0" → works
        - Test from user repo: cortex plan "feature X" → works
        - Verify isolation enforced
        - Verify correct storage locations
      audit: |
        - Query audit.db for workspace_mode
        - Verify CORTEX_REPO vs USER_REPO logged
        
    acceptance:
      - "✅ Commands work from CORTEX repo"
      - "✅ Commands work from user repos"
      - "✅ Context detected correctly"
      - "✅ Isolation enforced"
      
  AC-CROSS-009:
    id: AC-CROSS-009
    name: PATH-Based Invocation
    priority: HIGH
    stage: 3
    phase: 3.2
    new: true
    
    criteria: |
      Users can invoke cortex from any directory after adding to PATH.
      No cd to CORTEX repo required.
      
    invocation_methods:
      via_path: cortex plan "feature X" (after export PATH)
      via_alias: cortex plan "feature X" (after alias cortex="...")
      via_absolute: ~/PROJECTS/CORTEX/bin/cortex plan "feature X"
      via_relative: ./bin/cortex plan "feature X" (from CORTEX repo)
      
    validation:
      test: |
        - Add CORTEX/bin to PATH
        - cd ~/unrelated-directory/
        - Run: cortex --help
        - Verify command works
        - Run: which cortex
        - Verify points to CORTEX/bin/cortex
      audit: |
        - Query audit.db for cli_invocation_method
        
    acceptance:
      - "✅ Invocation from any directory works"
      - "✅ PATH-based execution validated"
      - "✅ No cd to CORTEX required"
      - "✅ Shell finds cortex binary"

