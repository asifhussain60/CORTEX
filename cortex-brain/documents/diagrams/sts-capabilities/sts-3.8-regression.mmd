flowchart TD
    Start([🧪 STS Validator<br/>Start Regression Test]) --> LoadBaseline
    
    subgraph BaselineLoad[" 📊 BASELINE LOADING "]
        LoadBaseline[Load sts-baseline.json] --> BaselineExists{Baseline<br/>exists?}
        
        BaselineExists -->|No| CreateBaseline[📝 Create initial baseline<br/>First run - establish metrics]
        BaselineExists -->|Yes| ParseBaseline[Parse baseline data:<br/>• 9 capabilities<br/>• Metrics per capability<br/>• Confidence scores]
        
        CreateBaseline --> ExecuteAll[Execute all 9 capabilities<br/>to establish baseline]
        ExecuteAll --> SaveBaseline[💾 Save baseline:<br/>timestamp, metrics, status]
        SaveBaseline --> FirstRun[✅ First run complete<br/>Baseline established]
        FirstRun --> End
        
        ParseBaseline --> ValidateStructure[Validate baseline structure:<br/>• All 9 capabilities present<br/>• Required metrics exist<br/>• Confidence values valid]
    end
    
    ValidateStructure --> RunCurrent
    
    subgraph CurrentRun[" ⚡ CURRENT EXECUTION "]
        RunCurrent[Execute all 9 capabilities] --> Cap1[1. Deployment]
        RunCurrent --> Cap2[2. Multi-workspace]
        RunCurrent --> Cap3[3. Upgrade]
        RunCurrent --> Cap4[4. End-to-end]
        RunCurrent --> Cap5[5. Brain persistence]
        RunCurrent --> Cap6[6. Agent collaboration]
        RunCurrent --> Cap7[7. Performance]
        RunCurrent --> Cap8[8. Regression self]
        RunCurrent --> Cap9[9. Vision API]
        
        Cap1 --> Collect1[Metrics: build_time, size]
        Cap2 --> Collect2[Metrics: ides, latency]
        Cap3 --> Collect3[Metrics: upgrade_time, preservation]
        Cap4 --> Collect4[Metrics: workflows, success_rate]
        Cap5 --> Collect5[Metrics: fifo, atomicity]
        Cap6 --> Collect6[Metrics: handoffs, latency]
        Cap7 --> Collect7[Metrics: codebase_time, concurrent]
        Cap8 --> Collect8[Metrics: baseline_comparison]
        Cap9 --> Collect9[Metrics: mockups, colors, elements]
        
        Collect1 --> CompileResults[Compile all results]
        Collect2 --> CompileResults
        Collect3 --> CompileResults
        Collect4 --> CompileResults
        Collect5 --> CompileResults
        Collect6 --> CompileResults
        Collect7 --> CompileResults
        Collect8 --> CompileResults
        Collect9 --> CompileResults
    end
    
    CompileResults --> Compare
    
    subgraph Comparison[" 🔍 REGRESSION DETECTION "]
        Compare[Compare current vs baseline] --> CheckDeploy{Deployment<br/>metrics OK?}
        
        CheckDeploy -->|Slower| Regression1[🔴 Regression: Deployment<br/>build_time: 1.2s → 3.5s]
        CheckDeploy -->|OK| CheckMulti
        
        CheckMulti{Multi-workspace<br/>metrics OK?}
        CheckMulti -->|Slower| Regression2[🔴 Regression: Multi-workspace<br/>latency: 45ms → 120ms]
        CheckMulti -->|OK| CheckUpgrade
        
        CheckUpgrade{Upgrade<br/>metrics OK?}
        CheckUpgrade -->|Slower| Regression3[🔴 Regression: Upgrade<br/>upgrade_time: 4.5s → 8.2s]
        CheckUpgrade -->|OK| CheckE2E
        
        CheckE2E{End-to-end<br/>metrics OK?}
        CheckE2E -->|Lower| Regression4[🔴 Regression: End-to-end<br/>success_rate: 100% → 67%]
        CheckE2E -->|OK| CheckPersistence
        
        CheckPersistence{Brain persistence<br/>metrics OK?}
        CheckPersistence -->|Degraded| Regression5[🔴 Regression: Persistence<br/>recovery failure detected]
        CheckPersistence -->|OK| CheckAgent
        
        CheckAgent{Agent collab<br/>metrics OK?}
        CheckAgent -->|Slower| Regression6[🔴 Regression: Agent collab<br/>latency: 35ms → 95ms]
        CheckAgent -->|OK| CheckPerf
        
        CheckPerf{Performance<br/>metrics OK?}
        CheckPerf -->|Slower| Regression7[🔴 Regression: Performance<br/>query_time: 42ms → 105ms]
        CheckPerf -->|OK| CheckVision
        
        CheckVision{Vision API<br/>metrics OK?}
        CheckVision -->|Slower| Regression8[🔴 Regression: Vision API<br/>processing: 0.04s → 2.1s]
        CheckVision -->|OK| NoRegression[✅ No regressions detected<br/>All metrics within thresholds]
    end
    
    Regression1 --> DetectedRegressions[📋 Regressions detected]
    Regression2 --> DetectedRegressions
    Regression3 --> DetectedRegressions
    Regression4 --> DetectedRegressions
    Regression5 --> DetectedRegressions
    Regression6 --> DetectedRegressions
    Regression7 --> DetectedRegressions
    Regression8 --> DetectedRegressions
    
    DetectedRegressions --> CountRegressions[Count regressions: {N}]
    CountRegressions --> FailResult[❌ FAIL Result<br/>{N} regressions found]
    
    NoRegression --> PassResult[✅ PASS Result<br/>All capabilities stable]
    
    FailResult --> GenerateReport
    PassResult --> GenerateReport
    
    subgraph Report[" 📄 REPORT GENERATION "]
        GenerateReport[Generate regression report] --> ReportDetails[Include details:<br/>• Capability name<br/>• Baseline metric<br/>• Current metric<br/>• Δ change<br/>• Status]
        
        ReportDetails --> SaveReport[💾 Save report:<br/>regression-report-{date}.md]
        SaveReport --> UpdateBaseline2[Update baseline if PASS]
    end
    
    UpdateBaseline2 --> MetricsUpdate
    
    subgraph MetricsUpdate[" 📊 METRICS UPDATE "]
        Update[Update sts-baseline.json:<br/>• Timestamp: now<br/>• capability: regression<br/>• status: PASS/FAIL<br/>• regressions_detected: {N}]
    end
    
    MetricsUpdate --> End([🎯 Regression Capability<br/>Validation Complete])
    
    %% Styling
    classDef successStyle fill:#50C878,stroke:#3A9B5C,stroke-width:2px,color:#fff
    classDef errorStyle fill:#E74C3C,stroke:#C0392B,stroke-width:2px,color:#fff
    classDef warningStyle fill:#F39C12,stroke:#D68910,stroke-width:2px,color:#fff
    classDef processStyle fill:#95A5A6,stroke:#7F8C8D,stroke-width:2px,color:#fff
    classDef phaseStyle fill:#95A5A6,stroke:#7F8C8D,stroke-width:3px,color:#fff
    
    class PassResult,NoRegression,FirstRun successStyle
    class FailResult,DetectedRegressions errorStyle
    class Regression1,Regression2,Regression3,Regression4,Regression5,Regression6,Regression7,Regression8 warningStyle
    class RunCurrent,Compare,GenerateReport processStyle
    class BaselineLoad,CurrentRun,Comparison,Report,MetricsUpdate phaseStyle
