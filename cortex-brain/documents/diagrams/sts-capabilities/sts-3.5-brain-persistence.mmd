graph TB
    Start([🧪 STS Validator<br/>Start Brain Persistence Test]) --> FIFOTest
    
    subgraph FIFOTest[" 📚 FIFO INTEGRITY TEST "]
        FIFOInit[Initialize Tier 1 Brain<br/>Max: 70 conversations] --> FIFOWrite[Write 75 conversations<br/>conv-001 through conv-075]
        
        FIFOWrite --> FIFOCheck[Query database:<br/>SELECT * FROM conversations<br/>ORDER BY timestamp]
        
        FIFOCheck --> FIFOCount{Count =<br/>70?}
        FIFOCount -->|No| FIFOFail[❌ FIFO count violation]
        FIFOCount -->|Yes| FIFOOrder
        
        FIFOOrder[Check oldest entry<br/>Should be conv-006] --> FIFOOldest{Oldest =<br/>conv-006?}
        FIFOOldest -->|No| FIFOFail
        FIFOOldest -->|Yes| FIFONewest
        
        FIFONewest[Check newest entry<br/>Should be conv-075] --> FIFOLatest{Newest =<br/>conv-075?}
        FIFOLatest -->|No| FIFOFail
        FIFOLatest -->|Yes| FIFOPass[✅ FIFO integrity verified<br/>Oldest 5 conversations rotated]
    end
    
    FIFOFail --> FailResult[❌ FAIL Result]
    FIFOPass --> AtomicityTest
    
    subgraph AtomicityTest[" ⚛️ WRITE ATOMICITY TEST "]
        AtomicInit[Start atomic write test] --> SimulateConcurrent[Simulate 10 concurrent writes<br/>Thread 1-10 writing simultaneously]
        
        SimulateConcurrent --> WriteConv[Each thread writes:<br/>conversation + metadata + context]
        
        WriteConv --> CheckCorruption{Any partial<br/>writes?}
        CheckCorruption -->|Yes| CorruptionDetected[❌ Data corruption found<br/>Partial conversation data]
        CheckCorruption -->|No| CheckConsistency
        
        CheckConsistency[Verify all 10 conversations<br/>have complete data] --> ConsistencyCheck{All records<br/>complete?}
        ConsistencyCheck -->|No| CorruptionDetected
        ConsistencyCheck -->|Yes| AtomicPass[✅ Atomicity verified<br/>No partial writes]
    end
    
    CorruptionDetected --> FailResult
    AtomicPass --> RecoveryTest
    
    subgraph RecoveryTest[" 🔄 AUTO-RECOVERY TEST "]
        RecoveryInit[Test auto-recovery] --> SimulateCrash[Simulate crash scenario:<br/>Kill process during write]
        
        SimulateCrash --> RestartSystem[Restart CORTEX system<br/>Initialize Tier 1 brain]
        
        RestartSystem --> CheckRecovery[Check database state:<br/>• Verify integrity<br/>• Check for locks<br/>• Validate data]
        
        CheckRecovery --> IntegrityOK{Database<br/>intact?}
        IntegrityOK -->|No| RecoveryFail[❌ Database corrupted<br/>Recovery failed]
        IntegrityOK -->|Yes| CheckLocks
        
        CheckLocks{Any stale<br/>locks?}
        CheckLocks -->|Yes| RecoveryFail
        CheckLocks -->|No| VerifyData
        
        VerifyData[Verify last successful write<br/>before crash] --> DataValid{Data<br/>valid?}
        DataValid -->|No| RecoveryFail
        DataValid -->|Yes| RecoveryPass[✅ Auto-recovery successful<br/>System operational]
    end
    
    RecoveryFail --> FailResult
    RecoveryPass --> PerformanceTest
    
    subgraph PerformanceTest[" ⚡ PERFORMANCE TEST "]
        PerfInit[Test access performance] --> WriteSpeed[Measure write speed<br/>1000 conversations]
        
        WriteSpeed --> WriteTime[⏱️ Total write time: {X}ms]
        WriteTime --> WriteCheck{Avg write<br/>< 100ms?}
        WriteCheck -->|No| SlowWrite[❌ Write performance degraded]
        WriteCheck -->|Yes| ReadSpeed
        
        ReadSpeed[Measure read speed<br/>Query 1000 conversations]
        ReadSpeed --> ReadTime[⏱️ Total read time: {Y}ms]
        ReadTime --> ReadCheck{Avg read<br/>< 100ms?}
        ReadCheck -->|No| SlowRead[❌ Read performance degraded]
        ReadCheck -->|Yes| PerfPass[✅ Performance validated<br/>Write: {X}ms, Read: {Y}ms]
    end
    
    SlowWrite --> FailResult
    SlowRead --> FailResult
    PerfPass --> MetricsCollection
    
    subgraph MetricsCollection[" 📊 METRICS COLLECTION "]
        Collect[Collect all metrics:<br/>• FIFO integrity: true<br/>• Oldest rotated: conv-001 to conv-005<br/>• Write atomicity: true<br/>• Concurrent writes: 10 successful<br/>• Auto-recovery: true<br/>• Avg write time: 42ms<br/>• Avg read time: 38ms]
        
        Validate[Validate thresholds:<br/>• FIFO = 70 conversations ✓<br/>• Atomicity = 100% ✓<br/>• Recovery = successful ✓<br/>• Performance < 100ms ✓]
    end
    
    Collect --> Validate
    Validate --> PassResult[✅ PASS Result<br/>All Criteria Met]
    
    PassResult --> UpdateBaseline[📝 Update sts-baseline.json<br/>capability: brain_persistence<br/>status: PASS]
    
    FailResult --> UpdateBaseline
    
    UpdateBaseline --> End([🎯 Brain Persistence Capability<br/>Validation Complete])
    
