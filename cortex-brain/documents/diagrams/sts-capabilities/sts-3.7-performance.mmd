    classDef phaseStyle fill:#E67E22,stroke:#CA6F1E,stroke-width:3px,color:#fff
    
    class PassResult,FastPerf,ConcurrentPass,QueryPass,MemPass successStyle
    class FailResult,SlowPerf,ConflictDetected,DeadlockDetected,OpFailed,SlowQuery,MemLeak errorStyle
