title: CORTEX 4-Tier Brain Architecture
description: Layered memory system with data flows
category: Architecture
priority: CRITICAL
version: 4.0.0
---

%%{
  init: {
    'theme': 'base',
    'themeVariables': {
      'primaryColor': '#50C878',
      'primaryTextColor': '#fff',
      'primaryBorderColor': '#3A9B5C',
      'lineColor': '#6C757D'
    }
  }
}%%

graph LR
    %% Input Operations
    Ops[⚙️ Operations<br/>User Requests] --> T0

    %% Tier 0: Governance
    subgraph Tier0[" 🛡️ TIER 0: GOVERNANCE "]
        T0[Brain Protection<br/>SKULL Rules]
        T0Rules[8 Enforcement Rules:<br/>• TDD_ENFORCEMENT<br/>• RED_PHASE_VALIDATION<br/>• HOLISTIC_CODE_DISCOVERY<br/>• REFACTOR_CLEANUP<br/>• TEST_FILE_VALIDATION<br/>• EMPTY_TEST_DETECTION<br/>• GIT_ISOLATION<br/>• TEST_LOCATION_SEPARATION]
    end
    
    T0 -->|✅ Validated| T1
    T0 -->|❌ Rejected| Reject[🚫 Rejected Operation]
    
    %% Tier 1: Working Memory
    subgraph Tier1[" 💾 TIER 1: WORKING MEMORY "]
        T1[Conversation Capture<br/>70-Conv FIFO]
        T1Props[Properties:<br/>• <100ms Access Time<br/>• Automatic Rotation<br/>• Context Injection<br/>• Import/Export]
        T1DB[(cortex-brain.db<br/>conversations table)]
    end
    
    T1 --> T1DB
    T1 -->|Patterns Detected| T2
    
    %% Tier 2: Knowledge Graph
    subgraph Tier2[" 🧠 TIER 2: KNOWLEDGE GRAPH "]
        T2[Pattern Learning<br/>Persistent Storage]
        T2Props[Stores:<br/>• User Patterns<br/>• Code Patterns<br/>• Best Practices<br/>• Common Solutions]
        T2DB[(cortex-brain.db<br/>patterns table)]
        T2Files[YAML Files:<br/>• knowledge-graph.yaml<br/>• lessons-learned.yaml<br/>• file-relationships.yaml]
    end
    
    T2 --> T2DB
    T2 --> T2Files
    T2 -->|Metrics Update| T3
    
    %% Tier 3: Dev Context
    subgraph Tier3[" 📊 TIER 3: DEV CONTEXT "]
        T3[Metrics & Analysis<br/>System Telemetry]
        T3Props[Tracks:<br/>• Complexity Metrics<br/>• Hotspot Files<br/>• Performance Data<br/>• Test Coverage]
        T3DB[(cortex_metrics.db<br/>metrics & hotspots)]
        T3Files[YAML Files:<br/>• development-context.yaml<br/>• module-definitions.yaml]
    end
    
    T3 --> T3DB
    T3 --> T3Files
    
    %% Data Flow Back to Operations
    T1DB -.->|Context Retrieval| Ops
    T2DB -.->|Pattern Retrieval| Ops
    T3DB -.->|Metrics Retrieval| Ops
    
    %% Response Generation
    Ops --> Response[📋 Response Generation<br/>Template Selection]
    Response --> Templates[62 Templates v4.0:<br/>• Adaptive Format<br/>• Context-Aware<br/>• 4-Tier Scaling]
    Templates --> Output[📤 User Response]
    
    %% Legend
    subgraph Legend[" 📖 LEGEND "]
        L1[🛡️ Governance Layer]
        L2[💾 Short-Term Memory]
        L3[🧠 Long-Term Memory]
        L4[📊 Analytics Layer]
        L5[➡️ Data Flow]
        L6[⋯> Retrieval Flow]
    end
    
    %% Styling
    classDef tier0 fill:#E74C3C,stroke:#C0392B,stroke-width:3px,color:#fff
    classDef tier1 fill:#4A90E2,stroke:#2E5C8A,stroke-width:3px,color:#fff
    classDef tier2 fill:#50C878,stroke:#3A9B5C,stroke-width:3px,color:#fff
    classDef tier3 fill:#F39C12,stroke:#D68910,stroke-width:3px,color:#fff
    classDef storage fill:#9B59B6,stroke:#7D3C98,stroke-width:2px,color:#fff
    classDef files fill:#1ABC9C,stroke:#16A085,stroke-width:2px,color:#fff
    classDef response fill:#E67E22,stroke:#CA6F1E,stroke-width:2px,color:#fff
    
    class T0,T0Rules tier0
    class T1,T1Props tier1
    class T2,T2Props tier2
    class T3,T3Props tier3
    class T1DB,T2DB,T3DB storage
    class T2Files,T3Files files
    class Response,Templates,Output response
