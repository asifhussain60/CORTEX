title: CORTEX Orchestrator Hierarchy
description: All orchestrators with BaseOrchestrator integration
category: Architecture
priority: CRITICAL
version: 4.0.0
---

%%{
  init: {
    'theme': 'base',
    'themeVariables': {
      'primaryColor': '#7B68EE',
      'primaryTextColor': '#fff',
      'primaryBorderColor': '#5A4FCF'
    }
  }
}%%

classDiagram
    %% Base Orchestrator
    class BaseOrchestrator {
        <<abstract>>
        +str name
        +Logger logger
        +PhaseManager phase_manager
        +ErrorHandler error_handler
        +ProgressTracker progress_tracker
        --
        +execute(context) Result
        +validate_context(context) bool
        +handle_error(error) Recovery
        +checkpoint_create() Checkpoint
        +checkpoint_restore(id) bool
        +log_phase_transition(from, to)
    }
    
    %% Integrated Orchestrators (7)
    class TDDOrchestrator {
        +TestRunner test_runner
        +CodeAnalyzer analyzer
        +QualityScorer scorer
        --
        +red_phase() TestResult
        +green_phase() Implementation
        +refactor_phase() CodeQuality
        +validate_test_failure() bool
        +score_code_quality(0-10) Score
    }
    
    class PlanningOrchestrator {
        +ComplexityAnalyzer complexity
        +PlanValidator validator
        +PhaseExecutor executor
        --
        +analyze_complexity() Complexity
        +generate_plan() Plan
        +validate_dor_dod() bool
        +execute_autonomous() Result
        +track_progress() Progress
    }
    
    class MaintenanceOrchestrator {
        +HealthChecker health
        +AlignmentEngine align
        +CleanupEngine cleanup
        --
        +pre_healthcheck() Health
        +align_system() Alignment
        +cleanup_workspace() Cleanup
        +optimize_brain() Optimization
        +vacuum_storage() Vacuum
        +refresh_prompts() Refresh
        +post_healthcheck() Health
    }
    
    class DocumentationOrchestrator {
        +CodeAnalyzer analyzer
        +APIDocGenerator doc_gen
        +DiagramGenerator diagram_gen
        --
        +analyze_modules() Modules
        +extract_types() Types
        +generate_docs() Docs
        +generate_diagrams() Diagrams
        +validate_completeness() bool
        +export_documentation() Files
    }
    
    class RefinementOrchestrator {
        +ASTAnalyzer ast
        +SKULLValidator skull
        +ArchitectureReviewer arch
        --
        +discover_codebase() Discovery
        +review_skull_tests() SKULLReview
        +refine_documentation() DocImprovement
        +improve_code_quality() Quality
        +review_architecture() ArchReview
        +optimize_performance() Performance
        +validate_system() Validation
    }
    
    class ArchitecturalReviewOrchestrator {
        +Reviewer reviewer
        +Scorer scorer
        --
        +analyze_architecture() Analysis
        +score_components(0-100) Score
        +generate_recommendations() Recommendations
    }
    
    class HolisticDiscoveryOrchestrator {
        +DiscoveryEngine engine
        +PatternDetector detector
        --
        +discover_patterns() Patterns
        +analyze_dependencies() Dependencies
        +map_relationships() RelationshipMap
    }
    
    %% Standalone Orchestrators (6)
    class CodeSanitizationOrchestrator {
        <<standalone>>
        +Analyzer analyzer
        +Transformer transformer
        +Validator validator
        --
        +analyze_codebase() Analysis
        +create_mapping() Mapping
        +transform_code() Transformed
        +validate_build() bool
        +generate_report() Report
    }
    
    class ADOOrchestrator {
        <<standalone>>
        +ADOClient client
        +StoryGenerator story_gen
        --
        +create_story() Story
        +create_feature() Feature
        +create_task() Task
        +generate_summary() Summary
        +review_code() Review
    }
    
    class VisionAPIValidationOrchestrator {
        <<standalone>>
        +ImageProcessor processor
        +ColorExtractor color
        +ElementDetector element
        --
        +analyze_mockup() Mockup
        +extract_colors() Colors
        +detect_elements() Elements
        +analyze_layout() Layout
        +generate_stories() Stories
    }
    
    class VacuumOrchestrator {
        <<stub>>
        +vacuum_databases() Result
    }
    
    class CleanupOrchestrator {
        <<stub>>
        +cleanup_workspace() Result
    }
    
    class RegeneratePromptsOrchestrator {
        <<stub>>
        +regenerate_prompts() Result
    }
    
    %% Inheritance Relationships
    BaseOrchestrator <|-- TDDOrchestrator : inherits
    BaseOrchestrator <|-- PlanningOrchestrator : inherits
    BaseOrchestrator <|-- MaintenanceOrchestrator : inherits
    BaseOrchestrator <|-- DocumentationOrchestrator : inherits
    BaseOrchestrator <|-- RefinementOrchestrator : inherits
    BaseOrchestrator <|-- ArchitecturalReviewOrchestrator : inherits
    BaseOrchestrator <|-- HolisticDiscoveryOrchestrator : inherits
    
    %% Composition Relationships
    TDDOrchestrator o-- BaseOrchestrator : uses phase_manager
    PlanningOrchestrator o-- BaseOrchestrator : uses error_handler
    MaintenanceOrchestrator o-- BaseOrchestrator : uses progress_tracker
    
    %% Dependencies
    PlanningOrchestrator ..> TDDOrchestrator : invokes (TDD integration)
    MaintenanceOrchestrator ..> CleanupOrchestrator : invokes
    MaintenanceOrchestrator ..> VacuumOrchestrator : invokes
    MaintenanceOrchestrator ..> RegeneratePromptsOrchestrator : invokes
    RefinementOrchestrator ..> DocumentationOrchestrator : invokes
    
