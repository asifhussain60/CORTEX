{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cortex.ai/schemas/planning-v6-plan.json",
  "title": "Planning v6 Plan Schema",
  "description": "Validates plan.yaml from Planning v6 Phase 2 (Detailed Plan Generation)",
  "version": "1.0.0",
  
  "definitions": {
    "ac_id": {
      "type": "string",
      "pattern": "^AC-[A-Z]+-\\d{3}$"
    },
    
    "task_id": {
      "type": "string",
      "pattern": "^TASK-\\d{3}$",
      "description": "Task ID (e.g., TASK-001)"
    },
    
    "phase_id": {
      "type": "string",
      "pattern": "^PHASE-\\d{1,2}$",
      "description": "Phase ID (e.g., PHASE-1)"
    },
    
    "priority": {
      "type": "string",
      "enum": ["P0_CRITICAL", "HIGH", "MEDIUM", "LOW"]
    },
    
    "task_status": {
      "type": "string",
      "enum": ["not_started", "in_progress", "completed", "blocked", "skipped"]
    },
    
    "task": {
      "type": "object",
      "required": ["id", "name", "description", "phase", "estimated_hours", "dependencies", "acceptance_criteria", "files_to_modify"],
      "properties": {
        "id": {
          "$ref": "#/definitions/task_id"
        },
        "name": {
          "type": "string",
          "minLength": 5,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000
        },
        "phase": {
          "$ref": "#/definitions/phase_id"
        },
        "priority": {
          "$ref": "#/definitions/priority"
        },
        "estimated_hours": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 40,
          "description": "Estimated effort (0.5 to 40 hours)"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/task_id"
          },
          "description": "Task IDs this task depends on"
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ac_id"
          },
          "minItems": 1,
          "description": "Must have at least one AC"
        },
        "files_to_modify": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Relative file paths"
          },
          "description": "Files to create or modify"
        },
        "status": {
          "$ref": "#/definitions/task_status"
        },
        "assignee": {
          "type": "string",
          "enum": ["tdd_master", "manual", "autonomous"],
          "description": "Who executes this task"
        },
        "test_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": "Test files for this task (TDD)"
        },
        "technical_notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Implementation guidance"
        }
      },
      "additionalProperties": false
    },
    
    "phase": {
      "type": "object",
      "required": ["id", "name", "description", "duration_hours", "tasks"],
      "properties": {
        "id": {
          "$ref": "#/definitions/phase_id"
        },
        "name": {
          "type": "string",
          "minLength": 5,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500
        },
        "duration_hours": {
          "type": "number",
          "minimum": 1,
          "description": "Total hours for this phase"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/task_id"
          },
          "minItems": 1,
          "description": "Task IDs in this phase"
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 200
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    
    "milestone": {
      "type": "object",
      "required": ["id", "name", "due_date", "deliverables"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^MS-\\d{1,2}$",
          "description": "Milestone ID (e.g., MS-1)"
        },
        "name": {
          "type": "string",
          "minLength": 5,
          "maxLength": 100
        },
        "due_date": {
          "type": "string",
          "format": "date",
          "description": "Target completion date (YYYY-MM-DD)"
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 200
          },
          "minItems": 1
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/phase_id"
          },
          "description": "Phases included in this milestone"
        }
      },
      "additionalProperties": false
    }
  },
  
  "type": "object",
  "required": ["metadata", "overview", "phases", "tasks", "effort_summary"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["plan_id", "plan_name", "created_at", "correlation_id", "phase"],
      "properties": {
        "plan_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{5,50}$"
        },
        "plan_name": {
          "type": "string",
          "minLength": 5,
          "maxLength": 100
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "phase": {
          "type": "string",
          "const": "phase_2_plan_generation"
        },
        "requirements_file": {
          "type": "string",
          "pattern": "^requirements-discovered\\.yaml$"
        },
        "approved": {
          "type": "boolean",
          "description": "User approval status"
        },
        "approval_timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    
    "overview": {
      "type": "object",
      "required": ["summary", "objectives", "scope"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 50,
          "maxLength": 500,
          "description": "High-level plan summary"
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 10,
            "maxLength": 200
          },
          "minItems": 1
        },
        "scope": {
          "type": "object",
          "required": ["in_scope", "out_of_scope"],
          "properties": {
            "in_scope": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 200
              },
              "minItems": 1
            },
            "out_of_scope": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 200
              }
            }
          },
          "additionalProperties": false
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 200
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 200
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["description", "impact", "mitigation"],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 10,
                "maxLength": 200
              },
              "impact": {
                "type": "string",
                "enum": ["HIGH", "MEDIUM", "LOW"]
              },
              "mitigation": {
                "type": "string",
                "minLength": 10,
                "maxLength": 200
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    
    "phases": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/phase"
      },
      "minItems": 1,
      "description": "Must have at least one phase"
    },
    
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/task"
      },
      "minItems": 1,
      "description": "Must have at least one task"
    },
    
    "milestones": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/milestone"
      }
    },
    
    "effort_summary": {
      "type": "object",
      "required": ["total_hours_min", "total_hours_max", "total_tasks", "total_phases"],
      "properties": {
        "total_hours_min": {
          "type": "number",
          "minimum": 0.5
        },
        "total_hours_max": {
          "type": "number",
          "minimum": 0.5
        },
        "total_tasks": {
          "type": "integer",
          "minimum": 1
        },
        "total_phases": {
          "type": "integer",
          "minimum": 1
        },
        "total_acceptance_criteria": {
          "type": "integer",
          "minimum": 1
        },
        "duration_weeks_min": {
          "type": "number",
          "minimum": 0.1,
          "description": "Estimated duration (weeks) at 40h/week"
        },
        "duration_weeks_max": {
          "type": "number",
          "minimum": 0.1
        }
      },
      "additionalProperties": false
    },
    
    "dashboard": {
      "type": "object",
      "required": ["enabled", "path"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "pattern": "^dashboard/plan-viewer\\.html$"
        },
        "websocket_port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        }
      },
      "additionalProperties": false
    },
    
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
