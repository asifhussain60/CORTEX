{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cortex.ai/schemas/planning-v6-dependencies.json",
  "title": "Planning v6 Dependencies Schema",
  "description": "Validates dependencies-discovered.yaml and task-dag.yaml from Planning v6",
  "version": "1.0.0",
  
  "definitions": {
    "task_id": {
      "type": "string",
      "pattern": "^TASK-\\d{3}$"
    },
    
    "req_id": {
      "type": "string",
      "pattern": "^REQ-\\d{3}$"
    },
    
    "dependency_type": {
      "type": "string",
      "enum": ["hard", "soft", "external", "circular_detected"],
      "description": "hard=blocking, soft=preferred order, external=third-party, circular_detected=needs resolution"
    },
    
    "dependency": {
      "type": "object",
      "required": ["from", "to", "type"],
      "properties": {
        "from": {
          "$ref": "#/definitions/task_id",
          "description": "Dependent task"
        },
        "to": {
          "$ref": "#/definitions/task_id",
          "description": "Dependency task (must complete first)"
        },
        "type": {
          "$ref": "#/definitions/dependency_type"
        },
        "rationale": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200,
          "description": "Why this dependency exists"
        }
      },
      "additionalProperties": false
    },
    
    "dag_node": {
      "type": "object",
      "required": ["task_id", "level", "dependencies", "dependents"],
      "properties": {
        "task_id": {
          "$ref": "#/definitions/task_id"
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "description": "Topological level (0=no deps, 1=depends on level 0, etc.)"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/task_id"
          },
          "description": "Tasks this task depends on"
        },
        "dependents": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/task_id"
          },
          "description": "Tasks that depend on this task"
        },
        "parallel_eligible": {
          "type": "boolean",
          "description": "Can execute in parallel with other tasks at same level"
        },
        "critical_path": {
          "type": "boolean",
          "description": "True if on critical path"
        }
      },
      "additionalProperties": false
    },
    
    "external_dependency": {
      "type": "object",
      "required": ["name", "type", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Dependency name (e.g., 'pyyaml', 'react')"
        },
        "type": {
          "type": "string",
          "enum": ["python", "npm", "api", "service", "tool"],
          "description": "Dependency category"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$|^\\^[0-9]+\\.[0-9]+\\.[0-9]+$|^latest$",
          "description": "Version (semver or 'latest')"
        },
        "purpose": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200
        },
        "installation_command": {
          "type": "string",
          "maxLength": 200,
          "description": "How to install (e.g., 'pip install pyyaml==6.0.1')"
        },
        "required_by_tasks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/task_id"
          },
          "description": "Tasks that require this dependency"
        }
      },
      "additionalProperties": false
    },
    
    "circular_dependency": {
      "type": "object",
      "required": ["cycle", "severity", "resolution"],
      "properties": {
        "cycle": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/task_id"
          },
          "minItems": 2,
          "description": "Tasks in circular dependency chain"
        },
        "severity": {
          "type": "string",
          "enum": ["blocked", "warning"],
          "description": "blocked=must fix, warning=suboptimal"
        },
        "resolution": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200,
          "description": "How to resolve the cycle"
        }
      },
      "additionalProperties": false
    }
  },
  
  "type": "object",
  "required": ["metadata", "task_dependencies", "dag", "validation"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["plan_id", "created_at", "correlation_id"],
      "properties": {
        "plan_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{5,50}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "source": {
          "type": "string",
          "enum": ["planning_v6_phase_1", "planning_v6_phase_2", "toolkit_dependency_mapper"],
          "description": "Where dependencies were discovered"
        }
      },
      "additionalProperties": false
    },
    
    "task_dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/dependency"
      },
      "description": "All task-to-task dependencies"
    },
    
    "requirement_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "type"],
        "properties": {
          "from": {
            "$ref": "#/definitions/req_id"
          },
          "to": {
            "$ref": "#/definitions/req_id"
          },
          "type": {
            "$ref": "#/definitions/dependency_type"
          }
        },
        "additionalProperties": false
      },
      "description": "Requirement-to-requirement dependencies"
    },
    
    "external_dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/external_dependency"
      },
      "description": "Third-party dependencies"
    },
    
    "dag": {
      "type": "object",
      "required": ["nodes", "levels", "critical_path"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dag_node"
          },
          "minItems": 1,
          "description": "All tasks as DAG nodes"
        },
        "levels": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of topological levels"
        },
        "critical_path": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/task_id"
          },
          "minItems": 1,
          "description": "Tasks on critical path (longest dependency chain)"
        },
        "parallelization_opportunities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["level", "tasks"],
            "properties": {
              "level": {
                "type": "integer",
                "minimum": 0
              },
              "tasks": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/task_id"
                },
                "minItems": 2,
                "description": "Tasks that can execute in parallel"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    
    "validation": {
      "type": "object",
      "required": ["is_acyclic", "all_tasks_reachable"],
      "properties": {
        "is_acyclic": {
          "type": "boolean",
          "description": "True if no circular dependencies"
        },
        "all_tasks_reachable": {
          "type": "boolean",
          "description": "True if all tasks can be reached from root"
        },
        "circular_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/circular_dependency"
          },
          "description": "Detected cycles (if any)"
        },
        "orphaned_tasks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/task_id"
          },
          "description": "Tasks with no dependencies and no dependents"
        },
        "validation_passed": {
          "type": "boolean",
          "description": "True if is_acyclic AND all_tasks_reachable AND no circular_dependencies"
        }
      },
      "additionalProperties": false
    },
    
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
