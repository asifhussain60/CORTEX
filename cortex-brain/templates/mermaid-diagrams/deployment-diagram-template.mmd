%% Deployment Diagram Template
%% Template Version: 1.0.0
%% Author: CORTEX Development Team
%% Usage: Use for infrastructure architecture, cloud deployments, and system topology
%%
%% Variables to replace:
%%   {{ENVIRONMENT}} - Environment name (dev, staging, prod)
%%   {{REGION}} - Cloud region
%%   {{SERVICE_N}} - Service names
%%   {{INSTANCE_N}} - Instance specifications

---
%% Basic Cloud Architecture
graph TB
    subgraph "Internet 🌐"
        USER[("👤 Users")]
        CDN["☁️ CDN<br/>CloudFront"]
    end
    
    subgraph "AWS Cloud ☁️"
        subgraph "Public Subnet"
            ALB["⚖️ ALB<br/>Application Load Balancer"]
            NAT["🚪 NAT Gateway"]
        end
        
        subgraph "Private Subnet - App Tier"
            ECS["🐳 ECS Cluster"]
            EC2_1["📦 EC2 Instance 1"]
            EC2_2["📦 EC2 Instance 2"]
        end
        
        subgraph "Private Subnet - Data Tier"
            RDS[("💾 RDS<br/>PostgreSQL")]
            REDIS[("⚡ ElastiCache<br/>Redis")]
            S3[("📁 S3 Bucket")]
        end
    end
    
    USER --> CDN
    CDN --> ALB
    ALB --> EC2_1
    ALB --> EC2_2
    EC2_1 --> ECS
    EC2_2 --> ECS
    ECS --> RDS
    ECS --> REDIS
    ECS --> S3
    EC2_1 --> NAT
    
    style ALB fill:#FF9900
    style RDS fill:#3B48CC
    style S3 fill:#569A31

