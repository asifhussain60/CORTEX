%% Microservices Deployment
graph TB
    subgraph "API Gateway"
        GW["🚪 Kong Gateway"]
    end
    
    subgraph "Services"
        subgraph "User Domain"
            US["👤 User Service<br/>3 replicas"]
            AUTH["🔐 Auth Service<br/>3 replicas"]
        end
        
        subgraph "Order Domain"
            OS["📦 Order Service<br/>5 replicas"]
            PAY["💳 Payment Service<br/>3 replicas"]
        end
        
        subgraph "Inventory Domain"
            INV["📊 Inventory Service<br/>3 replicas"]
            SHIP["🚚 Shipping Service<br/>2 replicas"]
        end
    end
    
    subgraph "Data Stores"
        US_DB[("💾 User DB")]
        OS_DB[("💾 Order DB")]
        INV_DB[("💾 Inventory DB")]
        CACHE[("⚡ Redis Cluster")]
    end
    
    subgraph "Messaging"
        KAFKA["📬 Kafka Cluster"]
    end
    
    GW --> US
    GW --> OS
    GW --> INV
    US --> US_DB
    US --> AUTH
    OS --> OS_DB
    OS --> PAY
    INV --> INV_DB
    INV --> SHIP
    
    US --> KAFKA
    OS --> KAFKA
    INV --> KAFKA
    
    US --> CACHE
    OS --> CACHE
    
    style GW fill:#003366,color:white
    style KAFKA fill:#231F20,color:white

---
%% CI/CD Pipeline Infrastructure
graph LR
    subgraph "Source"
        GIT["📂 GitHub"]
    end
    
    subgraph "CI Pipeline"
        BUILD["🔨 Build<br/>Docker Build"]
        TEST["🧪 Test<br/>Unit + Integration"]
        SCAN["🔍 Scan<br/>Security + Quality"]
        PUSH["📤 Push<br/>Registry"]
    end
    
    subgraph "Registry"
        ECR["📦 ECR<br/>Container Registry"]
    end
    
    subgraph "CD Pipeline"
        DEPLOY_DEV["🚀 Deploy Dev"]
        DEPLOY_STG["🚀 Deploy Staging"]
        DEPLOY_PROD["🚀 Deploy Production"]
    end
    
    subgraph "Environments"
        DEV["🔧 Dev Cluster"]
        STG["🧪 Staging Cluster"]
        PROD["🏭 Production Cluster"]
    end
    
    GIT -->|"Push"| BUILD
    BUILD --> TEST
    TEST --> SCAN
    SCAN -->|"Pass"| PUSH
    PUSH --> ECR
    
    ECR --> DEPLOY_DEV
    DEPLOY_DEV --> DEV
    DEV -->|"Approve"| DEPLOY_STG
    DEPLOY_STG --> STG
    STG -->|"Approve"| DEPLOY_PROD
    DEPLOY_PROD --> PROD
    
    style GIT fill:#181717,color:white
    style ECR fill:#FF9900
    style PROD fill:#4CAF50

