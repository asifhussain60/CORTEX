%% Kubernetes Cluster Architecture
graph TB
    subgraph "Kubernetes Cluster 🎯"
        subgraph "Control Plane"
            API["🔌 API Server"]
            ETCD[("📦 etcd")]
            SCHED["📋 Scheduler"]
            CM["⚙️ Controller Manager"]
        end
        
        subgraph "Worker Node 1"
            KUBELET1["🤖 Kubelet"]
            POD1A["🐳 Pod: Web"]
            POD1B["🐳 Pod: API"]
        end
        
        subgraph "Worker Node 2"
            KUBELET2["🤖 Kubelet"]
            POD2A["🐳 Pod: Worker"]
            POD2B["🐳 Pod: Cache"]
        end
        
        subgraph "Worker Node 3"
            KUBELET3["🤖 Kubelet"]
            POD3A["🐳 Pod: DB"]
            POD3B["🐳 Pod: Monitor"]
        end
    end
    
    subgraph "External"
        INGRESS["🚪 Ingress Controller"]
        LB["⚖️ Load Balancer"]
    end
    
    LB --> INGRESS
    INGRESS --> POD1A
    INGRESS --> POD1B
    API --> KUBELET1
    API --> KUBELET2
    API --> KUBELET3
    API --> ETCD
    
    style API fill:#326CE5,color:white
    style POD1A fill:#326CE5,color:white
    style POD1B fill:#326CE5,color:white

