%% Multi-Region High Availability
graph TB
    subgraph "Global"
        R53["🌐 Route 53<br/>DNS + Health Checks"]
        CF["☁️ CloudFront<br/>Global CDN"]
    end
    
    subgraph "US-East-1 🇺🇸"
        ALB_US["⚖️ ALB"]
        ECS_US["🐳 ECS Cluster"]
        RDS_US[("💾 RDS Primary")]
    end
    
    subgraph "EU-West-1 🇪🇺"
        ALB_EU["⚖️ ALB"]
        ECS_EU["🐳 ECS Cluster"]
        RDS_EU[("💾 RDS Replica")]
    end
    
    subgraph "AP-Southeast-1 🇸🇬"
        ALB_AP["⚖️ ALB"]
        ECS_AP["🐳 ECS Cluster"]
        RDS_AP[("💾 RDS Replica")]
    end
    
    R53 --> CF
    CF --> ALB_US
    CF --> ALB_EU
    CF --> ALB_AP
    
    ALB_US --> ECS_US --> RDS_US
    ALB_EU --> ECS_EU --> RDS_EU
    ALB_AP --> ECS_AP --> RDS_AP
    
    RDS_US -.->|"Async Replication"| RDS_EU
    RDS_US -.->|"Async Replication"| RDS_AP
    
    style R53 fill:#FF9900
    style RDS_US fill:#3B48CC,color:white
