%% Threat Model Diagram Template (STRIDE)
%% Template Version: 1.0.0
%% Author: CORTEX Development Team
%% Usage: Use for security threat modeling, STRIDE analysis, and trust boundary visualization
%%
%% Variables to replace:
%%   {{SYSTEM_NAME}} - Name of the system being modeled
%%   {{COMPONENT_N}} - Component names
%%   {{THREAT_N}} - Threat descriptions
%%   {{MITIGATION_N}} - Mitigation strategies

---
%% Data Flow Diagram with Trust Boundaries
graph TB
    subgraph "External Zone 🌐"
        USER[("👤 User<br/>External Actor")]
        ATTACKER[("☠️ Attacker<br/>Threat Actor")]
    end
    
    subgraph "DMZ Zone 🛡️"
        WAF["🔥 WAF<br/>Web Application Firewall"]
        LB["⚖️ Load Balancer<br/>SSL Termination"]
    end
    
    subgraph "Application Zone 🏢"
        API["🔌 API Gateway<br/>Authentication"]
        WEB["🖥️ Web Server<br/>Frontend"]
        APP["⚙️ App Server<br/>Business Logic"]
    end
    
    subgraph "Data Zone 🔐"
        DB[("💾 Database<br/>Sensitive Data")]
        CACHE[("⚡ Cache<br/>Session Data")]
        SECRETS["🔑 Secrets Manager<br/>Credentials"]
    end
    
    USER --> WAF
    ATTACKER -.->|"Attack Vector"| WAF
    WAF --> LB
    LB --> API
    LB --> WEB
    API --> APP
    WEB --> API
    APP --> DB
    APP --> CACHE
    APP --> SECRETS
    
    style ATTACKER fill:#ff4444,stroke:#cc0000,color:white
    style WAF fill:#4CAF50,stroke:#388E3C,color:white
    style SECRETS fill:#9C27B0,stroke:#7B1FA2,color:white
    style DB fill:#FF9800,stroke:#F57C00,color:white

---
%% STRIDE Threat Categories
graph TB
    subgraph "🎯 STRIDE Threat Model"
        direction TB
        
        subgraph "S - Spoofing"
            S1["🎭 Identity Spoofing"]
            S2["📧 Email Spoofing"]
            S3["🔗 IP Spoofing"]
        end
        
        subgraph "T - Tampering"
            T1["📝 Data Modification"]
            T2["🔄 Man-in-the-Middle"]
            T3["💉 SQL Injection"]
        end
        
        subgraph "R - Repudiation"
            R1["🚫 Action Denial"]
            R2["📜 Log Tampering"]
            R3["⏰ Timestamp Manipulation"]
        end
        
        subgraph "I - Info Disclosure"
            I1["🔓 Data Leakage"]
            I2["📤 Error Message Exposure"]
            I3["🕵️ Directory Traversal"]
        end
        
        subgraph "D - Denial of Service"
            D1["💥 Resource Exhaustion"]
            D2["🌊 DDoS Attack"]
            D3["🔒 Account Lockout Abuse"]
        end
        
        subgraph "E - Elevation of Privilege"
            E1["👑 Privilege Escalation"]
            E2["🚪 Authorization Bypass"]
            E3["🔐 Role Manipulation"]
        end
    end
    
    style S1 fill:#E91E63
    style T1 fill:#9C27B0
    style R1 fill:#673AB7
    style I1 fill:#3F51B5
    style D1 fill:#2196F3
    style E1 fill:#FF5722

---
%% Attack Tree for Authentication
graph TB
    ROOT["🎯 Compromise<br/>User Account"]
    
    ROOT --> CRED["Obtain Credentials"]
    ROOT --> BYPASS["Bypass Authentication"]
    ROOT --> HIJACK["Session Hijacking"]
    
    CRED --> PHISH["🎣 Phishing Attack"]
    CRED --> BRUTE["🔨 Brute Force"]
    CRED --> LEAK["💧 Credential Leak"]
    
    BRUTE --> DICT["📖 Dictionary Attack"]
    BRUTE --> STUFF["📚 Credential Stuffing"]
    
    BYPASS --> SQLI["💉 SQL Injection"]
    BYPASS --> IDOR["🔢 IDOR Vulnerability"]
    BYPASS --> BROKEN["🔓 Broken Auth Logic"]
    
    HIJACK --> XSS["📜 XSS Attack"]
    HIJACK --> CSRF["🔄 CSRF Attack"]
    HIJACK --> COOKIE["🍪 Cookie Theft"]
    
    style ROOT fill:#ff0000,color:white
    style PHISH fill:#ff6b6b
    style SQLI fill:#ff6b6b
    style XSS fill:#ff6b6b

---
%% Mitigation Flow Diagram
graph LR
    subgraph "Threats 🔴"
        TH1["SQL Injection"]
        TH2["XSS Attack"]
        TH3["CSRF Attack"]
        TH4["Brute Force"]
        TH5["Data Breach"]
    end
    
    subgraph "Mitigations 🟢"
        M1["Parameterized Queries"]
        M2["Output Encoding"]
        M3["CSRF Tokens"]
        M4["Rate Limiting"]
        M5["Encryption at Rest"]
    end
    
    subgraph "Controls ✅"
        C1["Input Validation Layer"]
        C2["Content Security Policy"]
        C3["Session Management"]
        C4["WAF Rules"]
        C5["TDE/Column Encryption"]
    end
    
    TH1 --> M1 --> C1
    TH2 --> M2 --> C2
    TH3 --> M3 --> C3
    TH4 --> M4 --> C4
    TH5 --> M5 --> C5
    
    style TH1 fill:#ff4444
    style TH2 fill:#ff4444
    style TH3 fill:#ff4444
    style TH4 fill:#ff4444
    style TH5 fill:#ff4444
    style M1 fill:#4CAF50
    style M2 fill:#4CAF50
    style M3 fill:#4CAF50
    style M4 fill:#4CAF50
    style M5 fill:#4CAF50

---
%% Data Classification Flow
graph TB
    subgraph "Data Classification 📊"
        PUBLIC["🌐 Public<br/>No restrictions"]
        INTERNAL["🏢 Internal<br/>Employee access"]
        CONFIDENTIAL["🔒 Confidential<br/>Need-to-know"]
        RESTRICTED["⛔ Restricted<br/>PII/PHI/PCI"]
    end
    
    subgraph "Handling Requirements"
        PUB_H["Standard handling<br/>No encryption required"]
        INT_H["Access controls<br/>Internal network only"]
        CONF_H["Encryption in transit<br/>Audit logging"]
        REST_H["Encryption at rest+transit<br/>Full audit trail<br/>DLP controls"]
    end
    
    PUBLIC --> PUB_H
    INTERNAL --> INT_H
    CONFIDENTIAL --> CONF_H
    RESTRICTED --> REST_H
    
    style RESTRICTED fill:#ff0000,color:white
    style CONFIDENTIAL fill:#ff9800,color:white
    style INTERNAL fill:#ffeb3b
    style PUBLIC fill:#4CAF50,color:white
