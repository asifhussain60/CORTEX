%% Entity-Relationship Diagram Template
%% Template Version: 1.0.0
%% Author: CORTEX Development Team
%% Usage: Use for database schemas, data models, and ORM relationships
%%
%% Variables to replace:
%%   {{ENTITY_N}} - Entity/table names
%%   {{ATTRIBUTE_N}} - Attribute names with types
%%   {{RELATIONSHIP_N}} - Relationship descriptions

---
%% Basic ER Diagram
erDiagram
    USER {
        uuid id PK "Primary Key"
        string email UK "Unique Email"
        string password_hash "Hashed Password"
        string first_name
        string last_name
        datetime created_at
        datetime updated_at
        boolean is_active
    }
    
    PROFILE {
        uuid id PK
        uuid user_id FK "Foreign Key to USER"
        string avatar_url
        text bio
        json settings
        datetime last_login
    }
    
    ROLE {
        uuid id PK
        string name UK
        string description
        json permissions
    }
    
    USER_ROLE {
        uuid user_id FK
        uuid role_id FK
        datetime assigned_at
    }
    
    USER ||--o| PROFILE : "has"
    USER ||--o{ USER_ROLE : "has"
    ROLE ||--o{ USER_ROLE : "assigned to"

---
%% E-Commerce Schema
erDiagram
    CUSTOMER {
        uuid id PK
        string email UK
        string name
        datetime created_at
    }
    
    ORDER {
        uuid id PK
        uuid customer_id FK
        decimal total_amount
        string status
        datetime order_date
        datetime shipped_date
    }
    
    ORDER_ITEM {
        uuid id PK
        uuid order_id FK
        uuid product_id FK
        int quantity
        decimal unit_price
    }
    
    PRODUCT {
        uuid id PK
        string sku UK
        string name
        text description
        decimal price
        int stock_quantity
        uuid category_id FK
    }
    
    CATEGORY {
        uuid id PK
        string name
        uuid parent_id FK "Self-reference for hierarchy"
    }
    
    CUSTOMER ||--o{ ORDER : "places"
    ORDER ||--|{ ORDER_ITEM : "contains"
    PRODUCT ||--o{ ORDER_ITEM : "included in"
    CATEGORY ||--o{ PRODUCT : "categorizes"
    CATEGORY ||--o{ CATEGORY : "parent of"

---
%% Content Management Schema
erDiagram
    AUTHOR {
        uuid id PK
        string username UK
        string email UK
        string bio
    }
    
    ARTICLE {
        uuid id PK
        uuid author_id FK
        string title
        string slug UK
        text content
        string status "draft|published|archived"
        datetime published_at
        datetime created_at
        datetime updated_at
    }
    
    TAG {
        uuid id PK
        string name UK
        string slug UK
    }
    
    ARTICLE_TAG {
        uuid article_id FK
        uuid tag_id FK
    }
    
    COMMENT {
        uuid id PK
        uuid article_id FK
        uuid author_id FK
        uuid parent_id FK "For nested comments"
        text content
        datetime created_at
    }
    
    MEDIA {
        uuid id PK
        uuid article_id FK
        string filename
        string url
        string mime_type
        int file_size
    }
    
    AUTHOR ||--o{ ARTICLE : "writes"
    ARTICLE ||--o{ ARTICLE_TAG : "has"
    TAG ||--o{ ARTICLE_TAG : "applied to"
    ARTICLE ||--o{ COMMENT : "has"
    AUTHOR ||--o{ COMMENT : "writes"
    COMMENT ||--o{ COMMENT : "replies to"
    ARTICLE ||--o{ MEDIA : "contains"

---
%% Security/Audit Schema
erDiagram
    AUDIT_LOG {
        uuid id PK
        uuid user_id FK
        string action "CREATE|UPDATE|DELETE|LOGIN|LOGOUT"
        string entity_type
        uuid entity_id
        json old_values
        json new_values
        string ip_address
        string user_agent
        datetime created_at
    }
    
    SESSION {
        uuid id PK
        uuid user_id FK
        string token_hash
        string ip_address
        string device_info
        datetime created_at
        datetime expires_at
        datetime revoked_at
    }
    
    API_KEY {
        uuid id PK
        uuid user_id FK
        string key_hash UK
        string name
        json permissions
        datetime last_used_at
        datetime expires_at
        boolean is_active
    }
    
    USER ||--o{ AUDIT_LOG : "generates"
    USER ||--o{ SESSION : "has"
    USER ||--o{ API_KEY : "owns"
