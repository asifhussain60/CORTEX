  # Long-Running Operation Templates (Phase 1.2)
  long_running_initial_notification:
    template: |
      ⏳ {operation_name} will take approximately {estimated_duration}
         Good time for {suggestion}
    default_suggestion: "coffee ☕"
    duration_thresholds:
      - range: [5, 10]  # 5-10 minutes
        suggestion: "a quick break ☕"
      - range: [10, 20]  # 10-20 minutes
        suggestion: "coffee ☕"
      - range: [20, 60]  # 20-60 minutes
        suggestion: "lunch 🍽️"
      - range: [60, 999]  # 1+ hours
        suggestion: "a walk 🚶"
  
  long_running_step_progress:
    template: "Step {current}/{total}: {description}"
    show_percentage: false
    show_eta: true

formatting:
  mandatory_sections:
  - understanding
  - challenge
  - response
  - request_echo
  - next_steps

