schema_version: '3.2'
last_updated: '2025-11-26'
optimization:
  type: aggressive_minimal
  original_templates: 107
  minimal_templates: 18
  reduction_strategy: Core essentials only + fallback pattern
shared:
  standard_header: '## 🧠 CORTEX {{title}}

    **Author:** Asif Hussain | **GitHub:** github.com/asifhussain60/CORTEX


    ---

    '
base_templates:
  standard_5_part: &standard_5_part_base
    base_structure: |
      ## 🧠 CORTEX {{operation}}
      **Author:** Asif Hussain | **GitHub:** github.com/asifhussain60/CORTEX
      
      ---
      
      ### 🎯 My Understanding Of Your Request
      {{understanding_content}}
      
      ### ⚠️ Challenge
      {{challenge_content}}
      
      ### 💬 Response
      {{response_content}}
      
      ### 📝 Your Request
      {{request_echo_content}}
      
      ### 🔍 Next Steps
      {{next_steps_content}}
  
  tech_aware_response: &tech_aware_base
    base_structure: |
      ## 🧠 CORTEX {{operation}}
      **Author:** Asif Hussain | **GitHub:** github.com/asifhussain60/CORTEX
      
      ---
      
      ### 🎯 My Understanding Of Your Request
      {{understanding_content}}
      
      ### ⚠️ Challenge
      {{challenge_content}}
      
      ### 💬 Response
      
      **🏆 Recommended Solution:**
      {{recommended_solution}}
      
      {{#if has_tech_stack}}
      **🔧 {{cloud_provider_name}}-Aligned Implementation:**
      {{company_aligned_implementation}}
      
      *Deployment Options:*
      - **Cloud Platform:** {{cloud_deployment}}
      - **Container Orchestration:** {{container_orchestration}}
      - **CI/CD:** {{cicd_pipeline}}
      - **Infrastructure as Code:** {{iac_tool}}
      - **Monitoring:** {{monitoring_platform}}
      {{/if}}
      
      ### 📝 Your Request
      {{request_echo_content}}
      
      ### 🔍 Next Steps
      {{next_steps_content}}
  
  compact_format: &compact_format_base
    base_structure: |
      ## 🧠 CORTEX {{operation}}
      **{{understanding_brief}}** | *No Challenge*
      
      **Author:** Asif Hussain | **GitHub:** github.com/asifhussain60/CORTEX
      
      ---
      
      💬 **Response:**
      {{response_content}}
      
      📝 **Your Request:** {{request_echo_content}}
      
      🔍 Next Steps: {{next_steps_content}}
templates:
commit_and_push:
    trigger_phrases:
      - "commit_and_push"
      - "commit and push"
    response_profile: "standard"
    template_sections:
      header:
        title: "Commit And Push"
        icon: "🧠"
        include_author: true
      understanding:
        content: "You want to execute the commit and push operation."
      challenge:
        default: "No Challenge"
        auto_detect: true
      response:
        content: "Commit and Push Orchestrator"
        include_details: true
      request_echo:
        enabled: true
      next_steps:
        format: "checkboxes"
        auto_generate: true
