graph TD
    %% Knowledge Flow: How Intelligence Flows Through CORTEX 6.0
    
    %% User Entry Point
    USER[👤 User Request<br/>e.g. implement user authentication]
    
    %% Phase -1: Intent Classification
    INTENT[🔍 Intent Classifier<br/>Pattern Match / LLM / Capability]
    
    %% Phase 0: MasterOrchestrator
    MASTER[🎯 MasterOrchestrator<br/>Central Controller]
    
    %% Phase 0.5: Governance Loading
    GOV_LOADER[📚 GovernanceMerger<br/>Load 4-Tier Rules]
    
    %% Tier Loading (Parallel)
    TIER0[🔥 Tier 0: CORTEX_CORE<br/>19 SKULL rules<br/>Immutable enforcement]
    TIER1[📋 Tier 1: BUSINESS_TIER_0<br/>Active epic, AC-INDEX<br/>Current requirements]
    TIER2[🏗️ Tier 2: COMPANY_PRACTICES<br/>Engineering standards<br/>Quality gates]
    TIER3[🧠 Tier 3: KNOWLEDGE_PRACTICES<br/>Learned patterns<br/>Performance insights]
    
    %% Phase 1: Rule Merging
    MERGE[⚙️ Rule Merger<br/>Tier 0 wins conflicts<br/>Produces unified ruleset]
    
    %% Phase 2: Validation
    VALIDATE[✅ Request Validator<br/>Check against SKULL<br/>Security approval]
    
    %% Phase 3: Planning
    PLANNER[📐 Planning Orchestrator<br/>Generate breakdown<br/>AC-IDs, dependencies]
    
    %% Phase 4: Todo Management
    TODO[📝 TodoManager<br/>Create trackable tasks<br/>Persist to progress-tracker.json]
    
    %% Phase 5: Routing to Specialist
    ROUTE_DECISION{Route to Specialist}
    
    %% Specialist Orchestrators
    TDD[🧪 TDD-Master<br/>RED→GREEN→REFACTOR]
    ADO[📊 ADO Orchestrator<br/>Work item sync]
    VACUUM[🧹 Vacuum Orchestrator<br/>Deep cleanup]
    
    %% Phase 6: TDD-Master Workflow (expanded)
    TDD_RED[🔴 RED: Write Failing Test<br/>Load Tier 1 requirements]
    TDD_GREEN[🟢 GREEN: Minimal Implementation<br/>Make test pass]
    TDD_REFACTOR[♻️ REFACTOR: Apply Best Practices<br/>Inject Tier 2 standards]
    
    %% Best Practice Injection
    BP_INJECT[📖 Best Practice Injector<br/>PEP8, SOLID, DRY, YAGNI<br/>Design patterns from Tier 2]
    
    %% Phase 7: Evidence Generation
    EVIDENCE[📦 Evidence Bundle<br/>Test results, coverage<br/>Audit logs, git diffs]
    
    %% Phase 8: Audit Trail
    AUDIT[🔐 EnhancedAuditLogger<br/>Hash chain integrity<br/>SQLite WAL]
    
    %% Phase 9: State Persistence
    STATE[💾 State Manager<br/>progress-tracker.json<br/>governance.db]
    
    %% Phase 10: Response
    RESPONSE[📤 Response to User<br/>Formatted output<br/>Evidence attached]
    
    %% === FLOW CONNECTIONS ===
    
    USER --> INTENT
    INTENT --> MASTER
    
    MASTER --> GOV_LOADER
    
    GOV_LOADER --> TIER0
    GOV_LOADER --> TIER1
    GOV_LOADER --> TIER2
    GOV_LOADER --> TIER3
    
    TIER0 --> MERGE
    TIER1 --> MERGE
    TIER2 --> MERGE
    TIER3 --> MERGE
    
    MERGE --> VALIDATE
    VALIDATE --> PLANNER
    PLANNER --> TODO
    TODO --> ROUTE_DECISION
    
    ROUTE_DECISION -->|TDD Request| TDD
    ROUTE_DECISION -->|ADO Sync| ADO
    ROUTE_DECISION -->|Cleanup| VACUUM
    
    TDD --> TDD_RED
    TDD_RED --> TDD_GREEN
    TDD_GREEN --> TDD_REFACTOR
    
    TDD_REFACTOR --> BP_INJECT
    BP_INJECT -->|Apply Tier 2| TDD_REFACTOR
    
    TDD_REFACTOR --> EVIDENCE
    ADO --> EVIDENCE
    VACUUM --> EVIDENCE
    
    EVIDENCE --> AUDIT
    AUDIT --> STATE
    STATE --> RESPONSE
    
    RESPONSE --> USER
    
    %% === KNOWLEDGE INJECTION POINTS ===
    
    TIER0 -.->|Enforce| VALIDATE
    TIER1 -.->|Provide Context| TDD_RED
    TIER2 -.->|Inject Standards| BP_INJECT
    TIER3 -.->|Suggest Optimizations| TDD_REFACTOR
    
    %% === DATA FLOWS ===
    
    MERGE -.->|Unified Rules| MASTER
    TODO -.->|Task List| STATE
    AUDIT -.->|Correlation ID| EVIDENCE
    
    %% === STYLING ===
    
