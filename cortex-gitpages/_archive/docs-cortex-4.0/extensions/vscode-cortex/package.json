{
  "name": "cortex-governance",
  "displayName": "CORTEX Governance",
  "description": "CORTEX governance integration for VS Code - inline validation, quick fixes, and audit trail viewer",
  "version": "1.0.0",
  "publisher": "cortex-dev",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other",
    "Linters",
    "Debuggers"
  ],
  "activationEvents": [
    "workspaceContains:cortex-config.yaml",
    "onCommand:cortex.connectToHub",
    "onView:cortex-audit-trail"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cortex.connectToHub",
        "title": "CORTEX: Connect to Hub",
        "category": "CORTEX"
      },
      {
        "command": "cortex.showViolations",
        "title": "CORTEX: Show Violations",
        "category": "CORTEX"
      },
      {
        "command": "cortex.showAuditTrail",
        "title": "CORTEX: Show Audit Trail",
        "category": "CORTEX"
      },
      {
        "command": "cortex.showHealth",
        "title": "CORTEX: Show Health Status",
        "category": "CORTEX"
      },
      {
        "command": "cortex.applyQuickFix",
        "title": "CORTEX: Apply Quick Fix",
        "category": "CORTEX"
      }
    ],
    "views": {
      "cortex-sidebar": [
        {
          "id": "cortex-audit-trail",
          "name": "CORTEX Audit Trail",
          "icon": "media/audit-trail.svg",
          "contextualTitle": "Audit Log"
        },
        {
          "id": "cortex-health",
          "name": "CORTEX Health",
          "icon": "media/health.svg",
          "contextualTitle": "MCP Hub Status"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cortex-sidebar",
          "title": "CORTEX",
          "icon": "media/cortex-icon.svg"
        }
      ]
    },
    "codeActions": [
      {
        "languages": [
          "markdown",
          "yaml",
          "json"
        ],
        "title": "CORTEX: Apply Quick Fix",
        "kind": "quickfix",
        "applicable": true
      }
    ],
    "configuration": {
      "type": "object",
      "title": "CORTEX",
      "properties": {
        "cortex.hubEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "MCP hub endpoint (can be overridden by cortex-config.yaml)"
        },
        "cortex.healthCheckInterval": {
          "type": "number",
          "default": 30,
          "description": "Health check interval in seconds"
        },
        "cortex.offlineMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable offline mode (use cached rules)"
        },
        "cortex.showDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Show governance violations as diagnostics"
        },
        "cortex.auditTrailMaxItems": {
          "type": "number",
          "default": 1000,
          "description": "Maximum audit trail entries to display"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --target=node14",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^16.0.0",
    "@types/vscode": "^1.60.0",
    "@vscode/test-electron": "^2.0.0",
    "esbuild": "^0.13.0",
    "typescript": "^4.4.0"
  },
  "dependencies": {
    "yaml": "^2.0.0"
  }
}
