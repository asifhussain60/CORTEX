<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>CortexLSPAdapter</RootNamespace>
    <AssemblyName>cortex-lsp-adapter</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- LSP support via OmniSharp -->
    <PackageReference Include="OmniSharp.Extensions.LanguageServer" Version="0.19.*" />
    <PackageReference Include="OmniSharp.Extensions.JsonRpc" Version="0.19.*" />
    
    <!-- YAML parsing -->
    <PackageReference Include="YamlDotNet" Version="13.0.0" />
    
    <!-- HTTP client -->
    <PackageReference Include="HttpClientFactory" Version="4.3.1" />
    
    <!-- JSON handling -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    
    <!-- Logging -->
    <PackageReference Include="Serilog" Version="3.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>

</Project>
