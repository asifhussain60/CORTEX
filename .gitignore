# SQLite runtime artifacts (NOT the database itself)
# These are transient files that cause merge conflicts
cortex_brain/state/*.db-shm
cortex_brain/state/*.db-wal

# Knowledge cache (AC-HYBRID-KNOWLEDGE-001)
# This is rebuilt automatically on git pull via post-merge hook
.cortex/knowledge.db
.cortex/knowledge-cache/

# Docker-first: Ephemeral runtime databases (Phase 2)
# All database state should be ephemeral in containers
.cortex/orchestrator_registry.db
.cortex/*.db
cortex_brain/state/*.db
cortex/core/state/*.db
**/governance.db
**/governance.db-shm
**/governance.db-wal

# macOS lock files (Finder temporary files)
# These are OS-generated and should never be committed
.!*
.DS_Store

