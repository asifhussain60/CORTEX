# ============================================================================
# SQLite Databases (Local Developer Artifacts - NOT Source Controlled)
# ============================================================================
# RATIONALE: Database files are EPHEMERAL observability artifacts (traces, audit logs)
#            similar to node_modules/ or .venv/ — each developer has their own.
#
# TEAM COLLABORATION:
#   ✅ Company domain knowledge: cortex-registry/company/domains/*.yaml (git-tracked)
#   ✅ Brain knowledge: cortex_intelligence/tier3/knowledge/*.yaml (git-tracked)
#   ❌ Trace logs: *.db (local-only, auto-created on first run)
#
# FIRST-TIME SETUP: No manual steps — databases auto-created by bootstrap
# PULLING UPDATES: Your local .cortex-runtime/traces/ preserved (not in git)
#
# Authority: CORE-051 (Cross-Platform MCP), Industry Best Practice
# ============================================================================

# All SQLite database files (local observability)
*.db
*.db-journal
*.db-wal
*.db-shm

# Local CORTEX dev artifacts (ephemeral, per-developer — never source-controlled)
.cortex-runtime/

# VS Code personal preferences
.favorites.json

# State databases (ephemeral)
cortex_intelligence/state/*.db
cortex/core/state/*.db
**/governance.db

# macOS lock files (Finder temporary files)
# These are OS-generated and should never be committed
