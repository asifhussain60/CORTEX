graph TD
    subgraph input["User Request + Context"]
        req["User Request"]
        ac_ctx["AC-ID Context<br/>(status, phase, evidence)"]
        phase_ctx["Phase Context<br/>(PHASE-E, etc)"]
    end
    
    subgraph tier0_overlay["TIER 0: Immutable Rules"]
        t0_load["Load 29 CORE Rules"]
        t0_compress["Compress:<br/>TDD|Types|Docs|Result[T]..."]
        t0_apply["Apply Rules:<br/>- No bare except<br/>- Type hints required<br/>- Docstrings mandatory"]
    end
    
    subgraph tier1_overlay["TIER 1: Project Governance"]
        t1_load["Load AC-ID State"]
        t1_condense["Condense to:<br/>FR-01✅[E:4]<br/>FR-02⏳[E:2]"]
        t1_gates["Verify Gates:<br/>- Phase passed<br/>- Dependencies OK<br/>- Evidence complete"]
    end
    
    subgraph tier2_overlay["TIER 2: Response Template"]
        t2_select["Select Template<br/>Based on request type"]
        t2_reference["Reference Template:<br/>[TEMPLATE: impl_multi_step]"]
        t2_adapt["Adapt to context:<br/>- Token budget<br/>- Verbosity level<br/>- Phase requirements"]
    end
    
    subgraph tier3_overlay["TIER 3: Knowledge Library"]
        t3_search["Semantic Search<br/>for domain knowledge"]
        t3_retrieve["Retrieve:<br/>- Best practices<br/>- Patterns<br/>- Domain rules"]
        t3_index["Index Knowledge:<br/>KB: governance-3tier<br/>KB: python-best-practices"]
    end
    
    subgraph assembly["Multi-Tier Assembly"]
        combine["Combine all tiers:<br/>Governance + Context<br/>+ Template + Knowledge"]
        structure["Assemble JSON:<br/>{<br/>  governance: [...],<br/>  tier1: {...},<br/>  tier2: {...},<br/>  tier3: {...],<br/>  task: ...<br/>}"]
        validate["Validate:<br/>- Rules complete<br/>- AC-IDs accurate<br/>- Template valid<br/>- Tokens < 4000"]
    end
    
    subgraph output["Composite Request"]
        composite["Optimized Composite<br/>290 tokens<br/>96% efficiency"]
        send["Send to GitHub Copilot"]
    end
    
    req --> t0_load
    ac_ctx --> t1_load
    phase_ctx --> t2_select
    
    t0_load --> t0_compress
    t0_compress --> t0_apply
    
    t1_load --> t1_condense
    t1_condense --> t1_gates
    
    t2_select --> t2_reference
    t2_reference --> t2_adapt
    
    req --> t3_search
    t3_search --> t3_retrieve
    t3_retrieve --> t3_index
    
    t0_apply --> combine
    t1_gates --> combine
    t2_adapt --> combine
    t3_index --> combine
    
    combine --> structure
    structure --> validate
    validate --> composite
    composite --> send
    
    style req fill:#e0e0ff
    style t0_apply fill:#ff9999
    style t1_gates fill:#99ccff
    style t2_adapt fill:#99e0ff
    style t3_index fill:#99ff99
    style composite fill:#ffff99
