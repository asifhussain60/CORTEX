flowchart TD
    Start([POST /api/v1/funding-invoices/generate]) --> CheckAmount
    CheckAmount{invoiceAmount > 0?}
    CheckAmount -->|No| ErrAmount[400 Bad Request: amount must be positive]
    CheckAmount -->|Yes| CheckDate
    CheckDate{invoiceDate >= today?}
    CheckDate -->|No| ErrDate[400 Bad Request: date cannot be in the past]
    CheckDate -->|Yes| CheckId
    CheckId{subaccountId provided?}
    CheckId -->|No| ErrId[400 Bad Request: subaccountId required]
    CheckId -->|Yes| LookupAccount
    LookupAccount[GET Subaccount from DB]
    LookupAccount --> AccountFound{Subaccount found?}
    AccountFound -->|No| Err404[404 Not Found: subaccount does not exist]
    AccountFound -->|Yes| PegCheck
    PegCheck{balance < invoiceAmount?}
    PegCheck -->|No| NotNeeded[200 OK: result = not needed]
    PegCheck -->|Yes| CreateInvoice[INSERT FundingInvoice + CashInOut]
    CreateInvoice --> Created[200 OK: result = invoice created, invoiceId]
    ErrAmount --> End([End])
    ErrDate --> End
    ErrId --> End
    Err404 --> End
    NotNeeded --> End
    Created --> End
