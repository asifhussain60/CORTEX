sequenceDiagram
    participant Client
    participant TransactionBatchController
    participant TransactionBatchService
    participant TransactionBatchRepository
    participant CashInOutRepository
    participant Database

    Client->>+TransactionBatchController: PUT /api/v1/transaction-batches/{batchId}
    TransactionBatchController->>TransactionBatchController: Validate batchId not null
    TransactionBatchController->>TransactionBatchController: Validate cashInOutId not empty
    TransactionBatchController->>+TransactionBatchService: UpdateBatchAsync(batchId, dto)
    TransactionBatchService->>+TransactionBatchRepository: GetByIdAsync(batchId)
    TransactionBatchRepository-->>-TransactionBatchService: TransactionBatch entity
    TransactionBatchService->>TransactionBatchService: Validate batch status allows update
    TransactionBatchService->>+CashInOutRepository: GetByIdAsync(cashInOutId)
    CashInOutRepository-->>-TransactionBatchService: CashInOut entity
    TransactionBatchService->>+Database: UPDATE TransactionBatch SET Status, UpdatedDate
    Database-->>-TransactionBatchService: Rows affected
    TransactionBatchService-->>-TransactionBatchController: UpdatedBatchDto
    TransactionBatchController-->>-Client: 200 OK { batchId, status, updatedDate }
