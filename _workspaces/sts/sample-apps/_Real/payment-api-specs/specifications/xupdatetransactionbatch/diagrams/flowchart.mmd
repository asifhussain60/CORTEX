flowchart TD
    Start([PUT /api/v1/transaction-batches/batchId]) --> CheckBatch
    CheckBatch{batchId provided?}
    CheckBatch -->|No| ErrBatch[400 Bad Request: batchId required]
    CheckBatch -->|Yes| CheckCash
    CheckCash{cashInOutId not empty?}
    CheckCash -->|No| ErrCash[400 Bad Request: cashInOutId required]
    CheckCash -->|Yes| LookupBatch
    LookupBatch[GET TransactionBatch from DB]
    LookupBatch --> BatchFound{Batch found?}
    BatchFound -->|No| Err404Batch[404 Not Found: batch does not exist]
    BatchFound -->|Yes| CheckStatus
    CheckStatus{Batch status allows update?}
    CheckStatus -->|No| ErrStatus[409 Conflict: batch already closed]
    CheckStatus -->|Yes| LookupCash
    LookupCash[GET CashInOut from DB]
    LookupCash --> CashFound{CashInOut found?}
    CashFound -->|No| Err404Cash[404 Not Found: cash record does not exist]
    CashFound -->|Yes| CheckInvoice
    CheckInvoice{TransactionInvoice exists?}
    CheckInvoice -->|Yes| LinkInvoice[Update invoice reference on batch]
    CheckInvoice -->|No| UpdateOnly
    LinkInvoice --> UpdateOnly
    UpdateOnly[UPDATE TransactionBatch status and timestamp]
    UpdateOnly --> Complete[200 OK: UpdatedBatchDto]
    ErrBatch --> End([End])
    ErrCash --> End
    Err404Batch --> End
    ErrStatus --> End
    Err404Cash --> End
    Complete --> End
