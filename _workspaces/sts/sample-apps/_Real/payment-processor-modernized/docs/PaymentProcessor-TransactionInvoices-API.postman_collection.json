{
  "info": {
    "name": "PaymentProcessor Transaction Invoices API",
    "description": "Postman collection for PaymentProcessor Transaction Invoices REST API - migrated from WCF transactions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "1234567"
  },
  "item": [
    {
      "name": "Transaction Invoices",
      "item": [
        {
          "name": "Create Invoice (Payroll-based)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employerId\": \"EMP-001\",\n  \"account_categoryId\": \"SA-001\",\n  \"paymentPlanId\": \"RP-001\",\n  \"employerTransactionDefault\": 500.00,\n  \"employeeTransactionDefault\": 250.00,\n  \"effectiveDate\": \"2025-12-15T00:00:00Z\",\n  \"invoiceDescription\": \"Payroll transaction - December 2025\",\n  \"isLSA\": false,\n  \"updateTemplate\": true,\n  \"createdBy\": \"system\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transaction-invoices",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transaction-invoices"]
            },
            "description": "Creates a payroll-based transaction invoice (migrated from XAddTransactionInvoice WCF transaction)"
          },
          "response": []
        },
        {
          "name": "Generate Invoice (On-Demand)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_categoryId\": \"SA-001\",\n  \"invoiceAmount\": 500.00,\n  \"invoiceDate\": \"2025-12-15T00:00:00Z\",\n  \"createdBy\": \"system\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transaction-invoices/generate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transaction-invoices", "generate"]
            },
            "description": "Generates on-demand invoice with peg amount logic (migrated from XGenerateTransactionInvoice WCF transaction)"
          },
          "response": []
        },
        {
          "name": "Create Batch Invoices",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employerIds\": [\"EMP-001\", \"EMP-002\"],\n  \"createdBy\": \"system\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transaction-invoices/batch",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transaction-invoices", "batch"]
            },
            "description": "Creates transaction invoices for multiple account_categorys (migrated from Updater_CreatePaymentTransactionInvoices)"
          },
          "response": []
        },
        {
          "name": "Get Invoice by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transaction-invoices/{{invoiceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transaction-invoices", "{{invoiceId}}"]
            },
            "description": "Retrieves a single transaction invoice by ID"
          },
          "response": []
        },
        {
          "name": "Get Invoices by Batch ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transaction-invoices/batch/{{batchId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transaction-invoices", "batch", "{{batchId}}"]
            },
            "description": "Retrieves all invoices in a specific batch"
          },
          "response": []
        },
        {
          "name": "Get Invoices by AccountCategory ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transaction-invoices/account_category/{{account_categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transaction-invoices", "account_category", "{{account_categoryId}}"]
            },
            "description": "Retrieves all invoices for a specific account_category"
          },
          "response": []
        }
      ]
    },
    {
