            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated batch description\",\n  \"employerId\": \"EMP-002\",\n  \"updatedBy\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transaction-batches/{{batchId}}",
