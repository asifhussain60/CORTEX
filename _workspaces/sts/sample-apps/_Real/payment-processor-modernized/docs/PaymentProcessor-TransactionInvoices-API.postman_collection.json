            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"December 2025 Payroll Batch\",\n  \"employerId\": \"EMP-001\",\n  \"createdBy\": \"system\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transaction-batches",
