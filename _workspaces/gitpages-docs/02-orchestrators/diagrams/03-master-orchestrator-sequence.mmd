sequenceDiagram
    participant Client
    participant Master as Master<br/>Orchestrator
    participant Router as Intent<br/>Router
    participant Handler as Domain<br/>Orchestrator
    participant Audit as Audit<br/>Logger
    participant State as State<br/>Manager
    
    Client->>Master: Execute Operation
    activate Master
    
    Master->>Master: Validate Governance
    Master->>Master: Check Boundaries
    
    Master->>Router: Route Operation
    activate Router
    Router->>Router: Classify Intent
    Router->>Router: Score Confidence
    Router-->>Master: Routing Decision
    deactivate Router
    
    Master->>Handler: Delegate Execution
    activate Handler
    Handler->>Handler: Execute Operation
    Handler-->>Master: Return Results
    deactivate Handler
    
    Master->>Audit: Log Operation
    activate Audit
    Audit->>Audit: Create Audit Entry
    Audit-->>Master: Logged
    deactivate Audit
    
    Master->>State: Persist State
    activate State
    State->>State: Save State
    State-->>Master: Saved
    deactivate State
    
    Master-->>Client: Response
    deactivate Master
