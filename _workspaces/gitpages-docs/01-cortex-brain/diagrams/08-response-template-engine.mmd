graph TD
    subgraph input["Input Context"]
        request_type["Request Type:<br/>- implementation<br/>- refactoring<br/>- documentation"]
        token_budget["Token Budget:<br/>- total: 4000<br/>- allocated by type"]
        phase["Phase:<br/>- PHASE-E<br/>- PHASE-DOC-REMEDIATION"]
    end
    
    subgraph selection["Template Selection"]
        templates["Available Templates:<br/>- impl_multi_step<br/>- refactoring_solid<br/>- documentation_technical<br/>- minimal_continuation"]
        matcher["Match request type<br/>to template"]
        selected["Selected Template:<br/>e.g. impl_multi_step"]
    end
    
    subgraph loading["Template Loading"]
        load_yaml["Load YAML template<br/>definition"]
        parse_sections["Parse sections:<br/>- test_skeleton<br/>- implementation<br/>- refactoring<br/>- validation"]
    end
    
    subgraph inheritance["Inheritance Processing"]
        check_parent["Check parent template<br/>if exists"]
        inherit_sections["Inherit sections<br/>from parent"]
        override["Apply overrides<br/>from child"]
        merged["Merged sections"]
    end
    
    subgraph verbosity["Verbosity Selection"]
        analyze_context["Analyze context:<br/>- token_budget<br/>- phase<br/>- complexity"]
        verbosity_rules["Apply verbosity rules:<br/>IF budget < 300: minimal<br/>IF phase == DOC: full<br/>ELSE: standard"]
        verbosity_level["Verbosity level:<br/>minimal/standard/full"]
    end
    
    subgraph adaptation["Section Adaptation"]
        adapt_each["For each section:<br/>- Adjust token count<br/>- Adapt detail level<br/>- Apply tone"]
        
        adapt_result["Adapted sections:<br/>- test_skeleton: 100 tokens (minimal)<br/>- implementation: 150 tokens<br/>- validation: 80 tokens"]
    end
    
    subgraph filtering["Section Filtering"]
        optional["Filter optional sections<br/>if budget tight"]
        required["Keep required sections"]
        final_sections["Final sections for<br/>composite request"]
    end
    
    subgraph validation["Template Validation"]
        validate_compliance["Validate TIER 0<br/>compliance:<br/>- Response header<br/>- No code blocks<br/>- Token limit"]
        validate_result["Validation: PASS ✅"]
    end
    
    subgraph composition["Final Composition"]
        compose["Compose final<br/>template structure"]
        composed["Composed Template<br/>Ready for request"]
    end
    
    request_type --> matcher
    token_budget --> matcher
    phase --> matcher
    
    matcher --> selected
    selected --> load_yaml
    load_yaml --> parse_sections
    parse_sections --> check_parent
    
    check_parent -->|Has parent| inherit_sections
    check_parent -->|No parent| merged
    inherit_sections --> override
    override --> merged
    
    merged --> analyze_context
    analyze_context --> verbosity_rules
    verbosity_rules --> verbosity_level
    
    verbosity_level --> adapt_each
    adapt_each --> adapt_result
    
    adapt_result --> optional
    optional --> required
    required --> final_sections
    
    final_sections --> validate_compliance
    validate_compliance --> validate_result
    
    validate_result --> compose
    compose --> composed
    
    style selected fill:#ffcc99
    style verbosity_level fill:#99ff99
    style final_sections fill:#99ccff
    style composed fill:#ffff99
