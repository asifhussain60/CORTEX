<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CortexLabs.FinTrack</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ✅ SMELL-7 FIXED: Nullable enabled — catches null reference bugs at compile time -->
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <UserSecretsId>cortexlabs-fintrack-refactored</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- ✅ SMELL-2 FIXED: BCrypt for password hashing (replaces plaintext storage) -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="7.5.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.5.1" />
  </ItemGroup>

</Project>
