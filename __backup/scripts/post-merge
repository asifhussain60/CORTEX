#!/bin/bash
#
# CORTEX 6.0 Post-Merge Hook (Database State Sync)
# 
# Automatically synchronizes database state after git pull/merge:
# 1. Detects if state files were updated in merge
# 2. Imports state from git-tracked exports to local databases
# 3. Applies pending database migrations
# 4. Validates database integrity
#
# This ensures pulling machines stay aligned with pushing machines
# without manual intervention.
#
# Author: Asif Hussain
# Copyright © 2025-2026 Asif Hussain. All rights reserved.
#
# Installation:
#   cp scripts/post-merge .git/hooks/post-merge
#   chmod +x .git/hooks/post-merge
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Handle both .git/hooks location and scripts/ location
if [[ "$SCRIPT_DIR" == *".git/hooks"* ]]; then
    PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
else
    PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
fi

cd "$PROJECT_ROOT"

echo ""
echo "🔄 CORTEX 6.0 Post-Merge State Synchronization"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# ============================================================================
# Step 1: Detect State File Changes
# ============================================================================

echo ""
echo "📋 Step 1: Detecting state file changes..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Check if any state files changed in merge
STATE_FILES_CHANGED=$(git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD | \
    grep -E '(progress-tracker\.json|active-todos\.yaml|AC-INDEX\.yaml|audit-logs/.*\.jsonl|tier3/patterns/.*\.yaml)' || true)

if [ -z "$STATE_FILES_CHANGED" ]; then
    echo "✅ No state files changed in merge - skipping sync"
    exit 0
fi

echo "📝 State files changed:"
echo "$STATE_FILES_CHANGED" | while read -r file; do
    echo "   • $file"
done

# ============================================================================
# Step 2: Apply Database Migrations (if migration system exists)
# ============================================================================

echo ""
echo "🔧 Step 2: Applying database migrations..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if [ -d "cortex-brain/database/migrations" ]; then
    if python3 -c "import src.infrastructure.database_migrator" 2>/dev/null; then
        echo "🔄 Running pending migrations..."
        python3 -m src.infrastructure.database_migrator apply_all 2>/dev/null || {
            echo "⚠️  Migration system not fully implemented yet - skipping"
        }
    else
        echo "⚠️  Migration module not found - will be available after Phase 1 implementation"
    fi
else
    echo "⚠️  Migration directory not found - will be created in Phase 1"
fi

# ============================================================================
# Step 3: Import Working Memory State (tier1)
# ============================================================================

echo ""
echo "💾 Step 3: Importing working memory state..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if echo "$STATE_FILES_CHANGED" | grep -q "progress-tracker\.json\|active-todos\.yaml"; then
    if python3 -c "import src.infrastructure.state_manager" 2>/dev/null; then
        echo "🔄 Importing progress-tracker.json and active-todos.yaml..."
        python3 -m src.infrastructure.state_manager import 2>/dev/null || {
            echo "⚠️  StateManager import not fully implemented yet"
            echo "   Manual import command: python3 -m src.infrastructure.state_manager import"
        }
    else
        echo "⚠️  StateManager module not found - will be available after Phase 2 implementation"
        echo "   Affected files: progress-tracker.json, active-todos.yaml"
    fi
else
    echo "✅ No working memory state changes detected"
fi

# ============================================================================
# Step 4: Import Audit Trail Exports (tier0)
# ============================================================================

echo ""
echo "📜 Step 4: Importing audit trail exports..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if echo "$STATE_FILES_CHANGED" | grep -q "audit-logs/.*\.jsonl"; then
    if python3 -c "import src.infrastructure.enhanced_audit_logger" 2>/dev/null; then
        echo "🔄 Importing audit log exports (JSONL)..."
        python3 -m src.infrastructure.enhanced_audit_logger import_exports 2>/dev/null || {
            echo "⚠️  AuditLogger import not fully implemented yet"
            echo "   Manual import command: python3 -m src.infrastructure.enhanced_audit_logger import_exports"
        }
    else
        echo "⚠️  AuditLogger import module not found - will be available after Phase 2 implementation"
        echo "   Affected files: audit-logs/*.jsonl"
    fi
else
    echo "✅ No audit trail exports detected"
fi

# ============================================================================
# Step 5: Import Knowledge Patterns (tier3)
# ============================================================================

echo ""
echo "🧠 Step 5: Importing knowledge patterns..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if echo "$STATE_FILES_CHANGED" | grep -q "tier3/patterns/.*\.yaml"; then
    if python3 -c "import src.infrastructure.tier3_manager" 2>/dev/null; then
        echo "🔄 Importing learned patterns..."
        python3 -m src.infrastructure.tier3_manager import_patterns 2>/dev/null || {
            echo "⚠️  Tier3Manager import not fully implemented yet"
            echo "   Manual import command: python3 -m src.infrastructure.tier3_manager import_patterns"
        }
    else
        echo "⚠️  Tier3Manager module not found - will be available after Phase 2 implementation"
        echo "   Affected files: tier3/patterns/*.yaml"
    fi
else
    echo "✅ No knowledge pattern changes detected"
fi

# ============================================================================
# Step 6: Validate Database Integrity
# ============================================================================

echo ""
echo "✅ Step 6: Validating database integrity..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if python3 -c "import src.infrastructure.database_validator" 2>/dev/null; then
    echo "🔍 Running database integrity checks..."
    python3 -m src.infrastructure.database_validator check_all 2>/dev/null || {
        echo "⚠️  Database validator not fully implemented yet"
    }
else
    echo "⚠️  Database validator module not found - will be available after Phase 3 implementation"
fi

# ============================================================================
# Summary
# ============================================================================

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✅ POST-MERGE SYNC COMPLETE"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "📊 Summary:"
echo "   • State files detected: $(echo "$STATE_FILES_CHANGED" | wc -l | tr -d ' ')"
echo "   • Database sync: Initiated"
echo "   • Machine alignment: In Progress"
echo ""
echo "⚠️  NOTE: Full sync functionality requires Phase 1-3 implementation"
echo "   Current status: Hook installed, awaiting module implementation"
echo ""
echo "📖 Reference: cortex-brain/documents/analysis/database-synchronization-strategy.md"
echo ""

exit 0
