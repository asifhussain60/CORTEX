#!/bin/bash
#
# CORTEX 6.0 Post-Checkout Hook (Branch Switch State Sync)
# 
# Automatically synchronizes database state after branch switches:
# 1. Detects if state files differ between branches
# 2. Imports state from git-tracked exports to local databases
# 3. Ensures database matches current branch state
#
# This ensures switching branches doesn't leave stale database state.
#
# Author: Asif Hussain
# Copyright © 2025-2026 Asif Hussain. All rights reserved.
#
# Installation:
#   cp scripts/post-checkout .git/hooks/post-checkout
#   chmod +x .git/hooks/post-checkout
#

set -e

# Arguments passed by git:
# $1 = ref of previous HEAD
# $2 = ref of new HEAD
# $3 = flag indicating branch checkout (1) or file checkout (0)

PREV_HEAD=$1
NEW_HEAD=$2
BRANCH_CHECKOUT=$3

# Only run on branch checkouts, not file checkouts
if [ "$BRANCH_CHECKOUT" != "1" ]; then
    exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Handle both .git/hooks location and scripts/ location
if [[ "$SCRIPT_DIR" == *".git/hooks"* ]]; then
    PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
else
    PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
fi

cd "$PROJECT_ROOT"

echo ""
echo "🔀 CORTEX 6.0 Post-Checkout State Synchronization"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# ============================================================================
# Step 1: Detect Branch Change
# ============================================================================

CURRENT_BRANCH=$(git branch --show-current)
echo "📋 Branch switched to: $CURRENT_BRANCH"

# ============================================================================
# Step 2: Detect State File Changes Between Branches
# ============================================================================

echo ""
echo "📋 Step 2: Detecting state file changes between branches..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Compare state files between previous and new HEAD
STATE_FILES_CHANGED=$(git diff --name-only "$PREV_HEAD" "$NEW_HEAD" | \
    grep -E '(progress-tracker\.json|active-todos\.yaml|AC-INDEX\.yaml|audit-logs/.*\.jsonl|tier3/patterns/.*\.yaml)' || true)

if [ -z "$STATE_FILES_CHANGED" ]; then
    echo "✅ No state files changed between branches - skipping sync"
    exit 0
fi

echo "📝 State files changed:"
echo "$STATE_FILES_CHANGED" | while read -r file; do
    echo "   • $file"
done

# ============================================================================
# Step 3: Import State from Current Branch
# ============================================================================

echo ""
echo "💾 Step 3: Importing state from current branch..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Import working memory state
if echo "$STATE_FILES_CHANGED" | grep -q "progress-tracker\.json\|active-todos\.yaml"; then
    if python3 -c "import src.infrastructure.state_manager" 2>/dev/null; then
        echo "🔄 Importing working memory state..."
        python3 -m src.infrastructure.state_manager import 2>/dev/null || {
            echo "⚠️  StateManager import not fully implemented yet"
        }
    else
        echo "⚠️  StateManager module not found - will be available after Phase 2 implementation"
    fi
fi

# Import audit trail exports
if echo "$STATE_FILES_CHANGED" | grep -q "audit-logs/.*\.jsonl"; then
    if python3 -c "import src.infrastructure.enhanced_audit_logger" 2>/dev/null; then
        echo "🔄 Importing audit trail exports..."
        python3 -m src.infrastructure.enhanced_audit_logger import_exports 2>/dev/null || {
            echo "⚠️  AuditLogger import not fully implemented yet"
        }
    else
        echo "⚠️  AuditLogger import module not found - will be available after Phase 2 implementation"
    fi
fi

# Import knowledge patterns
if echo "$STATE_FILES_CHANGED" | grep -q "tier3/patterns/.*\.yaml"; then
    if python3 -c "import src.infrastructure.tier3_manager" 2>/dev/null; then
        echo "🔄 Importing knowledge patterns..."
        python3 -m src.infrastructure.tier3_manager import_patterns 2>/dev/null || {
            echo "⚠️  Tier3Manager import not fully implemented yet"
        }
    else
        echo "⚠️  Tier3Manager module not found - will be available after Phase 2 implementation"
    fi
fi

# ============================================================================
# Summary
# ============================================================================

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✅ POST-CHECKOUT SYNC COMPLETE"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "📊 Branch: $CURRENT_BRANCH"
echo "📊 State files synced: $(echo "$STATE_FILES_CHANGED" | wc -l | tr -d ' ')"
echo ""
echo "⚠️  NOTE: Full sync functionality requires Phase 1-3 implementation"
echo ""

exit 0
