    - export audit
    - archive audit logs
    category: planning
    implementation_status:
      status: ready
      modules_implemented: 1
      modules_total: 1
      completion_percentage: 100
      notes: JSONL-based audit trail with CLI viewer, timeline visualization, statistics,
