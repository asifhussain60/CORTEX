    - planning
    - interactive
    - requirements
    status: designed
    estimated_hours: 8
    cortex_version: '2.1'
  pattern_search:
    name: Pattern Search
    description: Search Tier 2 Knowledge Graph for similar past features and proven
      approaches
    phase: PREPARATION
    execution_method: internal
    priority: 20
    class: PatternSearchModule
    file: planning/pattern_search_module.py
    dependencies:
    - feature_discovery
    optional: false
    tags:
    - planning
    - pattern-matching
    - tier2
    status: designed
    estimated_hours: 12
    cortex_version: '2.1'
  requirement_breakdown:
    name: Requirement Breakdown
    description: Decompose feature into phases, tasks, and acceptance criteria
    phase: PROCESSING
    execution_method: internal
    priority: 30
    class: RequirementBreakdownModule
    file: planning/requirement_breakdown_module.py
    dependencies:
    - feature_discovery
    optional: false
    tags:
    - planning
    - breakdown
    - work-planner
    status: designed
    estimated_hours: 16
    cortex_version: '2.1'
  dependency_analysis:
    name: Dependency Analysis
    description: Identify phase dependencies, external dependencies, and technical
      constraints
    phase: PROCESSING
    execution_method: internal
    priority: 40
    class: DependencyAnalysisModule
    file: planning/dependency_analysis_module.py
    dependencies:
    - requirement_breakdown
    optional: true
    tags:
    - planning
    - dependencies
    - architecture
    status: designed
    estimated_hours: 12
    cortex_version: '2.1'
  risk_identification:
    name: Risk Identification
    description: Identify technical risks, suggest mitigations, flag unknown unknowns
    phase: VALIDATION
    execution_method: internal
    priority: 50
    class: RiskIdentificationModule
    file: planning/risk_identification_module.py
    dependencies:
    - requirement_breakdown
    optional: false
    tags:
    - planning
    - risk-analysis
    - architect
    status: designed
    estimated_hours: 10
    cortex_version: '2.1'
  roadmap_generation:
    name: Roadmap Generation
    description: Generate phase-based roadmap with timeline, acceptance criteria,
      and markdown document
    phase: FINALIZATION
    execution_method: internal
    priority: 60
    class: RoadmapGenerationModule
    file: planning/roadmap_generation_module.py
    dependencies:
    - requirement_breakdown
    - risk_identification
    optional: false
    tags:
    - planning
    - roadmap
    - documentation
    status: designed
    estimated_hours: 12
    cortex_version: '2.1'
  plan_storage:
    name: Plan Storage
    description: Save feature plan to Tier 1 database and cortex-brain/feature-plans/
      markdown file
    phase: FINALIZATION
    execution_method: internal
    priority: 70
    class: PlanStorageModule
    file: planning/plan_storage_module.py
    dependencies:
    - roadmap_generation
    optional: false
    tags:
    - planning
    - storage
    - tier1
    status: designed
    estimated_hours: 8
    cortex_version: '2.1'
  diagram_regeneration:
    name: Diagram Regeneration
    description: Analyze CORTEX design and regenerate all visual assets from scratch
    phase: PROCESSING
    execution_method: internal
    priority: 50
    class: DiagramRegenerationOperation
    file: diagram_regeneration_operation.py
    dependencies: []
    optional: false
    tags:
    - documentation
    - diagrams
    - visual-assets
    - analysis
    status: implemented
    estimated_hours: 24
    cortex_version: '3.0'
    notes: Complete diagram regeneration with CORTEX design analysis, feature identification,
      Mermaid generation, and professional illustration prompts
  publish_branch_orchestrator:
    name: Publish Branch Orchestrator
    description: Build production package and publish to dedicated git branch
    phase: DEPLOYMENT
    execution_method: internal
    priority: 100
    class: PublishBranchOrchestrator
    file: publish/publish_branch_orchestrator.py
    dependencies: []
    optional: false
    tags:
    - publish
    - deployment
    - production
    - git
    status: implemented
    estimated_hours: 0
    cortex_version: '3.0'
    notes: Wraps existing publish_to_branch.py script for integration with CORTEX
      operations system
  enhanced_feedback_module:
    name: Enhanced Feedback Module
    description: Collect comprehensive metrics across 8 categories (Application, Crawler,
      CORTEX Performance, Knowledge Graph, Development Hygiene, TDD Mastery, Commit
      Metrics, Velocity) with privacy sanitization and GitHub Gist integration
    phase: EXECUTION
    execution_method: internal
    priority: 100
    class: EnhancedFeedbackModule
    file: modules/feedback/enhanced_feedback_module.py
    dependencies: []
    optional: false
    tags:
    - feedback
    - metrics
    - analytics
    - gist
    - privacy
    status: implemented
    estimated_hours: 8
    cortex_version: '3.0'
    notes: '8 metrics collectors: ApplicationMetricsCollector, CrawlerPerformanceCollector,
      CortexPerformanceCollector, KnowledgeGraphCollector, DevelopmentHygieneCollector,
      TDDMasteryCollector, CommitMetricsCollector, VelocityMetricsCollector. Privacy
      sanitization with 3 levels (full/medium/minimal). GitHub Gist upload with registry
      tracking'
  admin_feedback_review_module:
    name: Admin Feedback Review Module
    description: '[ADMIN ONLY] Aggregate and analyze feedback reports from multiple
      applications. Sync Gist registry, process reports, generate trend analysis,
      categorize issues'
    phase: EXECUTION
    execution_method: internal
    priority: 100
    class: AdminFeedbackReviewModule
    file: admin/scripts/feedback/admin_feedback_review.py
    dependencies: []
    optional: false
    tags:
    - feedback
    - admin
    - analytics
    - aggregation
    - trends
    status: implemented
    estimated_hours: 6
    cortex_version: '3.0'
    notes: 'CORTEX repo only. Natural language triggers: review feedback, feedback
      review, analyze feedback, process feedback, sync feedback, import feedback.
      Auto-syncs Gist registry by default. Stores in cortex-brain/analytics/ databases'
    implemented_date: '2025-11-24'
  ado_work_item:
    name: ADO Work Item Management
    description: Azure DevOps work item creation and management - interactive planning
      with ADO integration
    deployment_tier: user
    execution_method: internal
    natural_language:
    - plan ado
    - create ado work item
    - ado planning
    - azure devops planning
    - create work item
    category: planning
    modules:
    - ado_utility
    profiles:
      standard:
        description: Interactive ADO work item creation with DoR/DoD validation
        modules:
        - ado_utility
    implementation_status:
      status: ready
      modules_implemented: 1
      modules_total: 1
      completion_percentage: 100
      notes: ADO work item orchestrator migrated to utility in Sprint 3 (Task 6).
        Full ADO integration with work item creation, planning context, and DoR/DoD
        validation.
    examples:
    - plan ado
    - create ado work item for authentication feature
    - ado planning session
  swagger_estimation:
    name: SWAGGER/OpenAPI Complexity Estimation
    description: Analyze SWAGGER/OpenAPI specifications and estimate implementation
      complexity and timeframes
    deployment_tier: user
    execution_method: internal
    natural_language:
    - swagger estimate
    - openapi estimate
    - estimate swagger
    - analyze swagger complexity
    - api complexity analysis
    category: estimation
    modules:
    - swagger_estimation_utility
    profiles:
      standard:
        description: SWAGGER spec analysis with complexity scoring and time estimation
        modules:
        - swagger_estimation_utility
    implementation_status:
      status: ready
      modules_implemented: 1
      modules_total: 1
      completion_percentage: 100
      notes: SWAGGER entry point orchestrator migrated to estimation utility in Sprint
        13b (Final sprint). Analyzes API complexity, endpoint count, and provides
        implementation timeframes.
    examples:
    - swagger estimate
    - estimate this openapi spec
    - analyze swagger complexity
    - how long will this API take
  ux_enhancement:
    name: UX Enhancement Analysis
    description: Analyze user experience and suggest UI/UX improvements for applications
    deployment_tier: user
    execution_method: internal
    natural_language:
    - ux enhancement
    - improve ux
    - analyze user experience
    - ui improvement suggestions
    - enhance user interface
    category: enhancement
    modules:
    - ux_enhancement_utility
    profiles:
      standard:
        description: UX analysis with actionable improvement recommendations
        modules:
        - ux_enhancement_utility
    implementation_status:
      status: ready
      modules_implemented: 1
      modules_total: 1
      completion_percentage: 100
      notes: UX enhancement orchestrator migrated to utility. Analyzes UI patterns,
        accessibility, user flows, and provides specific improvement recommendations.
    examples:
    - ux enhancement
    - analyze user experience for this feature
    - suggest ui improvements
  lint_validation:
    name: Code Linting and Validation
    description: Run linting and code quality validation with auto-fix capabilities
    deployment_tier: user
    execution_method: internal
    natural_language:
    - lint code
    - run linter
    - validate code quality
    - check code standards
    - auto-fix linting issues
    category: quality
    modules:
    - lint_utility
    profiles:
      standard:
        description: Multi-language linting with auto-fix support
        modules:
        - lint_utility
    implementation_status:
      status: ready
      modules_implemented: 1
      modules_total: 1
      completion_percentage: 100
      notes: Lint validation orchestrator migrated to utility in Sprint 4 (Task 11).
        Integrates with TDD workflow for automated code quality checks.
    examples:
    - lint code
    - run linter on this file
    - validate code quality
    - auto-fix linting issues
  application_health:
    name: Application Health Dashboard
    description: Comprehensive application health monitoring with interactive dashboard
      and onboarding workflow
    deployment_tier: user
    execution_method: internal
    natural_language:
    - show health dashboard
    - application health
    - health check
    - onboard application
    - analyze application health
    category: monitoring
    modules:
    - application_health_agent
    profiles:
      standard:
        description: Real-time health monitoring with progressive crawling
        modules:
        - application_health_agent
    implementation_status:
      status: ready
      modules_implemented: 1
      modules_total: 1
      completion_percentage: 100
      notes: Application health orchestrator migrated to agent-based implementation
        in Sprint 5 (Task 15). Features progressive crawling, metrics collection,
        and interactive dashboard.
    examples:
    - show health dashboard
    - health check my application
    - onboard application for monitoring
  rca:
    name: Root Cause Analysis
    description: Interactive root cause analysis with 5 Whys methodology and structured
      investigation
    deployment_tier: user
    execution_method: copilot_chat
    natural_language:
    - root cause analysis
    - rca
    - analyze issue
    - investigate problem
    - 5 whys analysis
    category: investigation
    modules:
    - rca_utility
    profiles:
      standard:
        description: Structured RCA with 5 Whys and evidence collection
        modules:
        - rca_utility
    implementation_status:
      status: ready
      modules_implemented: 1
      modules_total: 1
      completion_percentage: 100
      notes: RCA orchestrator migrated to utility in Sprint 3 (Task 7). Interactive
        investigation workflow with structured evidence collection and remediation
        planning.
    examples:
    - root cause analysis for login failure
    - rca session
    - investigate this issue
    - 5 whys analysis
