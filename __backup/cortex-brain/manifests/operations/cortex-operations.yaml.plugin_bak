operations:
  system_integrity:
    name: System Integrity
    description: Comprehensive system validation and auto-fix - validates master plan
      alignment, runs tests, checks docs, organizes files, repairs links, removes
      legacy artifacts
    deployment_tier: admin
    execution_method: cli_wrapper
    cli_script: scripts/cli_wrappers/system_integrity_wrapper.py
    natural_language:
    - system integrity
    - validate system
    - check integrity
    - integrity check
    - validate cortex
    - system validation
    - integrity scan
    - check system health
    category: system
    modules:
    - system_integrity_orchestrator
    - load_protection_rules
    - evaluate_cortex_architecture
    profiles:
      full:
        description: Full 8-phase integrity check (analyze → tests → docs → organize
          → repair links → cleanup → manifests → report)
        modules:
        - system_integrity_orchestrator
      check_only:
        description: Report issues without auto-fix
        modules:
        - system_integrity_orchestrator
      quick:
        description: Skip tests and legacy cleanup
        modules:
        - system_integrity_orchestrator
    implementation_status:
      status: ready
      modules_implemented: 1
      modules_total: 1
      completion_percentage: 100
      notes: 8-phase orchestrator with master plan alignment, test validation, documentation
        completeness, file organization, broken link repair, legacy cleanup, manifest
        validation, and comprehensive reporting with auto-fix
    examples:
    - system integrity
    - validate system
    - check integrity
    - cortex validate
  refine:
    name: Refinement
    description: Holistic CORTEX system refinement with automated discovery and enhancement
      across code, tests, and documentation
    deployment_tier: admin
    execution_method: copilot_chat
    cli_script: scripts/cli_wrappers/refine_wrapper.py
    natural_language:
    - refine
    - refine the system
    - improve cortex
    - optimize cortex holistically
    - system refine
    - refinement
    - improve cortex quality
    - enhance system
    category: system
    modules:
    - refinement_orchestrator_v1
    profiles:
      standard:
        description: Full 7-phase refinement (discovery → skull review → docs → quality
          → architecture → performance → validation)
        modules:
        - refinement_orchestrator_v1
      discovery_only:
        description: Run discovery phase only (analysis without changes)
        modules:
        - refinement_orchestrator_v1
      docs_only:
        description: Run documentation refinement only
        modules:
        - refinement_orchestrator_v1
    implementation_status:
      status: ready
      modules_implemented: 1
      modules_total: 1
      completion_percentage: 100
      notes: 7-phase orchestrator with AST analysis, SKULL test optimization, doc
        refinement, code quality, architecture review, performance optimization, and
        validation with rollback safety
    examples:
    - refine
    - improve cortex
    - optimize cortex holistically
    - system refine
  upgrade:
    name: Upgrade
    description: Brain-safe CORTEX upgrade with 9-phase workflow and zero data loss
      guarantee. Preserves all learned patterns, knowledge graphs, and user work.
    deployment_tier: user
    execution_method: cli_wrapper
    cli_script: scripts/cli_wrappers/upgrade_wrapper.py
    orchestrator: src.orchestrators.upgrade_orchestrator_v2:UpgradeOrchestratorV2
    prompt_file: .github/prompts/cortex-upgrade.prompt.md
    natural_language:
    - upgrade cortex
    - upgrade system
    - check for updates
    - update cortex
    - pull latest changes
    - upgrade to latest version
    category: system
    modules:
    - upgrade_utility
    - upgrade_orchestrator_v2
    profiles:
      standard:
        description: Full 9-phase upgrade (health check → backup → pull → dependencies
          → migrations → validation → health → sync → report)
        modules:
        - upgrade_utility
        - upgrade_orchestrator_v2
      check_only:
        description: Check for updates without upgrading
        modules:
        - upgrade_utility
      rollback:
        description: Rollback to previous version using backup
        modules:
        - upgrade_utility
    implementation_status:
      status: ready
      modules_implemented: 2
      modules_total: 2
      completion_percentage: 100
      notes: 9-phase brain-safe upgrade with zero-loss guarantee. Only user-facing
        features validated. Protected paths never overwritten (brain data, knowledge
        graphs, configs).
    brain_protection:
      enabled: true
      protected_paths:
      - cortex-brain/tier1/working_memory.db
      - cortex-brain/tier2/knowledge-graph.yaml
      - cortex-brain/tier2/patterns/
      - cortex-brain/tier3/*.db
      - cortex-brain/conversation-history.db
      - cortex-brain/documents/
      - cortex-brain/config/
      - cortex.config.json
      zero_loss_guarantee: true
    examples:
    - upgrade cortex
    - check for updates
    - update to latest version
    - rollback upgrade
  review:
    name: Review
    description: Code Review CLI
    deployment_tier: dual_context
    execution_method: cli_wrapper
    cli_script: scripts/cli_wrappers/review_wrapper.py
    natural_language:
