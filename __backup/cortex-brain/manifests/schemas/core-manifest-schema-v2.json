{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cortex.dev/schemas/core-manifest-v2.json",
  "title": "CORTEX Core Manifest Schema",
  "description": "JSON Schema for validating CORTEX Core Manifest (orchestrator registry)",
  "version": "2.0.0",
  "type": "object",
  "required": ["schema_version", "manifest_type", "orchestrators"],
  "additionalProperties": false,
  
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Schema version (e.g., 2.0)",
      "examples": ["2.0"]
    },
    
    "manifest_type": {
      "type": "string",
      "const": "core",
      "description": "Must be 'core' for CoreManifest"
    },
    
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update",
      "examples": ["2025-12-22T00:00:00Z"]
    },
    
    "metadata": {
      "type": "object",
      "description": "Manifest metadata and statistics"
    },
    
    "changelog": {
      "type": "array",
      "description": "Manifest change history",
      "items": {
        "type": "object",
        "properties": {
          "version": {"type": "string"},
          "date": {"type": "string"},
          "author": {"type": "string"},
          "changes": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    
    "defaults": {
      "type": "object",
      "description": "Global defaults inherited by all orchestrators",
      "properties": {
        "schema_version": {
          "type": "string",
          "description": "Default schema version for orchestrators"
        },
        "deployment_tier": {
          "type": "string",
          "enum": ["cortex", "user", "admin", "dual_context"],
          "description": "Default deployment tier"
        },
        "maintainer": {
          "type": "string",
          "description": "Default maintainer team/person"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "active", "deprecated", "archived"],
          "description": "Default orchestrator status"
        },
        "logging": {
          "type": "object",
          "description": "Default logging configuration"
        }
      }
    },
    
    "orchestrators": {
      "type": "object",
      "description": "Registry of all orchestrators",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z_0-9]+$": {
          "type": "object",
          "required": ["version", "status", "category", "description", "source_file"],
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
              "description": "Semantic version (x.y.z)",
              "examples": ["4.0.1"]
            },
            
            "status": {
              "type": "string",
              "enum": ["draft", "active", "deprecated", "archived"],
              "description": "Current status of orchestrator"
            },
            
            "category": {
              "type": "string",
              "enum": ["planning", "tdd", "execution", "analysis", "deployment", "maintenance"],
              "description": "Orchestrator category"
            },
            
            "description": {
              "type": "string",
              "minLength": 50,
              "maxLength": 500,
              "description": "One-line purpose statement (minimum 50 characters)"
            },
            
            "source_file": {
              "type": "string",
              "pattern": "^src/.*\\.py$",
              "description": "Path to orchestrator implementation",
              "examples": ["src/orchestrators/planning_orchestrator.py"]
            },
            
            "entry_point": {
              "type": "string",
              "description": "Class name of orchestrator (PascalCase)",
              "pattern": "^[A-Z][a-zA-Z0-9]+$",
              "examples": ["PlanningOrchestrator"]
            },
            
            "documentation_path": {
              "type": "string",
              "description": "Path to detailed guide",
              "examples": [".github/prompts/modules/planning-system-guide.md"]
            },
            
            "changelog_path": {
              "type": "string",
              "description": "Path to version history",
              "examples": ["docs/orchestration/planning-system-changelog.md"]
            },
            
            "inherits_from": {
              "type": ["string", "null"],
              "description": "Parent orchestrator ID for inheritance",
              "examples": ["planning_orchestrator", null]
            },
            
            "parent_orchestrator": {
              "type": ["string", "null"],
              "description": "Parent orchestrator in hierarchy"
            },
            
            "child_orchestrators": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z_0-9]+$"
              },
              "uniqueItems": true,
              "description": "List of child orchestrators"
            },
            
            "related_orchestrators": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z_0-9]+$"
              },
              "uniqueItems": true,
              "description": "List of related orchestrators"
            },
            
            "config_overrides": {
              "type": "object",
              "description": "Configuration overrides from ConfigManifest",
              "required": ["namespace", "sections"],
              "properties": {
                "namespace": {
                  "type": "string",
                  "pattern": "^config://.*$",
                  "description": "ConfigManifest namespace reference",
                  "examples": ["config://planning"]
                },
                "sections": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "Dot-notation path to config section",
                    "examples": ["refactoring.planning", "token_optimization.planning"]
                  },
                  "minItems": 1
                }
              }
            },
            
            "integrations": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^integration://.*$",
                "description": "IntegrationManifest reference",
                "examples": ["integration://github", "integration://azure_devops"]
              },
              "uniqueItems": true
            },
            
            "deployment_tier": {
              "type": "string",
              "enum": ["cortex", "user", "admin", "dual_context"],
              "description": "Deployment tier (overrides default)"
            },
            
            "enabled": {
              "type": "boolean",
              "description": "Whether orchestrator is enabled",
              "default": true
            },
            
            "auto_start": {
              "type": "boolean",
              "description": "Whether to auto-start on system init",
              "default": false
            },
            
            "quality_gates": {
              "type": "object",
              "description": "Quality gate thresholds",
              "properties": {
                "min_test_coverage": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Minimum test coverage percentage"
                },
                "max_complexity": {
                  "type": "number",
                  "minimum": 1,
                  "description": "Maximum cyclomatic complexity"
                },
                "required_reviews": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Required code reviews"
                },
                "must_pass_linting": {
                  "type": "boolean",
                  "description": "Whether linting must pass"
                }
              }
            },
            
            "created_date": {
              "type": "string",
              "format": "date",
              "description": "Creation date (YYYY-MM-DD)",
              "examples": ["2024-01-15"]
            },
            
            "last_updated": {
              "type": "string",
              "format": "date",
              "description": "Last update date (YYYY-MM-DD)",
              "examples": ["2025-12-20"]
            },
            
            "deprecated_versions": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "uniqueItems": true,
              "description": "List of deprecated versions"
            }
          }
        }
      }
    },
    
    "categories": {
      "type": "object",
      "description": "Taxonomy of orchestrator categories",
      "patternProperties": {
        "^[a-z_0-9]+$": {
          "type": "object",
          "required": ["description", "orchestrators"],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 10
            },
            "orchestrators": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z_0-9]+$"
              }
            }
          }
        }
      }
    },
    
    "deprecated": {
      "type": "object",
      "description": "Deprecated orchestrators and manifests",
      "properties": {
        "orchestrators": {
          "type": "object",
          "patternProperties": {
            "^[a-z_0-9]+$": {
              "type": "object",
              "required": ["deprecated_date", "replacement"],
              "properties": {
                "deprecated_date": {
                  "type": "string",
                  "format": "date"
                },
                "replacement": {
                  "type": "string"
                },
                "removal_date": {
                  "type": "string",
                  "format": "date"
                },
                "migration_guide": {
                  "type": "string"
                }
              }
            }
          }
        },
        "manifests": {
          "type": "object",
          "patternProperties": {
            "^.*\\.yaml$": {
              "type": "object",
              "required": ["deprecated_date", "replacement"],
              "properties": {
                "deprecated_date": {
                  "type": "string",
                  "format": "date"
                },
                "replacement": {
                  "type": "string"
                },
                "removal_date": {
                  "type": "string",
                  "format": "date"
                },
                "backward_compatible": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    
    "validation": {
      "type": "object",
      "description": "Validation rules for the manifest",
      "properties": {
        "required_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_statuses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version_format": {
          "type": "string",
          "enum": ["semantic", "date", "custom"]
        }
      }
    }
  }
}
