{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/asifhussain60/CORTEX/schemas/core-manifest.json",
  "title": "CORTEX Core Manifest Schema",
  "description": "JSON Schema for validating CORTEX CoreManifest YAML files containing orchestrator registry, metadata, and relationships",
  "version": "2.0.0",
  "type": "object",
  "required": ["schema_version", "manifest_type", "last_updated", "defaults", "orchestrators"],
  
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Schema version (e.g., '2.0')"
    },
    
    "manifest_type": {
      "type": "string",
      "const": "core",
      "description": "Must be 'core' for CoreManifest"
    },
    
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    
    "defaults": {
      "type": "object",
      "description": "Global defaults inherited by all orchestrators",
      "required": ["schema_version", "deployment_tier", "maintainer", "status"],
      "properties": {
        "schema_version": {"type": "string"},
        "deployment_tier": {
          "type": "string",
          "enum": ["cortex", "user", "admin", "dual_context"]
        },
        "maintainer": {"type": "string"},
        "status": {
          "type": "string",
          "enum": ["draft", "active", "deprecated", "archived"]
        },
        "logging": {
          "type": "object",
          "properties": {
            "level": {
              "type": "string",
              "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]
            },
            "format": {"type": "string"},
            "destinations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "enabled"],
                "properties": {
                  "type": {"type": "string"},
                  "enabled": {"type": "boolean"},
                  "path": {"type": "string"}
                }
              }
            }
          }
        },
        "error_handling": {
          "type": "object",
          "properties": {
            "strategy": {
              "type": "string",
              "enum": ["fail_fast", "continue_on_error", "graceful_degradation"]
            },
            "retry_enabled": {"type": "boolean"},
            "max_retries": {"type": "integer", "minimum": 0},
            "rollback_enabled": {"type": "boolean"}
          }
        },
        "quality_gates": {
          "type": "object",
          "properties": {
            "min_test_coverage": {"type": "integer", "minimum": 0, "maximum": 100},
            "max_complexity": {"type": "integer", "minimum": 1},
            "required_reviews": {"type": "integer", "minimum": 0},
            "must_pass_linting": {"type": "boolean"}
          }
        }
      }
    },
    
    "orchestrators": {
      "type": "object",
      "description": "Registry of all CORTEX orchestrators",
      "additionalProperties": {
        "type": "object",
        "required": ["version", "status", "category", "description", "source_file", "entry_point"],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "Semantic version (e.g., '4.0.1')"
          },
          "status": {
            "type": "string",
            "enum": ["draft", "active", "deprecated", "archived"]
          },
          "category": {
            "type": "string",
            "enum": ["planning", "tdd", "execution", "analysis", "maintenance", "deployment", "documentation", "refactoring", "quality"]
          },
          "description": {
            "type": "string",
            "minLength": 50,
            "description": "Detailed orchestrator description (min 50 chars)"
          },
          "source_file": {
            "type": "string",
            "pattern": "^src/orchestrators/.+\\.py$",
            "description": "Relative path to Python source file"
          },
          "entry_point": {
            "type": "string",
            "pattern": "^[A-Z][a-zA-Z0-9]+$",
            "description": "Python class name (PascalCase)"
          },
          "documentation_path": {
            "type": "string",
            "description": "Path to orchestrator documentation"
          },
          "changelog_path": {
            "type": "string",
            "description": "Path to orchestrator changelog"
          },
          "inherits_from": {
            "oneOf": [
              {"type": "string"},
              {"type": "null"}
            ],
            "description": "Orchestrator ID this inherits from"
          },
          "parent_orchestrator": {
            "oneOf": [
              {"type": "string"},
              {"type": "null"}
            ],
            "description": "Parent orchestrator ID"
          },
          "child_orchestrators": {
            "type": "array",
            "items": {"type": "string"},
            "description": "List of child orchestrator IDs"
          },
          "related_orchestrators": {
            "type": "array",
            "items": {"type": "string"},
            "description": "List of related orchestrator IDs"
          },
          "config_overrides": {
            "type": "object",
            "required": ["namespace", "sections"],
            "properties": {
              "namespace": {
                "type": "string",
                "pattern": "^config://.+$",
                "description": "Config namespace (e.g., 'config://planning')"
              },
              "sections": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z_]+\\.[a-z_]+$"
                },
                "description": "Config section paths (e.g., 'refactoring.planning')"
              }
            }
          },
          "integrations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^integration://.+$"
            },
            "description": "Integration references (e.g., 'integration://github')"
          },
          "deployment_tier": {
            "type": "string",
            "enum": ["cortex", "user", "admin", "dual_context"]
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether orchestrator is enabled"
          },
          "auto_start": {
            "type": "boolean",
            "description": "Whether orchestrator starts automatically"
          },
          "quality_gates": {
            "type": "object",
            "properties": {
              "min_test_coverage": {"type": "integer", "minimum": 0, "maximum": 100},
              "max_complexity": {"type": "integer", "minimum": 1},
              "required_reviews": {"type": "integer", "minimum": 0},
              "must_pass_linting": {"type": "boolean"}
            }
          },
          "created_date": {
            "type": "string",
            "format": "date",
            "description": "Creation date (YYYY-MM-DD)"
          },
          "last_updated": {
            "type": "string",
            "format": "date",
            "description": "Last update date (YYYY-MM-DD)"
          },
          "deprecated_versions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "description": "List of deprecated versions"
          }
        }
      },
      "minProperties": 1
    },
    
    "categories": {
      "type": "object",
      "description": "Orchestrator taxonomy and categorization",
      "additionalProperties": {
        "type": "object",
        "required": ["description", "orchestrators", "characteristics"],
        "properties": {
          "description": {"type": "string"},
          "orchestrators": {
            "type": "array",
            "items": {"type": "string"}
          },
          "characteristics": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    
    "deprecated": {
      "type": "object",
      "description": "Deprecation and migration tracking",
      "properties": {
        "orchestrators": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["deprecated_date", "replacement", "removal_date", "reason"],
            "properties": {
              "deprecated_date": {"type": "string", "format": "date"},
              "replacement": {"type": "string"},
              "removal_date": {"type": "string", "format": "date"},
              "migration_guide": {"type": "string"},
              "reason": {"type": "string"}
            }
          }
        },
        "manifests": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["deprecated_date", "replacement", "removal_date", "reason"],
            "properties": {
              "deprecated_date": {"type": "string", "format": "date"},
              "replacement": {"type": "string"},
              "removal_date": {"type": "string", "format": "date"},
              "backward_compatible": {"type": "boolean"},
              "reason": {"type": "string"}
            }
          }
        }
      }
    },
    
    "validation": {
      "type": "object",
      "description": "Validation rules for manifest integrity",
      "properties": {
        "required_fields": {
          "type": "array",
          "items": {"type": "string"}
        },
        "allowed_statuses": {
          "type": "array",
          "items": {"type": "string"}
        },
        "allowed_categories": {
          "type": "array",
          "items": {"type": "string"}
        },
        "version_format": {"type": "string"},
        "naming_conventions": {
          "type": "object",
          "properties": {
            "orchestrator_id": {"type": "string"},
            "version": {"type": "string"},
            "description_min_length": {"type": "integer"}
          }
        },
        "cross_reference_patterns": {
          "type": "object",
          "properties": {
            "config_namespace": {"type": "string"},
            "integration_reference": {"type": "string"}
          }
        }
      }
    },
    
    "metadata": {
      "type": "object",
      "description": "Manifest metadata and statistics",
      "required": ["total_orchestrators", "active_orchestrators"],
      "properties": {
        "total_orchestrators": {"type": "integer", "minimum": 0},
        "active_orchestrators": {"type": "integer", "minimum": 0},
        "deprecated_orchestrators": {"type": "integer", "minimum": 0},
        "categories_count": {"type": "integer", "minimum": 0},
        "coverage": {
          "type": "object",
          "additionalProperties": {"type": "integer"}
        },
        "statistics": {
          "type": "object",
          "properties": {
            "avg_test_coverage": {"type": "number"},
            "avg_complexity": {"type": "number"},
            "total_lines_consolidated": {"type": "integer"},
            "reduction_percentage": {"type": "number"}
          }
        }
      }
    },
    
    "changelog": {
      "type": "array",
      "description": "Manifest version history",
      "items": {
        "type": "object",
        "required": ["version", "date", "changes", "author"],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "date": {"type": "string", "format": "date"},
          "changes": {
            "type": "array",
            "items": {"type": "string"}
          },
          "author": {"type": "string"}
        }
      }
    }
  }
}
