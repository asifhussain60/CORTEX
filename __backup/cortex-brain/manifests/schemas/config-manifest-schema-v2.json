{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cortex.dev/schemas/config-manifest-v2.json",
  "title": "CORTEX Config Manifest Schema",
  "description": "JSON Schema for validating CORTEX Config Manifest (runtime configuration)",
  "version": "2.0.0",
  "type": "object",
  "required": ["schema_version", "manifest_type", "categories"],
  "additionalProperties": false,
  
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Schema version (e.g., 2.0)"
    },
    
    "manifest_type": {
      "type": "string",
      "const": "config",
      "description": "Must be 'config' for ConfigManifest"
    },
    
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    
    "metadata": {
      "type": "object",
      "description": "Manifest metadata and statistics"
    },
    
    "changelog": {
      "type": "array",
      "description": "Manifest change history",
      "items": {
        "type": "object",
        "properties": {
          "version": {"type": "string"},
          "date": {"type": "string"},
          "author": {"type": "string"},
          "changes": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    
    "ado": {
      "type": "object",
      "description": "Azure DevOps configuration"
    },
    
    "sanitization": {
      "type": "object",
      "description": "Code sanitization configuration"
    },
    
    "global": {
      "type": "object",
      "description": "Global configuration settings",
      "properties": {
        "timezone": {
          "type": "string",
          "description": "Default timezone",
          "examples": ["UTC", "America/New_York"]
        },
        "date_format": {
          "type": "string",
          "description": "Date format standard",
          "examples": ["ISO8601", "RFC3339"]
        },
        "encoding": {
          "type": "string",
          "description": "Default character encoding",
          "examples": ["utf-8", "ascii"]
        },
        "timeouts": {
          "type": "object",
          "properties": {
            "default_operation": {
              "type": "number",
              "minimum": 1,
              "description": "Default operation timeout in seconds"
            },
            "long_operation": {
              "type": "number",
              "minimum": 1,
              "description": "Long operation timeout in seconds"
            },
            "network_request": {
              "type": "number",
              "minimum": 1,
              "description": "Network request timeout in seconds"
            }
          }
        },
        "performance": {
          "type": "object",
          "properties": {
            "max_parallel_operations": {
              "type": "number",
              "minimum": 1,
              "description": "Maximum concurrent operations"
            },
            "cache_ttl": {
              "type": "number",
              "minimum": 0,
              "description": "Cache time-to-live in seconds"
            },
            "enable_profiling": {
              "type": "boolean",
              "description": "Enable performance profiling"
            }
          }
        }
      }
    },
    
    "categories": {
      "type": "object",
      "description": "Category-based configuration rules",
      "required": ["cleanup", "refactoring", "testing"],
      "properties": {
        "cleanup": {
          "type": "object",
          "description": "Cleanup rules and configuration"
        },
        "refactoring": {
          "type": "object",
          "description": "Refactoring rules and thresholds"
        },
        "token_optimization": {
          "type": "object",
          "description": "Token optimization strategies"
        },
        "documentation": {
          "type": "object",
          "description": "Documentation generation rules"
        },
        "git": {
          "type": "object",
          "description": "Git checkpoint configuration"
        },
        "testing": {
          "type": "object",
          "description": "Testing framework configuration"
        }
      }
    },
    
    "orchestrator_overrides": {
      "type": "object",
      "description": "Orchestrator-specific configuration overrides",
      "patternProperties": {
        "^[a-z_]+$": {
          "type": "object",
          "description": "Override configuration for specific orchestrator",
          "properties": {
            "refactoring": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "enforcement_level": {
                  "type": "string",
                  "enum": ["strict", "warning", "disabled"]
                }
              }
            },
            "token_optimization": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "target_reduction": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            },
            "testing": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "coverage": {
                  "type": "object",
                  "properties": {
                    "min_coverage": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  }
                }
              }
            },
            "documentation": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "generation": {
                  "type": "object",
                  "properties": {
                    "format": {
                      "type": "string"
                    },
                    "include_diagrams": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    
    "feature_flags": {
      "type": "object",
      "description": "Feature flags for experimental features",
      "patternProperties": {
        "^enable_.*$": {
          "type": "boolean",
          "description": "Feature flag (must start with 'enable_')"
        }
      }
    },
    
    "validation": {
      "type": "object",
      "description": "Validation rules for the manifest",
      "properties": {
        "required_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_enforcement_levels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["strict", "warning", "disabled"]
          }
        }
      }
    }
  }
}
