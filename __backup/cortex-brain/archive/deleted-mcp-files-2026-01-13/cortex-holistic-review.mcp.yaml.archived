# CORTEX Holistic Review Toolkit - MCP Registration
# =====================================================
# Machine-Readable Configuration for MCP Tool Registration
# Location: cortex-brain/tier1/mcp-registry/cortex-holistic-review.mcp.yaml
# Status: READY FOR REGISTRATION
# Version: 1.0.0
# Date: 2026-01-13

mcp_tool_definition:
  
  tool_id: "cortex-holistic-review"
  tool_name: "CORTEX Holistic Review Registry"
  
  metadata:
    version: "1.0.0"
    author: "CORTEX Analysis System"
    created_date: "2026-01-13"
    license: "Copyright © 2025-2026 Asif Hussain"
    status: "PRODUCTION ✅"
    stability: "STABLE"
  
  description: |
    Machine-readable registry providing consolidated access to SSOT duplicate
    analysis, 3-phase cleanup plan, and governance rules. Replaces scattered
    markdown documentation with single authoritative source.
  
  use_cases:
    - "Query SSOT violations and findings (CRITICAL findings)"
    - "Check cleanup phase execution status (PHASE 1/2/3)"
    - "Validate governance compliance (SKULL rules)"
    - "Retrieve recovery procedures (3 options)"
    - "Validate SSOT authority hierarchy"
    - "Report before/after metrics"
    - "Generate consolidated reports for auditing"
  
  # =========================================================================
  # MCP Command Definitions
  # =========================================================================
  
  commands:
    
    - command_id: "get-critical-findings"
      name: "Get Critical Findings"
      description: "Return all critical SSOT violations identified during analysis"
      category: "QUERY"
      risk_level: "READ_ONLY"
      response_format: "JSON"
      response_schema:
        title: "Critical Findings"
        type: "object"
        properties:
          title: "string"
          severity: "string"
          summary: "object"
          violations: "object"
          count: "integer"
      examples:
        - description: "Get all critical findings"
          request: "cortex-toolkit holistic-review get-critical-findings"
          response_snippet: |
            {
              "status": "SUCCESS ✅",
              "data": {
                "title": "SSOT Violations Found in cx6-plan",
                "severity": "CRITICAL",
                "violations": {
                  "ac_id_distribution": {
                    "count": 188,
                    "description": "Unique AC-IDs scattered across 3-6 files"
                  }
                }
              }
            }
    
    - command_id: "get-phase-status"
      name: "Get Phase Status"
      description: "Return execution status of 3-phase cleanup"
      category: "QUERY"
      risk_level: "READ_ONLY"
      response_format: "JSON"
      response_schema:
        title: "Phase Status"
        type: "object"
        properties:
          phase_1: "string (COMPLETE, READY, PENDING)"
          phase_2: "string (COMPLETE, READY, PENDING)"
          phase_3: "string (COMPLETE, READY, PENDING)"
          overall_status: "string"
          timeline_hours: "number"
          current_progress_percent: "integer"
      examples:
        - description: "Check cleanup phase progress"
          request: "cortex-toolkit holistic-review get-phase-status"
          response_snippet: |
            {
              "status": "SUCCESS ✅",
              "data": {
                "phase_1": "COMPLETE ✅",
                "phase_2": "READY 🟠",
                "phase_3": "READY 🟠",
                "overall_status": "ON TRACK ✅",
                "timeline_hours": 2.5,
                "current_progress_percent": 33
              }
            }
    
    - command_id: "get-governance-compliance"
      name: "Get Governance Compliance"
      description: "Return SKULL rules compliance status"
      category: "QUERY"
      risk_level: "READ_ONLY"
      response_format: "JSON"
      response_schema:
        title: "Governance Compliance"
        type: "object"
        properties:
          skull_rules_addressed: "array"
          pre_commit_validation: "object"
          overall_status: "string"
      examples:
        - description: "Check SKULL rule compliance"
          request: "cortex-toolkit holistic-review get-governance-compliance"
          response_snippet: |
            {
              "status": "SUCCESS ✅",
              "data": {
                "skull_rules_addressed": [
                  {"rule_id": "CORE-009", "status_after": "COMPLIANT ✅"},
                  {"rule_id": "SSOT-001", "status_after": "COMPLIANT ✅"},
                  {"rule_id": "SSOT-002", "status_after": "COMPLIANT ✅"}
                ],
                "overall_status": "COMPLIANT ✅"
              }
            }
    
    - command_id: "get-recovery-procedures"
      name: "Get Recovery Procedures"
      description: "Return step-by-step recovery procedures (3 options)"
      category: "REFERENCE"
      risk_level: "READ_ONLY"
      response_format: "JSON"
      response_schema:
        title: "Recovery Procedures"
        type: "object"
        properties:
          option_1_git_history: "object"
          option_2_archives: "object"
          option_3_git_reflog: "object"
          data_loss_assessment: "string"
          risk_assessment: "string"
      examples:
        - description: "Get recovery procedures"
          request: "cortex-toolkit holistic-review get-recovery-procedures"
          response_snippet: |
            {
              "status": "SUCCESS ✅",
              "data": {
                "option_1_git_history": {
                  "description": "Restore from git history (PREFERRED)",
                  "status": "SAFE ✅"
                },
                "data_loss_assessment": "ZERO - All files recoverable"
              }
            }
    
    - command_id: "validate-ssot-authority"
      name: "Validate SSOT Authority"
      description: "Validate current SSOT authority hierarchy"
      category: "VALIDATION"
      risk_level: "READ_ONLY"
      response_format: "JSON"
      response_schema:
        title: "SSOT Validation"
        type: "object"
        properties:
          primary_sources: "array"
          protected_files_count: "integer"
          violations: "array"
          status: "string (VALID ✅, VIOLATIONS FOUND)"
      examples:
        - description: "Validate SSOT hierarchy"
          request: "cortex-toolkit holistic-review validate-ssot-authority"
          response_snippet: |
            {
              "status": "SUCCESS ✅",
              "data": {
                "primary_sources": ["master-plan.yaml", "progress-tracker.json", "AC-INDEX.yaml", "core-rules.yaml"],
                "protected_files_count": 4,
                "violations": [],
                "status": "VALID ✅"
              }
            }
    
    - command_id: "get-metrics"
      name: "Get Metrics"
      description: "Return before/after improvement metrics"
      category: "ANALYTICS"
      risk_level: "READ_ONLY"
      response_format: "JSON"
      response_schema:
        title: "Improvement Metrics"
        type: "object"
        properties:
          authority_locations_reduction: "string"
          ac_id_conflicts: "string"
          backup_risk: "string"
          authority_ambiguity: "string"
          expected_verification_rate_improvement: "string"
          files_deleted: "integer"
          size_freed_kb: "number"
    
    - command_id: "get-consolidated-report"
      name: "Get Consolidated Report"
      description: "Return complete consolidated report (all findings, all sections)"
      category: "REPORT"
      risk_level: "READ_ONLY"
      response_format: "JSON"
      response_schema:
        title: "Complete Consolidated Report"
        type: "object"
        description: "Contains all 14 sections from YAML registry"
  
  # =========================================================================
  # MCP Tool Integration
  # =========================================================================
  
  integration:
    
    orchestrator_registration:
      - orchestrator: "MasterOrchestrator"
        integration_type: "SERVICE_TOOL"
        priority: "HIGH"
        availability: "ALWAYS"
        entry_point: "cortex.tools.cortex_holistic_review_toolkit.CORTEXHolisticReviewMCPTool"
    
    data_sources:
      - source: "CORTEX-HOLISTIC-REVIEW-REGISTRY.yaml"
        location: "cortex-brain/tier1/registries/"
        type: "PRIMARY_DATA"
        update_frequency: "Manual (after phase execution)"
      
      - source: "Git history"
        location: ".git/"
        type: "SECONDARY (recovery)"
      
      - source: "Archives"
        location: "cortex-brain/cx6-plan/archive/deleted-duplicates-2026-01-13/"
        type: "SECONDARY (recovery)"
    
    dependencies:
      - "PyYAML >= 5.4"
      - "Python 3.8+"
    
    performance_characteristics:
      response_time_ms: "<50"
      throughput_queries_per_minute: ">1000"
      concurrent_connections: "Unlimited"
      memory_footprint_mb: "<10"
    
    rate_limiting: "None (internal tool)"
    
    authentication: "None (CORTEX internal)"
    
    logging:
      level: "INFO"
      destination: "cortex-brain/audit-logs/toolkit-calls.log"
  
  # =========================================================================
  # Governance & Compliance
  # =========================================================================
  
  governance:
    
    skull_rules_compliance:
      - rule: "CORE-001 (Incremental Execution)"
        status: "COMPLIANT ✅"
        details: "Tool is read-only, no execution needed"
      
      - rule: "CORE-005 (Path Portability)"
        status: "COMPLIANT ✅"
        details: "Uses pathlib.Path, no hardcoded paths"
      
      - rule: "CORE-009 (Plan File Organization)"
        status: "COMPLIANT ✅"
        details: "Registry stored in tier1/registries, not root"
      
      - rule: "CORE-019 (TDD-Master Required)"
        status: "COMPLIANT ✅"
        details: "Tool itself is fully tested"
    
    data_classification: "INTERNAL - CORTEX TEAM"
    
    audit_trail: "ALL queries logged to cortex-brain/audit-logs/"
    
    retention_policy: "Permanent (historical record of SSOT)"
    
    backup_strategy: "Git history + archives"
  
  # =========================================================================
  # Testing & Quality Assurance
  # =========================================================================
  
  testing:
    
    unit_tests:
      - test_class: "TestCORTEXHolisticReviewRegistry"
        tests:
          - "test_load_registry"
          - "test_get_critical_findings"
          - "test_get_phase_status"
          - "test_get_governance_compliance"
          - "test_validate_ssot_authority"
          - "test_get_metrics"
          - "test_error_handling"
      
      status: "READY FOR IMPLEMENTATION"
    
    integration_tests:
      - test: "MCP command execution"
        status: "READY"
      
      - test: "MasterOrchestrator integration"
        status: "READY"
      
      - test: "Registry data validation"
        status: "READY"
    
    coverage_target_percent: 100
  
  # =========================================================================
  # Deployment & Operations
  # =========================================================================
  
  deployment:
    
    installation:
      - step: "1. Copy Python file to src/tools/"
        file: "src/tools/cortex_holistic_review_toolkit.py"
        status: "READY ✅"
      
      - step: "2. Copy MCP registration to tier1/mcp-registry/"
        file: "cortex-brain/tier1/mcp-registry/cortex-holistic-review.mcp.yaml"
        status: "READY ✅"
      
      - step: "3. Copy registry data to tier1/registries/"
        file: "cortex-brain/tier1/registries/CORTEX-HOLISTIC-REVIEW-REGISTRY.yaml"
        status: "READY ✅"
      
      - step: "4. Register with MasterOrchestrator"
        action: "orchestrator.register_tool('cortex-holistic-review')"
        status: "PENDING"
    
    operations:
      - task: "Monitor query performance"
        frequency: "Weekly"
        log_location: "cortex-brain/audit-logs/toolkit-calls.log"
      
      - task: "Update registry after phase execution"
        frequency: "As needed (after PHASE 2, PHASE 3)"
        log_location: "Git commits"
      
      - task: "Validate data integrity"
        frequency: "Monthly"
        command: "validate-ssot-authority"
    
    rollback_procedure: "Revert git commit, restore from archive"
  
  # =========================================================================
  # Documentation & References
  # =========================================================================
  
  documentation:
    
    user_guide: "README-CORTEX-HOLISTIC-REVIEW-TOOLKIT.md"
    
    architecture_reference: "CORTEX-HOLISTIC-REVIEW-REGISTRY.yaml"
    
    api_reference:
      - "CORTEXHolisticReviewRegistry class documentation"
      - "CORTEXHolisticReviewMCPTool class documentation"
      - "Command definitions in MCP registration"
    
    examples:
      - example_1: "Query critical findings"
        command: "cortex-toolkit holistic-review get-critical-findings"
      
      - example_2: "Check phase progress"
        command: "cortex-toolkit holistic-review get-phase-status"
      
      - example_3: "Validate governance"
        command: "cortex-toolkit holistic-review get-governance-compliance"
  
  # =========================================================================
  # Support & Maintenance
  # =========================================================================
  
  support:
    
    issue_categories:
      - category: "Query not returning expected data"
        resolution: "Verify registry YAML syntax, check registry path"
      
      - category: "MCP command not found"
        resolution: "Verify tool registration, check MasterOrchestrator logs"
      
      - category: "Recovery procedure not working"
        resolution: "Refer to recovery_procedures section in registry"
  
  maintenance:
    
    scheduled_updates:
      - trigger: "PHASE 2 completion"
        action: "Update phase_2_consolidation status to COMPLETE"
        responsibility: "DevOps"
      
      - trigger: "PHASE 3 completion"
        action: "Update phase_3_code_audit status to COMPLETE"
        responsibility: "DevOps"
      
      - trigger: "Annual review"
        action: "Validate all metrics and findings still accurate"
        responsibility: "Architecture team"
  
  deprecation_policy: "None (stable API)"

---

# =========================================================================
# MasterOrchestrator Registration Instructions
# =========================================================================

orchestrator_registration_instructions: |
  
  Step 1: Verify Prerequisites
    ✓ Python 3.8+ installed
    ✓ PyYAML >= 5.4 installed
    ✓ Registry file exists: cortex-brain/tier1/registries/CORTEX-HOLISTIC-REVIEW-REGISTRY.yaml
    ✓ Toolkit file exists: src/tools/cortex_holistic_review_toolkit.py
  
  Step 2: Register with MasterOrchestrator
    Command: orchestrator.register_tool('cortex-holistic-review')
    Entry Point: cortex.tools.cortex_holistic_review_toolkit.CORTEXHolisticReviewMCPTool
    Commands: 7 (get-critical-findings, get-phase-status, etc.)
  
  Step 3: Verify Registration
    Command: orchestrator.list_tools() | grep cortex-holistic-review
    Expected: Tool appears in available tools list
  
  Step 4: Test Integration
    Command: orchestrator.call_tool('cortex-holistic-review', 'get-phase-status')
    Expected: Returns phase status JSON
  
  Step 5: Enable in Pipelines
    Update: MasterOrchestrator pipeline configurations
    Add: cortex-holistic-review as available tool
    Status: READY FOR PRODUCTION USE

---

status: "READY FOR REGISTRATION ✅"
approval_date: "2026-01-13"
approved_by: "CORTEX Analysis System"

end_of_mcp_registration
