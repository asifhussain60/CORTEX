{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Master Orchestrator Routing Schema",
  "description": "Schema for cortex-brain/config/master-orchestrator.yaml - Defines routing rules",
  "type": "object",
  "required": ["schema_version", "routing_rules"],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version for compatibility checking",
      "pattern": "^\\d+\\.\\d+$",
      "examples": ["5.0"]
    },
    "routing_rules": {
      "type": "array",
      "description": "Ordered list of routing rules (evaluated top-to-bottom)",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pattern", "orchestrator", "confidence", "match_type", "priority"],
        "properties": {
          "pattern": {
            "type": "string",
            "description": "Regex pattern for matching user input",
            "minLength": 3,
            "examples": [
              "^(vacuum|deep clean|organize files).*$",
              "^(plan|create a plan|make a plan)\\s*.*$"
            ]
          },
          "orchestrator": {
            "type": "string",
            "description": "Orchestrator ID (must exist in mcp-server.yaml registry)",
            "pattern": "^[a-z][a-z0-9_]*$",
            "examples": ["vacuum", "planning_v5", "ado_orchestrator_v2"]
          },
          "confidence": {
            "type": "number",
            "description": "Match confidence score (0.0 to 1.0)",
            "minimum": 0.0,
            "maximum": 1.0,
            "examples": [1.0, 0.95]
          },
          "match_type": {
            "type": "string",
            "description": "Type of pattern matching",
            "enum": ["regex", "exact", "fuzzy", "llm"],
            "examples": ["regex"]
          },
          "priority": {
            "type": "integer",
            "description": "Rule evaluation priority (lower = higher priority)",
            "minimum": 1,
            "maximum": 999,
            "examples": [10, 56, 100]
          },
          "path_extraction": {
            "type": "object",
            "description": "Optional path extraction from user input",
            "required": ["pattern", "group"],
            "properties": {
              "pattern": {
                "type": "string",
                "description": "Regex pattern with capture group",
                "examples": ["^(vacuum|deep clean)\\s+([^\\s]+).*$"]
              },
              "group": {
                "type": "integer",
                "description": "Capture group index (1-based)",
                "minimum": 1,
                "examples": [2]
              },
              "default": {
                "type": "string",
                "description": "Default value if extraction fails",
                "examples": ["."]
              }
            },
            "additionalProperties": false
          },
          "mode_extraction": {
            "type": "object",
            "description": "Optional mode extraction from user input (for multi-mode orchestrators)",
            "required": ["pattern"],
            "properties": {
              "pattern": {
                "type": "string",
                "description": "Regex pattern with capture group for mode",
                "examples": ["^cleanup\\s+(cache|logs|artifacts|full|git).*$"]
              },
              "group": {
                "type": "integer",
                "description": "Capture group index (1-based)",
                "minimum": 1,
                "examples": [1]
              },
              "default": {
                "type": "string",
                "description": "Default mode if extraction fails",
                "examples": ["full"]
              }
            },
            "additionalProperties": false
          },
          "metadata": {
            "type": "object",
            "description": "Additional metadata for orchestrator",
            "properties": {
              "description": {
                "type": "string",
                "examples": ["Vacuum v2 autonomous filesystem cleanup"]
              },
              "autonomous": {
                "type": "boolean",
                "examples": [true]
              },
              "mode": {
                "type": "string",
                "enum": ["auto", "wizard", "interactive"],
                "examples": ["wizard"]
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+$",
                "examples": ["2.0"]
              },
              "features": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "examples": [["10 cleanup categories", "Duplicate detection"]]
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true,
  
  "examples": [
    {
      "schema_version": "5.0",
      "routing_rules": [
        {
          "pattern": "^(vacuum|deep clean|organize files).*$",
          "orchestrator": "vacuum",
          "confidence": 1.0,
          "match_type": "regex",
          "priority": 56,
          "path_extraction": {
            "pattern": "^(vacuum|deep clean|organize files)\\s+([^\\s]+).*$",
            "group": 2,
            "default": "."
          },
          "metadata": {
            "description": "Vacuum v2 autonomous filesystem cleanup",
            "autonomous": true,
            "version": "2.0"
          }
        }
      ]
    }
  ]
}
