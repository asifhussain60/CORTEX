---
/**
 * Home Page
 * 
 * CORTEX Documentation landing page.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Search from '../components/Search.astro';
---

<BaseLayout 
  title="Home" 
  description="CORTEX Documentation - AI-Powered Development Assistant"
>
  <div class="max-w-4xl mx-auto">
    <!-- Hero Section -->
    <div class="text-center mb-16">
      <h1 class="text-5xl md:text-6xl font-bold mb-6 bg-gradient-to-r from-cortex-primary via-cortex-secondary to-cortex-accent bg-clip-text text-transparent">
        CORTEX Documentation
      </h1>
      <p class="text-xl text-gray-300 mb-8">
        AI-Powered Development Assistant for VS Code
      </p>
      <Search />
    </div>

    <!-- Quick Links -->
    <div class="grid md:grid-cols-3 gap-6 mb-16">
      <a 
        href="/cortex-docs/architecture" 
        class="glass p-6 rounded-lg hover:border-cortex-primary transition-all duration-200 hover:scale-105"
      >
        <div class="text-4xl mb-4">🏗️</div>
        <h3 class="text-xl font-semibold text-cortex-primary mb-2">Architecture</h3>
        <p class="text-gray-400">Understand CORTEX internal design and components</p>
      </a>

      <a 
        href="/cortex-docs/capabilities" 
        class="glass p-6 rounded-lg hover:border-cortex-secondary transition-all duration-200 hover:scale-105"
      >
        <div class="text-4xl mb-4">⚡</div>
        <h3 class="text-xl font-semibold text-cortex-secondary mb-2">Capabilities</h3>
        <p class="text-gray-400">Explore features and how to use them</p>
      </a>

      <a 
        href="/cortex-docs/guides" 
        class="glass p-6 rounded-lg hover:border-cortex-accent transition-all duration-200 hover:scale-105"
      >
        <div class="text-4xl mb-4">📚</div>
        <h3 class="text-xl font-semibold text-cortex-accent mb-2">Guides</h3>
        <p class="text-gray-400">Step-by-step tutorials and best practices</p>
      </a>
    </div>

    <!-- Role-Specific Content -->
    <div class="space-y-12">
      <!-- Business Leaders -->
      <div data-role-section="business,all" class="glass p-8 rounded-lg">
        <h2 class="text-2xl font-bold text-cortex-primary mb-4">💼 For Business Leaders</h2>
        <p class="text-gray-300 mb-4">
          Organizations benefit from understanding how CORTEX supports development workflows,
          quality assurance, and team productivity. The system has potential to streamline
          code review processes and provide early indicators of deployment risks.
        </p>
        <a href="/cortex-docs/business-guides" class="text-cortex-primary hover:underline">
          Read Business Guides →
        </a>
      </div>

      <!-- Product Owners -->
      <div data-role-section="product-owner,all" class="glass p-8 rounded-lg">
        <h2 class="text-2xl font-bold text-cortex-secondary mb-4">📊 For Product Owners</h2>
        <p class="text-gray-300 mb-4">
          Think of CORTEX like a quality control system in manufacturing. Just as inspectors
          catch defects before products ship, CORTEX analyzes code before deployment. Product
          teams use this capability to maintain velocity while ensuring reliability.
        </p>
        <a href="/cortex-docs/capabilities" class="text-cortex-secondary hover:underline">
          Explore Capabilities →
        </a>
      </div>

      <!-- Software Developers -->
      <div data-role-section="developer,all" class="glass p-8 rounded-lg">
        <h2 class="text-2xl font-bold text-cortex-accent mb-4">💻 For Software Developers</h2>
        <p class="text-gray-300 mb-4">
          CORTEX integrates with VS Code via the Model Context Protocol (MCP), providing
          orchestrated workflows for implementation, testing, refactoring, and analysis.
          The architecture follows event-driven patterns with governance enforcement at
          multiple layers.
        </p>
        <a href="/cortex-docs/architecture" class="text-cortex-accent hover:underline">
          View Architecture →
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
