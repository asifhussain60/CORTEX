---
/**
 * Diagram Renderer Component
 * 
 * Renders Mermaid or D3.js diagrams based on type.
 * Includes metadata display (purpose, audience).
 */

interface Props {
  diagramId: string;
  type: 'mermaid' | 'd3';
  code: string;
  metadata?: {
    title?: string;
    purpose?: string;
    audience?: string[];
  };
}

const { diagramId, type, code, metadata } = Astro.props;
---

<div class="diagram-container my-8">
  {metadata && (
    <div class="diagram-metadata mb-4 p-4 bg-cortex-dark/50 backdrop-blur-sm rounded-lg">
      {metadata.title && (
        <h3 class="text-xl font-semibold text-cortex-primary mb-2">
          {metadata.title}
        </h3>
      )}
      {metadata.purpose && (
        <p class="text-sm text-gray-300 mb-2">
          <span class="font-semibold">Purpose:</span> {metadata.purpose}
        </p>
      )}
      {metadata.audience && metadata.audience.length > 0 && (
        <p class="text-sm text-gray-400">
          <span class="font-semibold">Audience:</span> {metadata.audience.join(', ')}
        </p>
      )}
    </div>
  )}

  {type === 'mermaid' ? (
    <div 
      class="mermaid-diagram bg-white/5 backdrop-blur-sm p-6 rounded-lg overflow-x-auto"
      data-diagram-id={diagramId}
    >
      <pre class="mermaid">{code}</pre>
    </div>
  ) : (
    <div 
      id={`d3-${diagramId}`}
      class="d3-diagram bg-white/5 backdrop-blur-sm p-6 rounded-lg"
      data-diagram-code={code}
    ></div>
  )}
</div>

<script>
  // Mermaid initialization
  import mermaid from 'mermaid';
  
  mermaid.initialize({
    startOnLoad: true,
    theme: 'dark',
    themeVariables: {
      primaryColor: '#4CAF50',
      primaryTextColor: '#fff',
      primaryBorderColor: '#2196F3',
      lineColor: '#FF9800',
      secondaryColor: '#2196F3',
      tertiaryColor: '#FF9800',
    }
  });

  // D3 lazy loading for interactive diagrams
  document.addEventListener('DOMContentLoaded', () => {
    const d3Containers = document.querySelectorAll('.d3-diagram');
    
    if (d3Containers.length > 0) {
      import('d3').then((d3) => {
        d3Containers.forEach((container) => {
          const code = container.getAttribute('data-diagram-code');
          if (code) {
            try {
              const data = JSON.parse(code);
              renderD3Diagram(container, data, d3);
            } catch (e) {
              console.error('Failed to parse D3 diagram data:', e);
            }
          }
        });
      });
    }
  });

  function renderD3Diagram(container: Element, data: any, d3: any) {
    // Basic force-directed graph implementation
    const width = container.clientWidth;
    const height = 600;

    const svg = d3.select(container)
      .append('svg')
      .attr('width', width)
      .attr('height', height);

    // Render based on diagram type
    if (data.type === 'force-directed-graph') {
      renderForceDirectedGraph(svg, data, d3, width, height);
    }
  }

  function renderForceDirectedGraph(svg: any, data: any, d3: any, width: number, height: number) {
    const simulation = d3.forceSimulation(data.nodes)
      .force('link', d3.forceLink(data.links).id((d: any) => d.id))
      .force('charge', d3.forceManyBody().strength(-300))
      .force('center', d3.forceCenter(width / 2, height / 2));

    const link = svg.append('g')
      .selectAll('line')
      .data(data.links)
      .join('line')
      .attr('stroke', '#999')
      .attr('stroke-width', 2);

    const node = svg.append('g')
      .selectAll('circle')
      .data(data.nodes)
      .join('circle')
      .attr('r', 8)
      .attr('fill', '#4CAF50');

    const label = svg.append('g')
      .selectAll('text')
      .data(data.nodes)
      .join('text')
      .text((d: any) => d.label)
      .attr('font-size', 12)
      .attr('fill', '#fff');

    simulation.on('tick', () => {
      link
        .attr('x1', (d: any) => d.source.x)
        .attr('y1', (d: any) => d.source.y)
        .attr('x2', (d: any) => d.target.x)
        .attr('y2', (d: any) => d.target.y);

      node
        .attr('cx', (d: any) => d.x)
        .attr('cy', (d: any) => d.y);

      label
        .attr('x', (d: any) => d.x + 12)
        .attr('y', (d: any) => d.y + 4);
    });
  }
</script>

<style>
  .diagram-container {
    width: 100%;
  }

  .mermaid-diagram {
    border: 1px solid rgba(76, 175, 80, 0.2);
  }

  .d3-diagram {
    border: 1px solid rgba(33, 150, 243, 0.2);
  }

  .diagram-metadata {
    border-left: 4px solid #4CAF50;
  }
</style>
