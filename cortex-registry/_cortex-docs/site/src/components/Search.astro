---
/**
 * Search Component
 * 
 * Full-text search with role filtering.
 * Queries pre-built search index JSON.
 */
---

<div class="search-container mb-8">
  <div class="relative">
    <input
      type="search"
      id="search-input"
      placeholder="Search documentation..."
      class="w-full px-4 py-3 pl-12 bg-cortex-dark/50 backdrop-blur-sm border border-cortex-primary/30 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-cortex-primary focus:border-transparent"
      aria-label="Search documentation"
    />
    <svg 
      class="absolute left-4 top-3.5 w-5 h-5 text-gray-400"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
  </div>

  <div id="search-results" class="mt-4 hidden">
    <div class="bg-cortex-dark/80 backdrop-blur-md rounded-lg border border-cortex-primary/30 overflow-hidden">
      <div class="p-4 border-b border-cortex-primary/20">
        <p class="text-sm text-gray-300">
          <span id="result-count">0</span> results found
        </p>
      </div>
      <div id="results-list" class="max-h-96 overflow-y-auto">
        <!-- Results inserted here -->
      </div>
    </div>
  </div>
</div>

<script>
  let searchIndex: any[] = [];
  let currentRole = 'developer';

  async function loadSearchIndex() {
    try {
      const response = await fetch('/cortex-docs/data/search-index.json');
      searchIndex = await response.json();
    } catch (error) {
      console.error('Failed to load search index:', error);
    }
  }

  function initSearch() {
    const input = document.getElementById('search-input') as HTMLInputElement;
    const resultsContainer = document.getElementById('search-results');
    const resultsList = document.getElementById('results-list');
    const resultCount = document.getElementById('result-count');

    if (!input || !resultsContainer || !resultsList || !resultCount) return;

    // Debounced search
    let searchTimeout: number;
    input.addEventListener('input', (e) => {
      clearTimeout(searchTimeout);
      searchTimeout = window.setTimeout(() => {
        const query = (e.target as HTMLInputElement).value.trim();
        performSearch(query, resultsContainer, resultsList, resultCount);
      }, 300);
    });

    // Listen for role changes
    document.addEventListener('role-changed', (e: any) => {
      currentRole = e.detail.role;
      if (input.value.trim()) {
        performSearch(input.value.trim(), resultsContainer, resultsList, resultCount);
      }
    });

    // Load search index
    loadSearchIndex();
  }

  function performSearch(
    query: string,
    resultsContainer: HTMLElement,
    resultsList: HTMLElement,
    resultCount: HTMLElement
  ) {
    if (!query) {
      resultsContainer.classList.add('hidden');
      return;
    }

    const results = searchDocuments(query);
    displayResults(results, resultsContainer, resultsList, resultCount);
  }

  function searchDocuments(query: string): any[] {
    const lowerQuery = query.toLowerCase();
    const results: any[] = [];

    searchIndex.forEach((doc) => {
      // Filter by current role if doc has role restrictions
      if (doc.roles && !doc.roles.includes(currentRole) && !doc.roles.includes('all')) {
        return;
      }

      // Simple fuzzy matching
      const titleMatch = doc.title?.toLowerCase().includes(lowerQuery);
      const contentMatch = doc.content?.toLowerCase().includes(lowerQuery);

      if (titleMatch || contentMatch) {
        results.push({
          ...doc,
          relevance: titleMatch ? 2 : 1  // Title matches score higher
        });
      }
    });

    // Sort by relevance
    results.sort((a, b) => b.relevance - a.relevance);

    return results.slice(0, 20);  // Top 20 results
  }

  function displayResults(
    results: any[],
    resultsContainer: HTMLElement,
    resultsList: HTMLElement,
    resultCount: HTMLElement
  ) {
    if (results.length === 0) {
      resultCount.textContent = '0';
      resultsList.innerHTML = '<p class="p-4 text-gray-400 text-center">No results found</p>';
      resultsContainer.classList.remove('hidden');
      return;
    }

    resultCount.textContent = results.length.toString();
    
    resultsList.innerHTML = results.map((result) => `
      <a 
        href="${result.url}" 
        class="block p-4 hover:bg-cortex-primary/10 transition-colors border-b border-cortex-primary/10 last:border-b-0"
      >
        <h4 class="text-cortex-primary font-semibold mb-1">${result.title}</h4>
        ${result.description ? `<p class="text-sm text-gray-400">${result.description}</p>` : ''}
        ${result.category ? `<span class="inline-block mt-2 px-2 py-1 text-xs bg-cortex-secondary/20 text-cortex-secondary rounded">${result.category}</span>` : ''}
      </a>
    `).join('');

    resultsContainer.classList.remove('hidden');
  }

  // Initialize on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSearch);
  } else {
    initSearch();
  }
</script>

<style>
  #search-input:focus {
    box-shadow: 0 0 0 3px rgba(76, 175, 80, 0.1);
  }

  #results-list::-webkit-scrollbar {
    width: 8px;
  }

  #results-list::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
  }

  #results-list::-webkit-scrollbar-thumb {
    background: rgba(76, 175, 80, 0.3);
    border-radius: 4px;
  }

  #results-list::-webkit-scrollbar-thumb:hover {
    background: rgba(76, 175, 80, 0.5);
  }
</style>
