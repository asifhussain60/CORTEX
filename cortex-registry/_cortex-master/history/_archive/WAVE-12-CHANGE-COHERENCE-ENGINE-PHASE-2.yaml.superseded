# ============================================================================
# WAVE 12: CHANGE COHERENCE ENGINE - PHASE 2 (ACCUMULATION PREVENTION)
# ============================================================================
# Authority: chat01.md TDD unholistic refactor analysis + ENH-101 foundation
# Purpose: Transform CCE from single-edit detector to multi-pass consolidator
# Status: DESIGN COMPLETE - HIGH PRIORITY (PREVENTS MANUAL WAVE 1→2→3 CYCLES)
# Created: 2026-02-13
# AC-ID: AC-WAVE12-001
# Priority: P1-CRITICAL (prevents technical debt accumulation)
# ============================================================================

version: "1.0"
created: "2026-02-13T23:30:00Z"
last_updated: "2026-02-13T23:30:00Z"
wave_id: "WAVE-12"
name: "Change Coherence Engine Phase 2 - Accumulation Prevention & Auto-Consolidation"
priority: "P1-CRITICAL"
roi_score: 9.3  # High ROI - prevents manual cleanup waves, makes CCE actionable

metadata:
  total_tracks: 6
  estimated_effort: "18-24 days"
  parallelizable: "high"  # T1-T4 fully parallel, T5-T6 depend on T1-T4
  blocking_dependencies:
    - "ENH-101 Stage 1-6 complete (113 tests passing)"
  value_delivery: |
    - Multi-session edit accumulation tracking
    - Auto-sync related markers (version headers/footers)
    - Automated consolidation engine (detection → action)
    - File-type-specific semantic validation
    - Canonical section order enforcement
    - Post-refactor test execution safety net
  execution_timing: "IMMEDIATE (builds on ENH-101 foundation)"
  foundation: "ENH-101: Change Coherence Engine (implemented 2026-02-13)"
  
objectives:
  primary: "Transform CCE from single-edit validator to multi-pass accumulation preventer"
  secondary: "Enable automated consolidation (detection → action), not just detection"
  tertiary: "Add safety nets (auto-sync, post-refactor tests) to prevent manual cleanup cycles"
  strategic: "Eliminate Wave 1 → Wave 2 → Wave 3 manual refactoring patterns"

# ============================================================================
# PROBLEM STATEMENT (from tdd-unholistic-refactor.md analysis)
# ============================================================================

problem_analysis:
  summary: |
    The TDD refactor session (tdd-unholistic-refactor.md) revealed that even with
    careful manual refactoring, a second pass (Wave 2) was needed to catch issues
    missed in Wave 1. Current ENH-101 CCE validates single edits but doesn't:
    
    1. Track accumulation patterns across multiple editing sessions
    2. Auto-sync related markers (e.g., version header ↔ footer)
    3. Offer automated fixes (only detects, doesn't consolidate)
    4. Validate file-type-specific semantics (e.g., no Python code in .md)
    5. Enforce canonical section ordering
    6. Run post-refactor tests to verify no breakage
    
  observed_failures:
    - issue: "Wave 1 refactor (1,996 → 1,166 lines) still had issues"
      evidence: "Wave 2 needed to remove 200 more lines of duplicates"
      root_cause: "Single-pass validation doesn't catch cumulative patterns"
      
    - issue: "Version header updated (8.0 → 8.1) but footer remained v7.0"
      evidence: "Manual fix required in Wave 2"
      root_cause: "No auto-sync between related markers"
      
    - issue: "600 lines of Python pseudo-code in instruction file"
      evidence: "Copilot added code examples that can't execute in chat"
      root_cause: "No file-type-specific semantic validation"
      
    - issue: "Quick Commands section appeared at 2 different locations"
      evidence: "Lines 390 and 1079 both had Quick Commands"
      root_cause: "No canonical section order enforcement"
      
    - issue: "Refactor completed but no verification CORTEX still works"
      evidence: "Manual test run needed later to verify"
      root_cause: "No post-refactor test execution hook"
      
  impact:
    - "Manual Wave 1 → Wave 2 cycles waste 4-8 hours per refactor"
    - "Version mismatches create confusion and governance violations"
    - "File-type semantic errors (code in docs) reduce signal-to-noise"
    - "Section drift increases navigation complexity"
    - "Refactor-induced breakage discovered too late (manual testing)"

# ============================================================================
# TRACK 1: MULTI-PASS ACCUMULATION PREVENTION (P1)
# ============================================================================

tracks:
  - track_id: "T1"
    name: "AccumulationTracker - Multi-Session Edit Pattern Detection"
    priority: "P1-CRITICAL"
    duration: "3-4 days"
    effort: "18-24h"
    parallelizable: true
    
    description: |
      Track edit history across sessions and detect accumulation patterns.
      Example: "3 edits added 'MCP' sections in last 7 days → likely duplicates"
      
    component:
      name: "AccumulationTracker"
      location: "cortex/orchestrators/coherence/accumulation_tracker.py"
      
    deliverables:
      - id: "T1-D1"
        name: "Edit History Database"
        file: "cortex/orchestrators/coherence/edit_history.db"
        description: |
          SQLite database tracking every file edit:
          - file_path, timestamp, changes_summary, editor_type
          - before_line_count, after_line_count, sections_added
        tests: 6
        
      - id: "T1-D2"
        name: "AccumulationTracker Core"
        file: "cortex/orchestrators/coherence/accumulation_tracker.py"
        methods:
          - "track_edit(file_path: Path, changes: List[Change], timestamp: datetime)"
          - "detect_accumulation_patterns(file_path: Path, window_days: int = 7) -> List[AccumulationIssue]"
          - "suggest_consolidation_waves(issues: List[AccumulationIssue]) -> List[Wave]"
          - "get_edit_velocity(file_path: Path) -> EditVelocityMetrics"
        tests: 12
        
      - id: "T1-D3"
        name: "Pattern Detection Algorithms"
        file: "cortex/orchestrators/coherence/accumulation_patterns.py"
        patterns:
          - name: "RepeatedSectionAddition"
            description: "Same section name added N times in window"
            threshold: "N >= 2"
          - name: "GrowthWithoutCleanup"
            description: "File grows >20% without any deletions"
            threshold: "growth_ratio > 1.2, deletion_ratio < 0.05"
          - name: "VersionMarkerDrift"
            description: "Version updated M times but related markers unchanged"
            threshold: "M >= 2"
        tests: 10
        
      - id: "T1-D4"
        name: "Integration with CCE"
        file: "cortex/orchestrators/coherence/change_coherence_engine.py"
        changes: |
          Extend CCE.pre_edit() to call AccumulationTracker:
          - Load edit history for file
          - Detect accumulation patterns
          - If patterns found → WARN user before allowing edit
        tests: 8
        
    test_strategy:
      golden_path_tests:
        - name: "test_accumulation_detection_truth"
          description: "Simulate 3 edits adding 'MCP' sections → detect pattern"
          mocks: 0
          
        - name: "test_wave_suggestion_truth"
          description: "Detect 5 accumulation issues → generate Wave 2 consolidation plan"
          mocks: 0
          
    acceptance_criteria:
      - "Edit history captured in SQLite for every CCE-validated edit"
      - "Accumulation patterns detected with ≥90% accuracy"
      - "Wave consolidation suggestions actionable (user can execute)"
      - "Integration tests pass with real edit scenarios"

# ============================================================================
# TRACK 2: AUTO-SYNC RELATED MARKERS (P0)
# ============================================================================

  - track_id: "T2"
    name: "RelatedMarkerSync - Auto-Sync Version Headers/Footers"
    priority: "P0-CRITICAL"
    duration: "2-3 days"
    effort: "12-18h"
    parallelizable: true
    
    description: |
      Auto-detect and sync related content markers (version headers/footers,
      TOC entries, cross-references). Eliminates manual sync errors.
      
    component:
      name: "RelatedMarkerSync"
      location: "cortex/orchestrators/coherence/related_marker_sync.py"
      
    deliverables:
      - id: "T2-D1"
        name: "Marker Detection Registry"
        file: "cortex/orchestrators/coherence/marker_patterns.yaml"
        patterns:
          - type: "version_header_footer"
            header_pattern: "**Version:** {version}"
            footer_pattern: "*v{version}"
            sync_rule: "footer version must match header version"
            
          - type: "toc_section_reference"
            toc_pattern: "- [{title}](#{anchor})"
            section_pattern: "## {title}"
            sync_rule: "TOC entry must match section title"
            
          - type: "file_path_reference"
            reference_pattern: "See {file_path} for details"
            target_check: "file must exist at path"
            
        tests: 5
        
      - id: "T2-D2"
        name: "RelatedMarkerSync Core"
        file: "cortex/orchestrators/coherence/related_marker_sync.py"
        methods:
          - "detect_related_markers(content: str) -> Dict[str, List[Marker]]"
          - "sync_markers(content: str, changed_marker: Marker) -> str"
          - "generate_sync_suggestions(markers: Dict) -> List[SyncSuggestion]"
          - "auto_apply_sync(content: str, suggestions: List[SyncSuggestion], mode: str) -> str"
        tests: 15
        
      - id: "T2-D3"
        name: "Integration with CoherenceValidator"
        file: "cortex/orchestrators/coherence/coherence_validator.py"
        changes: |
          Extend post_edit validation:
          - Detect related markers after edit
          - If markers out of sync → generate suggestions
          - If mode=auto → apply sync automatically
          - If mode=prompt → ask user approval
        tests: 8
        
    test_strategy:
      golden_path_tests:
        - name: "test_version_sync_truth"
          description: "Edit header 'Version: 8.1' → footer auto-updates to 'v8.1'"
          mocks: 0
          
        - name: "test_toc_sync_truth"
          description: "Move section → TOC entry auto-updates line number"
          mocks: 0
          
    acceptance_criteria:
      - "Version header/footer sync detected with 100% accuracy"
      - "Auto-sync applied in <50ms for typical files"
      - "User can choose auto/prompt/manual sync modes"
      - "No false positives (precision ≥95%)"

# ============================================================================
# TRACK 3: AUTO-CONSOLIDATION ENGINE (P1)
# ============================================================================

  - track_id: "T3"
    name: "AutoConsolidationEngine - Detection to Action"
    priority: "P1-CRITICAL"
    duration: "4-5 days"
    effort: "24-30h"
    parallelizable: true
    
    description: |
      Transform CCE from detector to fixer. When duplicates/issues detected,
      offer automated consolidation plans that user can approve and execute.
      
    component:
      name: "AutoConsolidationEngine"
      location: "cortex/orchestrators/coherence/auto_consolidation.py"
      
    deliverables:
      - id: "T3-D1"
        name: "ConsolidationPlan Generator"
        file: "cortex/orchestrators/coherence/consolidation_plan.py"
        methods:
          - "generate_plan(issues: List[CoherenceIssue]) -> ConsolidationPlan"
          - "optimize_plan(plan: ConsolidationPlan) -> ConsolidationPlan"
          - "validate_plan_safety(plan: ConsolidationPlan) -> SafetyReport"
        plan_types:
          - "MERGE_DUPLICATES: Merge N duplicate sections into canonical"
          - "REMOVE_OBSOLETE: Delete section marked obsolete"
          - "REORDER_SECTIONS: Move sections to canonical order"
          - "SYNC_MARKERS: Update related markers to match"
        tests: 12
        
      - id: "T3-D2"
        name: "AutoConsolidationEngine Core"
        file: "cortex/orchestrators/coherence/auto_consolidation.py"
        methods:
          - "execute_consolidation(plan: ConsolidationPlan, mode: str) -> Result"
          - "preview_consolidation(plan: ConsolidationPlan) -> DiffPreview"
          - "rollback_consolidation(plan_id: str) -> Result"
        modes:
          - "preview: Generate diff, no changes"
          - "interactive: Step-by-step with user approval"
          - "autonomous: Execute all steps silently"
        tests: 15
        
      - id: "T3-D3"
        name: "Safety Checks"
        file: "cortex/orchestrators/coherence/consolidation_safety.py"
        checks:
          - name: "PreservesSemantics"
            description: "Consolidation doesn't change meaning"
          - name: "NoDataLoss"
            description: "All unique content preserved"
          - name: "ValidatesAfterChange"
            description: "Result passes all coherence checks"
        tests: 10
        
      - id: "T3-D4"
        name: "MCP Tool Integration"
        file: "cortex/mcp/tools/coherence_tools.py"
        new_tool: "cortex_auto_consolidate"
        parameters:
          - "file_path: str"
          - "mode: 'preview' | 'interactive' | 'autonomous'"
        tests: 8
        
    test_strategy:
      golden_path_tests:
        - name: "test_duplicate_merge_truth"
          description: "3x GAP-001 sections → merge into canonical → verify no data loss"
          mocks: 0
          
        - name: "test_autonomous_consolidation_truth"
          description: "Full workflow: detect → plan → execute → verify"
          mocks: 0
          
    acceptance_criteria:
      - "Consolidation plans generated in <500ms for typical files"
      - "Safety checks prevent data loss (100% verified)"
      - "Preview mode shows exact diff before execution"
      - "Autonomous mode creates git commit with AC markers"

# ============================================================================
# TRACK 4: FILE-TYPE-SPECIFIC VALIDATORS (P2)
# ============================================================================

  - track_id: "T4"
    name: "FileTypeValidatorRegistry - Semantic Validation"
    priority: "P2-IMPORTANT"
    duration: "3-4 days"
    effort: "18-24h"
    parallelizable: true
    
    description: |
      Load file-type-specific validation rules to catch semantic errors
      (e.g., Python code in .md instruction files, YAML syntax in .py files).
      
    component:
      name: "FileTypeValidatorRegistry"
      location: "cortex/orchestrators/coherence/file_type_validators/"
      
    deliverables:
      - id: "T4-D1"
        name: "Markdown Validator"
        file: "cortex/orchestrators/coherence/file_type_validators/markdown_validator.py"
        rules:
          - "No Python code blocks in instruction files (.github/)"
          - "Headers follow sequence (no ## after ####)"
          - "Links resolve to existing files"
        tests: 8
        
      - id: "T4-D2"
        name: "Python Validator"
        file: "cortex/orchestrators/coherence/file_type_validators/python_validator.py"
        rules:
          - "Type hints present (CORE-011)"
          - "Google-style docstrings (CORE-012)"
          - "No bare except (CORE-013)"
        tests: 10
        
      - id: "T4-D3"
        name: "YAML Validator"
        file: "cortex/orchestrators/coherence/file_type_validators/yaml_validator.py"
        rules:
          - "Valid YAML syntax"
          - "Schema compliance (if schema exists)"
          - "No duplicate keys"
        tests: 6
        
      - id: "T4-D4"
        name: "Registry Integration"
        file: "cortex/orchestrators/coherence/file_type_validators/__init__.py"
        methods:
          - "get_validator(file_path: Path) -> Validator"
          - "validate_file(file_path: Path) -> ValidationResult"
        tests: 5
        
    test_strategy:
      golden_path_tests:
        - name: "test_markdown_code_detection_truth"
          description: "Add Python code to .md instruction file → validator blocks"
          mocks: 0
          
    acceptance_criteria:
      - "File-type detection accurate (100% for .py/.md/.yaml)"
      - "Validators catch semantic errors with ≥90% precision"
      - "False positives <5%"

# ============================================================================
# TRACK 5: CANONICAL SECTION ORDER ENFORCEMENT (P2)
# ============================================================================

  - track_id: "T5"
    name: "Section Order Enforcement"
    priority: "P2-IMPORTANT"
    duration: "2-3 days"
    effort: "12-18h"
    parallelizable: false  # Depends on T1 (StructureAnalyzer)
    dependencies: ["T1"]
    
    description: |
      Extend StructureAnalyzer to enforce canonical section ordering per file type.
      Prevents section drift and duplication by enforcing structure.
      
    component:
      name: "SectionOrderValidator"
      location: "cortex/orchestrators/coherence/section_order_validator.py"
      
    deliverables:
      - id: "T5-D1"
        name: "Canonical Order Registry"
        file: "cortex/orchestrators/coherence/canonical_orders.yaml"
        orders:
          - file_pattern: ".github/copilot-instructions.md"
            canonical_order:
              - "Header (version, identity)"
              - "MCP Gate Check"
              - "System Identity"
              - "Interaction Flow"
              - "Quick Commands"
              - "CORE Rules"
              - "Orchestrators"
              - "Footer"
              
          - file_pattern: "*.yaml (enhancements)"
            canonical_order:
              - "metadata"
              - "objectives"
              - "problem_analysis"
              - "solution"
              - "stages"
              - "success_metrics"
              
        tests: 4
        
      - id: "T5-D2"
        name: "SectionOrderValidator Core"
        file: "cortex/orchestrators/coherence/section_order_validator.py"
        methods:
          - "load_canonical_order(file_path: Path) -> List[SectionTemplate]"
          - "validate_order(sections: List[Section], canonical: List[SectionTemplate]) -> OrderingReport"
          - "suggest_reordering(report: OrderingReport) -> ReorderPlan"
        tests: 12
        
      - id: "T5-D3"
        name: "Integration with StructureAnalyzer"
        file: "cortex/orchestrators/coherence/structure_analyzer.py"
        changes: |
          Add validate_section_order() method to StructureAnalyzer
        tests: 6
        
    test_strategy:
      golden_path_tests:
        - name: "test_section_order_enforcement_truth"
          description: "Add section out of order → validator suggests correct position"
          mocks: 0
          
    acceptance_criteria:
      - "Canonical orders defined for 10+ file patterns"
      - "Order violations detected with 100% accuracy"
      - "Reordering suggestions actionable"

# ============================================================================
# TRACK 6: POST-REFACTOR TEST EXECUTION (P0)
# ============================================================================

  - track_id: "T6"
    name: "PostRefactorVerificationOrchestrator"
    priority: "P0-CRITICAL"
    duration: "3-4 days"
    effort: "18-24h"
    parallelizable: false  # Depends on T3 (consolidation engine)
    dependencies: ["T3"]
    
    description: |
      After coherence fixes applied, auto-run affected tests to verify no breakage.
      Provides fail-fast safety net for refactoring operations.
      
    component:
      name: "PostRefactorVerificationOrchestrator"
      location: "cortex/orchestrators/coherence/post_refactor_verification.py"
      
    deliverables:
      - id: "T6-D1"
        name: "Test Impact Analysis"
        file: "cortex/orchestrators/coherence/test_impact_analyzer.py"
        methods:
          - "identify_affected_tests(changed_files: List[Path]) -> List[TestFile]"
          - "estimate_test_runtime(tests: List[TestFile]) -> timedelta"
          - "prioritize_tests(tests: List[TestFile]) -> List[TestFile]"
        tests: 10
        
      - id: "T6-D2"
        name: "PostRefactorVerificationOrchestrator Core"
        file: "cortex/orchestrators/coherence/post_refactor_verification.py"
        methods:
          - "execute_tests(tests: List[TestFile], mode: str) -> TestResult"
          - "generate_verification_report(results: List[TestResult]) -> Report"
          - "handle_test_failures(failures: List[TestFailure]) -> FailureReport"
        modes:
          - "fast: Run unit tests only"
          - "normal: Run unit + integration"
          - "comprehensive: Run all affected tests"
        tests: 12
        
      - id: "T6-D3"
        name: "Integration with AutoConsolidationEngine"
        file: "cortex/orchestrators/coherence/auto_consolidation.py"
        changes: |
          After consolidation execution:
          - Call PostRefactorVerification.execute_tests()
          - If tests fail → rollback consolidation
          - If tests pass → commit with AC markers
        tests: 8
        
      - id: "T6-D4"
        name: "MCP Tool Integration"
        file: "cortex/mcp/tools/coherence_tools.py"
        new_tool: "cortex_verify_refactor"
        parameters:
          - "changed_files: List[str]"
          - "mode: 'fast' | 'normal' | 'comprehensive'"
        tests: 6
        
    test_strategy:
      golden_path_tests:
        - name: "test_post_refactor_safety_net_truth"
          description: "Consolidate file → run tests → tests pass → commit"
          mocks: 0
          
        - name: "test_rollback_on_failure_truth"
          description: "Consolidate file → tests fail → auto-rollback → restore original"
          mocks: 0
          
    acceptance_criteria:
      - "Test impact analysis accurate (≥90% precision)"
      - "Test execution completes in <2min for fast mode"
      - "Rollback on test failure works 100%"
      - "Commit only happens if all affected tests pass"

# ============================================================================
# SUCCESS METRICS
# ============================================================================

success_metrics:
  accumulation_prevention:
    target: "Zero Wave 1 → Wave 2 manual cleanup cycles"
    measurement: "Track refactor operations over 30 days"
    
  auto_sync_accuracy:
    target: "100% version header/footer sync"
    measurement: "Monitor all version updates"
    
  consolidation_success:
    target: "≥95% of consolidation plans execute successfully"
    measurement: "Track consolidation operations + rollback rate"
    
  semantic_validation:
    target: "≥90% catch rate for file-type semantic errors"
    measurement: "Manual audit of 100 files with intentional errors"
    
  section_order_compliance:
    target: "100% of instruction files follow canonical order"
    measurement: "Scan .github/*.md files"
    
  post_refactor_safety:
    target: "Zero refactor-induced test breakage reaches production"
    measurement: "Track post-refactor test execution results"

# ============================================================================
