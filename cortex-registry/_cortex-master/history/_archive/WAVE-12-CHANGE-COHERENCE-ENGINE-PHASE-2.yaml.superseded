# ============================================================================

integration:
  mcp_tools:
    - tool: "cortex_validate_coherence"
      enhancement: "Add accumulation tracking + auto-sync"
      
    - tool: "cortex_auto_consolidate"
      new: true
      purpose: "Execute consolidation plans"
      
    - tool: "cortex_verify_refactor"
      new: true
      purpose: "Run post-refactor tests"
      
  orchestrators:
    - orchestrator: "TDDOrchestrator"
      integration: "Call CCE.pre_edit() with accumulation check"
      
    - orchestrator: "RefactoringOrchestrator"
      integration: "Call CCE.post_edit() with auto-consolidation"
      
    - orchestrator: "MasterOrchestrator"
      integration: "Route REFACTOR intents through enhanced CCE"
      
  governance:
    - rule: "CORE-002"
      enhancement: "FileTypeValidator enforces no .md file generation"
      
    - rule: "CORE-028"
      enhancement: "SectionOrderValidator enforces file naming + structure"

# ============================================================================
# EXECUTION STRATEGY
# ============================================================================

execution:
