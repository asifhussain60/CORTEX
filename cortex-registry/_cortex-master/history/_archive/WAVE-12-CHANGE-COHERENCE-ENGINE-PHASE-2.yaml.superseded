# ============================================================================
# ROI ANALYSIS
# ============================================================================

roi_analysis:
  current_cost_per_refactor:
    wave_1_manual: "4-6 hours"
    wave_2_manual: "3-4 hours"
    wave_3_manual: "2-3 hours"
    total: "9-13 hours per refactor cycle"
    
