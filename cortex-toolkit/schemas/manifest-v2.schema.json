{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cortex.dev/schemas/manifest-v2.schema.json",
  "title": "CORTEX Toolkit Manifest v2",
  "description": "Schema for CORTEX toolkit manifest version 2.0",
  "type": "object",
  "required": ["version", "categories"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^2\\.\\d+\\.\\d+$",
      "description": "Manifest version (must be 2.x.x)"
    },
    "schema_version": {
      "type": "integer",
      "const": 2,
      "description": "Schema version number"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp in ISO 8601 format"
    },
    "toolkit_root": {
      "type": "string",
      "description": "Root path of the toolkit"
    },
    "categories": {
      "type": "object",
      "description": "Tool categories",
      "additionalProperties": {
        "$ref": "#/definitions/category"
      }
    }
  },
  "definitions": {
    "category": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": {
          "type": "string",
          "description": "Category description"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/tool"
          },
          "default": []
        }
      }
    },
    "tool": {
      "type": "object",
      "required": ["name", "command", "script", "description", "platforms", "requires_admin", "execution_method"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Tool identifier (lowercase, hyphens allowed)"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "CLI command name"
        },
        "script": {
          "type": "string",
          "minLength": 1,
          "description": "Path to script relative to toolkit root"
        },
        "wrapper": {
          "type": "string",
          "description": "Path to CLI wrapper script"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable description"
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["windows", "linux", "macos"]
          },
          "minItems": 1,
          "description": "Supported platforms"
        },
        "requires_admin": {
          "type": "boolean",
          "description": "Whether admin privileges are required"
        },
        "execution_method": {
          "type": "string",
          "enum": ["cli", "cli_wrapper", "copilot_chat", "python_api"],
          "description": "How the tool is executed"
        },
        "user_friendly_name": {
          "type": "string",
          "description": "Display name for UI"
        },
        "functionality": {
          "type": "string",
          "description": "Detailed functionality description"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of tool names this tool depends on"
        },
        "conflicts_with": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of tool names that conflict with this tool"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cleanup",
              "validation",
              "generation",
              "analysis",
              "migration",
              "documentation",
              "testing",
              "deployment",
              "monitoring",
              "maintenance",
              "security",
              "optimization"
            ]
          },
          "default": [],
          "description": "Capability keywords for this tool"
        },
        "idempotent": {
          "type": "boolean",
          "default": true,
          "description": "Whether running multiple times produces same result"
        },
        "destructive": {
          "type": "boolean",
          "default": false,
          "description": "Whether the tool modifies or deletes data"
        },
        "rollback_supported": {
          "type": "boolean",
          "default": false,
          "description": "Whether checkpoint/rollback is available"
        },
        "input_schema": {
          "$ref": "#/definitions/json_schema",
          "description": "JSON Schema for tool input validation"
        },
        "output_schema": {
          "$ref": "#/definitions/json_schema",
          "description": "JSON Schema for tool output validation"
        },
        "rate_limit": {
          "type": "object",
          "properties": {
            "max_calls_per_minute": {
              "type": "integer",
              "minimum": 1,
              "default": 60,
              "description": "Maximum calls allowed per minute"
            },
            "burst_limit": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum burst calls allowed"
            }
          },
          "description": "Rate limiting configuration"
        },
        "security": {
          "type": "object",
          "properties": {
            "privilege_level": {
              "type": "string",
              "enum": ["user", "admin", "system"],
              "default": "user",
              "description": "Required privilege level"
            },
            "audit_required": {
              "type": "boolean",
              "default": false,
              "description": "Whether operations should be logged"
            },
            "allowed_users": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "List of allowed user identifiers"
            }
          },
          "description": "Security configuration"
        }
      },
      "additionalProperties": true
    },
    "json_schema": {
      "type": "object",
      "description": "A valid JSON Schema definition",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["object", "array", "string", "number", "integer", "boolean", "null"]
        },
        "properties": {
          "type": "object"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "items": {
          "type": "object"
        },
        "enum": {
          "type": "array"
        },
        "default": {},
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "minLength": {
          "type": "integer"
        },
        "maxLength": {
          "type": "integer"
        }
      }
    }
  }
}
