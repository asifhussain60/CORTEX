{
  "version": "4.0",
  "environment": "development",
  "paths": {
    "orchestrators": "src/orchestrators",
    "brain": "src/brain",
    "templates": "src/templates",
    "mcp_gateway": "src/mcp",
    "logs": "logs",
    "cache": ".cortex/cache"
  },
  "brain": {
    "tier1_db": "{repo}/cortex-brain/tier1/conversations.db",
    "tier2_db": "~/.cortex/shared/tier2/knowledge-graph.db",
    "tier3_db": "{repo}/cortex-brain/tier3/metrics.db",
    "tier0_rules": "~/.cortex/shared/skull_rules.yaml",
    "max_conversations": 70,
    "pattern_confidence_threshold": 0.5,
    "enable_cross_repo_learning": true
  },
  "ide": {
    "auto_detect": true,
    "detected_ide": "unknown",
    "vscode_config_path": ".vscode/cortex.config.json",
    "visual_studio_config_path": ".vs/cortex/config.json"
  },
  "logging": {
    "level": "INFO",
    "console_output": true,
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "max_file_size_mb": 10,
    "backup_count": 5
  },
  "features": {
    "mcp_gateway_enabled": false,
    "response_templates_v4": false,
    "dependency_injection": false,
    "documentation_engine": false
  },
  "legacy_v3": {
    "comment": "Legacy v3.9.0 configuration - kept for backward compatibility during migration",
    "planningSystem": {
      "version": "3.0",
      "comment": "Planning System 3.0 - Tiered routing, automatic refactor/vacuum cycles, centralized versioning"
    },
    "application": {
      "name": "CORTEX",
      "framework": "Browser-Native (SQL.js + TypeScript) + PowerShell",
      "language": "TypeScript/Python/PowerShell",
      "rootPath": "",
      "buildCommand": "npm run build",
      "runCommand": "npm run dev"
    }
  },
  "machines": {
    "": {
      "comment": "Add your machine hostname here for automatic path resolution",
      "rootPath": "",
      "brainPath": ""
    },
    "Asifs-MacBook-Pro.local": {
      "rootPath": "/Users/asifhussain/PROJECTS/CORTEX",
      "brainPath": "/Users/asifhussain/PROJECTS/CORTEX/cortex-brain"
    },
    "Asifs-MacBook-Air.local": {
      "rootPath": "/Users/asifhussain/PROJECTS/CORTEX",
      "brainPath": "/Users/asifhussain/PROJECTS/CORTEX/cortex-brain"
    },
    "AHHOME": {
      "rootPath": "D:\\PROJECTS\\CORTEX",
      "brainPath": "D:\\PROJECTS\\CORTEX\\cortex-brain"
    },
    "WLRMTAHUSSAIN": {
      "rootPath": "C:\\PROJECTS\\CORTEX",
      "brainPath": "C:\\PROJECTS\\CORTEX\\cortex-brain"
    }
  },
  "testing": {
    "framework": "None",
    "configPath": "",
    "orchestrationPattern": "none",
    "orchestrationScript": "",
    "healthCheckUrl": "",
    "healthCheckTimeout": 30,
    "testCommand": "",
    "headlessDefault": false
  },
  "database": {
    "provider": "None",
    "connectionStringKey": "",
    "testSessionId": null,
    "testHostToken": ""
  },
  "governance": {
    "autoChainTasks": true,
    "autoChainPhases": false,
    "requireBuildValidation": false,
    "requireGitValidation": true,
    "testQualityThreshold": 70
  },
  "planning": {
    "yaml_modularization_threshold_bytes": 20480,
    "comment": "Phase 10: Automatic YAML modularization - splits plans >20KB into modular structure for 80%+ faster loads and 85%+ token reduction"
  },
  "system_alignment": {
    "skip_duplicate_detection": true,
    "comment": "Duplicate detection skipped by default to prevent O(n²) performance issue (330k+ file ops with 575 docs). Enable only for deep validation: set to false"
  },
  "token_optimization": {
    "enabled": true,
    "soft_limit": 40000,
    "hard_limit": 50000,
    "target_reduction": 0.6,
    "quality_threshold": 0.9,
    "cache_check_frequency": 5
  },
  "tier1": {
    "conversation_boundaries": {
      "mode": "session-based",
      "idle_gap_threshold_seconds": 7200,
      "auto_close_on_workflow_complete": true,
      "explicit_commands": {
        "new_conversation": [
          "new conversation",
          "start fresh",
          "new topic",
          "fresh start"
        ],
        "continue_conversation": [
          "continue",
          "keep going",
          "next",
          "resume"
        ]
      }
    },
    "session_cleanup": {
      "enabled": true,
      "retention_days": 90,
      "auto_cleanup_on_startup": false
    }
  },
  "portability": {
    "version": "5.0.0",
    "lastUpdated": "2025-11-06",
    "configSchema": "cortex-config-v5.0",
    "setupCompleted": true
  },
  "ado_planning": {
    "enabled": true,
    "database_path": "cortex-brain/ado-work-items.db",
    "templates_path": "cortex-brain/templates/ado",
    "storage_path": "cortex-brain/documents/planning/ado",
    "pagination_size": 50,
    "cache_size": 100,
    "auto_inject_context": true,
    "track_file_changes": true,
    "track_commits": true
  },
  "vision_api": {
    "enabled": true,
    "auto_detect_images": true,
    "auto_analyze_on_detect": true,
    "auto_inject_context": true,
    "max_images_per_request": 5,
    "supported_formats": ["png", "jpg", "jpeg", "webp", "gif", "bmp"],
    "max_tokens_per_image": 500,
    "warn_threshold_tokens": 400,
    "max_image_size_bytes": 2000000,
    "downscale_threshold": 1920,
    "jpeg_quality": 85,
    "cache_analysis_results": true,
    "cache_ttl_hours": 24
  },
  "story_refresh": {
    "enabled": true,
    "target_read_time_min": 25,
    "target_read_time_max": 30,
    "words_per_minute": 200,
    "tolerance_percent": 7,
    "extended_tolerance_percent": 20,
    "enforce_validation": true,
    "fail_on_critical_length": false
  },
  "adaptive_templates": {
    "enabled": true,
    "enable_brain_learning": true,
    "enable_optimization": true,
    "use_pattern_learning": true,
    "confidence_threshold": 0.7,
    "quality_feedback_loop": true,
    "context_aware_selection": true,
    "learning_weight": 0.3
  },
  "github": {
    "comment": "GitHub Personal Access Token for automatic Gist upload",
    "token": "",
    "repository_owner": "asifhussain60",
    "repository_name": "CORTEX"
  },
  "openai": {
    "comment": "OpenAI API configuration for DALL-E image generation and GPT features",
    "api_key_env": "OPENAI_API_KEY",
    "dalle": {
      "model": "dall-e-3",
      "size": "1792x1024",
      "quality": "hd",
      "output_dir": "cortex-brain/documents/images/features-dec-2025"
    }
  },
  "plugins": {
    "cleanup_plugin": {
      "enabled": true,
      "dry_run": true,
      "auto_cleanup_on_startup": false,
      "temp_patterns": [
        "*.tmp",
        "*.temp",
        "*~",
        "*.swp",
        "*.swo",
        "*.bak",
        "*.old",
        "*.orig",
        "*.rej",
        ".DS_Store",
        "Thumbs.db",
        "desktop.ini"
      ],
      "backup_patterns": [
        "*.bak",
        "*.backup",
        "*.old",
        "*_backup_*",
        "*_old_*",
        "*.orig"
      ],
      "cache_dirs": [
        "__pycache__",
        ".pytest_cache",
        ".mypy_cache",
        "node_modules/.cache",
        ".cache",
        "dist",
        "build",
        "*.egg-info"
      ],
      "preserve_patterns": [
        "*.keep",
        ".gitkeep",
        "LICENSE",
        "README*",
        "CHANGELOG*",
        ".git/",
        ".gitignore",
        "cortex-brain/",
        "src/",
        "tests/",
        "docs/",
        "prompts/",
        "workflows/",
        "scripts/"
      ],
      "max_temp_age_days": 7,
      "max_log_age_days": 30,
      "max_backup_age_days": 14,
      "min_duplicate_size_kb": 10,
      "large_file_threshold_mb": 100,
      "compress_old_archives": true,
      "enforce_structure": true,
      "detect_orphans": true
    },
    "doc_refresh_plugin": {
      "enabled": true,
      "auto_refresh": false
    },
    "configuration_wizard_plugin": {
      "enabled": true
    }
  }
}