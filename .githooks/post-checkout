#!/bin/bash
# AC_START: AC-PHASE50-MCPCLEANUP-001
# CORTEX Post-Checkout Hook: MCP Environment Enforcement
# Phase 50: Ensures CORTEX MCP is the ONLY MCP server on all machines
#
# Triggered on: git pull, git checkout, git clone
# Purpose: Auto-verify and enforce CORTEX-only MCP policy

set -e

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Hook parameters (provided by git)
PREV_HEAD=$1
NEW_HEAD=$2
BRANCH_CHECKOUT=$3  # 1 if branch checkout, 0 if file checkout

# Only run on branch checkouts (not file checkouts)
if [ "$BRANCH_CHECKOUT" != "1" ]; then
    exit 0
fi

echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}🔌 CORTEX Post-Checkout: MCP Environment Check${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

# ============================================================================
# CHECK 1: Verify CORTEX MCP Configuration
# ============================================================================

VSCODE_SETTINGS=".vscode/settings.json"
VSCODE_MCP=".vscode/mcp.json"

# Check if mcp.json exists
if [ ! -f "$VSCODE_MCP" ]; then
    echo -e "${YELLOW}⚠️  WARNING: .vscode/mcp.json not found${NC}"
    echo -e "${CYAN}   Running MCP setup...${NC}"
    python .cortex/setup-mcp.py --silent 2>/dev/null || python .cortex/setup-mcp.py
    echo -e "${GREEN}✅ MCP configuration created${NC}"
else
    # Verify CORTEX is in mcp.json
    if grep -q '"cortex"' "$VSCODE_MCP" 2>/dev/null; then
        echo -e "${GREEN}✅ CORTEX MCP server: Configured${NC}"
    else
        echo -e "${YELLOW}⚠️  WARNING: CORTEX not in mcp.json, running setup...${NC}"
        python .cortex/setup-mcp.py --silent 2>/dev/null || python .cortex/setup-mcp.py
    fi
fi

# ============================================================================
# CHECK 2: Detect Competing MCP Servers
# ============================================================================

COMPETING_FOUND=0

# Check for Pylance MCP in settings.json
if [ -f "$VSCODE_SETTINGS" ]; then
    # Check for Pylance MCP configuration
    if grep -q '"pylance"' "$VSCODE_SETTINGS" 2>/dev/null && \
       grep -q '"mcpServers"' "$VSCODE_SETTINGS" 2>/dev/null; then
        if grep -A5 '"mcpServers"' "$VSCODE_SETTINGS" | grep -q '"pylance"'; then
            echo -e "${YELLOW}⚠️  WARNING: Pylance MCP detected in settings.json${NC}"
            COMPETING_FOUND=1
        fi
    fi
    
    # Check for GitKraken MCP configuration
    if grep -q '"gitkraken"' "$VSCODE_SETTINGS" 2>/dev/null && \
       grep -q '"mcpServers"' "$VSCODE_SETTINGS" 2>/dev/null; then
        if grep -A5 '"mcpServers"' "$VSCODE_SETTINGS" | grep -q '"gitkraken"'; then
            echo -e "${YELLOW}⚠️  WARNING: GitKraken MCP detected in settings.json${NC}"
            COMPETING_FOUND=1
        fi
    fi
fi

# Check mcp.json for non-CORTEX servers
if [ -f "$VSCODE_MCP" ]; then
    # Extract server names (simple grep approach)
    NON_CORTEX_SERVERS=$(grep -oE '"[a-zA-Z0-9_-]+"[[:space:]]*:' "$VSCODE_MCP" | \
                         grep -v '"servers"' | grep -v '"cortex"' | \
                         sed 's/"//g' | sed 's/://g' | tr '\n' ', ' | sed 's/,$//')
    
    if [ -n "$NON_CORTEX_SERVERS" ]; then
        echo -e "${YELLOW}⚠️  WARNING: Non-CORTEX MCP servers in mcp.json: $NON_CORTEX_SERVERS${NC}"
        COMPETING_FOUND=1
    fi
fi

# ============================================================================
# CHECK 3: Validate Git Hooks Configuration
# ============================================================================

# Ensure git hooks path is configured
HOOKS_PATH=$(git config core.hooksPath 2>/dev/null || echo "")

if [ "$HOOKS_PATH" != ".githooks" ]; then
    echo -e "${YELLOW}⚠️  Git hooks not configured, setting up...${NC}"
    git config core.hooksPath .githooks
    echo -e "${GREEN}✅ Git hooks configured: .githooks${NC}"
else
    echo -e "${GREEN}✅ Git hooks: .githooks${NC}"
fi

# ============================================================================
# CHECK 4: Virtual Environment Verification
# ============================================================================

# Detect OS
case "$(uname -s)" in
    Darwin*|Linux*)
        VENV_PYTHON=".venv/bin/python"
        ;;
    MINGW*|CYGWIN*|MSYS*)
        VENV_PYTHON=".venv/Scripts/python.exe"
        ;;
    *)
        VENV_PYTHON=".venv/bin/python"
        ;;
esac

if [ ! -f "$VENV_PYTHON" ]; then
    echo -e "${YELLOW}⚠️  Virtual environment not found${NC}"
    echo -e "${CYAN}   Run: python -m venv .venv && source .venv/bin/activate && pip install -r requirements.txt${NC}"
else
    echo -e "${GREEN}✅ Virtual environment: Ready${NC}"
fi

# ============================================================================
# SUMMARY
# ============================================================================

echo ""
if [ $COMPETING_FOUND -eq 1 ]; then
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${YELLOW}⚠️  MCP POLICY WARNING${NC}"
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo -e "${CYAN}CORTEX MCP should be the ONLY MCP server.${NC}"
    echo -e "${CYAN}Competing servers may cause tool conflicts.${NC}"
    echo ""
    echo -e "To clean up competing MCPs:"
    echo -e "  ${GREEN}python .cortex/setup-mcp.py --cleanup${NC}"
    echo ""
else
    echo -e "${GREEN}✅ MCP Environment: CORTEX-only policy enforced${NC}"
fi

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# AC_COMPLETE: AC-PHASE50-MCPCLEANUP-001 ✅
exit 0
