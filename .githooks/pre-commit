#!/bin/bash
# CORTEX Pre-Commit Hook - MCP-FIRST Enforcement
# Ensures all commits comply with MCP-FIRST architecture
# Auto-installed on: git config core.hooksPath .githooks

set -e

echo "🔍 CORTEX Pre-Commit Hook: Validating MCP-FIRST compliance..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check for staged Python files that might bypass MCP
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

if [ -z "$STAGED_PY_FILES" ]; then
    echo "✅ No Python files to validate"
    exit 0
fi

VIOLATIONS=0

# Check for direct file operations in non-test files
for FILE in $STAGED_PY_FILES; do
    # Skip test files
    if [[ "$FILE" == *"test_"* ]] || [[ "$FILE" == *"/tests/"* ]]; then
        continue
    fi
    
    # Skip MCP tools themselves
    if [[ "$FILE" == *"cortex/mcp/"* ]]; then
        continue
    fi
    
    # Check for suspicious patterns that suggest MCP bypass
    if git diff --cached "$FILE" | grep -E "(create_file|replace_string_in_file|multi_replace_string_in_file)" > /dev/null; then
        echo -e "${YELLOW}⚠️  Warning: $FILE contains file manipulation calls${NC}"
        echo "   This might bypass MCP-FIRST architecture"
        VIOLATIONS=$((VIOLATIONS + 1))
    fi
done

# Check prompt/instruction files for MCP-FIRST presence
STAGED_PROMPTS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(copilot-instructions\.md|CORTEX\.prompt\.md|cortex-architect\.prompt\.md)' || true)

for PROMPT in $STAGED_PROMPTS; do
    if ! git diff --cached "$PROMPT" | grep -q "MCP PRE-FLIGHT\|MCP-FIRST"; then
        echo -e "${RED}❌ Error: $PROMPT missing MCP enforcement language${NC}"
        echo "   All instruction files MUST include MCP PRE-FLIGHT checks"
        VIOLATIONS=$((VIOLATIONS + 1))
    fi
done

# Summary
if [ $VIOLATIONS -gt 0 ]; then
    echo ""
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}❌ COMMIT BLOCKED: $VIOLATIONS MCP-FIRST violations detected${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo "Fix violations before committing:"
    echo "  1. Ensure IMPLEMENT/FIX/REFACTOR use cortex_process_request"
    echo "  2. Ensure ANALYZE/AUDIT use cortex_lens_analyze"
    echo "  3. Add MCP PRE-FLIGHT checks to instruction files"
    echo ""
    echo "To bypass this check (NOT RECOMMENDED):"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi

echo -e "${GREEN}✅ MCP-FIRST compliance validated${NC}"
exit 0
