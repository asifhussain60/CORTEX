#!/bin/bash
# AC_START: AC-PHASE71-S2-001 + AC-PHASE2-GAP002-001
# CORTEX Pre-Commit Hook: Markdown Artifact Prevention + Governance Alignment
# Phase 71 S2: Block unauthorized root markdown files
# Phase 2 S5: Validate governance alignment on CORE rule changes

set -e

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}🔍 Running CORTEX Pre-Commit Checks...${NC}"

# ============================================================================
# CHECK 1: Markdown Artifact Prevention
# ============================================================================

# Get list of staged markdown files in root
STAGED_ROOT_MD=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^[^/]+\.md$' || true)

if [ -n "$STAGED_ROOT_MD" ]; then
    # Check each root markdown file
    VIOLATIONS=0
    ALLOWED_FILES=("README.md")
    
    while IFS= read -r file; do
        # Check if file is in allowed list
        ALLOWED=0
        for allowed in "${ALLOWED_FILES[@]}"; do
            if [ "$file" = "$allowed" ]; then
                ALLOWED=1
                break
            fi
        done
        
        if [ $ALLOWED -eq 0 ]; then
            echo -e "${RED}❌ CORE-002 VIOLATION: Blocked root markdown file: $file${NC}"
            echo -e "${YELLOW}   Only .github/prompts/*.md, .github/agents/*.md, README.md allowed${NC}"
            VIOLATIONS=$((VIOLATIONS + 1))
        fi
    done <<< "$STAGED_ROOT_MD"
    
    if [ $VIOLATIONS -gt 0 ]; then
        echo ""
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${RED}Pre-commit check FAILED (Markdown Prevention)${NC}"
        echo -e "${RED}Found $VIOLATIONS unauthorized root markdown file(s)${NC}"
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo ""
        echo -e "${YELLOW}Resolution:${NC}"
        echo -e "  1. Remove markdown files (display findings inline in chat)"
        echo -e "  2. Or move to allowed paths (.github/prompts/, .github/agents/)"
        echo -e "  3. Or unstage: git reset HEAD <file>"
        echo ""
        exit 1
    fi
fi

# ============================================================================
# CHECK 2: Governance Alignment Validation
# ============================================================================

# Check if any governance files changed
GOVERNANCE_FILES=$(git diff --cached --name-only --diff-filter=ACM | \
    grep -E '(copilot-instructions\.md|cortex-architect\.prompt\.md|core-rules\.yaml|enforcement_orchestrator\.py)' || true)

if [ -n "$GOVERNANCE_FILES" ]; then
    echo -e "${BLUE}📋 Governance files changed, validating alignment...${NC}"
    
    # Run alignment validation script
    if python3 scripts/validate_governance_alignment.py; then
        echo -e "${GREEN}✅ Governance alignment: VALID${NC}"
    else
        echo ""
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${RED}Pre-commit check FAILED (Governance Alignment)${NC}"
        echo -e "${RED}CORE-002 misalignment detected across layers${NC}"
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo ""
        echo -e "${YELLOW}Resolution:${NC}"
        echo -e "  1. Ensure all 6 layers use same allowed paths:"
        echo -e "     - .github/prompts/*.md"
        echo -e "     - .github/agents/*.md"
        echo -e "     - README.md"
        echo -e "  2. Run: python3 scripts/validate_governance_alignment.py"
        echo -e "  3. Fix misalignments and re-commit"
        echo ""
        exit 1
    fi
fi

# ============================================================================
# CHECK 3: Wave 8 Registry Blacklist Enforcement (CORE-056)
# ============================================================================
# AC_START: AC-WAVE8-BLACKLIST-001 - Wave 8 Stage 2 pre-commit enforcement

BLACKLIST_VIOLATIONS=0

# Check for blacklisted files being staged
STAGED_BLACKLIST=$(git diff --cached --name-only --diff-filter=ACM | \
    grep -E 'cortex-registry/_cortex-master/(index\.yaml|phases/|waves/|execution/|meta/)' || true)

if [ -n "$STAGED_BLACKLIST" ]; then
    # Filter out exceptions (governance, enhancements, directives, WAVE documentation)
    FILTERED_BLACKLIST=$(echo "$STAGED_BLACKLIST" | \
        grep -v 'governance/' | \
        grep -v 'enhancements/' | \
        grep -v 'directives/' | \
        grep -v 'WAVE-' || true)
    
    if [ -n "$FILTERED_BLACKLIST" ]; then
        echo -e "${RED}❌ CORE-056 VIOLATION: Internal registry blacklist enforcement${NC}"
        echo ""
        echo -e "${YELLOW}Attempted to stage internal artifacts:${NC}"
        while IFS= read -r file; do
            echo -e "  - $file"
        done <<< "$FILTERED_BLACKLIST"
        BLACKLIST_VIOLATIONS=$(($(echo "$FILTERED_BLACKLIST" | wc -l)))
    fi
fi

if [ $BLACKLIST_VIOLATIONS -gt 0 ]; then
    echo ""
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}Pre-commit check FAILED (Registry Blacklist - CORE-056)${NC}"
    echo -e "${RED}Found $BLACKLIST_VIOLATIONS blacklisted file(s)${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo -e "${YELLOW}Blacklist Policy (Wave 8 Stage 2):${NC}"
    echo -e "  ✗ cortex-registry/_cortex-master/index.yaml"
    echo -e "  ✗ cortex-registry/_cortex-master/phases/"
    echo -e "  ✗ cortex-registry/_cortex-master/waves/"
    echo -e "  ✗ cortex-registry/_cortex-master/execution/"
    echo -e "  ✗ cortex-registry/_cortex-master/meta/"
    echo ""
    echo -e "${YELLOW}Exceptions (explicitly allowed):${NC}"
    echo -e "  ✓ governance/ (reusable governance patterns)"
    echo -e "  ✓ enhancements/ (reusable enhancement specs)"
    echo -e "  ✓ directives/ (reusable execution directives)"
    echo -e "  ✓ WAVE-*.md/yaml (reference documentation)"
    echo ""
    echo -e "${YELLOW}Resolution:${NC}"
    echo -e "  1. Unstage: git reset HEAD <file>"
    echo -e "  2. Override (internal only): git commit --no-verify"
    echo ""
    exit 1
fi

echo -e "${GREEN}✅ Registry blacklist: COMPLIANT (CORE-056)${NC}"
# AC_COMPLETE: AC-WAVE8-BLACKLIST-001 ✅

# ============================================================================
# CHECK 4: MCP Configuration Policy (CORTEX-only)
# ============================================================================
# AC_START: AC-PHASE50-MCPCLEANUP-002 - Pre-commit MCP policy validation

MCP_VIOLATIONS=0

# Check if .vscode/mcp.json or settings.json are being committed
MCP_CONFIG_CHANGES=$(git diff --cached --name-only --diff-filter=ACM | \
    grep -E '\.vscode/(mcp\.json|settings\.json)' || true)

if [ -n "$MCP_CONFIG_CHANGES" ]; then
    echo -e "${BLUE}🔌 MCP configuration changed, validating CORTEX-only policy...${NC}"
    
    # Check mcp.json for non-CORTEX servers
    if echo "$MCP_CONFIG_CHANGES" | grep -q "mcp.json"; then
        # Get staged content of mcp.json
        STAGED_MCP=$(git show :".vscode/mcp.json" 2>/dev/null || echo "")
        
        if [ -n "$STAGED_MCP" ]; then
            # AC_START: AC-MCP-FIX-004
            # Description: Replace regex with Python JSON parser for accuracy
            # Check for servers other than "cortex" using proper JSON parsing
            NON_CORTEX=$(echo "$STAGED_MCP" | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
    servers = data.get('mcpServers', {})
    non_cortex = [s for s in servers.keys() if s != 'cortex']
    print(' '.join(non_cortex))
except:
    pass
" 2>/dev/null || echo "")
            # AC_COMPLETE: AC-MCP-FIX-004 ✅ JSON parser for MCP server validation
            
            if [ -n "$NON_CORTEX" ]; then
                echo -e "${RED}❌ MCP POLICY VIOLATION: Non-CORTEX MCP servers detected: $NON_CORTEX${NC}"
                echo -e "${YELLOW}   CORTEX must be the ONLY MCP server in this repository${NC}"
                MCP_VIOLATIONS=$((MCP_VIOLATIONS + 1))
            fi
        fi
    fi
    
    # Check settings.json for non-CORTEX MCP servers
    if echo "$MCP_CONFIG_CHANGES" | grep -q "settings.json"; then
        STAGED_SETTINGS=$(git show :".vscode/settings.json" 2>/dev/null || echo "")
        
        if [ -n "$STAGED_SETTINGS" ]; then
            # Check mcpServers section for non-CORTEX entries
            if echo "$STAGED_SETTINGS" | grep -q "mcpServers"; then
                # Look for pylance, gitkraken, or other servers
                if echo "$STAGED_SETTINGS" | grep -q '"pylance".*mcp\|mcp.*"pylance"'; then
                    echo -e "${RED}❌ MCP POLICY VIOLATION: Pylance MCP detected in settings.json${NC}"
                    MCP_VIOLATIONS=$((MCP_VIOLATIONS + 1))
                fi
                if echo "$STAGED_SETTINGS" | grep -q '"gitkraken".*mcp\|mcp.*"gitkraken"'; then
                    echo -e "${RED}❌ MCP POLICY VIOLATION: GitKraken MCP detected in settings.json${NC}"
                    MCP_VIOLATIONS=$((MCP_VIOLATIONS + 1))
                fi
            fi
        fi
    fi
    
    if [ $MCP_VIOLATIONS -gt 0 ]; then
        echo ""
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${RED}Pre-commit check FAILED (MCP Policy)${NC}"
        echo -e "${RED}Found $MCP_VIOLATIONS MCP policy violation(s)${NC}"
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo ""
        echo -e "${YELLOW}Resolution:${NC}"
        echo -e "  1. Remove non-CORTEX MCP servers from configuration"
        echo -e "  2. Run: python .cortex/setup-mcp.py --cleanup"
        echo -e "  3. Re-stage and commit"
        echo ""
        echo -e "${CYAN}Policy: CORTEX MCP must be the ONLY MCP server${NC}"
        echo ""
        exit 1
    fi
    
    echo -e "${GREEN}✅ MCP policy: CORTEX-only verified${NC}"
fi

# AC_COMPLETE: AC-PHASE50-MCPCLEANUP-002 ✅

echo ""
echo -e "${GREEN}✅ All pre-commit checks passed${NC}"
exit 0

# AC_COMPLETE: AC-PHASE71-S2-001 ✅
