#!/bin/bash
# AC_START: AC-PHASE71-S2-001 + AC-PHASE2-GAP002-001
# CORTEX Pre-Commit Hook: Markdown Artifact Prevention + Governance Alignment
# Phase 71 S2: Block unauthorized root markdown files
# Phase 2 S5: Validate governance alignment on CORE rule changes

set -e

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}🔍 Running CORTEX Pre-Commit Checks...${NC}"

# ============================================================================
# CHECK 1: Markdown Artifact Prevention
# ============================================================================

# Get list of staged markdown files in root
STAGED_ROOT_MD=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^[^/]+\.md$' || true)

if [ -n "$STAGED_ROOT_MD" ]; then
    # Check each root markdown file
    VIOLATIONS=0
    ALLOWED_FILES=("README.md")
    
    while IFS= read -r file; do
        # Check if file is in allowed list
        ALLOWED=0
        for allowed in "${ALLOWED_FILES[@]}"; do
            if [ "$file" = "$allowed" ]; then
                ALLOWED=1
                break
            fi
        done
        
        if [ $ALLOWED -eq 0 ]; then
            echo -e "${RED}❌ CORE-002 VIOLATION: Blocked root markdown file: $file${NC}"
            echo -e "${YELLOW}   Only .github/prompts/*.md, .github/agents/*.md, README.md allowed${NC}"
            VIOLATIONS=$((VIOLATIONS + 1))
        fi
    done <<< "$STAGED_ROOT_MD"
    
    if [ $VIOLATIONS -gt 0 ]; then
        echo ""
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${RED}Pre-commit check FAILED (Markdown Prevention)${NC}"
        echo -e "${RED}Found $VIOLATIONS unauthorized root markdown file(s)${NC}"
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo ""
        echo -e "${YELLOW}Resolution:${NC}"
        echo -e "  1. Remove markdown files (display findings inline in chat)"
        echo -e "  2. Or move to allowed paths (.github/prompts/, .github/agents/)"
        echo -e "  3. Or unstage: git reset HEAD <file>"
        echo ""
        exit 1
    fi
fi

# ============================================================================
# CHECK 2: Governance Alignment Validation
# ============================================================================

# Check if any governance files changed
GOVERNANCE_FILES=$(git diff --cached --name-only --diff-filter=ACM | \
    grep -E '(copilot-instructions\.md|cortex-architect\.prompt\.md|core-rules\.yaml|enforcement_orchestrator\.py)' || true)

if [ -n "$GOVERNANCE_FILES" ]; then
    echo -e "${BLUE}📋 Governance files changed, validating alignment...${NC}"
    
    # Run alignment validation script
    if python3 scripts/validate_governance_alignment.py; then
        echo -e "${GREEN}✅ Governance alignment: VALID${NC}"
    else
        echo ""
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${RED}Pre-commit check FAILED (Governance Alignment)${NC}"
        echo -e "${RED}CORE-002 misalignment detected across layers${NC}"
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo ""
        echo -e "${YELLOW}Resolution:${NC}"
        echo -e "  1. Ensure all 6 layers use same allowed paths:"
        echo -e "     - .github/prompts/*.md"
        echo -e "     - .github/agents/*.md"
        echo -e "     - README.md"
        echo -e "  2. Run: python3 scripts/validate_governance_alignment.py"
        echo -e "  3. Fix misalignments and re-commit"
        echo ""
        exit 1
    fi
fi

echo ""
echo -e "${GREEN}✅ All pre-commit checks passed${NC}"
exit 0

# AC_COMPLETE: AC-PHASE71-S2-001 ✅
