#!/bin/bash
# AC_START: AC-PHASE71-S2-001 + AC-PHASE2-GAP002-001
# CORTEX Pre-Commit Hook: Markdown Artifact Prevention + Governance Alignment
# Phase 71 S2: Block unauthorized root markdown files
# Phase 2 S5: Validate governance alignment on CORE rule changes

set -e

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}🔍 CORTEX Pre-Commit (optimized)...${NC}"

# Cache staged files once
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Cache staged files once
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# ============================================================================
# CHECK 1: Markdown Artifact Prevention
# ============================================================================

STAGED_ROOT_MD=$(echo "$STAGED_FILES" | grep -E '^[^/]+\.md$' || true)

if [ -n "$STAGED_ROOT_MD" ]; then
    # Check each root markdown file
    VIOLATIONS=0
    ALLOWED_FILES=("README.md")
    
    while IFS= read -r file; do
        # Check if file is in allowed list
        ALLOWED=0
        for allowed in "${ALLOWED_FILES[@]}"; do
            if [ "$file" = "$allowed" ]; then
                ALLOWED=1
                break
            fi
        done
        
        if [ $ALLOWED -eq 0 ]; then
            echo -e "${RED}❌ CORE-002 VIOLATION: Blocked root markdown file: $file${NC}"
            echo -e "${YELLOW}   Only .github/prompts/*.md, .github/agents/*.md, README.md allowed${NC}"
            VIOLATIONS=$((VIOLATIONS + 1))
        fi
    done <<< "$STAGED_ROOT_MD"
    
    if [ $VIOLATIONS -gt 0 ]; then
        echo ""
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${RED}Pre-commit check FAILED (Markdown Prevention)${NC}"
        echo -e "${RED}Found $VIOLATIONS unauthorized root markdown file(s)${NC}"
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo ""
        echo -e "${YELLOW}Resolution:${NC}"
        echo -e "  1. Remove markdown files (display findings inline in chat)"
        echo -e "  2. Or move to allowed paths (.github/prompts/, .github/agents/)"
        echo -e "  3. Or unstage: git reset HEAD <file>"
        echo ""
        exit 1
    fi
fi

# ============================================================================
# CHECK 2: Governance Alignment Validation (Skip if no changes)
# ============================================================================

GOVERNANCE_FILES=$(echo "$STAGED_FILES" | \
    grep -E '(copilot-instructions\.md|cortex-architect\.prompt\.md|core-rules\.yaml|enforcement_orchestrator\.py)' || true)

if [ -n "$GOVERNANCE_FILES" ]; then
    echo -e "${BLUE}📋 Governance files changed, validating alignment...${NC}"
    
    # Run alignment validation script
    if python3 scripts/validate_governance_alignment.py; then
        echo -e "${GREEN}✅ Governance alignment: VALID${NC}"
    else
        echo ""
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${RED}Pre-commit check FAILED (Governance Alignment)${NC}"
        echo -e "${RED}CORE-002 misalignment detected across layers${NC}"
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo ""
        echo -e "${YELLOW}Resolution:${NC}"
        echo -e "  1. Ensure all 6 layers use same allowed paths:"
        echo -e "     - .github/prompts/*.md"
        echo -e "     - .github/agents/*.md"
        echo -e "     - README.md"
        echo -e "  2. Run: python3 scripts/validate_governance_alignment.py"
        echo -e "  3. Fix misalignments and re-commit"
        echo ""
        exit 1
    fi
fi

# ============================================================================
# CHECK 3: Registry Blacklist (CORE-056) - CONSOLIDATED & OPTIMIZED
# ============================================================================

# Detect ARCHITECT mode
ARCHITECT_MODE=0
[ -d ".cortex" ] || [ -f "cortex/__init__.py" ] && [ -d "cortex-registry" ] && ARCHITECT_MODE=1
[ "$CORTEX_MODE" = "architect" ] && ARCHITECT_MODE=1

# Single pass through registry patterns
STAGED_BLACKLIST=$(echo "$STAGED_FILES" | \
    grep -E 'cortex-registry/_cortex-master/(index\.yaml|phases/|waves/|execution/|meta/)' || true)

if [ -n "$STAGED_BLACKLIST" ]; then
    if [ $ARCHITECT_MODE -eq 1 ]; then
        echo -e "${YELLOW}⚠️  ARCHITECT MODE: Internal registry updates allowed${NC}"
    else
        # Filter exceptions
        FILTERED_BLACKLIST=$(echo "$STAGED_BLACKLIST" | \
            grep -v 'governance/' | grep -v 'enhancements/' | grep -v 'directives/' | grep -v 'WAVE-' || true)
        
        if [ -n "$FILTERED_BLACKLIST" ]; then
            echo -e "${RED}❌ CORE-056 VIOLATION: Registry blacklist${NC}"
            echo -e "${YELLOW}Files: $(echo "$FILTERED_BLACKLIST" | tr '\n' ' ')${NC}"
            exit 1
        fi
    fi
fi

# ============================================================================
# CHECK 4: MCP Configuration Policy (Optimized)
# ============================================================================

MCP_CONFIG_CHANGES=$(echo "$STAGED_FILES" | grep -E '\.vscode/(mcp\.json|settings\.json)' || true)

if [ -n "$MCP_CONFIG_CHANGES" ]; then
    MCP_VIOLATIONS=0
    
    if echo "$MCP_CONFIG_CHANGES" | grep -q "mcp.json"; then
        NON_CORTEX=$(git show :".vscode/mcp.json" 2>/dev/null | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
    non_cortex = [s for s in data.get('mcpServers', {}).keys() if s != 'cortex']
    print(' '.join(non_cortex) if non_cortex else '')
except: pass
" 2>/dev/null || echo "")
        
        [ -n "$NON_CORTEX" ] && MCP_VIOLATIONS=$((MCP_VIOLATIONS + 1))
    fi
    
    if [ $MCP_VIOLATIONS -gt 0 ]; then
        echo -e "${RED}❌ MCP POLICY VIOLATION: Non-CORTEX servers detected${NC}"
        exit 1
    fi
fi

# ============================================================================
# CHECK 5: CORE-095/096 Governance (Optimized)
# ============================================================================

# Only run if staging files in monitored paths
if echo "$STAGED_FILES" | grep -qE '^[^/]+/'; then
    # CORE-095: Folder structure (fast check)
    APPROVED_FOLDERS="cortex|cortex_brain|cortex_lens|cortex-registry|tests|docs|company|deployment|scripts|_archives|_workspaces"
    UNAPPROVED=$(echo "$STAGED_FILES" | grep -v '^\.' | sed 's|/.*||' | sort -u | grep -vE "^($APPROVED_FOLDERS)$" || true)
    
    if [ -n "$UNAPPROVED" ]; then
        echo -e "${RED}❌ CORE-095: Unapproved folders: $(echo $UNAPPROVED | tr '\n' ' ')${NC}"
        exit 1
    fi
    
    # CORE-096: Build artifacts (fast check)
    if echo "$STAGED_FILES" | grep -qE '(dist/|build/|__pycache__|\.pyc$|\.egg-info/)'; then
        echo -e "${RED}❌ CORE-096: Build artifacts detected${NC}"
        exit 1
    fi
fi

echo ""
echo -e "${GREEN}✅ All pre-commit checks passed${NC}"
exit 0

# AC_COMPLETE: AC-PHASE71-S2-001 ✅
