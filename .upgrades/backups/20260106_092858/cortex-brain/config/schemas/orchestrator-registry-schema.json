{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orchestrator Registry Schema",
  "description": "Schema for cortex-brain/config/mcp-server.yaml - Defines orchestrator registration",
  "type": "object",
  "required": ["orchestrators"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Registry schema version",
      "pattern": "^\\d+\\.\\d+$"
    },
    "server": {
      "type": "object",
      "description": "MCP server configuration (optional)"
    },
    "orchestrators": {
      "type": "object",
      "description": "Map of orchestrator ID to orchestrator definition",
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "object",
          "required": ["class", "module", "config", "type"],
          "properties": {
            "class": {
              "type": "string",
              "description": "Python class name (PascalCase)",
              "pattern": "^[A-Z][a-zA-Z0-9]+$",
              "examples": ["VacuumOrchestratorV2", "PlanningOrchestratorV5"]
            },
            "module": {
              "type": "string",
              "description": "Python module path (dot-separated)",
              "pattern": "^src\\.(orchestrators|cortex_agents|operations)\\.[a-z0-9_.]+$",
              "examples": [
                "src.orchestrators.vacuum.vacuum_orchestrator_v2",
                "src.orchestrators.planning.planning_orchestrator_v5"
              ]
            },
            "config": {
              "type": "string",
              "description": "Path to YAML manifest file (must exist)",
              "pattern": "^cortex-brain/manifests/orchestrators/[a-z0-9-.]+\\.yaml$",
              "examples": [
                "cortex-brain/manifests/orchestrators/vacuum-orchestrator-v2.yaml",
                "cortex-brain/manifests/orchestrators/planning-system-4.0-manifest.yaml"
              ]
            },
            "type": {
              "type": "string",
              "description": "Orchestrator execution mode",
              "enum": ["autonomous", "guided"],
              "examples": ["autonomous"]
            },
            "description": {
              "type": "string",
              "description": "Human-readable description",
              "minLength": 10,
              "maxLength": 200,
              "examples": ["Deep filesystem cleanup and reorganization"]
            },
            "version": {
              "type": "string",
              "description": "Semantic version",
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "examples": ["2.0.0", "4.0.1"]
            },
            "modes": {
              "type": "array",
              "description": "Supported execution modes",
              "items": {
                "type": "string",
                "enum": ["auto", "wizard", "interactive", "batch"]
              },
              "examples": [["auto", "wizard"]]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  
  "examples": [
    {
      "orchestrators": {
        "vacuum": {
          "class": "VacuumOrchestratorV2",
          "module": "src.orchestrators.vacuum.vacuum_orchestrator_v2",
          "config": "cortex-brain/manifests/orchestrators/vacuum-orchestrator-v2.yaml",
          "type": "autonomous",
          "description": "Deep filesystem cleanup and reorganization"
        }
      }
    }
  ]
}
