#!/usr/bin/env python3
"""
Pre-commit hook: File Naming Enforcement

Blocks commits with CORE-028 violations (non-kebab-case test files).

Authority: AC-GOLDEN-FRAMEWORK-003
Install: git config core.hooksPath .githooks
"""
import sys
from pathlib import Path

# Add scripts to path
sys.path.insert(0, str(Path(__file__).parent.parent / "scripts"))

from enforce_test_naming import scan_test_files


def main():
    """Run file naming check on staged files."""
    print("🔍 Checking file naming compliance (CORE-028)...")
    
    violations = scan_test_files(Path("tests"))
    
    if not violations:
        print("✅ All test files comply with CORE-028 (kebab-case)")
        return 0
    
    print(f"\n❌ COMMIT BLOCKED: {len(violations)} naming violation(s) found\n")
    for violation in violations[:5]:  # Show first 5
        print(violation)
    
    if len(violations) > 5:
        print(f"\n... and {len(violations) - 5} more violations")
    
    print("\n🔧 FIX: python3 scripts/enforce-test-naming.py --fix")
    print("Then retry commit.")
    
    return 1


if __name__ == "__main__":
    sys.exit(main())
