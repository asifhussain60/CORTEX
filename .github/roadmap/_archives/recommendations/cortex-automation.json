    "user_interaction": "Single CLI command replaces all manual steps"
  },

  "automation_architecture": {
    "layers": [
      {
        "name": "CLI Interface Layer",
        "commands": [
          "pytest-cortex-generate phase1 --use-real-orchestrators",
          "pytest-cortex-generate phase2 --analysis=badmonolith",
          "pytest-cortex-generate phase3 --tdd-phases",
          "cortex-test-suite init --challenge=badmonolith-refactor --phases=1,2,3"
        ],
        "user_intervention": "ZERO"
      },
      {
        "name": "Test Scaffolding Engine",
        "capabilities": [
          "Template loading from DomainTemplateFactory",
          "Test file generation with auto-injection",
          "Governance validation before generation",
          "AC-ID auto-detection and injection",
          "Audit trail pre-configuration"
        ],
        "implementation_hours": 6
      },
      {
        "name": "Fixture Composition Layer",
        "enhancements": [
          "FixtureCompositionFactory (NEW)",
          "cortex_test_context fixture (ENHANCED)",
          "Orchestrator injection system",
          "Audit logger configuration",
          "Response header pre-injection"
        ],
        "implementation_hours": 8
      },
      {
        "name": "Orchestrator Execution Layer",
        "usage": "Real instances (not mocked)",
        "orchestrators": [
          "MasterOrchestrator",
          "PlanningOrchestrator",
          "InteractionOrchestrator",
          "TDDOrchestrator",
          "HousekeepingOrchestrator"
        ],
        "audit_capture": "Complete with hash chain validation"
      }
    ]
  },

