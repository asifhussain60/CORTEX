  "technical_components": {
    "new_classes": [
      {
        "name": "TestScaffoldingEngine",
        "responsibilities": [
          "generate_phase_tests(phase, config) → test_file",
          "validate_governance(test_code) → bool",
          "inject_fixtures(test_code) → enhanced_code",
          "auto_detect_ac_id(test_code) → ac_id",
          "configure_audit_trail(test_code) → configured_code"
        ],
        "dependencies": [
          "DomainTemplateFactory",
          "GovernanceValidator",
          "AuditTrailConfigurator"
        ],
        "implementation_hours": 6
      },
      {
        "name": "FixtureCompositionFactory",
        "responsibilities": [
          "create_cortex_context(phase) → ExecutionContext",
          "provide_orchestrator_instance(name) → Orchestrator",
          "provide_audit_logger() → AuditLogger",
          "provide_response_headers(domain) → Dict"
        ],
        "dependencies": [
          "DomainTemplateFactory",
          "OrchestratorRegistry",
          "AuditLogger"
        ],
        "implementation_hours": 4
      }
    ],
    "enhanced_fixtures": [
      {
        "name": "cortex_test_context",
        "provides": [
          "governance_rules",
          "orchestrator_instances",
          "audit_logger",
          "response_headers",
          "ac_id_tracking"
        ],
        "auto_injected": true
      }
    ],
    "cli_commands": [
      {
        "name": "pytest-cortex-generate",
        "subcommands": [
          {
            "name": "phase1",
            "options": "--use-real-orchestrators",
            "generates": "test_orchestrator_coordination_phase1_gen.py"
          },
          {
            "name": "phase2",
            "options": "--analysis=badmonolith",
            "generates": "test_monolith_analysis_phase2_gen.py"
          },
          {
            "name": "phase3",
            "options": "--tdd-phases",
            "generates": "test_tdd_phase3_gen.py"
          }
        ]
      },
      {
        "name": "cortex-test-suite",
        "subcommands": [
          {
            "name": "init",
            "options": "--challenge=badmonolith-refactor --phases=1,2,3",
            "generates": "complete_test_suite_with_audit_config"
          }
        ]
      }
    ]
  },

