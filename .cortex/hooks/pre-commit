#!/bin/zsh
# Pre-commit hook: Prevent copyright lines in Python source files
# Enforces: Copyright statements only in .md docs and response headers, never in .py code

FORBIDDEN_PATTERNS=(
    "Copyright © "
    "Copyright (c) "
    "All rights reserved"
)

# Check staged Python files
git diff --cached --name-only --diff-filter=ACM | grep '\.py$' | while read pyfile; do
    for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
        if git show ":$pyfile" | grep -q "$pattern"; then
            echo "❌ CORE-VIOLATION: File '$pyfile' contains copyright statement"
            echo "   Per CORTEX.prompt.md, copyright only in responses/docs, never in .py files"
            exit 1
        fi
    done
done

# Check for bare except clauses (CORE-013 CRITICAL)
git diff --cached --name-only --diff-filter=ACM | grep '\.py$' | while read pyfile; do
    if git show ":$pyfile" | grep -E '^\s*except\s*:' > /dev/null; then
        echo "❌ CORE-013 BLOCKER: Bare except clause in '$pyfile'"
        echo "   Use specific exception handling instead"
        exit 1
    fi
done

# Check type hints on public functions (CORE-011)
git diff --cached --name-only --diff-filter=ACM | grep '\.py$' | while read pyfile; do
    # Quick check: look for 'def ' followed by function name with no type hints
    if git show ":$pyfile" | grep -E '^\s*def [a-z_]+\([^)]*\)\s*:' | grep -v ' ->' > /dev/null; then
        echo "⚠️  CORE-011: Function in '$pyfile' may lack return type hints"
        echo "   Review and add '-> ReturnType' if needed"
    fi
done

# ========================================
# FILE PLACEMENT ENFORCEMENT (CORE-038)
# Authority: AC-FILE-PLACEMENT-ENFORCEMENT-001
# ========================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

STAGED_FILES=$(git diff --cached --name-only)
VIOLATIONS=()

# Check for files in forbidden root locations
for FILE in $STAGED_FILES; do
    # Pattern 1: Root-level .md/.py/.yaml files
    if [[ $FILE =~ ^\./[^/]+\.(md|py|yaml|yml)$ ]]; then
        FILENAME=$(basename "$FILE")
        if [[ ! "$FILENAME" =~ ^(README\.md|requirements\.txt|pytest\.ini|cortex-config\.yaml|cortex-impl-map\.yaml|mkdocs\.yml|pyrightconfig\.json|setup\.(py|cfg)|pyproject\.toml)$ ]]; then
            VIOLATIONS+=("$FILE")
        fi
    fi
    
    # Pattern 2: Files in reports/ root (must be in subfolder)
    if [[ $FILE =~ ^reports/[^/]+\.(md|yaml|yml)$ ]]; then
        VIOLATIONS+=("$FILE")
    fi
    
    # Pattern 3: Files in docs/ root (must be in subfolder)
    if [[ $FILE =~ ^docs/[^/]+\.md$ ]]; then
        FILENAME=$(basename "$FILE")
        if [[ "$FILENAME" != "README.md" ]]; then
            VIOLATIONS+=("$FILE")
        fi
    fi
    
    # Pattern 4: Files in cortex/ root (must be in subfolder)
    if [[ $FILE =~ ^cortex/[^/]+\.py$ ]]; then
        VIOLATIONS+=("$FILE")
    fi
    
    # Pattern 5: Files in cortex_brain/ root (must be in subfolder)
    if [[ $FILE =~ ^cortex_brain/[^/]+\.py$ ]]; then
        VIOLATIONS+=("$FILE")
    fi
done

if [ ${#VIOLATIONS[@]} -gt 0 ]; then
    echo -e "${RED}❌ FILE PLACEMENT VIOLATION (CORE-038)${NC}"
    echo ""
    echo -e "${RED}ERROR: Files detected in forbidden root locations:${NC}"
    for VIOLATION in "${VIOLATIONS[@]}"; do
        echo -e "  ${RED}✗${NC} $VIOLATION"
    done
    echo ""
    echo -e "${YELLOW}SOLUTION: Move to appropriate subfolders${NC}"
    echo "  • .md files → docs/{subfolder}/kebab-case-name.md"
    echo "  • Reports → reports/{subfolder}/kebab-case-name.md"
    echo "  • .py files → cortex/{module}/kebab-case-name.py"
    echo ""
    exit 1
fi

# ========================================
# FILE NAMING ENFORCEMENT (CORE-028)
# Authority: AC-NAMING-002 (Updated 2026-01-28)
# CORE-028: Python modules MUST use snake_case (underscores, not hyphens)
# Hyphens in .py filenames cause SyntaxError on import
# ========================================

echo -e "\n${GREEN}Checking CORE-028 file naming compliance...${NC}"

NAMING_VIOLATIONS=()

# Check staged Python files for naming violations
for FILE in $(git diff --cached --name-only --diff-filter=ACM | grep '\.py$'); do
    FILENAME=$(basename "$FILE")
    FILENAME_NO_EXT="${FILENAME%.py}"
    
    # For Python files: check for hyphens (FORBIDDEN - must use underscores)
    if [[ "$FILENAME_NO_EXT" =~ - ]]; then
        SUGGESTED=$(echo "$FILENAME_NO_EXT" | tr '-' '_')
        NAMING_VIOLATIONS+=("$FILE|HYPHEN|$SUGGESTED.py|Python modules must use snake_case (underscores) - hyphens cause SyntaxError")
    fi
    
    # Check for length (advisory warning, not hard error)
    if [ ${#FILENAME_NO_EXT} -gt 40 ]; then
        echo -e "  ${YELLOW}⚠️  $FILE${NC}"
        echo -e "    ${YELLOW}Advisory:${NC} Filename exceeds 40 characters (consider shortening for readability)"
    fi
done

if [ ${#NAMING_VIOLATIONS[@]} -gt 0 ]; then
    echo -e "\n${RED}❌ CORE-028 FILE NAMING VIOLATION${NC}"
    echo -e "${RED}Python modules MUST use snake_case (underscores). Hyphens cause SyntaxError.${NC}"
    echo ""
    
    for VIOLATION in "${NAMING_VIOLATIONS[@]}"; do
        IFS='|' read -r FILEPATH TYPE SUGGESTED REASON <<< "$VIOLATION"
        echo -e "  ${RED}✗${NC} $FILEPATH"
        echo -e "    ${YELLOW}Issue:${NC} $REASON"
        echo -e "    ${GREEN}Suggested:${NC} $SUGGESTED"
        echo ""
    done
    
    echo -e "${YELLOW}To fix naming violations:${NC}"
    echo "  1. Rename files to use snake_case (underscores instead of hyphens)"
    echo "  2. Update imports across the codebase"
    echo "  Authority: CORE-028 (Python modules MUST use snake_case)"
    echo ""
    exit 1
fi

echo -e "${GREEN}✓ All files comply with CORE-028 naming policy (snake_case for Python)${NC}"

exit 0
