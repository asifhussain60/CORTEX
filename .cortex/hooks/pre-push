#!/bin/bash
# =============================================================================
# CORTEX Pre-Push Hook: Production Readiness Verification
# =============================================================================
# Authority: CORE-035 (Single Canonical Implementation)
# AC-ID: AC-PRE-PUSH-001
#
# INSTALLATION:
#   cp .cortex/hooks/pre-push .git/hooks/pre-push
#   chmod +x .git/hooks/pre-push
#
# This hook BLOCKS push if production readiness verification fails.
# Ensures machines pulling from remote receive 100% production-ready code.
#
# Checks performed (12 total):
#   1. All 23 orchestrators wired
#   2. LENS Intelligence operational
#   3. MasterOrchestrator full control
#   4. Machine-readable configuration
#   5. Single execution path (CORE-035) - CRITICAL
#   6. Clean test suite (35+ tests)
#   7. Docker-plan compliance
#   8. Production readiness (Tier 1)
#   9. MCP exposure (9+ tools)
#  10. Docker configuration valid
#  11. Database cleanliness
#  12. Prompt-Code Synchronization (CORE-030) ⭐ TEAM COLLABORATION
# =============================================================================

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Get script directory
CORTEX_ROOT="$(git rev-parse --show-toplevel)"
VERIFY_SCRIPT="$CORTEX_ROOT/_workspaces/docker-plan/verify_prod_ready.py"
PYTHON="$CORTEX_ROOT/.venv/bin/python"

echo ""
echo -e "${BLUE}═══════════════════════════════════════════════════════════════════════${NC}"
echo -e "${BLUE}  🛡️  CORTEX PRE-PUSH VERIFICATION${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════════════════════════════${NC}"
echo ""

# Check Python environment exists
if [ ! -f "$PYTHON" ]; then
    echo -e "${YELLOW}⚠️  Virtual environment not found, using system python3${NC}"
    PYTHON="python3"
fi

# Check verification script exists
if [ ! -f "$VERIFY_SCRIPT" ]; then
    echo -e "${RED}❌ Verification script not found: $VERIFY_SCRIPT${NC}"
    echo -e "${YELLOW}   Skipping verification (script missing)${NC}"
    exit 0
fi

# Run verification
echo -e "${BLUE}Running production readiness verification...${NC}"
echo ""

cd "$CORTEX_ROOT"
PYTHONPATH="$CORTEX_ROOT" $PYTHON "$VERIFY_SCRIPT" --skip-docker 2>&1
RESULT=$?

echo ""

if [ $RESULT -eq 0 ]; then
    echo -e "${GREEN}═══════════════════════════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}  ✅ PRODUCTION READY - Push allowed${NC}"
    echo -e "${GREEN}═══════════════════════════════════════════════════════════════════════${NC}"
    exit 0
else
    echo -e "${RED}═══════════════════════════════════════════════════════════════════════${NC}"
    echo -e "${RED}  ❌ NOT PRODUCTION READY - Push BLOCKED${NC}"
    echo -e "${RED}═══════════════════════════════════════════════════════════════════════${NC}"
    echo ""
    echo -e "${YELLOW}To bypass (NOT RECOMMENDED):${NC}"
    echo -e "  git push --no-verify"
    echo ""
    echo -e "${YELLOW}To fix:${NC}"
    echo -e "  1. Review failed checks above"
    echo -e "  2. Run: PYTHONPATH=. python _workspaces/docker-plan/verify_prod_ready.py --verbose"
    echo -e "  3. Address each FAILED check"
    echo -e "  4. Re-attempt push"
    echo ""
    exit 1
fi
