<UserControl x:Class="CortexVSExtension.ToolWindows.CortexDashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="400"
             Background="{DynamicResource VsBrush.Window}"
             Loaded="UserControl_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="🧠 CORTEX Dashboard" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource VsBrush.WindowText}"/>
            <TextBlock Text="AI Assistant with long-term memory and context awareness" 
                       FontSize="11" 
                       Foreground="{DynamicResource VsBrush.GrayText}"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Workspace Info -->
        <GroupBox Grid.Row="1" Header="Workspace" 
                  Margin="0,0,0,10"
                  Foreground="{DynamicResource VsBrush.WindowText}"
                  BorderBrush="{DynamicResource VsBrush.ToolWindowBorder}">
            <StackPanel Margin="5">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="Context: " FontWeight="Bold" Width="100" 
                               Foreground="{DynamicResource VsBrush.WindowText}"/>
                    <TextBlock x:Name="ContextText" Text="Loading..." 
                               Foreground="{DynamicResource VsBrush.WindowText}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="CORTEX Path: " FontWeight="Bold" Width="100" 
                               Foreground="{DynamicResource VsBrush.WindowText}"/>
                    <TextBlock x:Name="CortexPathText" Text="Loading..." 
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource VsBrush.WindowText}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="Workspace: " FontWeight="Bold" Width="100" 
                               Foreground="{DynamicResource VsBrush.WindowText}"/>
                    <TextBlock x:Name="WorkspacePathText" Text="Loading..." 
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource VsBrush.WindowText}"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Quick Actions -->
        <GroupBox Grid.Row="2" Header="Quick Actions" 
                  Margin="0,0,0,10"
                  Foreground="{DynamicResource VsBrush.WindowText}"
                  BorderBrush="{DynamicResource VsBrush.ToolWindowBorder}">
            <StackPanel Margin="5">
                <Button x:Name="CreatePlanButton" Content="📋 Create Plan" 
                        Margin="0,2" Padding="5" Click="CreatePlanButton_Click"
                        Background="{DynamicResource VsBrush.ButtonFace}"
                        Foreground="{DynamicResource VsBrush.ButtonText}"/>
                <Button x:Name="StartTddButton" Content="🧪 Start TDD" 
                        Margin="0,2" Padding="5" Click="StartTddButton_Click"
                        Background="{DynamicResource VsBrush.ButtonFace}"
                        Foreground="{DynamicResource VsBrush.ButtonText}"/>
                <Button x:Name="MaintenanceButton" Content="🔧 System Maintenance" 
                        Margin="0,2" Padding="5" Click="MaintenanceButton_Click"
                        Background="{DynamicResource VsBrush.ButtonFace}"
                        Foreground="{DynamicResource VsBrush.ButtonText}"/>
                <Button x:Name="RefreshButton" Content="🔄 Refresh Dashboard" 
                        Margin="0,2" Padding="5" Click="RefreshButton_Click"
                        Background="{DynamicResource VsBrush.ButtonFace}"
                        Foreground="{DynamicResource VsBrush.ButtonText}"/>
            </StackPanel>
        </GroupBox>

        <!-- Recent Activity -->
        <GroupBox Grid.Row="3" Header="Recent Activity" 
                  Foreground="{DynamicResource VsBrush.WindowText}"
                  BorderBrush="{DynamicResource VsBrush.ToolWindowBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ActivityPanel" Margin="5">
                    <TextBlock Text="No recent activity" 
                               Foreground="{DynamicResource VsBrush.GrayText}"
                               FontStyle="Italic"/>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>
