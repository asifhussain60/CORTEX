    UNIT = "unit"
    INTEGRATION = "integration"
    FUNCTIONAL = "functional"
    PERFORMANCE = "performance"
    SECURITY = "security"
    END_TO_END = "end_to_end"


class TestStatus(Enum):
    """Status of a test."""
    PASSING = "passing"
    FAILING = "failing"
    SKIPPED = "skipped"
    PENDING = "pending"
    FLAKY = "flaky"


class QualityGate(Enum):
