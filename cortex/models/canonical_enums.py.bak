"""
Canonical Enum Definitions - Single Source of Truth (SSOT)

AC-ID: AC-PERMANENT-FIX-017
Purpose: Eliminate CORE-035 violations by consolidating 275+ duplicate enum definitions

This module serves as the SINGLE CANONICAL LOCATION for all enums used across CORTEX.
All other files must import enums from this module, never define duplicates.

Governance Rules:
- CORE-035: Single Canonical Implementation
- CORE-011: Type hints mandatory (all enums use Enum)
- CORE-030: Implementation Truth (this is the truth; other copies are errors)

Migration Strategy:
1. Search codebase for enum definitions
2. Replace with imports from this module
3. Delete original enum definitions
4. Validate circular import prevention
"""

from enum import Enum, IntEnum


# ============================================================================
# ACTION & EXECUTION ENUMS
# ============================================================================

class ActionType(Enum):
    """Types of actions."""
    CREATE = "create"
    MODIFY = "modify"
    DELETE = "delete"
    QUERY = "query"
    EXECUTE = "execute"
    ROLLBACK = "rollback"


class ExecutionMode(Enum):
    """Execution mode enumeration."""
    SYNCHRONOUS = "synchronous"
    ASYNCHRONOUS = "asynchronous"
    BATCH = "batch"
    STREAMING = "streaming"
    PARALLEL = "parallel"


class ExecutionStrategy(Enum):
    """Strategy for executing operations."""
    SEQUENTIAL = "sequential"
    PARALLEL = "parallel"
    DISTRIBUTED = "distributed"
    ADAPTIVE = "adaptive"
    FALLBACK = "fallback"





# ============================================================================
# ALERT & MONITORING ENUMS
# ============================================================================

class AlertSeverity(IntEnum):
    """Alert severity levels."""
    INFO = 0
    WARNING = 1
    CRITICAL = 2
    ERROR = 3


class AlertPriority(Enum):
    """Alert priority levels."""
    LOW = "low"
    MEDIUM = "medium"
    HIGH = "high"
    URGENT = "urgent"


class AlertState(Enum):
    """State of an alert."""
    ACTIVE = "active"
    ACKNOWLEDGED = "acknowledged"
    RESOLVED = "resolved"
    ESCALATED = "escalated"


# ============================================================================
# AUDIT & GOVERNANCE ENUMS
# ============================================================================

class AuditEventType(Enum):
    """Types of audit events."""
    ACCESS = "access"
    MODIFICATION = "modification"
    DELETION = "deletion"
    AUTHORIZATION = "authorization"
    AUTHENTICATION = "authentication"
    CONFIGURATION_CHANGE = "configuration_change"


class AuditAction(Enum):
    """Action being audited."""
    CREATE = "create"
    READ = "read"
    UPDATE = "update"
    DELETE = "delete"
    EXECUTE = "execute"
    ESCALATE = "escalate"


class AuditOperationType(Enum):
    """Type of operation being audited."""
    USER_LOGIN = "user_login"
    DATA_ACCESS = "data_access"
    CONFIGURATION_CHANGE = "configuration_change"
    PRIVILEGE_CHANGE = "privilege_change"
    SYSTEM_CHANGE = "system_change"


class ApprovalStatus(Enum):
    """Status of an approval."""
    PENDING = "pending"
    APPROVED = "approved"
    REJECTED = "rejected"
    ESCALATED = "escalated"
    EXPIRED = "expired"


class CheckpointStatus(Enum):
    """Status of a checkpoint."""
    CREATED = "created"
    VALIDATED = "validated"
    COMMITTED = "committed"
    ROLLED_BACK = "rolled_back"
    FAILED = "failed"


# ============================================================================
# CHALLENGE & INTENT ENUMS
# ============================================================================

class ChallengeType(Enum):
    """Types of challenges generated by ChallengeEngine."""
    BETTER_SOLUTION = "better_solution"
    MISSING_CONTEXT = "missing_context"
    CLARIFICATION_NEEDED = "clarification_needed"
    ALTERNATIVE_APPROACH = "alternative_approach"
    PERFORMANCE_CONCERN = "performance_concern"
    SECURITY_RISK = "security_risk"
    SCALABILITY_ISSUE = "scalability_issue"
    MAINTAINABILITY_CONCERN = "maintainability_concern"


class ChallengeCategory(Enum):
    """Category of challenge."""
    TECHNICAL = "technical"
    BUSINESS = "business"
    PROCESS = "process"
    ARCHITECTURE = "architecture"
    PERFORMANCE = "performance"


class IntentType(Enum):
    """Types of user intents."""
    IMPLEMENT = "implement"
    FIX = "fix"
    REFACTOR = "refactor"
    ANALYZE = "analyze"
    DOCUMENT = "document"
    TEST = "test"
    DEPLOY = "deploy"
    GOVERNANCE = "governance"


class RoutingType(Enum):
    """Types of routing paths."""
    DIRECT = "direct"
    CACHED = "cached"
    FUZZY = "fuzzy"
    COMPOSITE = "composite"
    FALLBACK = "fallback"


# ============================================================================
# CHANGE & VERSION ENUMS
# ============================================================================

class ChangeType(Enum):
    """Type of change being tracked."""
    FEATURE = "feature"
    BUGFIX = "bugfix"
    REFACTOR = "refactor"
    DOCUMENTATION = "documentation"
    PERFORMANCE = "performance"
    SECURITY = "security"
    BREAKING = "breaking"


class BrainTier(Enum):
    """CORTEX brain hierarchy tiers."""
    TIER_0 = "tier_0"
    TIER_1 = "tier_1"
    TIER_2 = "tier_2"
    TIER_3 = "tier_3"


class TierType(Enum):
    """Types of tiers."""
    GOVERNANCE = "governance"
    ACCEPTANCE = "acceptance"
    TEMPLATES = "templates"
    KNOWLEDGE = "knowledge"


# ============================================================================
# CIRCUIT BREAKER & RESILIENCE ENUMS
# ============================================================================

class CircuitBreakerState(IntEnum):
    """States of the circuit breaker."""
    CLOSED = 0      # Normal operation
    OPEN = 1        # Failing, requests rejected
    HALF_OPEN = 2   # Testing recovery


# ============================================================================
# COHERENCE & VALIDATION ENUMS
# ============================================================================

class CoherenceType(Enum):
    """Types of coherence checks."""
    SEMANTIC = "semantic"
    SYNTACTIC = "syntactic"
    LOGICAL = "logical"
    TEMPORAL = "temporal"
    REFERENTIAL = "referential"


class ValidationLevel(Enum):
    """Levels of validation."""
    STRICT = "strict"
    NORMAL = "normal"
    LENIENT = "lenient"
    NONE = "none"


# ============================================================================
# CONTINUATION & DECISION ENUMS
# ============================================================================

class ContinuationReason(Enum):
    """Reason for continuing conversation."""
    MORE_CONTEXT_NEEDED = "more_context_needed"
    CLARIFICATION_NEEDED = "clarification_needed"
    REFINEMENT_NEEDED = "refinement_needed"
    FOLLOW_UP = "follow_up"
    VALIDATION = "validation"


class DecisionStatus(Enum):
    """Status of a decision."""
    PENDING = "pending"
    MADE = "made"
    IMPLEMENTED = "implemented"
    REVIEWED = "reviewed"
    REVISED = "revised"


# ============================================================================
# GOVERNANCE & TIER ENUMS
# ============================================================================

class GovernanceStatus(Enum):
    """Status of governance check."""
    COMPLIANT = "compliant"
    NON_COMPLIANT = "non_compliant"
    WARNING = "warning"
    ESCALATED = "escalated"
    EXEMPT = "exempt"


class RuleType(Enum):
    """Type of governance rule."""
    MANDATORY = "mandatory"
    RECOMMENDED = "recommended"
    OPTIONAL = "optional"
    DEPRECATED = "deprecated"


# ============================================================================
