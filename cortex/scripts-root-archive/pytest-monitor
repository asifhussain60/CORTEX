#!/usr/bin/env python3
"""pytest-monitor: Run pytest with real-time progress monitoring.

Usage:
    pytest-monitor tests/unit/core/ -v --tb=short
    pytest-monitor tests/ -q --tb=no --hang-timeout=60
    pytest-monitor tests/unit/infrastructure/ --collect-only --verbose-progress
"""

import sys
import argparse
from pathlib import Path

# Add cortex to path
cortex_path = Path(__file__).parent.parent.parent / "cortex"
sys.path.insert(0, str(cortex_path.parent))

from cortex.devx.test_progress_monitor import run_tests_with_progress


def main() -> int:
    """Main entry point."""
    parser = argparse.ArgumentParser(
        description="Run pytest with real-time progress monitoring and hanging detection",
        prog="pytest-monitor"
    )
    
    parser.add_argument(
        "test_path",
        nargs="?",
        default="tests/",
        help="Path to tests (default: tests/)"
    )
    
    parser.add_argument(
        "--hang-timeout",
        type=int,
        default=30,
        help="Seconds without output before reporting hanging (default: 30)"
    )
    
    parser.add_argument(
        "--verbose-progress",
        action="store_true",
        help="Print real-time progress updates (default: enabled)"
    )
    
    parser.add_argument(
        "--quiet",
        "-q",
        action="store_true",
        help="Quiet mode - minimal progress output"
    )
    
    # Pass remaining args to pytest
    args, pytest_args = parser.parse_known_args()
    
    return run_tests_with_progress(
        test_path=args.test_path,
        pytest_args=pytest_args,
        hang_timeout=args.hang_timeout,
        verbose=not args.quiet
    )


if __name__ == "__main__":
    sys.exit(main())
