#!/usr/bin/env bash
# CORTEX GitHub Pages Publisher
# Simple command to deploy documentation to GitHub Pages
# Usage: ./scripts/publish

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

cd "$REPO_ROOT"

echo "╔════════════════════════════════════════════════════════════╗"
echo "║  🧠 CORTEX GitHub Pages Publisher                         ║"
echo "║  Author: Asif Hussain                                     ║"
echo "╚════════════════════════════════════════════════════════════╝"
echo ""

# Check for uncommitted changes
if ! git diff-index --quiet HEAD --; then
    echo "⚠️  Warning: You have uncommitted changes."
    echo ""
    echo "Options:"
    echo "  1. Commit changes first (recommended)"
    echo "  2. Stash changes temporarily"
    echo "  3. Proceed anyway (not recommended)"
    echo ""
    read -p "Choose [1/2/3]: " choice
    case $choice in
        1)
            echo ""
            read -p "Enter commit message: " commit_msg
            git add -A
            git commit -m "$commit_msg"
            git push origin CORTEX-4.0
            echo "✅ Changes committed and pushed"
            echo ""
            ;;
        2)
            git stash
            echo "✅ Changes stashed"
            echo ""
            ;;
        3)
            echo "⚠️  Proceeding with uncommitted changes..."
            echo ""
            ;;
        *)
            echo "❌ Invalid choice. Exiting."
            exit 1
            ;;
    esac
fi

# Run the deployment script
echo "🚀 Starting GitHub Pages deployment..."
echo ""
bash "$SCRIPT_DIR/deploy_to_ghpages.sh"

echo ""
echo "╔════════════════════════════════════════════════════════════╗"
echo "║  ✅ DEPLOYMENT COMPLETE                                    ║"
echo "╚════════════════════════════════════════════════════════════╝"
echo ""
echo "📍 Your site is available at:"
echo "   🌐 https://asifhussain60.github.io/CORTEX/"
echo "   📊 Story Viewer: https://asifhussain60.github.io/CORTEX/story/viewer.html"
echo "   📚 Knowledge Base: https://asifhussain60.github.io/CORTEX/knowledge/"
echo ""
echo "⏱️  Note: It may take 1-2 minutes for changes to appear."
echo ""
