#!/bin/bash
#
# CORTEX Optimize - Quick Access Script
#
# Makes optimization commands easier to type.
# Add to PATH or source in .bashrc/.zshrc
#
# Usage:
#   optimize tokens status
#   optimize tokens auto
#   optimize files all
#   optimize all
#

# Get CORTEX root directory (assuming script is in CORTEX/scripts/)
CORTEX_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Run the Python optimize module
cd "$CORTEX_ROOT"
python3 -m src.operations.optimize "$@"
