#!/bin/bash
#
# CORTEX 6.0 Pre-Commit Hook (Enhanced)
# 
# Validates before every commit:
# 1. Audit trail verification (ensures work is logged with SUCCESS evidence)
# 2. Architecture compliance (test structure, core components)
# 3. SKULL rule compliance (brain protection)
#
# KEY PRINCIPLE: If audit log verification ERRORS or shows no evidence
# of successful work, the commit is REJECTED.
#
# Author: Asif Hussain
# Copyright © 2025-2026 Asif Hussain. All rights reserved.
#
# Installation:
#   cp scripts/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# To bypass (emergency only):
#   git commit --no-verify
#

# DO NOT use set -e - we need to capture exit codes explicitly
# set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Handle both .git/hooks location and scripts/ location
if [[ "$SCRIPT_DIR" == *".git/hooks"* ]]; then
    PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
else
    PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
fi

echo ""
echo "🧠 CORTEX 6.0 Pre-Commit Validation (Enhanced)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Check if we have staged changes
STAGED_COUNT=$(git diff --cached --name-only | wc -l | tr -d ' ')
if [ "$STAGED_COUNT" -eq "0" ]; then
    echo "⚠️  No staged changes detected"
    exit 0
fi

echo "📁 Staged files: $STAGED_COUNT"

# ============================================================================
# Step 1: Audit Trail Verification (STRICT)
# ============================================================================
echo ""
echo "📝 Step 1: Audit Trail Verification (STRICT MODE)"
echo "------------------------------------------------------------"

AUDIT_SCRIPT="$PROJECT_ROOT/scripts/verify_audit_trail.py"

if [ -f "$AUDIT_SCRIPT" ]; then
    # Capture both output and exit code
    AUDIT_OUTPUT=$(python3 "$AUDIT_SCRIPT" 2>&1) || true
    AUDIT_EXIT=${PIPESTATUS[0]}
    
    # Display output
    echo "$AUDIT_OUTPUT"
    
    # Check for Python errors in output (indicates script crash)
    if echo "$AUDIT_OUTPUT" | grep -qE "(Traceback|Error:|Exception:|ModuleNotFoundError|ImportError|SyntaxError)"; then
        echo ""
        echo "❌ AUDIT VERIFICATION SCRIPT ERROR"
        echo ""
        echo "The audit verification script encountered an error."
        echo "This must be fixed before commits can proceed."
        echo ""
        echo "💡 Debug with:"
        echo "   python3 scripts/verify_audit_trail.py"
        echo ""
        echo "⚠️  To bypass (EMERGENCY ONLY): git commit --no-verify"
        exit 1
    fi
    
    # Check exit code
    if [ $AUDIT_EXIT -ne 0 ]; then
        echo ""
        echo "❌ AUDIT TRAIL VERIFICATION FAILED (Exit code: $AUDIT_EXIT)"
        echo ""
        echo "Your work must be logged before committing."
        echo ""
        echo "💡 Quick fix:"
        echo "   python3 .asif/AI-Learning/cortex6/source-of-truth/update_session.py --log 'description of work'"
        echo ""
        echo "⚠️  To bypass (EMERGENCY ONLY): git commit --no-verify"
        exit 1
    fi
    
    # Additional validation: Check for SUCCESS evidence in audit
    # Look for work categories beyond just middleware
    if echo "$AUDIT_OUTPUT" | grep -qE "Categories:.*BUILD_EXECUTION|VALIDATION|EXECUTION|STATE_MANAGEMENT|COMPLETED"; then
        echo "✅ Audit trail contains evidence of successful work"
    else
        echo ""
        echo "⚠️  WARNING: Audit trail has entries but no SUCCESS evidence"
        echo "   Consider logging your work explicitly before committing."
        # Not blocking, just warning
    fi
else
    echo "⚠️  Audit verification script not found at: $AUDIT_SCRIPT"
    echo ""
    echo "❌ COMMIT BLOCKED: Audit verification is required"
    echo ""
    echo "💡 Ensure scripts/verify_audit_trail.py exists"
    exit 1
fi

# ============================================================================
# Step 2: Architecture Audit (STRICT)
# ============================================================================
echo ""
echo "🔍 Step 2: Architecture Compliance (STRICT MODE)"
echo "------------------------------------------------------------"

ARCH_SCRIPT="$PROJECT_ROOT/scripts/audit_architecture.py"

if [ -f "$ARCH_SCRIPT" ]; then
    # Capture both output and exit code
    ARCH_OUTPUT=$(python3 "$ARCH_SCRIPT" 2>&1) || true
    ARCH_EXIT=${PIPESTATUS[0]}
    
    # Display output
    echo "$ARCH_OUTPUT"
    
    # Check for Python errors in output
    if echo "$ARCH_OUTPUT" | grep -qE "(Traceback|Error:|Exception:|ModuleNotFoundError|ImportError|SyntaxError)" | grep -v "PASSED\|checks passed"; then
        # Filter out false positives from report text
        if echo "$ARCH_OUTPUT" | grep -qE "^Traceback|^.*Error:.*$" | head -1; then
            echo ""
            echo "❌ ARCHITECTURE AUDIT SCRIPT ERROR"
            echo ""
            echo "The architecture audit script encountered an error."
            echo "This must be fixed before commits can proceed."
            echo ""
            echo "💡 Debug with:"
            echo "   python3 scripts/audit_architecture.py"
            echo ""
            echo "⚠️  To bypass (EMERGENCY ONLY): git commit --no-verify"
            exit 1
        fi
    fi
    
    # Check exit code
    if [ $ARCH_EXIT -ne 0 ]; then
        echo ""
        echo "❌ ARCHITECTURE AUDIT FAILED (Exit code: $ARCH_EXIT)"
        echo ""
        echo "Fix the architecture issues before committing."
        echo ""
        echo "⚠️  To bypass (EMERGENCY ONLY): git commit --no-verify"
        exit 1
    fi
else
    echo "⚠️  Architecture audit script not found at: $ARCH_SCRIPT"
    echo ""
    echo "❌ COMMIT BLOCKED: Architecture audit is required"
    echo ""
    echo "💡 Ensure scripts/audit_architecture.py exists"
    exit 1
fi

# ============================================================================
# Step 3: Quick SKULL Checks (inline for speed)
# ============================================================================
echo ""
echo "🛡️  Step 3: SKULL Quick Checks"
echo "------------------------------------------------------------"

# Check for test files outside tests/
TESTS_OUTSIDE=$(git diff --cached --name-only | grep -E "^test_.*\.py$" | grep -v "^tests/" || true)
if [ -n "$TESTS_OUTSIDE" ]; then
    echo "❌ SKULL VIOLATION: Test files outside tests/ directory:"
    echo "$TESTS_OUTSIDE"
    echo ""
    echo "Move test files to tests/ directory"
    exit 1
fi

# Check for sensitive data patterns (basic check)
SENSITIVE=$(git diff --cached -U0 | grep -iE "(password|secret|api_key|token)\s*=" | head -5 || true)
if [ -n "$SENSITIVE" ]; then
    echo "⚠️  WARNING: Possible sensitive data detected:"
    echo "$SENSITIVE"
    echo ""
    echo "Review before committing. Use environment variables for secrets."
fi

# Check for direct database modifications outside StateManager
DB_DIRECT=$(git diff --cached --name-only | xargs grep -l "sqlite3.connect" 2>/dev/null | grep -v "state_manager.py" | grep -v "test_" || true)
if [ -n "$DB_DIRECT" ]; then
    echo "⚠️  WARNING: Direct SQLite usage found outside StateManager:"
    echo "$DB_DIRECT"
    echo ""
    echo "Consider using StateManager for database operations."
fi

echo "✓ SKULL checks passed"

# ============================================================================
# Step 4: Path Portability Validation (CORE-005)
# ============================================================================
echo ""
echo "🔍 Step 4: Path Portability Validation (CORE-005)"
echo "------------------------------------------------------------"

# Get list of staged files (excluding archives and certain directories)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | \
    grep -v 'archive/' | \
    grep -v '.cortex/chats/' | \
    grep -v 'sharpening-cortex/BadMonolith/' | \
    grep -v '\.md$' | \
    grep -v '\.json$' | \
    grep -v '\.yaml$' | \
    grep -v '\.yml$' | \
    grep -v 'cortex-brain/tier0/governance/' | \
    grep -v 'cortex-brain/documents/' | \
    grep -v 'challenge_detection_engine.py' || true)

if [ -n "$STAGED_FILES" ]; then
    echo "📁 Scanning staged files for hardcoded paths..."
    
    # Define forbidden path patterns
    FORBIDDEN_PATTERNS=(
        '/Users/[a-zA-Z]+'
        'C:\\\\[^ ]+'
        'D:\\\\[^ ]+'
        'E:\\\\[^ ]+'
        'd:/[Pp]rojects'
        'D:/[Pp]ROJECTS'
        'c:/[Pp]rojects'
        '/home/[a-z]+/'
    )
    
    PATH_VIOLATIONS=0
    VIOLATION_FILES=""
    
    for file in $STAGED_FILES; do
        if [ -f "$PROJECT_ROOT/$file" ]; then
            # Check each pattern
            for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
                if grep -qE "$pattern" "$PROJECT_ROOT/$file" 2>/dev/null; then
                    echo "❌ CORE-005 violation in: $file"
                    echo "   Pattern found: $pattern"
                    PATH_VIOLATIONS=$((PATH_VIOLATIONS + 1))
                    VIOLATION_FILES="$VIOLATION_FILES\n   - $file"
                    break
                fi
            done
        fi
    done
    
    if [ $PATH_VIOLATIONS -gt 0 ]; then
        echo ""
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "❌ PATH PORTABILITY VIOLATIONS DETECTED (CORE-005)"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
        echo "Found $PATH_VIOLATIONS file(s) with hardcoded platform-specific paths:"
        echo -e "$VIOLATION_FILES"
        echo ""
        echo "❌ Violations:"
        echo "   • Breaks cross-platform compatibility (MAC/WIN)"
        echo "   • Violates multi-machine development protocol"
        echo "   • Will fail CI/CD on alternate platforms"
        echo ""
        echo "✅ Correct approach:"
        echo "   # ❌ BAD (hardcoded)"
        echo "   path = '/Users/asif/PROJECTS/CORTEX/cortex-brain'"
        echo "   path = 'D:/PROJECTS/CORTEX/cortex-brain'"
        echo ""
        echo "   # ✅ GOOD (portable)"
        echo "   from pathlib import Path"
        echo "   from src.utils.project_root import get_project_root"
        echo "   path = get_project_root() / 'cortex-brain'"
        echo ""
        echo "💡 Fix with:"
        echo "   Replace hardcoded paths with get_project_root() or Path()"
        echo ""
        echo "⚠️  To bypass (EMERGENCY ONLY): git commit --no-verify"
        echo ""
        exit 1
    fi
    
    echo "✓ No hardcoded paths detected (CORE-005 compliant)"
else
    echo "✓ No files to validate"
fi

# ============================================================================
# Step 5: File Type-Specific Validation (CORE-023)
# ============================================================================
echo ""
echo "🔍 Step 5: File Type-Specific Validation (CORE-023)"
echo "------------------------------------------------------------"

# Get list of modified HTML files
HTML_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.html$' || true)
HTML_COUNT=$(echo "$HTML_FILES" | grep -c '\.html$' || echo "0")

if [ "$HTML_COUNT" -gt "0" ]; then
    echo "📄 Found $HTML_COUNT modified HTML file(s)"
    echo ""
    
    # Run HTML validator on each file
    HTML_VALIDATION_FAILED=0
    
    for html_file in $HTML_FILES; do
        if [ -f "$PROJECT_ROOT/$html_file" ]; then
            echo "Validating: $html_file"
            
            # Run HTML validator
            VALIDATION_OUTPUT=$(python3 -m src.orchestrators.html_view.validators.html_validator "$PROJECT_ROOT/$html_file" 2>&1) || true
            VALIDATION_EXIT=$?
            
            if [ $VALIDATION_EXIT -ne 0 ]; then
                echo "❌ VALIDATION FAILED: $html_file"
                echo "$VALIDATION_OUTPUT"
                echo ""
                HTML_VALIDATION_FAILED=1
            else
                echo "✅ Valid: $html_file"
            fi
        fi
    done
    
    if [ $HTML_VALIDATION_FAILED -eq 1 ]; then
        echo ""
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "❌ HTML VALIDATION FAILED (CORE-023)"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
        echo "Modified HTML file(s) contain syntax errors or WCAG violations."
        echo "All HTML must be valid HTML5 with zero parse errors."
        echo ""
        echo "💡 Fix via HTMLViewOrchestrator:"
        echo "   python -m src.main \"fix visual issues in <file.html>\""
        echo ""
        echo "💡 Or run validator manually:"
        echo "   python -m src.orchestrators.html_view.validators.html_validator <file.html>"
        echo ""
        echo "⚠️  To bypass (EMERGENCY ONLY): git commit --no-verify"
        echo ""
        exit 1
    fi
    
    echo "✓ All HTML files validated successfully"
else
    echo "✓ No HTML files modified (validation skipped)"
fi

# ============================================================================
# Step 6: Verify Session Audit Has Build Progress
# ============================================================================
echo ""
echo "📊 Step 6: Build Progress Verification"
echo "------------------------------------------------------------"

SESSION_AUDIT="$PROJECT_ROOT/.asif/AI-Learning/cortex6/source-of-truth/session-audit.jsonl"
if [ -f "$SESSION_AUDIT" ]; then
    RECENT_ENTRIES=$(tail -5 "$SESSION_AUDIT" 2>/dev/null | wc -l | tr -d ' ')
    echo "✓ Session audit has $RECENT_ENTRIES recent entries"
    
    # Show last entry
    LAST_ENTRY=$(tail -1 "$SESSION_AUDIT" 2>/dev/null || echo "{}")
    if [ -n "$LAST_ENTRY" ]; then
        LAST_TASK=$(echo "$LAST_ENTRY" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('task', 'unknown'))" 2>/dev/null || echo "parse error")
        LAST_STATUS=$(echo "$LAST_ENTRY" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('status', 'unknown'))" 2>/dev/null || echo "parse error")
        echo "✓ Last logged: $LAST_TASK ($LAST_STATUS)"
    fi
else
    echo "⚠️  No session audit file found"
    echo "   This is acceptable for non-build commits"
fi

# ============================================================================
# Step 7: Export Database State (NEW - Database Sync Strategy)
# ============================================================================
echo ""
echo "💾 Step 7: Exporting database state for git sync..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Export working memory state (tier1)
if python3 -c "import src.infrastructure.state_manager" 2>/dev/null; then
    echo "🔄 Exporting progress-tracker.json and active-todos.yaml..."
    python3 -m src.infrastructure.state_manager export 2>/dev/null && {
        # Stage exported state files if they changed
        if [ -f "cortex-brain/tier1/tracking/progress-tracker.json" ]; then
            git add cortex-brain/tier1/tracking/progress-tracker.json 2>/dev/null || true
        fi
        if [ -f "cortex-brain/tier1/tracking/active-todos.yaml" ]; then
            git add cortex-brain/tier1/tracking/active-todos.yaml 2>/dev/null || true
        fi
        echo "✅ Working memory state exported"
    } || {
        echo "⚠️  StateManager export not fully implemented yet - skipping"
    }
else
    echo "⚠️  StateManager module not found - will be available after Phase 2 implementation"
fi

# Export audit trail session (tier0)
if python3 -c "import src.infrastructure.enhanced_audit_logger" 2>/dev/null; then
    echo "🔄 Exporting audit trail session..."
    python3 -m src.infrastructure.enhanced_audit_logger export_session 2>/dev/null && {
        # Stage audit export files if any were created
        git add cortex-brain/audit-logs/*.jsonl 2>/dev/null || true
        echo "✅ Audit trail session exported"
    } || {
        echo "⚠️  AuditLogger export not fully implemented yet - skipping"
    }
else
    echo "⚠️  AuditLogger export module not found - will be available after Phase 2 implementation"
fi

# Export knowledge patterns (tier3)
if python3 -c "import src.infrastructure.tier3_manager" 2>/dev/null; then
    echo "🔄 Exporting learned patterns..."
    python3 -m src.infrastructure.tier3_manager export_patterns 2>/dev/null && {
        # Stage pattern files if they changed
        git add cortex-brain/tier3/patterns/*.yaml 2>/dev/null || true
        echo "✅ Knowledge patterns exported"
    } || {
        echo "⚠️  Tier3Manager export not fully implemented yet - skipping"
    }
else
    echo "⚠️  Tier3Manager module not found - will be available after Phase 2 implementation"
fi

echo ""
echo "📖 Reference: cortex-brain/documents/analysis/database-synchronization-strategy.md"

# ============================================================================
# Success
# ============================================================================
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✅ ALL CHECKS PASSED - Commit allowed"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "📋 Summary:"
echo "   • Audit trail: ✅ Verified"
echo "   • Architecture: ✅ Compliant"
echo "   • SKULL rules: ✅ Passed"
echo "   • Path portability: ✅ Passed (CORE-005)"
echo "   • HTML validation: ✅ Passed (CORE-023)"
echo "   • Build progress: ✅ Logged"
echo "   • Database state: ✅ Exported for sync"
echo ""

exit 0
