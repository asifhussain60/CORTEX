#!/bin/bash
#
# CORTEX 6.0 Pre-Commit Hook (Enhanced)
# 
# Validates before every commit:
# 1. Audit trail verification (ensures work is logged with SUCCESS evidence)
# 2. Architecture compliance (test structure, core components)
# 3. SKULL rule compliance (brain protection)
#
# KEY PRINCIPLE: If audit log verification ERRORS or shows no evidence
# of successful work, the commit is REJECTED.
#
# Author: Asif Hussain
# Copyright © 2025-2026 Asif Hussain. All rights reserved.
#
# Installation:
#   cp scripts/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# To bypass (emergency only):
#   git commit --no-verify
#

# DO NOT use set -e - we need to capture exit codes explicitly
# set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Handle both .git/hooks location and scripts/ location
if [[ "$SCRIPT_DIR" == *".git/hooks"* ]]; then
    PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
else
    PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
fi

echo ""
echo "🧠 CORTEX 6.0 Pre-Commit Validation (Enhanced)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Check if we have staged changes
STAGED_COUNT=$(git diff --cached --name-only | wc -l | tr -d ' ')
if [ "$STAGED_COUNT" -eq "0" ]; then
    echo "⚠️  No staged changes detected"
    exit 0
fi

echo "📁 Staged files: $STAGED_COUNT"

# ============================================================================
# Step 1: Audit Trail Verification (STRICT)
# ============================================================================
echo ""
echo "📝 Step 1: Audit Trail Verification (STRICT MODE)"
echo "------------------------------------------------------------"

AUDIT_SCRIPT="$PROJECT_ROOT/scripts/verify_audit_trail.py"

if [ -f "$AUDIT_SCRIPT" ]; then
    # Capture both output and exit code
    AUDIT_OUTPUT=$(python3 "$AUDIT_SCRIPT" 2>&1) || true
    AUDIT_EXIT=${PIPESTATUS[0]}
    
    # Display output
    echo "$AUDIT_OUTPUT"
    
    # Check for Python errors in output (indicates script crash)
    if echo "$AUDIT_OUTPUT" | grep -qE "(Traceback|Error:|Exception:|ModuleNotFoundError|ImportError|SyntaxError)"; then
        echo ""
        echo "❌ AUDIT VERIFICATION SCRIPT ERROR"
        echo ""
        echo "The audit verification script encountered an error."
        echo "This must be fixed before commits can proceed."
        echo ""
        echo "💡 Debug with:"
        echo "   python3 scripts/verify_audit_trail.py"
        echo ""
        echo "⚠️  To bypass (EMERGENCY ONLY): git commit --no-verify"
        exit 1
    fi
    
    # Check exit code
    if [ $AUDIT_EXIT -ne 0 ]; then
        echo ""
        echo "❌ AUDIT TRAIL VERIFICATION FAILED (Exit code: $AUDIT_EXIT)"
        echo ""
        echo "Your work must be logged before committing."
        echo ""
        echo "💡 Quick fix:"
        echo "   python3 .asif/AI-Learning/cortex6/source-of-truth/update_session.py --log 'description of work'"
        echo ""
        echo "⚠️  To bypass (EMERGENCY ONLY): git commit --no-verify"
        exit 1
    fi
    
    # Additional validation: Check for SUCCESS evidence in audit
    # Look for work categories beyond just middleware
    if echo "$AUDIT_OUTPUT" | grep -qE "Categories:.*BUILD_EXECUTION|VALIDATION|EXECUTION|STATE_MANAGEMENT|COMPLETED"; then
        echo "✅ Audit trail contains evidence of successful work"
    else
        echo ""
        echo "⚠️  WARNING: Audit trail has entries but no SUCCESS evidence"
        echo "   Consider logging your work explicitly before committing."
        # Not blocking, just warning
    fi
else
    echo "⚠️  Audit verification script not found at: $AUDIT_SCRIPT"
    echo ""
    echo "❌ COMMIT BLOCKED: Audit verification is required"
    echo ""
    echo "💡 Ensure scripts/verify_audit_trail.py exists"
    exit 1
fi

# ============================================================================
# Step 2: Architecture Audit (STRICT)
# ============================================================================
echo ""
echo "🔍 Step 2: Architecture Compliance (STRICT MODE)"
echo "------------------------------------------------------------"

ARCH_SCRIPT="$PROJECT_ROOT/scripts/audit_architecture.py"

if [ -f "$ARCH_SCRIPT" ]; then
    # Capture both output and exit code
    ARCH_OUTPUT=$(python3 "$ARCH_SCRIPT" 2>&1) || true
    ARCH_EXIT=${PIPESTATUS[0]}
    
    # Display output
    echo "$ARCH_OUTPUT"
    
    # Check for Python errors in output
    if echo "$ARCH_OUTPUT" | grep -qE "(Traceback|Error:|Exception:|ModuleNotFoundError|ImportError|SyntaxError)" | grep -v "PASSED\|checks passed"; then
        # Filter out false positives from report text
        if echo "$ARCH_OUTPUT" | grep -qE "^Traceback|^.*Error:.*$" | head -1; then
            echo ""
            echo "❌ ARCHITECTURE AUDIT SCRIPT ERROR"
            echo ""
            echo "The architecture audit script encountered an error."
            echo "This must be fixed before commits can proceed."
            echo ""
            echo "💡 Debug with:"
            echo "   python3 scripts/audit_architecture.py"
            echo ""
            echo "⚠️  To bypass (EMERGENCY ONLY): git commit --no-verify"
            exit 1
        fi
    fi
    
    # Check exit code
    if [ $ARCH_EXIT -ne 0 ]; then
        echo ""
        echo "❌ ARCHITECTURE AUDIT FAILED (Exit code: $ARCH_EXIT)"
        echo ""
        echo "Fix the architecture issues before committing."
        echo ""
        echo "⚠️  To bypass (EMERGENCY ONLY): git commit --no-verify"
        exit 1
    fi
else
    echo "⚠️  Architecture audit script not found at: $ARCH_SCRIPT"
    echo ""
    echo "❌ COMMIT BLOCKED: Architecture audit is required"
    echo ""
    echo "💡 Ensure scripts/audit_architecture.py exists"
    exit 1
fi

# ============================================================================
# Step 3: Quick SKULL Checks (inline for speed)
# ============================================================================
echo ""
echo "🛡️  Step 3: SKULL Quick Checks"
echo "------------------------------------------------------------"

# Check for test files outside tests/
TESTS_OUTSIDE=$(git diff --cached --name-only | grep -E "^test_.*\.py$" | grep -v "^tests/" || true)
if [ -n "$TESTS_OUTSIDE" ]; then
    echo "❌ SKULL VIOLATION: Test files outside tests/ directory:"
    echo "$TESTS_OUTSIDE"
    echo ""
    echo "Move test files to tests/ directory"
    exit 1
fi

# Check for sensitive data patterns (basic check)
SENSITIVE=$(git diff --cached -U0 | grep -iE "(password|secret|api_key|token)\s*=" | head -5 || true)
if [ -n "$SENSITIVE" ]; then
    echo "⚠️  WARNING: Possible sensitive data detected:"
    echo "$SENSITIVE"
    echo ""
    echo "Review before committing. Use environment variables for secrets."
fi

# Check for direct database modifications outside StateManager
DB_DIRECT=$(git diff --cached --name-only | xargs grep -l "sqlite3.connect" 2>/dev/null | grep -v "state_manager.py" | grep -v "test_" || true)
if [ -n "$DB_DIRECT" ]; then
    echo "⚠️  WARNING: Direct SQLite usage found outside StateManager:"
    echo "$DB_DIRECT"
    echo ""
    echo "Consider using StateManager for database operations."
fi

echo "✓ SKULL checks passed"

# ============================================================================
# Step 4: Verify Session Audit Has Build Progress
# ============================================================================
echo ""
echo "📊 Step 4: Build Progress Verification"
echo "------------------------------------------------------------"

SESSION_AUDIT="$PROJECT_ROOT/.asif/AI-Learning/cortex6/source-of-truth/session-audit.jsonl"
if [ -f "$SESSION_AUDIT" ]; then
    RECENT_ENTRIES=$(tail -5 "$SESSION_AUDIT" 2>/dev/null | wc -l | tr -d ' ')
    echo "✓ Session audit has $RECENT_ENTRIES recent entries"
    
    # Show last entry
    LAST_ENTRY=$(tail -1 "$SESSION_AUDIT" 2>/dev/null || echo "{}")
    if [ -n "$LAST_ENTRY" ]; then
        LAST_TASK=$(echo "$LAST_ENTRY" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('task', 'unknown'))" 2>/dev/null || echo "parse error")
        LAST_STATUS=$(echo "$LAST_ENTRY" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('status', 'unknown'))" 2>/dev/null || echo "parse error")
        echo "✓ Last logged: $LAST_TASK ($LAST_STATUS)"
    fi
else
    echo "⚠️  No session audit file found"
    echo "   This is acceptable for non-build commits"
fi

# ============================================================================
# Success
# ============================================================================
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✅ ALL CHECKS PASSED - Commit allowed"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "📋 Summary:"
echo "   • Audit trail: ✅ Verified"
echo "   • Architecture: ✅ Compliant"
echo "   • SKULL rules: ✅ Passed"
echo "   • Build progress: ✅ Logged"
echo ""

exit 0
