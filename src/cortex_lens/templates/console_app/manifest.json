{
  "template_name": "console_app",
  "display_name": "Console Application",
  "description": "Command-line tools, scripts, and console applications",
  "version": "1.0.0",
  "tabs": [
    {
      "id": "overview",
      "label": "Overview",
      "icon": "📊",
      "enabled": true,
      "components": [
        "kpi-cards",
        "repository-summary",
        "health-overview",
        "recent-activity"
      ]
    },
    {
      "id": "architecture",
      "label": "Architecture",
      "icon": "🏗️",
      "enabled": true,
      "components": [
        "module-structure",
        "dependency-graph",
        "entry-points",
        "command-structure"
      ]
    },
    {
      "id": "code-quality",
      "label": "Code Quality",
      "icon": "✨",
      "enabled": true,
      "components": [
        "complexity-metrics",
        "maintainability-index",
        "code-smells",
        "documentation-coverage"
      ]
    },
    {
      "id": "dependencies",
      "label": "Dependencies",
      "icon": "📦",
      "enabled": true,
      "components": [
        "dependency-tree",
        "version-matrix",
        "security-advisories",
        "update-recommendations"
      ]
    },
    {
      "id": "testing",
      "label": "Testing",
      "icon": "🧪",
      "enabled": true,
      "components": [
        "test-coverage",
        "test-suite-health",
        "test-execution-time",
        "test-reliability"
      ]
    }
  ],
  "features": {
    "narrative_panel": true,
    "reconciliation_widget": true,
    "export_formats": ["json", "yaml", "csv"],
    "theme_support": true,
    "responsive_design": true
  }
}
