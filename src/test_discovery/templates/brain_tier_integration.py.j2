"""
Integration test template for brain tier components.

Tests cross-tier interactions and data flow.
"""

def test_tier{{ tier_number }}_initialization(temp_brain):
    """Test Tier {{ tier_number }} initialization."""
    {% if tier_number == 0 %}
    from src.tier0.governance_rules import GovernanceRules
    
    # Tier 0: Governance rules
    rules = GovernanceRules()
    assert rules is not None
    
    # Verify core instincts loaded
    assert len(rules.get_all_instincts()) > 0
    
    {% elif tier_number == 1 %}
    from src.tier1.working_memory import WorkingMemory
    
    # Tier 1: Working memory
    memory = WorkingMemory(brain_path=temp_brain)
    assert memory is not None
    
    # Verify database initialized
    assert memory.is_initialized()
    
    {% elif tier_number == 2 %}
    from src.tier2.knowledge_graph import KnowledgeGraph
    
    # Tier 2: Knowledge graph
    kg = KnowledgeGraph(brain_path=temp_brain)
    assert kg is not None
    
    # Verify database initialized
    assert kg.is_initialized()
    
    {% elif tier_number == 3 %}
    from src.tier3.development_context import DevelopmentContext
    
    # Tier 3: Development context
    dev_context = DevelopmentContext(brain_path=temp_brain)
    assert dev_context is not None
    
    # Verify database initialized
    assert dev_context.is_initialized()
    {% endif %}


def test_tier{{ tier_number }}_basic_operations(temp_brain):
    """Test Tier {{ tier_number }} basic operations."""
    {% if tier_number == 0 %}
    from src.tier0.governance_rules import GovernanceRules
    
    rules = GovernanceRules()
    
    # Test rule validation
    result = rules.validate("TDD_ENFORCEMENT", {"has_test": True})
    assert isinstance(result, dict)
    assert "valid" in result or "passed" in result
    
    {% elif tier_number == 1 %}
    from src.tier1.working_memory import WorkingMemory
    
    memory = WorkingMemory(brain_path=temp_brain)
    
    # Test storing conversation
    memory.store_conversation(
        session_id="test-001",
        user_message="Test message",
        assistant_response="Test response",
        intent="test"
    )
    
    # Test retrieval
    conversations = memory.get_recent_conversations(limit=5)
    assert len(conversations) > 0
    assert conversations[0]["session_id"] == "test-001"
    
    {% elif tier_number == 2 %}
    from src.tier2.knowledge_graph import KnowledgeGraph
    
    kg = KnowledgeGraph(brain_path=temp_brain)
    
    # Test pattern storage
    pattern_id = kg.store_pattern(
        pattern_type="test_pattern",
        description="Integration test pattern",
        confidence=0.85
    )
    
    assert pattern_id is not None
    
    # Test pattern retrieval
    pattern = kg.get_pattern(pattern_id)
    assert pattern is not None
    assert pattern["pattern_type"] == "test_pattern"
    
    {% elif tier_number == 3 %}
    from src.tier3.development_context import DevelopmentContext
    
    dev_context = DevelopmentContext(brain_path=temp_brain)
    
    # Test metrics storage
    dev_context.store_metric(
        file_path="test/file.py",
        metric_type="complexity",
        value=15.5
    )
    
    # Test metrics retrieval
    metrics = dev_context.get_metrics("test/file.py")
    assert len(metrics) > 0
    assert metrics[0]["metric_type"] == "complexity"
    {% endif %}


{% if tier_number > 0 %}
def test_tier{{ tier_number }}_cross_tier_integration(temp_brain):
    """Test Tier {{ tier_number }} integration with other tiers."""
    {% if tier_number == 1 %}
    from src.tier1.working_memory import WorkingMemory
    from src.tier2.knowledge_graph import KnowledgeGraph
    
    memory = WorkingMemory(brain_path=temp_brain)
    kg = KnowledgeGraph(brain_path=temp_brain)
    
    # Store conversation in Tier 1
    memory.store_conversation(
        session_id="cross-tier-001",
        user_message="Learn this pattern",
        assistant_response="Pattern learned",
        intent="learning"
    )
    
    # Extract patterns for Tier 2 (simulated)
    conversations = memory.get_recent_conversations(limit=1)
    assert len(conversations) > 0
    
    # Store pattern in Tier 2
    pattern_id = kg.store_pattern(
        pattern_type="conversation_pattern",
        description=f"Pattern from {conversations[0]['session_id']}",
        confidence=0.75
    )
    
    assert pattern_id is not None
    
    {% elif tier_number == 2 %}
    from src.tier2.knowledge_graph import KnowledgeGraph
    from src.tier3.development_context import DevelopmentContext
    
    kg = KnowledgeGraph(brain_path=temp_brain)
    dev_context = DevelopmentContext(brain_path=temp_brain)
    
    # Store pattern in Tier 2
    pattern_id = kg.store_pattern(
        pattern_type="code_pattern",
        description="High complexity detected",
        confidence=0.9
    )
    
    # Store related metric in Tier 3
    dev_context.store_metric(
        file_path="src/complex_module.py",
        metric_type="complexity",
        value=45.0
    )
    
    # Verify both tiers have data
    pattern = kg.get_pattern(pattern_id)
    metrics = dev_context.get_metrics("src/complex_module.py")
    
    assert pattern is not None
    assert len(metrics) > 0
    
    {% elif tier_number == 3 %}
    from src.tier3.development_context import DevelopmentContext
    from src.tier2.knowledge_graph import KnowledgeGraph
    
    dev_context = DevelopmentContext(brain_path=temp_brain)
    kg = KnowledgeGraph(brain_path=temp_brain)
    
    # Store metrics
    dev_context.store_metric(
        file_path="src/hotspot.py",
        metric_type="change_frequency",
        value=25
    )
    
    # Query patterns related to hotspots
    patterns = kg.query_patterns(pattern_type="hotspot_pattern")
    
    # Integration successful if no errors
    assert isinstance(patterns, list)
    {% endif %}


def test_tier{{ tier_number }}_isolation(temp_brain):
    """Test Tier {{ tier_number }} maintains proper isolation."""
    {% if tier_number == 1 %}
    from src.tier1.working_memory import WorkingMemory
    
    memory = WorkingMemory(brain_path=temp_brain)
    
    # Tier 1 should NOT directly access Tier 2 or Tier 3
    assert not hasattr(memory, "knowledge_graph")
    assert not hasattr(memory, "development_context")
    
    {% elif tier_number == 2 %}
    from src.tier2.knowledge_graph import KnowledgeGraph
    
    kg = KnowledgeGraph(brain_path=temp_brain)
    
    # Tier 2 should NOT directly access Tier 3
    assert not hasattr(kg, "development_context")
    
    # Tier 2 CAN access Tier 1 for learning
    # But should be indirect through queries
    
    {% elif tier_number == 3 %}
    from src.tier3.development_context import DevelopmentContext
    
    dev_context = DevelopmentContext(brain_path=temp_brain)
    
    # Tier 3 is top-level, no upward access restrictions
    # But should not have direct database handles to lower tiers
    {% endif %}
{% endif %}
