def test_{{ component_name_lower }}_retry_logic({{ component_name_lower }}):
    """Test {{ component_name }} retry logic on errors."""
    fail_count = 0
    max_retries = 3
    
    def failing_operation():
        nonlocal fail_count
        fail_count += 1
        if fail_count < max_retries:
            raise Exception("Temporary failure")
        return "success"
    
    result = {{ component_name_lower }}.with_retry(failing_operation, max_retries=max_retries)
    
    assert result == "success"
    assert fail_count == max_retries


