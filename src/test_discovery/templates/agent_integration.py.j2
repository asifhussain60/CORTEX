"""
Integration test template for agent components.

Tests agent interactions, intent handling, and execution flow.
"""

def test_{{ agent_name_lower }}_intent_detection(temp_project, temp_brain):
    """Test {{ agent_name }} intent detection."""
    from src.cortex_agents.{{ agent_module }} import {{ agent_name }}
    from src.cortex_agents.base_agent import AgentRequest
    
    # Setup
    agent = {{ agent_name }}()
    
    {% if intent_patterns %}
    # Test intent recognition
    {% for intent in intent_patterns %}
    request = AgentRequest(
        intent="{{ intent }}",
        message="Test message for {{ intent }}",
        context={}
    )
    
    assert agent.can_handle(request) is True
    {% endfor %}
    {% else %}
    # Test default intent
    request = AgentRequest(
        intent="default",
        message="Test message",
        context={}
    )
    
    can_handle = agent.can_handle(request)
    assert isinstance(can_handle, bool)
    {% endif %}


def test_{{ agent_name_lower }}_execution_integration(temp_project, temp_brain):
    """Test {{ agent_name }} execution with dependencies."""
    from src.cortex_agents.{{ agent_module }} import {{ agent_name }}
    from src.cortex_agents.base_agent import AgentRequest, AgentResponse
    
    agent = {{ agent_name }}()
    
    request = AgentRequest(
        intent="test_intent",
        message="Integration test",
        context={"project_root": temp_project}
    )
    
    # Execute agent
    response = agent.execute(request)
    
    # Verify response structure
    assert isinstance(response, AgentResponse)
    assert hasattr(response, "success")
    assert hasattr(response, "result")
    assert hasattr(response, "message")
    
    # Verify execution metadata
    assert response.execution_time is not None if hasattr(response, "execution_time") else True


