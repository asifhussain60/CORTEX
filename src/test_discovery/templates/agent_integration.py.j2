def test_{{ agent_name_lower }}_error_recovery(temp_project, temp_brain):
    """Test {{ agent_name }} error recovery."""
    from src.cortex_agents.{{ agent_module }} import {{ agent_name }}
    from src.cortex_agents.base_agent import AgentRequest
    
    agent = {{ agent_name }}()
    
    # Test with invalid request
    invalid_request = AgentRequest(
        intent="invalid_intent_xyz",
        message=None,  # Invalid message
        context={}
    )
    
    # Agent should handle gracefully
    try:
        response = agent.execute(invalid_request)
        # If no exception, should return error response
        assert response.success is False
        assert response.message != ""
    except Exception as e:
        # Verify informative error
        assert "invalid" in str(e).lower() or "error" in str(e).lower()
