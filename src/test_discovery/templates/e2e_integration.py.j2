def test_{{ component_name_lower }}_parallel_workflow_execution({{ component_name_lower }}, workflow_context):
    """Test {{ component_name }} handles parallel workflow execution."""
    workflows = [
        {**workflow_context, "workflow_id": i}
        for i in range(3)
    ]
    
    results = []
    for workflow in workflows:
        result = {{ component_name_lower }}.execute_workflow(workflow)
        results.append(result)
    
    # All workflows should complete successfully
    assert len(results) == 3
    assert all(r.get("success") for r in results)


