def test_{{ component_name_lower }}_pattern_learning({{ component_name_lower }}):
    """Test {{ component_name }} learns from patterns."""
    # Create pattern events
    events = [
        {"type": "success", "context": {"iteration": i}}
        for i in range(3)
    ]
    
    # Process events
    for event in events:
        {{ component_name_lower }}.capture(event)
    
    # Verify pattern learned
    patterns = {{ component_name_lower }}.get_patterns()
    assert len(patterns) > 0


def test_{{ component_name_lower }}_knowledge_storage({{ component_name_lower }}, learning_event):
    """Test {{ component_name }} stores knowledge correctly."""
    # Capture learning
    {{ component_name_lower }}.capture(learning_event)
    
    # Retrieve stored knowledge
    stored = {{ component_name_lower }}.retrieve(learning_event["event_type"])
    
    assert stored is not None
    assert learning_event["event_type"] in str(stored)


