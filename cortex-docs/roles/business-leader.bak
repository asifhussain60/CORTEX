<!-- ══════════════════════════════════════════════════════════
     SCRIPTS: Tab switching + Mermaid init + D3.js charts
     ══════════════════════════════════════════════════════════ -->
<script>
/* ── Tab switching ── */
(function () {
    'use strict';
    document.querySelectorAll('.bl-tab').forEach(function (tab) {
        tab.addEventListener('click', function () {
            var layout = this.closest('.bl-tab-layout');

            // Deactivate all tabs in this group
            layout.querySelectorAll('.bl-tab').forEach(function (t) {
                t.classList.remove('active');
                t.setAttribute('aria-selected', 'false');
            });

            // Deactivate all panels in this group
            layout.querySelectorAll('.bl-tab-panel').forEach(function (p) {
                p.classList.remove('active');
            });

            // Activate clicked tab + target panel
            this.classList.add('active');
            this.setAttribute('aria-selected', 'true');
            var target = document.getElementById(this.dataset.target);
            if (target) target.classList.add('active');
        });
    });
})();
</script>

<script>
/* ── Mermaid init — dark glassmorphism theme ── */
if (typeof mermaid !== 'undefined') {
    mermaid.initialize({
        startOnLoad: true,
        theme: 'base',
        themeVariables: {
            background: '#0a0e27',
            primaryColor: '#0d1b3e',
            primaryTextColor: '#e2e8f0',
            primaryBorderColor: '#00d4ff',
            lineColor: '#3a4060',
            secondaryColor: '#1a1f44',
            tertiaryColor: '#12162e',
            edgeLabelBackground: '#0a0e27',
            fontSize: '14px',
            nodeBorder: '#00d4ff',
            clusterBkg: '#0d1120',
            titleColor: '#e2e8f0'
        },
        flowchart: { curve: 'basis', htmlLabels: true },
        mindmap: { padding: 20 }
    });
}
</script>

<script>
/* ── D3.js Chart 1: Defect Cost Bar Chart ── */
(function () {
    'use strict';
    if (typeof d3 === 'undefined') return;
    var container = document.getElementById('defect-cost-canvas');
    if (!container) return;

    var stages = [
        { label: 'Commit\n(CORTEX Gate)', cost: 1,   color: '#34d399' },
        { label: 'Code Review',           cost: 4,   color: '#38bdf8' },
        { label: 'QA / Testing',          cost: 15,  color: '#f59e0b' },
        { label: 'UAT / Staging',         cost: 40,  color: '#fb923c' },
        { label: 'Production',            cost: 100, color: '#fb7185' }
    ];

    var margin = { top: 24, right: 40, bottom: 68, left: 64 };
    var totalW = Math.max(container.offsetWidth || 0, 480);
    var totalH = 420; /* d3_min_height_400 gate — html-view-lifecycle.yaml § asset_validation */
    var w = totalW - margin.left - margin.right;
    var h = totalH - margin.top - margin.bottom;

    var svg = d3.select(container)
        .append('svg')
        .attr('width', '100%')
        .attr('height', totalH)
        .attr('viewBox', '0 0 ' + totalW + ' ' + totalH)
        .attr('preserveAspectRatio', 'xMidYMid meet');

    var g = svg.append('g').attr('transform', 'translate(' + margin.left + ',' + margin.top + ')');

    var x = d3.scaleBand().domain(stages.map(function(d){ return d.label; })).range([0, w]).padding(0.38);
    var y = d3.scaleLinear().domain([0, 115]).range([h, 0]);

    /* Grid */
    g.append('g')
        .attr('class', 'bl-d3-grid-lines')
        .call(d3.axisLeft(y).ticks(5).tickSize(-w).tickFormat(''))
        .call(function(s){ s.select('.domain').remove(); s.selectAll('line').attr('stroke', 'rgba(255,255,255,0.05)'); });

    /* Bars with gradient fill per colour */
    var defs = svg.append('defs');
    stages.forEach(function(d, i) {
        var grad = defs.append('linearGradient').attr('id', 'bar-grad-' + i).attr('x1','0').attr('y1','0').attr('x2','0').attr('y2','1');
        grad.append('stop').attr('offset','0%').attr('stop-color', d.color).attr('stop-opacity', 0.95);
        grad.append('stop').attr('offset','100%').attr('stop-color', d.color).attr('stop-opacity', 0.55);
    });

    var bars = g.selectAll('.bar').data(stages).enter().append('g');

    bars.append('rect')
        .attr('x', function(d){ return x(d.label); })
        .attr('y', function(d){ return y(d.cost); })
        .attr('width', x.bandwidth())
        .attr('height', function(d){ return h - y(d.cost); })
        .attr('fill', function(d, i){ return 'url(#bar-grad-' + i + ')'; })
        .attr('rx', 6)
        .attr('stroke', function(d){ return d.color; })
        .attr('stroke-width', 1)
        .attr('stroke-opacity', 0.4);

    /* Value labels */
    bars.append('text')
        .attr('x', function(d){ return x(d.label) + x.bandwidth() / 2; })
        .attr('y', function(d){ return y(d.cost) - 7; })
        .attr('text-anchor', 'middle')
        .attr('fill', function(d){ return d.color; })
        .attr('font-size', '13px')
        .attr('font-weight', '800')
        .attr('font-family', 'Inter, sans-serif')
        .text(function(d){ return d.cost + 'x'; });

    /* X axis */
    var xAxis = g.append('g')
        .attr('transform', 'translate(0,' + h + ')')
        .call(d3.axisBottom(x).tickSize(0));
    xAxis.select('.domain').attr('stroke', 'rgba(255,255,255,0.08)');
    xAxis.selectAll('text')
        .attr('fill', '#a0a6c0')
        .attr('font-size', '11px')
        .attr('font-family', 'Inter, sans-serif')
        .each(function(d) {
            var el = d3.select(this);
            var parts = d.split('\n');
            el.text('');
            parts.forEach(function(p, i) {
                el.append('tspan').attr('x', 0).attr('dy', i === 0 ? '1.1em' : '1.2em').text(p);
            });
        });

    /* Y axis */
    var yAxis = g.append('g').call(d3.axisLeft(y).ticks(5).tickFormat(function(d){ return d + 'x'; }));
    yAxis.select('.domain').remove();
    yAxis.selectAll('text').attr('fill', '#78809a').attr('font-size', '11px').attr('font-family', 'Inter, sans-serif');
    yAxis.selectAll('line').attr('stroke', 'rgba(255,255,255,0.04)');

    /* CORTEX annotation */
    g.append('text')
        .attr('x', x(stages[0].label) + x.bandwidth() / 2)
        .attr('y', h + 55)
        .attr('text-anchor', 'middle')
        .attr('fill', '#34d399')
        .attr('font-size', '10px')
        .attr('font-weight', '700')
        .attr('font-family', 'Inter, sans-serif')
        .text('🛡️ CORTEX blocks here');
})();
</script>

<script>
/* ── D3.js Chart 2: Engineering Time Allocation Before vs After ── */
(function () {
    'use strict';
    if (typeof d3 === 'undefined') return;
    var container = document.getElementById('value-flow-canvas');
    if (!container) return;

    var categories = [
        { label: 'Feature Development', before: 35, after: 60, color: '#00d4ff' },
        { label: 'Bug Fixing & Rework',  before: 30, after: 10, color: '#fb7185' },
        { label: 'Code Review',          before: 15, after: 10, color: '#f59e0b' },
        { label: 'Compliance & Audit',   before: 12, after: 5,  color: '#a78bfa' },
        { label: 'Incident Response',    before: 8,  after: 15, color: '#34d399' }
    ];

    var margin = { top: 40, right: 100, bottom: 24, left: 175 };
    var totalW = Math.max(container.offsetWidth || 0, 540);
    var barH = 22;
    var gap = 8;
    var groupH = barH * 2 + gap;
    var totalH = margin.top + margin.bottom + categories.length * (groupH + 14) + 10;
    var w = totalW - margin.left - margin.right;

    var svg = d3.select(container)
        .append('svg')
        .attr('width', '100%')
        .attr('height', totalH)
        .attr('viewBox', '0 0 ' + totalW + ' ' + totalH)
        .attr('preserveAspectRatio', 'xMidYMid meet');

    /* Legend */
    var lg = svg.append('g').attr('transform', 'translate(' + margin.left + ',12)');
    lg.append('rect').attr('width', 13).attr('height', 13).attr('rx', 3).attr('fill', 'rgba(160,166,192,0.25)').attr('stroke', 'rgba(255,255,255,0.15)').attr('stroke-width', 1);
    lg.append('text').attr('x', 19).attr('y', 10.5).attr('fill', '#a0a6c0').attr('font-size', '11px').attr('font-family', 'Inter, sans-serif').text('Before CORTEX');
    lg.append('rect').attr('x', 130).attr('width', 13).attr('height', 13).attr('rx', 3).attr('fill', '#00d4ff').attr('opacity', 0.75);
    lg.append('text').attr('x', 148).attr('y', 10.5).attr('fill', '#a0a6c0').attr('font-size', '11px').attr('font-family', 'Inter, sans-serif').text('After CORTEX');

    var g = svg.append('g').attr('transform', 'translate(' + margin.left + ',' + margin.top + ')');
    var x = d3.scaleLinear().domain([0, 100]).range([0, w]);

    categories.forEach(function(d, i) {
        var yBase = i * (groupH + 14);

        /* Label */
        g.append('text')
            .attr('x', -10).attr('y', yBase + barH - 3)
            .attr('text-anchor', 'end')
            .attr('fill', '#e2e8f0').attr('font-size', '12px').attr('font-weight', '600')
            .attr('font-family', 'Inter, sans-serif').text(d.label);

        /* Before bar */
        g.append('rect')
            .attr('x', 0).attr('y', yBase)
            .attr('width', x(d.before)).attr('height', barH)
            .attr('rx', 5)
            .attr('fill', 'rgba(160,166,192,0.18)')
            .attr('stroke', 'rgba(255,255,255,0.1)').attr('stroke-width', 1);
        g.append('text')
            .attr('x', x(d.before) + 6).attr('y', yBase + barH / 2 + 4)
            .attr('fill', '#78809a').attr('font-size', '11px').attr('font-family', 'Inter, sans-serif')
            .text(d.before + '%');

        /* After bar */
        g.append('rect')
            .attr('x', 0).attr('y', yBase + barH + gap)
            .attr('width', x(d.after)).attr('height', barH)
            .attr('rx', 5)
            .attr('fill', d.color).attr('opacity', 0.75);
        g.append('text')
            .attr('x', x(d.after) + 6).attr('y', yBase + barH + gap + barH / 2 + 4)
            .attr('fill', d.color).attr('font-size', '11px').attr('font-weight', '700')
            .attr('font-family', 'Inter, sans-serif').text(d.after + '%');
    });
})();
</script>

<script>
/* ── D3.js Chart 3: Governance Rule Donut Chart ── */
(function () {
    'use strict';
    if (typeof d3 === 'undefined') return;
    var container = document.getElementById('governance-canvas');
    if (!container) return;

    var domains = [
        { label: 'Core / General',   count: 14, color: '#00d4ff' },
        { label: 'TDD / Quality',    count: 6,  color: '#34d399' },
        { label: 'Security',         count: 4,  color: '#fb7185' },
        { label: 'Architecture',     count: 4,  color: '#a78bfa' },
        { label: 'Naming / Docs',    count: 4,  color: '#f59e0b' }
    ];

    var size = Math.min(Math.max(container.offsetWidth || 0, 280), 340);
    var radius = size / 2 - 22;
    var innerR = radius * 0.56;

    var svg = d3.select(container)
        .append('svg')
        .attr('width', '100%')
        .attr('height', size)
        .attr('viewBox', '0 0 ' + size + ' ' + size)
        .attr('preserveAspectRatio', 'xMidYMid meet');

    var g = svg.append('g').attr('transform', 'translate(' + size / 2 + ',' + size / 2 + ')');

    var pie = d3.pie().value(function(d){ return d.count; }).sort(null).padAngle(0.03);
    var arc = d3.arc().innerRadius(innerR).outerRadius(radius).cornerRadius(4);
    var arcHover = d3.arc().innerRadius(innerR).outerRadius(radius + 10).cornerRadius(4);

    /* Glow filter */
    var defs = svg.append('defs');
    var filter = defs.append('filter').attr('id', 'donut-glow').attr('x', '-30%').attr('y', '-30%').attr('width', '160%').attr('height', '160%');
    filter.append('feGaussianBlur').attr('in', 'SourceGraphic').attr('stdDeviation', '4').attr('result', 'blur');
    var feMerge = filter.append('feMerge');
    feMerge.append('feMergeNode').attr('in', 'blur');
    feMerge.append('feMergeNode').attr('in', 'SourceGraphic');

    var arcs = g.selectAll('.arc').data(pie(domains)).enter().append('g');

    arcs.append('path')
        .attr('d', arc)
        .attr('fill', function(d){ return d.data.color; })
        .attr('opacity', 0.82)
        .attr('filter', 'url(#donut-glow)')
        .on('mouseenter', function(event, d) {
            d3.select(this).transition().duration(160).attr('d', arcHover).attr('opacity', 1);
            cLabel.text(d.data.count);
            cSub.text(d.data.label);
        })
        .on('mouseleave', function() {
            d3.select(this).transition().duration(160).attr('d', arc).attr('opacity', 0.82);
            cLabel.text('32');
            cSub.text('CORE Rules');
        });

    var cLabel = g.append('text')
        .attr('text-anchor', 'middle').attr('dy', '0.25em')
        .attr('fill', '#ffffff').attr('font-size', '2rem').attr('font-weight', '800')
        .attr('font-family', 'Inter, sans-serif').text('32');

    var cSub = g.append('text')
        .attr('text-anchor', 'middle').attr('dy', '1.9em')
        .attr('fill', '#a0a6c0').attr('font-size', '0.68rem').attr('font-weight', '600')
        .attr('letter-spacing', '0.06em').attr('font-family', 'Inter, sans-serif').text('CORE Rules');

    /* Legend below donut */
    var legendY = size / 2 + radius + 18;
    if (legendY + domains.length * 20 <= size) {
        var legendG = svg.append('g').attr('transform', 'translate(16,' + legendY + ')');
        domains.forEach(function(d, i) {
            var row = legendG.append('g').attr('transform', 'translate(0,' + (i * 20) + ')');
            row.append('rect').attr('width', 11).attr('height', 11).attr('rx', 3).attr('fill', d.color).attr('opacity', 0.85);
            row.append('text').attr('x', 16).attr('y', 9).attr('fill', '#a0a6c0').attr('font-size', '10px').attr('font-family', 'Inter, sans-serif').text(d.label + ' (' + d.count + ')');
        });
    }
})();
</script>

<script src="../assets/js/content-loader.js"></script>
<script>
    window.cortexLoader = new ContentLoader('../data/content.json');
</script>

</body>
</html>
