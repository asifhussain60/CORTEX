<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>CORTEX — AI Engineering Orchestration Framework | Strategic Executive Command</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --glass-bg: rgba(10, 15, 30, 0.7);
            --glass-border: rgba(255, 255, 255, 0.1);
            --accent-cyan: #00d4ff;
            --accent-emerald: #10b981;
            --accent-violet: #8b5cf6;
            --text-main: #e2e8f0;
        }

        body {
            background-color: #030712;
            background-image: 
                radial-gradient(circle at 20% 20%, rgba(0, 212, 255, 0.05) 0%, transparent 40%),
                radial-gradient(circle at 80% 80%, rgba(139, 92, 246, 0.05) 0%, transparent 40%);
            color: var(--text-main);
            font-family: 'Inter', 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
            -webkit-tap-highlight-color: transparent;
        }

        /* ── Inter heading override ── */
        h1, h2, h3, h4, h5, h6 {
            font-family: 'Inter', sans-serif;
            letter-spacing: -0.02em;
            word-spacing: 0.04em;
        }

        /* Hero Wrapper Styles - Preserved as requested */
        .hero-section-wrapper {
            position: relative;
            padding-top: 2rem;
            margin-bottom: 2rem;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .hero-robot-container {
            position: relative;
            z-index: 10;
            margin-bottom: -1px;
        }
        .hero-divider-line {
            width: 100%;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1) 50%, transparent);
        }

        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            border-radius: 1.5rem;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5);
            position: relative;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @media (hover: hover) {
            .glass-card:hover {
                border-color: rgba(0, 212, 255, 0.3);
                transform: translateY(-5px);
                box-shadow: 0 12px 48px 0 rgba(0, 212, 255, 0.15);
            }
        }

        .glass-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(45deg, transparent, rgba(255,255,255,0.03), transparent);
            transform: rotate(45deg);
            animation: shine 15s infinite linear;
            pointer-events: none;
        }

        @keyframes shine {
            0% { transform: translateX(-100%) rotate(45deg); }
            100% { transform: translateX(100%) rotate(45deg); }
        }

        .hero-robot-head {
            width: 140px;
            filter: drop-shadow(0 0 20px rgba(0, 212, 255, 0.4));
            transition: filter 0.5s ease;
        }

        .stat-glow {
            text-shadow: 0 0 15px currentColor;
        }

        .intelligence-diamond {
            position: relative;
            width: 320px;
            height: 320px;
            margin: 0 auto;
        }

        .diamond-node {
            position: absolute;
            width: 90px;
            height: 90px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: rgba(15, 23, 42, 0.9);
            border: 1px solid var(--glass-border);
            z-index: 10;
            transition: all 0.3s ease;
        }

        @media (max-width: 640px) {
            .intelligence-diamond {
                transform: scale(0.8);
            }
        }

        .nav-blur {
            background: rgba(3, 7, 18, 0.8);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid var(--glass-border);
        }

        .chart-container svg {
            overflow: visible;
        }

        .token-ring {
            stroke-dasharray: 283;
            stroke-dashoffset: 283;
            animation: ring-progress 2s ease-out forwards;
        }

        @keyframes ring-progress {
            to { stroke-dashoffset: 17; } /* 94% progress */
        }
        
        .analyzer-tag {
            background: rgba(0, 212, 255, 0.1);
            border: 1px solid rgba(0, 212, 255, 0.2);
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #00d4ff;
        }

        /* Mobile specific layout fixes */
        @media (max-width: 768px) {
            .hero-robot-head { width: 100px; }
            .glass-card { border-radius: 1rem; }
        }

        /* ── Enhanced Section Styles ── */
        .section-eyebrow {
            font-size: 0.65rem; font-weight: 700;
            letter-spacing: 0.18em; text-transform: uppercase;
        }
        .pill-badge {
            display: inline-flex; align-items: center; gap: 0.4rem;
            padding: 0.2rem 0.8rem; border-radius: 999px;
            font-size: 0.65rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase;
        }
        /* Pain vs CORTEX comparison — card-pair layout */
        .compare-pair {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0;
            border-radius: 1rem;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.07);
            margin-bottom: 0.75rem;
        }
        .compare-pair-before {
            background: rgba(239, 68, 68, 0.05);
            border-right: 1px solid rgba(239,68,68,0.12);
            padding: 1rem 1.1rem;
        }
        .compare-pair-after {
            background: rgba(16, 185, 129, 0.05);
            padding: 1rem 1.1rem;
        }
        .compare-pair-before .ccp-id {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.6rem; font-weight: 700;
            letter-spacing: 0.12em; color: #f87171;
            margin-bottom: 0.25rem; display: block;
        }
        .compare-pair-after .ccp-id {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.6rem; font-weight: 700;
            letter-spacing: 0.12em; color: #34d399;
            margin-bottom: 0.25rem; display: block;
        }
        .compare-pair-before p { color: #fca5a5; font-size: 0.8rem; line-height: 1.5; margin: 0; }
        .compare-pair-after  p { color: #6ee7b7; font-size: 0.8rem; line-height: 1.5; margin: 0; }
        @media (max-width: 600px) {
            .compare-pair { grid-template-columns: 1fr; }
            .compare-pair-before { border-right: none; border-bottom: 1px solid rgba(239,68,68,0.12); }
        }
        /* Pipeline breadcrumb */
        .pipeline-track {
            display: flex; align-items: center; flex-wrap: wrap;
            gap: 0; justify-content: center;
        }
        .pipeline-node {
            display: flex; flex-direction: column; align-items: center;
            padding: 0.6rem 0.9rem;
            border-radius: 0.6rem;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            min-width: 100px; text-align: center;
            position: relative;
        }
        .pipeline-node.active {
            background: rgba(0,212,255,0.08);
            border-color: rgba(0,212,255,0.3);
        }
        .pipeline-connector {
            width: 2rem; height: 1px;
            background: linear-gradient(90deg, rgba(0,212,255,0.3), rgba(139,92,246,0.3));
            flex-shrink: 0;
        }
        /* Mermaid theme override */
        .mermaid svg { background: transparent !important; }
        /* Animated counter */
        @keyframes count-up { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
        .count-animate { animation: count-up 0.6s ease forwards; }
        /* Hover lift for stat cards */
        .stat-card {
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }
        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 40px -8px rgba(0,212,255,0.2);
        }

        /* ── SDLC Visual Pipeline ── */
        .sdlc-pipeline {
            display: flex;
            align-items: stretch;
            gap: 0;
            overflow-x: auto;
            padding-bottom: 0.5rem;
            scroll-snap-type: x mandatory;
        }
        .sdlc-phase {
            flex: 1;
            min-width: 110px;
            max-width: 160px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.45rem;
            padding: 1.25rem 0.75rem 1rem;
            border-radius: 0.875rem;
            border: 1px solid rgba(255,255,255,0.06);
            background: linear-gradient(160deg, var(--phase-glow, rgba(255,255,255,0.02)), rgba(255,255,255,0.01));
            scroll-snap-align: start;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .sdlc-phase:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px -4px var(--phase-glow, rgba(0,0,0,0.2));
            border-color: var(--phase-color, rgba(255,255,255,0.1));
        }
        .sdlc-phase--certified {
            border-color: rgba(16,185,129,0.3);
        }
        .sdlc-icon {
            font-size: 1.75rem;
            line-height: 1;
        }
        .sdlc-label {
            font-family: 'Inter', sans-serif;
            font-size: 0.7rem;
            font-weight: 800;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--phase-color, #e2e8f0);
        }
        .sdlc-gate {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.58rem;
            font-weight: 600;
            padding: 0.15rem 0.5rem;
            border-radius: 999px;
            border: 1px solid rgba(255,255,255,0.08);
            background: rgba(255,255,255,0.04);
            color: #94a3b8;
            white-space: nowrap;
            text-align: center;
        }
        .sdlc-gate--dor  { border-color: rgba(0,212,255,0.25); color: #67e8f9; }
        .sdlc-gate--arch { border-color: rgba(167,139,250,0.25); color: #c4b5fd; }
        .sdlc-gate--tdd  { border-color: rgba(139,92,246,0.3); color: #a78bfa; }
        .sdlc-gate--gov  { border-color: rgba(56,189,248,0.25); color: #7dd3fc; }
        .sdlc-gate--lens { border-color: rgba(52,211,153,0.25); color: #6ee7b7; }
        .sdlc-gate--sec  { border-color: rgba(248,113,113,0.3); color: #fca5a5; }
        .sdlc-gate--dod  { border-color: rgba(16,185,129,0.35); color: #34d399; background: rgba(16,185,129,0.08); }
        .sdlc-desc {
            font-size: 0.68rem;
            color: #64748b;
            text-align: center;
            line-height: 1.45;
            margin-top: 0.1rem;
        }
        .sdlc-arrow {
            display: flex;
            align-items: center;
            padding: 0 0.2rem;
            font-size: 1.25rem;
            color: rgba(255,255,255,0.12);
            flex-shrink: 0;
            align-self: center;
        }
        @media (max-width: 900px) {
            .sdlc-pipeline { gap: 0; }
            .sdlc-phase { min-width: 90px; padding: 1rem 0.5rem; }
            .sdlc-desc { display: none; }
        }

        /* ── Domain Bubble Grid ── */
        .domain-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 0.6rem;
            justify-content: center;
            align-items: center;
        }
        .domain-bubble {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-radius: 1rem;
            border: 1px solid rgba(255,255,255,0.08);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            cursor: default;
            flex-shrink: 0;
        }
        .domain-bubble:hover {
            transform: scale(1.06);
            box-shadow: 0 8px 24px -4px var(--bubble-glow);
            border-color: var(--bubble-color);
        }
        .domain-bubble .db-count {
            font-family: 'Inter', sans-serif;
            font-weight: 900;
            color: var(--bubble-color);
            line-height: 1;
        }
        .domain-bubble .db-name {
            font-family: 'JetBrains Mono', monospace;
            font-weight: 600;
            text-transform: uppercase;
            color: #64748b;
            letter-spacing: 0.06em;
            text-align: center;
        }
    </style>
</head>
<body class="min-h-screen">

    <nav class="nav-blur sticky top-0 z-50 px-4 md:px-6 py-4 flex justify-between items-center">
        <div class="flex items-center gap-2 md:gap-3">
            <div class="w-8 h-8 rounded-lg bg-cyan-500 flex items-center justify-center font-bold text-black text-xs">CX</div>
            <div class="flex flex-col leading-none">
                <span class="font-bold tracking-tight text-lg md:text-xl">CORTEX</span>
                <span class="text-[9px] text-cyan-500/70 font-semibold tracking-widest uppercase hidden md:block">AI Engineering Orchestration Framework</span>
            </div>
        </div>
        <div class="flex gap-4">
            <span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-[10px] md:text-xs font-semibold flex items-center gap-2">
                <i data-lucide="shield-check" class="w-3 h-3"></i>
                <span class="hidden sm:inline tracking-widest uppercase">Strategic Command</span>
                <span class="sm:hidden">EXECUTIVE</span>
            </span>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 md:px-6 py-8 md:py-12 space-y-16 md:space-y-24">

        <!-- ── Hero Section ── -->
        <section class="text-center space-y-6 md:space-y-8">
            <div class="hero-section-wrapper">
                <div class="hero-robot-container">
                    <a href="../index.html" title="Back to CORTEX Home">
                        <img alt="CORTEX Logo" class="hero-robot-head" loading="eager" fetchpriority="high"
                             src="../assets/images/cortex-logo-200.png"/>
                    </a>
                </div>
                <div class="hero-divider-line"></div>
            </div>

            <div class="space-y-4">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-[10px] font-bold tracking-widest uppercase">
                    <div class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></div> AI Engineering Orchestration Framework
                </div>
                <h1 class="text-3xl md:text-5xl lg:text-6xl font-black tracking-tighter bg-clip-text text-transparent bg-gradient-to-b from-white to-slate-500 leading-[1.1] md:leading-tight">
                    Strategic Engineering Governance at Scale
                </h1>
                <p class="text-lg md:text-xl text-slate-400 max-w-3xl mx-auto font-light leading-relaxed px-4">
                    CORTEX — the <span class="text-cyan-400 font-semibold">AI Engineering Orchestration Framework</span> — transforms software engineering from an ad-hoc process into a <span class="text-cyan-400 font-semibold uppercase tracking-tight">Governed Development Lifecycle</span>. Institutional integrity through automated cognitive checkpoints.
                </p>
            </div>

            <div class="flex flex-wrap justify-center gap-4 md:gap-6 pt-4 px-2">
                <div class="glass-card px-4 md:px-8 py-4 md:py-6 text-center w-[calc(50%-1rem)] md:w-48">
                    <div class="text-xl md:text-3xl font-black text-emerald-400 mb-1">99 / 99</div>
                    <div class="text-[8px] md:text-[10px] text-slate-500 uppercase tracking-widest font-bold">Success Cycles</div>
                </div>
                <div class="glass-card px-4 md:px-8 py-4 md:py-6 text-center w-[calc(50%-1rem)] md:w-48 border-cyan-500/30">
                    <div class="text-xl md:text-3xl font-black text-cyan-400 mb-1">94%</div>
                    <div class="text-[8px] md:text-[10px] text-slate-500 uppercase tracking-widest font-bold">Token Savings</div>
                </div>
                <div class="glass-card px-4 md:px-8 py-4 md:py-6 text-center w-full md:w-48">
                    <div class="text-xl md:text-3xl font-black text-violet-400 mb-1">Zero</div>
                    <div class="text-[8px] md:text-[10px] text-slate-500 uppercase tracking-widest font-bold">Regressions</div>
                </div>
            </div>
        </section>

        <!-- ── NEW: The Cost of Uncontrolled AI (8 Pain Points) ── -->
        <section class="space-y-10">
            <div class="text-center space-y-3 px-4">
                <div class="section-eyebrow text-red-400">The Problem Space</div>
                <h2 class="text-2xl md:text-4xl font-black tracking-tighter">The Cost of Uncontrolled AI</h2>
                <p class="text-slate-400 max-w-2xl mx-auto text-sm md:text-base font-light leading-relaxed">
                    Unorchestrated AI creates 8 structural failure modes that compound silently — eroding quality, audit trails and institutional knowledge.
                </p>
            </div>

            <div class="glass-card p-5 md:p-8 space-y-2">
                <!-- Column headers -->
                <div class="grid grid-cols-2 gap-0 mb-3 px-1">
                    <div class="flex items-center gap-2 text-[9px] font-black uppercase tracking-widest text-red-400">
                        <span class="text-base">❌</span> Without CORTEX
                    </div>
                    <div class="flex items-center gap-2 text-[9px] font-black uppercase tracking-widest text-emerald-400">
                        <span class="text-base">✅</span> With CORTEX
                    </div>
                </div>

                <div class="compare-pair">
                    <div class="compare-pair-before">
                        <span class="ccp-id">CCP-001 · Session Amnesia</span>
                        <p>No memory between sessions. Every conversation starts from zero — context, decisions, and prior work vanish.</p>
                    </div>
                    <div class="compare-pair-after">
                        <span class="ccp-id">Persistent Memory</span>
                        <p>Orchestrator traces, 7 SQLite databases, and RCA history carry full context across every session indefinitely.</p>
                    </div>
                </div>
                <div class="compare-pair">
                    <div class="compare-pair-before">
                        <span class="ccp-id">CCP-002 · No Enforcement</span>
                        <p>AI suggestions violate standards silently. Governance lives only in documents nobody reads at commit time.</p>
                    </div>
                    <div class="compare-pair-after">
                        <span class="ccp-id">Tiered Enforcement</span>
                        <p>36 governance rules enforced automatically at pre-commit, CI pipeline, and runtime — no human reviewer required.</p>
                    </div>
                </div>
                <div class="compare-pair">
                    <div class="compare-pair-before">
                        <span class="ccp-id">CCP-003 · Implementation First</span>
                        <p>Code ships without tests. Regressions surface in production weeks after the causal change.</p>
                    </div>
                    <div class="compare-pair-after">
                        <span class="ccp-id">Mandatory TDD</span>
                        <p>CORE-008 mandates RED → GREEN → REFACTOR on every change. No implementation proceeds without a failing test.</p>
                    </div>
                </div>
                <div class="compare-pair">
                    <div class="compare-pair-before">
                        <span class="ccp-id">CCP-004 · Invisible Audit Trail</span>
                        <p>Who changed what, when, and why? No traceable decision log. Compliance evidence reconstructed manually.</p>
                    </div>
                    <div class="compare-pair-after">
                        <span class="ccp-id">Full Traceability</span>
                        <p>AC_START/AC_COMPLETE markers log every operation — hash-chained and tamper-evident from keystroke to release.</p>
                    </div>
                </div>
                <div class="compare-pair">
                    <div class="compare-pair-before">
                        <span class="ccp-id">CCP-005 · Single-Pass Execution</span>
                        <p>One-shot AI responses with no convergence loop. Defects survive review because nothing rescans after a fix.</p>
                    </div>
                    <div class="compare-pair-after">
                        <span class="ccp-id">Convergence Loops</span>
                        <p>CORE-068: detect → fix → rescan cycles repeat autonomously until zero P0/P1 violations remain — up to 3 passes.</p>
                    </div>
                </div>
                <div class="compare-pair">
                    <div class="compare-pair-before">
                        <span class="ccp-id">CCP-006 · Context Blindness</span>
                        <p>AI responds without workspace awareness. Suggestions ignore existing architecture, history, and coupling.</p>
                    </div>
                    <div class="compare-pair-after">
                        <span class="ccp-id">LENS Intelligence</span>
                        <p>9 parallel analyzers scan structure, history, dependencies, security, and patterns before every single response.</p>
                    </div>
                </div>
                <div class="compare-pair">
                    <div class="compare-pair-before">
                        <span class="ccp-id">CCP-007 · Knowledge Drain</span>
                        <p>Expertise leaves when engineers leave. No pattern library. Institutional knowledge lives in Slack threads.</p>
                    </div>
                    <div class="compare-pair-after">
                        <span class="ccp-id">Living Knowledge Base</span>
                        <p>Pattern library, domain knowledge, and RCA prevention rules persist and compound over time — cross-team.</p>
                    </div>
                </div>
                <div class="compare-pair">
                    <div class="compare-pair-before">
                        <span class="ccp-id">CCP-008 · Security Afterthought</span>
                        <p>Security reviewed at end-of-cycle in a separate scanner. Vulnerabilities routinely reach production.</p>
                    </div>
                    <div class="compare-pair-after">
                        <span class="ccp-id">5-Layer Security</span>
                        <p>PII blocks, governance integrity, LENS scans, CVE analysis, and OWASP gate — enforced from keystroke to release.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Section 1: The 9 LENS Analyzers (Sensory System) -->
        <section class="space-y-12">
            <div class="text-center space-y-4 px-4">
                <div class="text-cyan-400 font-bold tracking-widest text-[10px] uppercase">Automated Perception</div>
                <h2 class="text-2xl md:text-4xl font-black tracking-tighter">Real-Time Intelligence: The LENS System</h2>
                <p class="text-slate-400 max-w-2xl mx-auto text-sm md:text-lg font-light">
                    CORTEX employs 9 parallel analyzers to achieve sub-second situational awareness of your entire engineering environment.
                </p>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 md:gap-4">
                <div class="glass-card p-4 space-y-2 border-white/5">
                    <span class="analyzer-tag">Structure</span>
                    <p class="text-[10px] md:text-[11px] text-slate-500">Functional mapping of classes and interfaces.</p>
                </div>
                <div class="glass-card p-4 space-y-2 border-white/5">
                    <span class="analyzer-tag">History</span>
                    <p class="text-[10px] md:text-[11px] text-slate-500">Identifies high-churn, high-risk components.</p>
                </div>
                <div class="glass-card p-4 space-y-2 border-white/5">
                    <span class="analyzer-tag">Dependencies</span>
                    <p class="text-[10px] md:text-[11px] text-slate-500">Maps architecture coupling and risk.</p>
                </div>
                <div class="glass-card p-4 space-y-2 border-white/5">
                    <span class="analyzer-tag">Security</span>
                    <p class="text-[10px] md:text-[11px] text-slate-500">Instant scan for patterns and vulnerabilities.</p>
                </div>
                <div class="glass-card p-4 space-y-2 border-white/5">
                    <span class="analyzer-tag">Patterns</span>
