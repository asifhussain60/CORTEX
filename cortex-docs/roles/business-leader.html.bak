    <script>
        window.onload = function() {
            lucide.createIcons();
            buildRoiChart();
        };

        // ── Shift-Left ROI Chart (enhanced with cost-multiplier labels) ──
        function buildRoiChart() {
            const roiData = [
                { stage: 'Keyboard', cost: 1,   label: '1×',   color: '#10b981' },
                { stage: 'Review',   cost: 4,   label: '4×',   color: '#00d4ff' },
                { stage: 'QA',       cost: 15,  label: '15×',  color: '#8b5cf6' },
                { stage: 'UAT',      cost: 40,  label: '40×',  color: '#f59e0b' },
                { stage: 'Prod',     cost: 100, label: '100×', color: '#ef4444' }
            ];

            const chartEl = document.getElementById('roi-chart');
            if (!chartEl) return;

            const margin = { top: 28, right: 16, bottom: 36, left: 28 };
            const totalW = chartEl.getBoundingClientRect().width || 400;
            const totalH = chartEl.getBoundingClientRect().height || 220;
            const width  = totalW - margin.left - margin.right;
            const height = totalH - margin.top  - margin.bottom;

            const svg = d3.select('#roi-chart')
                .append('svg')
                .attr('width', '100%').attr('height', '100%')
                .attr('viewBox', `0 0 ${totalW} ${totalH}`)
                .append('g')
                .attr('transform', `translate(${margin.left},${margin.top})`);

            const x = d3.scaleBand().range([0, width]).domain(roiData.map(d => d.stage)).padding(0.38);
            const y = d3.scaleLinear().domain([0, 112]).range([height, 0]);

            // Soft grid
            svg.append('g').call(d3.axisLeft(y).ticks(5).tickSize(-width).tickFormat(''))
                .selectAll('line').attr('stroke', 'rgba(255,255,255,0.04)');
            svg.selectAll('.domain').remove();

            // Bars with entrance animation
            svg.selectAll('.bar').data(roiData).enter().append('rect')
                .attr('x', d => x(d.stage)).attr('width', x.bandwidth())
                .attr('fill', d => d.color).attr('rx', 5)
                .attr('y', height).attr('height', 0)
                .transition().duration(1400).ease(d3.easeCubicOut)
                .attr('y', d => y(d.cost)).attr('height', d => height - y(d.cost));

            // Bar inner glow overlay
            svg.selectAll('.bar-glow').data(roiData).enter().append('rect')
                .attr('x', d => x(d.stage) + 2).attr('width', d => Math.max(0, x.bandwidth() - 4))
                .attr('fill', d => d.color).attr('rx', 4).attr('opacity', 0.12)
                .attr('y', d => y(d.cost)).attr('height', d => Math.min(12, height - y(d.cost)));

            // Cost multiplier label above bar
            svg.selectAll('.cost-label').data(roiData).enter().append('text')
                .attr('x', d => x(d.stage) + x.bandwidth() / 2)
                .attr('y', d => y(d.cost) - 7)
                .attr('text-anchor', 'middle').attr('fill', d => d.color)
                .attr('font-size', '10px').attr('font-weight', '800').attr('font-family', 'Inter, sans-serif')
                .text(d => d.label);

            // "CORTEX catches here" annotation on Keyboard bar
            const kx = x('Keyboard') + x.bandwidth() / 2;
            const ky = y(1) - 18;
            svg.append('line').attr('x1', kx).attr('y1', ky - 2).attr('x2', kx).attr('y2', y(1) - 6)
                .attr('stroke', '#10b981').attr('stroke-width', 1.5).attr('stroke-dasharray', '3,2');
            svg.append('text').attr('x', kx).attr('y', ky - 5)
                .attr('text-anchor', 'middle').attr('fill', '#10b981')
                .attr('font-size', '7px').attr('font-weight', '700').attr('font-family', 'JetBrains Mono, monospace')
                .text('← 94% caught here');

            // X-axis stage labels
            svg.append('g').attr('transform', `translate(0,${height})`)
                .call(d3.axisBottom(x).tickSize(0))
                .selectAll('text')
                .attr('fill', '#64748b').attr('font-size', '9px').attr('font-weight', 'bold')
                .attr('font-family', 'Inter, sans-serif').attr('dy', '1.2em');
            svg.selectAll('.domain').remove();
        }

        // Rebuild chart on window resize
        window.addEventListener('resize', () => {
            const el = document.getElementById('roi-chart');
            if (el) { el.innerHTML = ''; buildRoiChart(); }
        });
    </script>
</body>
</html>