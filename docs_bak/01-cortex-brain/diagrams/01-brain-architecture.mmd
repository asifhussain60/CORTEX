graph TB
    subgraph user ["User Layer"]
        req["User Request"]
    end
    
    subgraph lens ["LENS Protocol Analysis"]
        lang["Language: Intent Classification"]
        exam["Examination: Code Analysis"]
        nav["Navigation: Git History"]
        syn["Synthesis: Context Aggregation"]
    end
    
    subgraph tiers ["4-Tier Brain Architecture"]
        subgraph t0["TIER 0: Immutable Rules"]
            t0_rules["29 CORE Rules<br/>(SKULL Governance)"]
            t0_protect["Brain Protection<br/>Mechanisms"]
        end
        
        subgraph t1["TIER 1: Project Governance"]
            t1_ac["AC-ID Tracking<br/>& Lifecycle"]
            t1_audit["Audit Trail<br/>Hash-Chain"]
            t1_gates["Governance<br/>Gates"]
        end
        
        subgraph t2["TIER 2: Response Templates"]
            t2_templates["Response<br/>Templates v4.0"]
            t2_optim["Token<br/>Optimization"]
            t2_adapt["Adaptive<br/>Formatting"]
        end
        
        subgraph t3["TIER 3: Knowledge Library"]
            t3_repo["Knowledge<br/>Repository"]
            t3_search["Semantic<br/>Search"]
            t3_cache["Caching &<br/>Retrieval"]
        end
        
        t0 --> t1
        t1 --> t2
        t2 --> t3
    end
    
    subgraph composite["Composite Request Generation"]
        comp_assembly["Multi-Tier<br/>Assembly"]
        comp_compress["Token<br/>Compression"]
        comp_validate["Compliance<br/>Validation"]
    end
    
    subgraph output ["Execution Layer"]
        copilot["GitHub Copilot<br/>Execution"]
        audit["Audit Logging<br/>& Verification"]
    end
    
    req --> lang
    lang --> exam
    exam --> nav
    nav --> syn
    syn --> t0_rules
    
    t0_protect -.->|Enforce| t1_ac
    t1_ac -.->|Context| t2_templates
    t2_adapt -.->|Enhance| t3_repo
    
    t1_ac --> comp_assembly
    t2_templates --> comp_assembly
    t3_repo --> comp_assembly
    
    comp_assembly --> comp_compress
    comp_compress --> comp_validate
    comp_validate --> copilot
    
    copilot --> audit
    audit -->|Log to Trail| t1_audit
    
    style t0 fill:#ff6b6b
    style t1 fill:#4ecdc4
    style t2 fill:#45b7d1
    style t3 fill:#96ceb4
    style composite fill:#ffeaa7
    style tiers fill:#f0f0f0
