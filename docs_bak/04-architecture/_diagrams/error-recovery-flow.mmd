graph TD
    A["User Request"] --> B["Orchestrator<br/>Execution"]
    
    B --> C{"Error<br/>Detected?"}
    
    C -->|Yes| D["Circuit Breaker<br/>Check"]
    C -->|No| E["Normal Response"]
    
    D --> F{"Circuit<br/>Open?"}
    
    F -->|Yes| G["Return Cached<br/>Response"]
    F -->|No| H["Retry Logic"]
    
    H --> I{"Retry<br/>Success?"}
    
    I -->|Yes| E
