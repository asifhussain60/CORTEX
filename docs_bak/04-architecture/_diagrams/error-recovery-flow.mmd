    J --> K["Graceful<br/>Degradation"]
    
    E --> L["Audit Log"]
    G --> L
    K --> L
    
    L --> M["Return Response"]
    
    style A fill:#E3F2FD
    style M fill:#C8E6C9
    style C fill:#FFF9C4
