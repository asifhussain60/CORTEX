{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CORTEX Toolkit Schemas",
  "version": "1.0.0",
  "definitions": {
    "tool_registry_entry": {
      "type": "object",
      "required": [
        "name",
        "tier",
        "version",
        "capability_description",
        "file_path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "tier": {
          "type": "string",
          "enum": [
            "tier0",
            "tier1",
            "tier2",
            "tier3"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "capability_description": {
          "type": "string",
          "minLength": 10
        },
        "file_path": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "deprecated": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "capability_query": {
      "type": "object",
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 3
        },
        "tier_filter": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10
        }
      }
    },
    "consolidation_result": {
      "type": "object",
      "required": [
        "similarity_score",
        "tool_a",
        "tool_b",
        "recommendation"
      ],
      "properties": {
        "similarity_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tool_a": {
          "type": "string"
        },
        "tool_b": {
          "type": "string"
        },
        "recommendation": {
          "type": "string",
          "enum": [
            "merge",
            "keep_both",
            "refactor"
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    }
  }
}