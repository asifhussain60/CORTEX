<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ project_name }} - CORTEX Onboarding Dashboard</title>
    
    <!-- D3.js v7 for architecture graphs -->
    <script src="https://d3js.org/d3.v7.min.js"></script>
    
    <!-- Chart.js v4 for metrics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    
    <!-- Socket.IO for real-time updates (optional) -->
    {% if enable_websocket %}
    <script src="https://cdn.socket.io/4.5.4/socket.io.min.js"></script>
    {% endif %}
    
    <link rel="stylesheet" href="/static/css/onboarding_dashboard.css">
</head>
<body>
    <!-- Dashboard Container -->
    <div class="dashboard-container">
        <!-- Header -->
        <header class="dashboard-header">
            <div class="header-content">
                <h1 class="dashboard-title">
                    <span class="cortex-icon">🧠</span>
                    {{ project_name }} Onboarding Dashboard
                </h1>
                <p class="dashboard-subtitle">
                    Generated: {{ timestamp }} | 
                    Scanned: {{ file_count }} files ({{ loc_count | format_number }} LOC) |
                    Health Score: <span class="health-score health-{{ health_category }}">{{ health_score }}%</span>
                </p>
            </div>
            <div class="header-actions">
                <button class="btn btn-secondary" onclick="exportDashboard('pdf')">
                    📄 Export PDF
                </button>
                <button class="btn btn-secondary" onclick="exportDashboard('png')">
                    📷 Export PNG
                </button>
                <button class="btn btn-primary" onclick="refreshDashboard()">
                    🔄 Refresh
                </button>
            </div>
        </header>

        <!-- Tab Navigation -->
        <nav class="tab-navigation">
            <button class="tab-button active" data-tab="overview">
                📊 Overview
            </button>
            <button class="tab-button" data-tab="architecture">
                🏗️ Architecture
            </button>
            <button class="tab-button" data-tab="quality">
                ⭐ Quality
            </button>
            <button class="tab-button" data-tab="security">
                🔒 Security
            </button>
            <button class="tab-button" data-tab="recommendations">
                💡 Recommendations
            </button>
        </nav>

        <!-- Tab Content -->
        <div class="tab-content-container">
            <!-- Overview Tab -->
            <div id="overview-tab" class="tab-content active">
                {% include 'partials/overview_tab.html.j2' %}
            </div>

            <!-- Architecture Tab -->
            <div id="architecture-tab" class="tab-content">
                {% include 'partials/architecture_tab.html.j2' %}
            </div>

            <!-- Quality Tab -->
            <div id="quality-tab" class="tab-content">
                {% include 'partials/quality_tab.html.j2' %}
            </div>

            <!-- Security Tab -->
            <div id="security-tab" class="tab-content">
                {% include 'partials/security_tab.html.j2' %}
            </div>

            <!-- Recommendations Tab -->
            <div id="recommendations-tab" class="tab-content">
                {% include 'partials/recommendations_tab.html.j2' %}
            </div>
        </div>

        <!-- Footer -->
        <footer class="dashboard-footer">
            <p>
                <strong>Author:</strong> Asif Hussain | 
                <strong>Copyright:</strong> © 2024-2025 | 
                <strong>Repository:</strong> <a href="https://github.com/asifhussain60/CORTEX" target="_blank">github.com/asifhussain60/CORTEX</a>
            </p>
            <p class="footer-note">
                This dashboard was generated by CORTEX AI Assistant using clean architecture principles.
            </p>
        </footer>
    </div>

    <!-- Loading Overlay -->
    <div id="loading-overlay" class="loading-overlay" style="display: none;">
        <div class="loading-spinner"></div>
        <p class="loading-message">Updating dashboard...</p>
    </div>

    <!-- JavaScript -->
    <script src="/static/js/onboarding_dashboard.js"></script>
    
    {% if enable_websocket %}
    <script>
        // WebSocket connection for real-time updates
        const socket = io('{{ websocket_url }}');
        
        socket.on('health_update', (data) => {
            updateHealthScore(data.score, data.category);
        });
        
        socket.on('scan_progress', (data) => {
            updateScanProgress(data.current, data.total, data.message);
        });
        
        socket.on('new_issue', (data) => {
            addNewIssue(data.issue);
        });
    </script>
    {% endif %}
    
    <script>
        // Initialize dashboard data
        const dashboardData = {{ dashboard_data | tojson }};
        
        // Initialize on page load
        document.addEventListener('DOMContentLoaded', () => {
            initializeDashboard(dashboardData);
        });
    </script>
</body>
</html>
