<!-- Recommendations Tab Content -->
<div class="recommendations-container">
    <!-- Priority Matrix -->
    <div class="card card-primary">
        <h2 class="card-title">🎯 Priority Matrix</h2>
        <div class="priority-matrix">
            <div class="matrix-quadrant quadrant-critical">
                <h3>🔴 Critical - High ROI</h3>
                <p class="quadrant-subtitle">Fix immediately for maximum impact</p>
                <div class="recommendation-count">{{ critical_high_roi_count }} recommendations</div>
            </div>
            <div class="matrix-quadrant quadrant-important">
                <h3>🟡 Important - Medium ROI</h3>
                <p class="quadrant-subtitle">Schedule for next sprint</p>
                <div class="recommendation-count">{{ important_medium_roi_count }} recommendations</div>
            </div>
            <div class="matrix-quadrant quadrant-optional">
                <h3>🟢 Optional - Low Impact</h3>
                <p class="quadrant-subtitle">Consider during refactoring</p>
                <div class="recommendation-count">{{ optional_low_roi_count }} recommendations</div>
            </div>
            <div class="matrix-quadrant quadrant-deferred">
                <h3>⚪ Deferred - Nice to Have</h3>
                <p class="quadrant-subtitle">Low priority enhancements</p>
                <div class="recommendation-count">{{ deferred_count }} recommendations</div>
            </div>
        </div>
    </div>

    <!-- Top Recommendations -->
    <div class="card">
        <h2 class="card-title">💡 Top 10 Recommendations (Sorted by ROI)</h2>
        <div class="recommendations-list">
            {% for rec in top_recommendations %}
            <div class="recommendation-item priority-{{ rec.priority }}">
                <div class="rec-header">
                    <div class="rec-title-section">
                        <span class="rec-priority-badge priority-{{ rec.priority }}">{{ rec.priority | upper }}</span>
                        <h3 class="rec-title">{{ rec.title }}</h3>
                    </div>
                    <div class="rec-roi">
                        <span class="roi-value">ROI: {{ rec.roi_score }}</span>
                        <span class="roi-impact">{{ rec.impact_label }}</span>
                    </div>
                </div>
                
                <p class="rec-description">{{ rec.description }}</p>
                
                <div class="rec-details">
                    <div class="rec-metric">
                        <span class="metric-icon">⏱️</span>
                        <span class="metric-label">Effort:</span>
                        <span class="metric-value">{{ rec.effort_hours }}h</span>
                    </div>
                    <div class="rec-metric">
                        <span class="metric-icon">📈</span>
                        <span class="metric-label">Impact:</span>
                        <span class="metric-value">{{ rec.impact_points }} pts</span>
                    </div>
                    <div class="rec-metric">
                        <span class="metric-icon">🎯</span>
                        <span class="metric-label">Affected:</span>
                        <span class="metric-value">{{ rec.affected_files }} files</span>
                    </div>
                </div>
                
                <div class="rec-benefits">
                    <strong>Expected Benefits:</strong>
                    <ul>
                        {% for benefit in rec.benefits %}
                        <li>{{ benefit }}</li>
                        {% endfor %}
                    </ul>
                </div>
                
                <div class="rec-implementation">
                    <strong>Implementation Steps:</strong>
                    <ol>
                        {% for step in rec.implementation_steps %}
                        <li>{{ step }}</li>
                        {% endfor %}
                    </ol>
                </div>
                
                <div class="rec-code-template">
                    <strong>Code Template:</strong>
                    <pre><code class="language-{{ rec.language }}">{{ rec.code_template }}</code></pre>
                    <button class="btn btn-small btn-secondary" onclick="copyCodeTemplate('{{ rec.id }}')">
                        📋 Copy Template
                    </button>
                </div>
                
                <div class="rec-actions">
                    <button class="btn btn-primary" onclick="applyRecommendation('{{ rec.id }}')">
                        ✅ Apply Fix
                    </button>
                    <button class="btn btn-secondary" onclick="scheduleRecommendation('{{ rec.id }}')">
                        📅 Schedule
                    </button>
                    <button class="btn btn-secondary" onclick="dismissRecommendation('{{ rec.id }}')">
                        ❌ Dismiss
                    </button>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>

    <!-- Category Breakdown -->
    <div class="card">
        <h2 class="card-title">📊 Recommendations by Category</h2>
        <div class="category-grid">
            {% for category in recommendation_categories %}
            <div class="category-card">
                <div class="category-header">
                    <span class="category-icon">{{ category.icon }}</span>
                    <h3 class="category-name">{{ category.name }}</h3>
                </div>
                <div class="category-stats">
                    <div class="category-count">{{ category.count }}</div>
                    <div class="category-label">recommendations</div>
                </div>
                <div class="category-effort">
                    <span>Total Effort: {{ category.total_effort }}h</span>
                </div>
                <button class="btn btn-small btn-secondary" onclick="filterByCategory('{{ category.id }}')">
                    View All
                </button>
            </div>
            {% endfor %}
        </div>
    </div>

    <!-- Quick Wins -->
    <div class="card">
        <h2 class="card-title">⚡ Quick Wins (Under 2 hours)</h2>
        <p class="card-description">Low-effort, high-impact improvements you can make today</p>
        <div class="quick-wins-list">
            {% for win in quick_wins %}
            <div class="quick-win-item">
                <div class="win-header">
                    <span class="win-icon">{{ win.icon }}</span>
                    <h3 class="win-title">{{ win.title }}</h3>
                    <span class="win-effort">{{ win.effort_minutes }} min</span>
                </div>
                <p class="win-description">{{ win.description }}</p>
                <div class="win-actions">
                    <button class="btn btn-small btn-primary" onclick="applyQuickWin('{{ win.id }}')">
                        ⚡ Apply Now
                    </button>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>

    <!-- Technical Debt Summary -->
    <div class="card">
        <h2 class="card-title">💳 Technical Debt Summary</h2>
        <div class="debt-summary">
            <div class="debt-stat">
                <span class="debt-icon">💰</span>
                <div class="debt-content">
                    <span class="debt-value">{{ total_debt_hours }}h</span>
                    <span class="debt-label">Total Debt</span>
                </div>
            </div>
            <div class="debt-stat">
                <span class="debt-icon">📊</span>
                <div class="debt-content">
                    <span class="debt-value">{{ debt_ratio }}%</span>
                    <span class="debt-label">Debt Ratio</span>
                </div>
            </div>
            <div class="debt-stat">
                <span class="debt-icon">⏰</span>
                <div class="debt-content">
                    <span class="debt-value">{{ estimated_payoff_weeks }} weeks</span>
                    <span class="debt-label">Payoff Time</span>
                </div>
            </div>
        </div>
        <div class="debt-chart">
            <canvas id="debt-trend-chart"></canvas>
        </div>
    </div>

    <!-- Refactoring Roadmap -->
    <div class="card">
        <h2 class="card-title">🗺️ Refactoring Roadmap</h2>
        <div class="roadmap-timeline">
            {% for phase in refactoring_phases %}
            <div class="roadmap-phase">
                <div class="phase-header">
                    <span class="phase-number">Phase {{ phase.number }}</span>
                    <h3 class="phase-title">{{ phase.title }}</h3>
                    <span class="phase-duration">{{ phase.duration }}</span>
                </div>
                <div class="phase-goals">
                    <strong>Goals:</strong>
                    <ul>
                        {% for goal in phase.goals %}
                        <li>{{ goal }}</li>
                        {% endfor %}
                    </ul>
                </div>
                <div class="phase-deliverables">
                    <strong>Deliverables:</strong>
                    <ul>
                        {% for deliverable in phase.deliverables %}
                        <li>{{ deliverable }}</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>

    <!-- Export Recommendations -->
    <div class="card">
        <h2 class="card-title">💾 Export Recommendations</h2>
        <div class="export-options">
            <button class="btn btn-secondary" onclick="exportRecommendations('csv')">
                📊 Export as CSV
            </button>
            <button class="btn btn-secondary" onclick="exportRecommendations('json')">
                🔧 Export as JSON
            </button>
            <button class="btn btn-secondary" onclick="exportRecommendations('markdown')">
                📝 Export as Markdown
            </button>
            <button class="btn btn-secondary" onclick="generateJiraTickets()">
                🎫 Generate Jira Tickets
            </button>
        </div>
    </div>
</div>
