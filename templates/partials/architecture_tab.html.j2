<!-- Architecture Tab Content -->
<div class="architecture-container">
    <!-- Architecture Sub-Tabs -->
    <div class="card">
        <div class="architecture-sub-tabs">
            <button class="sub-tab-btn active" onclick="switchArchitectureView('dependency')">
                🔗 Dependency Graph
            </button>
            <button class="sub-tab-btn" onclick="switchArchitectureView('uml')">
                📐 UML Class Diagrams
            </button>
        </div>
    </div>

    <!-- Dependency Graph View -->
    <div id="dependency-view" class="architecture-view active">
        <!-- Architecture Controls -->
        <div class="card card-controls">
            <div class="controls-grid">
                <div class="control-group">
                    <label for="graph-type">Graph Type:</label>
                    <select id="graph-type" onchange="updateArchitectureGraph()">
                        <option value="dependency">Dependency Graph</option>
                        <option value="hierarchy">Component Hierarchy</option>
                        <option value="dataflow">Data Flow</option>
                        <option value="callgraph">Call Graph</option>
                    </select>
                </div>

            <div class="control-group">
                <label for="filter-language">Filter by Language:</label>
                <select id="filter-language" onchange="updateArchitectureGraph()">
                    <option value="all">All Languages</option>
                    {% for lang in languages %}
                    <option value="{{ lang.name }}">{{ lang.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="control-group">
                <label for="min-health">Min Health Score:</label>
                <input type="range" id="min-health" min="0" max="100" value="0" 
                       oninput="updateArchitectureGraph(); document.getElementById('health-value').textContent = this.value + '%'">
                <span id="health-value">0%</span>
            </div>

            <div class="control-group">
                <button class="btn btn-secondary" onclick="resetArchitectureView()">
                    🔄 Reset View
                </button>
                <button class="btn btn-secondary" onclick="exportArchitectureGraph()">
                    💾 Export Graph
                </button>
            </div>
        </div>
    </div>

    <!-- Main Architecture Graph -->
    <div class="card card-full-height">
        <h2 class="card-title">🏗️ Dependency Graph</h2>
        <div id="architecture-graph" class="graph-container">
            <!-- D3.js force-directed graph will be rendered here -->
            <svg id="dependency-svg" width="100%" height="600"></svg>
        </div>
        <div class="graph-legend">
            <div class="legend-item">
                <span class="legend-circle" style="background-color: #10b981;"></span>
                <span>Healthy (80-100%)</span>
            </div>
            <div class="legend-item">
                <span class="legend-circle" style="background-color: #f59e0b;"></span>
                <span>Warning (50-79%)</span>
            </div>
            <div class="legend-item">
                <span class="legend-circle" style="background-color: #ef4444;"></span>
                <span>Critical (&lt;50%)</span>
            </div>
            <div class="legend-item">
                <span class="legend-circle" style="background-color: #6366f1;"></span>
                <span>External Dependency</span>
            </div>
        </div>
    </div>

    <!-- Architecture Metrics -->
    <div class="metrics-grid">
        <div class="metric-card">
            <h3 class="metric-title">📊 Complexity Metrics</h3>
            <div class="metric-list">
                <div class="metric-row">
                    <span class="metric-label">Cyclomatic Complexity:</span>
                    <span class="metric-value">{{ avg_complexity | round(2) }}</span>
                </div>
                <div class="metric-row">
                    <span class="metric-label">Max Nesting Depth:</span>
                    <span class="metric-value">{{ max_nesting }}</span>
                </div>
                <div class="metric-row">
                    <span class="metric-label">Coupling Score:</span>
                    <span class="metric-value">{{ coupling_score }}%</span>
                </div>
                <div class="metric-row">
                    <span class="metric-label">Cohesion Score:</span>
                    <span class="metric-value">{{ cohesion_score }}%</span>
                </div>
            </div>
        </div>

        <div class="metric-card">
            <h3 class="metric-title">🔗 Dependency Analysis</h3>
            <div class="metric-list">
                <div class="metric-row">
                    <span class="metric-label">Total Dependencies:</span>
                    <span class="metric-value">{{ total_dependencies }}</span>
                </div>
                <div class="metric-row">
                    <span class="metric-label">Circular Dependencies:</span>
                    <span class="metric-value metric-{{ 'error' if circular_dependencies > 0 else 'success' }}">
                        {{ circular_dependencies }}
                    </span>
                </div>
                <div class="metric-row">
                    <span class="metric-label">External Dependencies:</span>
                    <span class="metric-value">{{ external_dependencies }}</span>
                </div>
                <div class="metric-row">
                    <span class="metric-label">Dependency Depth:</span>
                    <span class="metric-value">{{ max_dependency_depth }}</span>
                </div>
            </div>
        </div>

        <div class="metric-card">
            <h3 class="metric-title">🎯 Architecture Patterns</h3>
            <div class="pattern-list">
                {% for pattern in detected_patterns %}
                <div class="pattern-item">
                    <span class="pattern-icon">{{ pattern.icon }}</span>
                    <span class="pattern-name">{{ pattern.name }}</span>
                    <span class="pattern-confidence">{{ pattern.confidence }}%</span>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Component Details Panel (shown on node click) -->
    <div id="component-details" class="component-details" style="display: none;">
        <div class="details-header">
            <h3 id="component-name">Component Name</h3>
            <button class="btn-close" onclick="closeComponentDetails()">×</button>
        </div>
        <div class="details-content">
            <div class="details-section">
                <h4>📊 Metrics</h4>
                <div id="component-metrics"></div>
            </div>
            <div class="details-section">
                <h4>🔗 Dependencies</h4>
                <div id="component-dependencies"></div>
            </div>
            <div class="details-section">
                <h4>⚠️ Issues</h4>
                <div id="component-issues"></div>
            </div>
        </div>
    </div>
    </div> <!-- End dependency-view -->

    <!-- UML Diagrams View -->
    <div id="uml-view" class="architecture-view" style="display: none;">
        <!-- UML Controls -->
        <div class="card card-controls">
            <div class="controls-grid">
                <div class="control-group">
                    <p class="info-text">UML diagram generated with full project scope (50 classes max)</p>
                </div>

                <div class="control-group">
                    <button class="btn btn-secondary" onclick="exportUMLDiagram()">
                        💾 Export SVG
                    </button>
                </div>
            </div>
        </div>

        <!-- UML Statistics -->
        <div class="card">
            <div class="uml-stats">
                <div class="uml-stats-item">
                    <div class="uml-stats-value" id="uml-class-count">{{ uml_stats.total_classes or 0 }}</div>
                    <div class="uml-stats-label">Classes</div>
                </div>
                <div class="uml-stats-item">
                    <div class="uml-stats-value" id="uml-relationship-count">{{ uml_stats.total_relationships or 0 }}</div>
                    <div class="uml-stats-label">Relationships</div>
                </div>
                <div class="uml-stats-item">
                    <div class="uml-stats-value" id="uml-abstract-count">{{ uml_stats.abstract_classes or 0 }}</div>
                    <div class="uml-stats-label">Abstract</div>
                </div>
                <div class="uml-stats-item">
                    <div class="uml-stats-value" id="uml-inheritance-count">{{ uml_stats.inheritance_relationships or 0 }}</div>
                    <div class="uml-stats-label">Inheritance</div>
                </div>
            </div>
        </div>

        <!-- UML Diagram Container -->
        <div class="card card-full-height">
            <h2 class="card-title">📐 UML Class Diagram</h2>
            <div id="uml-diagram-container" class="uml-container">
                {% if uml_diagram_svg %}
                    {{ uml_diagram_svg | safe }}
                {% elif uml_error %}
                    <div class="uml-error">
                        <h3>Error Generating UML</h3>
                        <p>{{ uml_error }}</p>
                    </div>
                {% else %}
                    <div class="uml-loading">No UML diagram available</div>
                {% endif %}
            </div>
        </div>
    </div> <!-- End uml-view -->
</div>

<script>
    // Architecture graph data
    const architectureData = {
        nodes: {{ architecture_nodes | tojson }},
        edges: {{ architecture_edges | tojson }},
        patterns: {{ detected_patterns | tojson }}
    };
</script>
