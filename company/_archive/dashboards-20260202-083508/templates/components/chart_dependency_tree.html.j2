{# 
  D3.js Dependency Tree Component
  CORTEX Phase 18 - Dependencies Tab
  Hierarchical tree visualization of dependencies
#}

<div class="chart-container">
  <div class="chart-header">
    <h3>Dependency Tree</h3>
    <p class="chart-description">Hierarchical dependency structure</p>
  </div>
  <div id="dependency-tree" 
       class="visualization-canvas" 
       role="img" 
       aria-label="Dependency tree hierarchical visualization"
       style="min-height: 600px;">
  </div>
</div>

<script>
(function() {
  'use strict';
  
  function renderDependencyTree(data) {
    const container = document.getElementById('dependency-tree');
    if (!container) return;
    
    const width = container.clientWidth || 800;
    const height = 600;
    
    container.innerHTML = "";
    
    const svg = d3.select("#dependency-tree")
      .append("svg")
      .attr("width", "100%")
      .attr("height", height)
      .attr("viewBox", [0, 0, width, height]);
    
    const g = svg.append("g")
      .attr("transform", `translate(${width / 2},50)`);
    
    const tree = d3.tree()
      .size([width - 100, height - 100])
      .separation((a, b) => (a.parent === b.parent ? 1 : 2) / a.depth);
    
    const root = d3.hierarchy(data);
    tree(root);
    
    // Reposition for radial layout
    root.each(d => {
      d.y = d.depth * 120;
    });
    
    // Add links
    g.append("g")
      .attr("fill", "none")
      .attr("stroke", "rgba(255, 255, 255, 0.3)")
      .attr("stroke-width", 2)
      .selectAll("path")
      .data(root.links())
      .join("path")
      .attr("d", d3.linkVertical()
        .x(d => d.x - width / 2)
        .y(d => d.y));
    
    // Add nodes
    const node = g.append("g")
      .selectAll("g")
      .data(root.descendants())
      .join("g")
      .attr("transform", d => `translate(${d.x - width / 2},${d.y})`);
    
    node.append("circle")
      .attr("r", 8)
      .attr("fill", d => d.children ? "rgba(77, 140, 255, 0.8)" : "rgba(34, 197, 94, 0.8)")
      .attr("stroke", "#fff")
      .attr("stroke-width", 2);
    
    node.append("text")
      .attr("dy", "0.31em")
      .attr("x", d => d.children ? -12 : 12)
      .attr("text-anchor", d => d.children ? "end" : "start")
      .attr("font-size", "11px")
      .attr("fill", "rgba(255, 255, 255, 0.9)")
      .text(d => d.data.name)
      .clone(true).lower()
      .attr("stroke", "#0a1428")
      .attr("stroke-width", 3);
    
    node.append("title")
      .text(d => d.data.name);
  }
  
  // Initialize
  if (typeof window.dashboardData !== 'undefined' && window.dashboardData.dependencyTree) {
    renderDependencyTree(window.dashboardData.dependencyTree);
  } else {
    console.warn("Dependency tree data not available");
  }
})();
</script>
