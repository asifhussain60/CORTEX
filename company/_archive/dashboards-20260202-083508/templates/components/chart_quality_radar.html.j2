{# 
  Chart.js Code Quality Radar Component
  CORTEX Phase 18 - Quality Tab
  Displays code quality metrics as radar chart
#}

<div class="chart-container">
  <div class="chart-header">
    <h3>Code Quality Metrics</h3>
    <p class="chart-description">Multi-dimensional quality assessment</p>
  </div>
  <div class="chart-canvas-wrapper">
    <canvas id="quality-radar" role="img" aria-label="Code quality radar chart showing maintainability, complexity, test coverage, and documentation scores"></canvas>
  </div>
</div>

<script>
(function() {
  'use strict';
  
  // Render quality radar chart
  function renderQualityRadar(data) {
    const ctx = document.getElementById('quality-radar');
    if (!ctx) return;
    
    const chartData = {
      labels: [
        'Maintainability',
        'Complexity',
        'Test Coverage',
        'Documentation',
        'Security',
        'Performance'
      ],
      datasets: [{
        label: 'Quality Score',
        data: [
          data.maintainability || 70,
          data.complexity || 65,
          data.testCoverage || 80,
          data.documentation || 60,
          data.security || 75,
          data.performance || 70
        ],
        fill: true,
        backgroundColor: 'rgba(54, 162, 235, 0.2)',
        borderColor: 'rgb(54, 162, 235)',
        pointBackgroundColor: 'rgb(54, 162, 235)',
        pointBorderColor: '#fff',
        pointHoverBackgroundColor: '#fff',
        pointHoverBorderColor: 'rgb(54, 162, 235)'
      }]
    };
    
    new Chart(ctx, {
      type: 'radar',
      data: chartData,
      options: {
        elements: {
          line: {
            borderWidth: 3
          }
        },
        scales: {
          r: {
            angleLines: {
              color: 'rgba(255, 255, 255, 0.1)'
            },
            grid: {
              color: 'rgba(255, 255, 255, 0.1)'
            },
            pointLabels: {
              color: 'rgba(255, 255, 255, 0.8)',
              font: {
                size: 12
              }
            },
            ticks: {
              color: 'rgba(255, 255, 255, 0.6)',
              backdropColor: 'transparent',
              min: 0,
              max: 100
            }
          }
        },
        plugins: {
          legend: {
            labels: {
              color: 'rgba(255, 255, 255, 0.8)'
            }
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                return context.label + ': ' + context.parsed.r + '/100';
              }
            }
          }
        }
      }
    });
  }
  
  // Initialize with data
  if (typeof window.dashboardData !== 'undefined' && window.dashboardData.qualityMetrics) {
    renderQualityRadar(window.dashboardData.qualityMetrics);
  } else {
    console.warn("Quality metrics data not available");
  }
})();
</script>

<style>
.chart-canvas-wrapper {
  position: relative;
  height: 400px;
  padding: 20px;
}

.chart-canvas-wrapper canvas {
  max-width: 100%;
  max-height: 100%;
}
</style>
