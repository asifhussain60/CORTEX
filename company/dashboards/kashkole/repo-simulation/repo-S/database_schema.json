{
  "database_name": "ContosoPOS_DB",
  "server": "localhost\\SQLEXPRESS",
  "type": "SQL Server",
  "version": "2022",
  "size_gb": 0.5,
  "tables": [
    {"name": "Products", "rows": 250, "columns": 12, "indexes": 3, "foreign_keys": 1},
    {"name": "Categories", "rows": 15, "columns": 5, "indexes": 1, "foreign_keys": 0},
    {"name": "Sales", "rows": 5200, "columns": 10, "indexes": 4, "foreign_keys": 2},
    {"name": "SaleItems", "rows": 18500, "columns": 8, "indexes": 3, "foreign_keys": 2},
    {"name": "Customers", "rows": 450, "columns": 15, "indexes": 2, "foreign_keys": 0},
    {"name": "Users", "rows": 5, "columns": 12, "indexes": 2, "foreign_keys": 0},
    {"name": "Roles", "rows": 3, "columns": 4, "indexes": 1, "foreign_keys": 0},
    {"name": "UserRoles", "rows": 5, "columns": 3, "indexes": 2, "foreign_keys": 2},
    {"name": "AuditLogs", "rows": 12500, "columns": 8, "indexes": 2, "foreign_keys": 1},
    {"name": "Settings", "rows": 25, "columns": 4, "indexes": 1, "foreign_keys": 0}
  ],
  "views": [
    {"name": "vw_SalesSummary", "columns": 8, "base_tables": ["Sales", "SaleItems", "Products"]},
    {"name": "vw_CustomerPurchases", "columns": 6, "base_tables": ["Customers", "Sales"]},
    {"name": "vw_InventoryStatus", "columns": 5, "base_tables": ["Products", "Categories"]}
  ],
  "stored_procedures": [
    {"name": "sp_GetDailySales", "parameters": 2, "complexity": "low"},
    {"name": "sp_GetProductSales", "parameters": 3, "complexity": "medium"},
    {"name": "sp_UpdateInventory", "parameters": 2, "complexity": "low"},
    {"name": "sp_GenerateReceipt", "parameters": 1, "complexity": "medium"},
    {"name": "sp_CloseRegister", "parameters": 2, "complexity": "low"}
  ],
  "relationships": [
    {"from": "Products", "to": "Categories", "type": "many-to-one"},
    {"from": "SaleItems", "to": "Products", "type": "many-to-one"},
    {"from": "SaleItems", "to": "Sales", "type": "many-to-one"},
    {"from": "Sales", "to": "Customers", "type": "many-to-one"},
    {"from": "Sales", "to": "Users", "type": "many-to-one"},
    {"from": "UserRoles", "to": "Users", "type": "many-to-one"},
    {"from": "UserRoles", "to": "Roles", "type": "many-to-one"}
  ]
}
