{
  "name": "cortex-dashboard-spa",
  "version": "3.0.0",
  "description": "CORTEX Enterprise Repository Intelligence Dashboard",
  "private": true,
  "main": "js/app.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint js/",
    "serve": "python -m http.server 8080"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@testing-library/jest-dom": "^6.4.0",
    "eslint": "^8.57.0",
    "fuse.js": "^7.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.spec.js",
      "**/*.test.js"
    ],
    "moduleNameMapper": {
      "^../js/(.*)$": "<rootDir>/js/$1"
    },
    "setupFilesAfterEnv": [
      "@testing-library/jest-dom"
    ],
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/vendor/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "author": "Asif Hussain",
  "license": "MIT"
}
