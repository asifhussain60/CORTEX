{# 
  D3.js Directory Treemap Component
  CORTEX Phase 18 - Architecture Tab
  Visualizes directory structure as treemap
#}

<div class="chart-container">
  <div class="chart-header">
    <h3>Directory Structure</h3>
    <p class="chart-description">Hierarchical view of repository files and folders</p>
  </div>
  <div id="directory-treemap" class="visualization-canvas" role="img" aria-label="Directory structure treemap visualization">
    <div class="loading-placeholder">Loading treemap...</div>
  </div>
</div>

<script>
(function() {
  'use strict';
  
  // Load data and render treemap
  function renderDirectoryTreemap(data) {
    const width = 800;
    const height = 600;
    
    // Clear loading placeholder
    const container = d3.select("#directory-treemap");
    container.html("");
    
    // Create SVG
    const svg = container.append("svg")
      .attr("width", width)
      .attr("height", height)
      .attr("viewBox", [0, 0, width, height])
      .attr("style", "max-width: 100%; height: auto;");
    
    // Create hierarchy
    const root = d3.hierarchy(data)
      .sum(d => d.size || 0)
      .sort((a, b) => b.value - a.value);
    
    // Create treemap layout
    d3.treemap()
      .size([width, height])
      .padding(1)
      .round(true)
      (root);
    
    // Color scale
    const color = d3.scaleOrdinal(d3.schemeCategory10);
    
    // Create cells
    const leaf = svg.selectAll("g")
      .data(root.leaves())
      .join("g")
      .attr("transform", d => `translate(${d.x0},${d.y0})`);
    
    // Add rectangles
    leaf.append("rect")
      .attr("fill", d => color(d.parent.data.name))
      .attr("fill-opacity", 0.6)
      .attr("stroke", "#fff")
      .attr("width", d => d.x1 - d.x0)
      .attr("height", d => d.y1 - d.y0)
      .append("title")
      .text(d => `${d.data.name}\n${d.value} bytes`);
    
    // Add text labels
    leaf.append("text")
      .attr("x", 3)
      .attr("y", 13)
      .text(d => d.data.name)
      .attr("font-size", "10px")
      .attr("fill", "#000")
      .each(function(d) {
        const width = d.x1 - d.x0;
        if (this.getComputedTextLength() > width - 6) {
          d3.select(this).text(d.data.name.substring(0, 10) + "...");
        }
      });
  }
  
  // Initialize with data
  if (typeof window.dashboardData !== 'undefined' && window.dashboardData.directoryTree) {
    renderDirectoryTreemap(window.dashboardData.directoryTree);
  } else {
    console.warn("Directory tree data not available");
  }
})();
</script>

<style>
.chart-container {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12px;
  padding: 20px;
  margin: 20px 0;
  backdrop-filter: blur(10px);
}

.chart-header h3 {
  margin: 0 0 8px 0;
  color: #fff;
  font-size: 1.25rem;
}

.chart-description {
  margin: 0 0 16px 0;
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.9rem;
}

.visualization-canvas {
  background: rgba(0, 0, 0, 0.2);
  border-radius: 8px;
  min-height: 400px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-placeholder {
  color: rgba(255, 255, 255, 0.5);
  font-style: italic;
}
</style>
