{# 
  Chart.js LOC Distribution Bar Chart Component
  CORTEX Phase 18 - Quality Tab
  Lines of code distribution across files
#}

<div class="chart-container">
  <div class="chart-header">
    <h3>Lines of Code Distribution</h3>
    <p class="chart-description">File size distribution by line count</p>
  </div>
  <div class="chart-canvas-wrapper" style="position: relative; height: 400px; padding: 20px;">
    <canvas id="loc-bar-chart" 
            role="img" 
            aria-label="Lines of code distribution bar chart"></canvas>
  </div>
</div>

<script>
(function() {
  'use strict';
  
  function renderLOCBarChart(data) {
    const ctx = document.getElementById('loc-bar-chart');
    if (!ctx) return;
    
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: data.labels,
        datasets: [{
          label: 'Number of Files',
          data: data.values,
          backgroundColor: [
            'rgba(34, 197, 94, 0.6)',    // Green: <100
            'rgba(77, 140, 255, 0.6)',   // Blue: 100-500
            'rgba(245, 158, 11, 0.6)',   // Orange: 500-1000
            'rgba(239, 68, 68, 0.6)'     // Red: 1000+
          ],
          borderColor: [
            'rgb(34, 197, 94)',
            'rgb(77, 140, 255)',
            'rgb(245, 158, 11)',
            'rgb(239, 68, 68)'
          ],
          borderWidth: 2
        }]
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          x: {
            beginAtZero: true,
            ticks: {
              color: 'rgba(255, 255, 255, 0.8)',
              font: {size: 12}
            },
            grid: {
              color: 'rgba(255, 255, 255, 0.1)'
            },
            title: {
              display: true,
              text: 'Number of Files',
              color: 'rgba(255, 255, 255, 0.8)',
              font: {size: 13}
            }
          },
          y: {
            ticks: {
              color: 'rgba(255, 255, 255, 0.8)',
              font: {size: 12}
            },
            grid: {
              color: 'rgba(255, 255, 255, 0.1)'
            },
            title: {
              display: true,
              text: 'Lines of Code Range',
              color: 'rgba(255, 255, 255, 0.8)',
              font: {size: 13}
            }
          }
        },
        plugins: {
          legend: {
            display: false
          },
          title: {
            display: true,
            text: 'File Size Distribution (Lines of Code)',
            color: 'rgba(255, 255, 255, 0.9)',
            font: {size: 16, weight: '600'}
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                const percentage = ((context.parsed.x / total) * 100).toFixed(1);
                return `${context.parsed.x} files (${percentage}%)`;
              }
            }
          }
        }
      }
    });
  }
  
  // Initialize
  if (typeof window.dashboardData !== 'undefined' && window.dashboardData.locDistribution) {
    renderLOCBarChart(window.dashboardData.locDistribution);
  } else {
    console.warn("LOC distribution data not available");
  }
})();
</script>
