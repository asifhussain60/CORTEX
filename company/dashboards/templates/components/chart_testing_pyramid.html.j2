{# 
  Chart.js Testing Pyramid Component
  CORTEX Phase 18 - Testing Tab
  Visualization of test distribution (unit/integration/e2e)
#}

<div class="chart-container">
  <div class="chart-header">
    <h3>Testing Pyramid</h3>
    <p class="chart-description">Test distribution by type (ideal: more unit, fewer E2E)</p>
  </div>
  <div class="chart-canvas-wrapper" style="position: relative; height: 450px; padding: 20px;">
    <canvas id="testing-pyramid" 
            role="img" 
            aria-label="Testing pyramid showing distribution of unit, integration, and end-to-end tests"></canvas>
  </div>
</div>

<script>
(function() {
  'use strict';
  
  function renderTestingPyramid(data) {
    const ctx = document.getElementById('testing-pyramid');
    if (!ctx) return;
    
    // Create pyramid-style stacked bar chart
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: ['Test Distribution'],
        datasets: [
          {
            label: 'Unit Tests',
            data: [data.unit],
            backgroundColor: 'rgba(34, 197, 94, 0.7)',
            borderColor: 'rgb(34, 197, 94)',
            borderWidth: 2,
            barThickness: 150
          },
          {
            label: 'Integration Tests',
            data: [data.integration],
            backgroundColor: 'rgba(77, 140, 255, 0.7)',
            borderColor: 'rgb(77, 140, 255)',
            borderWidth: 2,
            barThickness: 100
          },
          {
            label: 'E2E Tests',
            data: [data.e2e],
            backgroundColor: 'rgba(245, 158, 11, 0.7)',
            borderColor: 'rgb(245, 158, 11)',
            borderWidth: 2,
            barThickness: 50
          }
        ]
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          x: {
            stacked: false,
            beginAtZero: true,
            ticks: {
              color: 'rgba(255, 255, 255, 0.8)',
              font: {size: 12}
            },
            grid: {
              color: 'rgba(255, 255, 255, 0.1)'
            },
            title: {
              display: true,
              text: 'Number of Tests',
              color: 'rgba(255, 255, 255, 0.8)',
              font: {size: 13}
            }
          },
          y: {
            stacked: false,
            ticks: {
              color: 'rgba(255, 255, 255, 0.8)',
              font: {size: 12}
            },
            grid: {
              display: false
            }
          }
        },
        plugins: {
          legend: {
            position: 'top',
            labels: {
              color: 'rgba(255, 255, 255, 0.8)',
              font: {size: 14},
              padding: 15,
              boxWidth: 20,
              boxHeight: 20
            }
          },
          title: {
            display: true,
            text: 'Testing Pyramid Distribution',
            color: 'rgba(255, 255, 255, 0.9)',
            font: {size: 18, weight: '600'},
            padding: {bottom: 20}
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                const total = data.unit + data.integration + data.e2e;
                const percentage = ((context.parsed.x / total) * 100).toFixed(1);
                return `${context.dataset.label}: ${context.parsed.x} (${percentage}%)`;
              }
            }
          }
        }
      }
    });
  }
  
  // Initialize
  if (typeof window.dashboardData !== 'undefined' && window.dashboardData.testingPyramid) {
    renderTestingPyramid(window.dashboardData.testingPyramid);
  } else {
    console.warn("Testing pyramid data not available");
  }
})();
</script>
