{
  "info": {
    "name": "RA Funding Invoices API",
    "description": "Postman collection for RA Funding Invoices REST API - migrated from WCF transactions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "1234567"
  },
  "item": [
    {
      "name": "Funding Invoices",
      "item": [
        {
          "name": "Create Invoice (Payroll-based)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employerId\": \"EMP-001\",\n  \"subaccountId\": \"SA-001\",\n  \"reimbursementPlanId\": \"RP-001\",\n  \"employerFundingDefault\": 500.00,\n  \"employeeFundingDefault\": 250.00,\n  \"effectiveDate\": \"2025-12-15T00:00:00Z\",\n  \"invoiceDescription\": \"Payroll funding - December 2025\",\n  \"isLSA\": false,\n  \"updateTemplate\": true,\n  \"createdBy\": \"system\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/funding-invoices",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "funding-invoices"]
            },
            "description": "Creates a payroll-based funding invoice (migrated from XAddFundingInvoice WCF transaction)"
          },
          "response": []
        },
        {
          "name": "Generate Invoice (On-Demand)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subaccountId\": \"SA-001\",\n  \"invoiceAmount\": 500.00,\n  \"invoiceDate\": \"2025-12-15T00:00:00Z\",\n  \"createdBy\": \"system\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/funding-invoices/generate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "funding-invoices", "generate"]
            },
            "description": "Generates on-demand invoice with peg amount logic (migrated from XGenerateFundingInvoice WCF transaction)"
          },
          "response": []
        },
        {
          "name": "Create Batch Invoices",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employerIds\": [\"EMP-001\", \"EMP-002\"],\n  \"createdBy\": \"system\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/funding-invoices/batch",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "funding-invoices", "batch"]
            },
            "description": "Creates funding invoices for multiple subaccounts (migrated from Updater_CreateRAFundingInvoices)"
          },
          "response": []
        },
        {
          "name": "Get Invoice by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/funding-invoices/{{invoiceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "funding-invoices", "{{invoiceId}}"]
            },
            "description": "Retrieves a single funding invoice by ID"
          },
          "response": []
        },
        {
          "name": "Get Invoices by Batch ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/funding-invoices/batch/{{batchId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "funding-invoices", "batch", "{{batchId}}"]
            },
            "description": "Retrieves all invoices in a specific batch"
          },
          "response": []
        },
        {
          "name": "Get Invoices by Subaccount ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/funding-invoices/subaccount/{{subaccountId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "funding-invoices", "subaccount", "{{subaccountId}}"]
            },
            "description": "Retrieves all invoices for a specific subaccount"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Funding Batches",
      "item": [
        {
          "name": "Create Batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"December 2025 Payroll Batch\",\n  \"employerId\": \"EMP-001\",\n  \"createdBy\": \"system\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/funding-batches",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "funding-batches"]
