            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"batchId\": \"{{batchId}}\",\n  \"description\": \"December 2025 Batch - Closed\",\n  \"excludedInvoiceIds\": [\"INV-999\"],\n  \"closedBy\": \"system\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/funding-batches/close",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "funding-batches", "close"]
