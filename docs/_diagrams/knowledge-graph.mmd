flowchart TB
    subgraph SOURCES["Intelligence Sources"]
        AST[AST Adapter<br/>Code Structure]
        GIT[Git Adapter<br/>History]
        COMM[Comments Adapter<br/>Documentation]
        REL[Relationships Adapter<br/>Dependencies]
    end
    
    subgraph BKIO["BKIO Orchestrator"]
        PARSE[Document Parsing]
        EXTRACT[Entity Extraction]
        DETECT[Conflict Detection]
        RESOLVE[Conflict Resolution]
    end
    
    subgraph STORAGE["Knowledge Storage"]
        T3[(Tier 3 Knowledge Base)]
        GRAPH[(Knowledge Graph<br/>CORTEX LENS)]
        VALID[Consistency Validator]
    end
    
    AST & GIT & COMM & REL --> PARSE
    PARSE --> EXTRACT --> DETECT --> RESOLVE
    RESOLVE --> T3 & GRAPH
    GRAPH --> VALID
    
    subgraph GRAPH_OPS["Graph Operations (50+)"]
        NODE[GraphNode - Entity]
        EDGE[GraphEdge - Relationship]
        PATH[Path Finding]
        QUERY[Query Engine]
    end
    
    GRAPH --> GRAPH_OPS
    
    subgraph VALIDATION["Consistency Checks"]
        DUP[Duplicate Detection]
        ORPHAN[Orphan Detection]
        VER[Version Tracking]
        CONFLICT[Conflict Resolution]
    end
    
    VALID --> VALIDATION
