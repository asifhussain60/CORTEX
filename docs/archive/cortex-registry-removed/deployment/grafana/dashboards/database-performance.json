{
  "dashboard": {
    "title": "CORTEX Database Performance",
    "description": "Database query latency, connection pool metrics, and transaction health",
    "tags": ["cortex", "database"],
    "panels": [
      {
        "title": "Query Latency by Type (ms)",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(db_query_duration_seconds_bucket[5m])) by (query_type) * 1000"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Connection Pool Metrics",
        "targets": [
          {
            "expr": "db_connections_active",
            "legendFormat": "Active"
          },
          {
            "expr": "db_connections_idle",
            "legendFormat": "Idle"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Transaction Rollback Rate",
        "targets": [
          {
            "expr": "rate(db_transactions_rolled_back_total[1m])"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Lock Contention Events",
        "targets": [
          {
            "expr": "rate(db_lock_waits_total[5m])"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Query Performance Distribution",
        "targets": [
          {
            "expr": "rate(db_queries_total[5m]) by (query_type, status)"
          }
        ],
        "type": "table"
      }
    ]
  }
}
