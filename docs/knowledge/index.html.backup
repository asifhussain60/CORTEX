        <!-- How CORTEX Uses Guidelines -->
        <section class="glass-card-display animation-t1">
            <h2 class="section-title">
                <i class="fas fa-brain"></i>
                How CORTEX Consults Guidelines
            </h2>
            
            <p class="intro-text">Guidelines are integrated into <strong>Tier 2 Knowledge Graph</strong> with semantic relationships. CORTEX automatically queries relevant guidelines during code generation based on context.</p>
            
            <div class="diagram-container">
                <div class="mermaid">
sequenceDiagram
    participant User
    participant CORTEX
    participant T2 as Tier 2 Knowledge Graph
    participant Guidelines as Best Practice Files
    
    User->>CORTEX: Request code implementation
    CORTEX->>CORTEX: Analyze context (language, domain, task)
    CORTEX->>T2: Query relevant guidelines
    T2->>Guidelines: Fetch React + API + Testing patterns
    Guidelines-->>T2: Return best practices
    T2-->>CORTEX: Provide context-aware guidelines
    CORTEX->>CORTEX: Generate code following guidelines
    CORTEX-->>User: Implementation with quality enforced
                </div>
            </div>
            
            <div class="two-column-grid">
                <div class="info-box">
                    <h3>Automatic Consultation</h3>
                    <ul class="feature-list-compact">
                        <li>No manual prompting required</li>
                        <li>Context-aware guideline selection</li>
                        <li>Semantic relationship traversal</li>
                        <li>Multi-guideline synthesis</li>
                    </ul>
                </div>
                
                <div class="info-box">
                    <h3>Tier 2 Integration</h3>
                    <ul class="feature-list-compact">
                        <li>35 guidelines stored as nodes</li>
                        <li>Relationships mapped semantically</li>
                        <li>Query patterns learned over time</li>
                        <li>Continuous graph enrichment</li>
                    </ul>
                </div>
            </div>
        </section>

