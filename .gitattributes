# CORTEX .gitattributes
# Ensures consistent line endings across Mac/Linux/Windows
# Prevents health check from seeing files as "missing" or "changed" on Windows
# Default: normalize all text files to LF in the repo
* text=auto eol=lf
# Explicitly force LF for source files
*.py        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.sh        text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.env       text eol=lf
# .NET / C# fixtures — LF to avoid CRLF issues on Windows checkout
*.cs        text eol=lf
*.csproj    text eol=lf
*.sln       text eol=lf
# Shell scripts must always be LF
*.sh        text eol=lf
*.bash      text eol=lf
# Binary files — never touch line endings
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.dll       binary
*.pdb       binary
*.exe       binary
*.zip       binary
*.tar.gz    binary
*.whl       binary
*.pyc       binary
*.pdf filter=lfs diff=lfs merge=lfs -text
*.pptx filter=lfs diff=lfs merge=lfs -text
