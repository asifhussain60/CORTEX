# CORTEX Pre-Commit Hook Ignore Patterns
# Files/patterns listed here will be ignored by the pre-commit hook

# Allowed root-level files
README.md
LICENSE
CHANGELOG.md
cortex.config.json
cortex.config.template.json
requirements.txt
pytest.ini
mkdocs.yml
.gitignore
.cortexignore

# Allowed directories at root
.github/
docs/
scripts/
tests/
src/
cortex-brain/
cortex-toolkit/
cortex-sample-apps/
cortex-lens-output/
archive/

# Temporary build artifacts (allowed temporarily)
htmlcov/
site/
.pytest_cache/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE files
.vscode/
.vs/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Database files
*.db
*.sqlite
*.sqlite3

# Log files (temporary)
logs/
*.log

# Coverage reports (generated)
coverage.json
.coverage
htmlcov/
