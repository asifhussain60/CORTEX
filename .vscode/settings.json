{
  "// GitHub Copilot Chat Settings - Prevent markdown file generation (CORE-002)": null,
  "github.copilot.chat.saveSession": false,
  "github.copilot.chat.welcomeMessage": "inline",
  "github.copilot.chat.localeOverride": "en",
  "github.copilot.chat.contextWindowSizeKb": 8,
  
  "// File Explorer Suppression - Hide Copilot-generated markdown files": null,
  "files.exclude": {
    "**/*-summary.md": true,
    "**/*-report.md": true,
    "**/*-completion.md": true,
    "**/*-COMPLETION.md": true,
    "**/*-SUMMARY.md": true,
    "**/*-REPORT.md": true,
    "**/PHASE-*-COMPLETION.md": true,
    "**/ENH-*-PHASE-*-COMPLETION.md": true,
    "**/ARCHITECT-*-SUMMARY.md": true
  },
  
  "// Files Watcher - Exclude Copilot patterns from watchers": null,
  "files.watcherExclude": {
    "**/*-summary.md": true,
    "**/*-report.md": true,
    "**/*-completion.md": true,
    "**/*-COMPLETION.md": true
  },
  
  "// Search Exclusions - Hide from search results": null,
  "search.exclude": {
    "**/*-summary.md": true,
    "**/*-report.md": true,
    "**/*-completion.md": true,
    "**/*-COMPLETION.md": true,
    "**/*-SUMMARY.md": true,
    "**/*-REPORT.md": true
  },
  
  "// Python Environment": null,
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.extraPaths": ["${workspaceFolder}/cortex"],
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "tests/"
  ],
  "chat.tools.terminal.autoApprove": {
    "/^python -m pytest tests/integration/test_phase28_s5_orchestrator_integration\\.py --collect-only 2>&1 \\| Select-Object -First 30$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^python -m pytest tests/integration/test_phase28_s5_orchestrator_integration\\.py -v --tb=short 2>&1 \\| tail -50$/": {
      "approve": true,
      "matchCommandLine": true
    }
  }
}
